	-- ==========================================
	-- CONTENT + TABS (CanvasGroup for the fade animation)
	-- ==========================================
	local ContentFrame = Instance.new("CanvasGroup", MainFrame)
	ContentFrame.Name = "ContentFrame"
	ContentFrame.Size = UDim2.new(1, -(sidebarW + pad * 3), 1, -(topBarH + pad * 2))
	ContentFrame.Position = UDim2.new(0, sidebarW + pad * 2, 0, topBarH + pad)
	ContentFrame.BackgroundTransparency = 1
	ContentFrame.BorderSizePixel = 0

	local pages = {}
	local tabButtons = {}
	local tabBars = {}
	local tabOrder = {}
	local activeTab = nil
	local currentPage = nil
	local tabTweenInfo = TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	local function refreshTabColors()
		local t = themes[currentThemeName]
		for name, btn in pairs(tabButtons) do
			local active = (name == activeTab)
			TweenService:Create(btn, tabTweenInfo, {
				BackgroundColor3 = t.Stroke,
				BackgroundTransparency = active and 0.35 or 1,
				TextColor3 = active and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(170, 170, 170)
			}):Play()
			local bar = tabBars[name]
			if bar then
				TweenService:Create(bar, tabTweenInfo, {
					BackgroundColor3 = t.TopGrad2,
					BackgroundTransparency = active and 0 or 1
				}):Play()
			end
		end
	end

	local function selectTab(name, instant)
		if not pages[name] then return end
		if name == activeTab and not instant then return end
		activeTab = name
		for pageName, page in pairs(pages) do
			page.Visible = (pageName == name)
		end
		refreshTabColors()
		if not instant then
			local page = pages[name]
			page.Position = UDim2.new(0, math.floor(16 * scale), 0, 0)
			ContentFrame.GroupTransparency = 1
			local info = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(page, info, {Position = UDim2.new(0, 0, 0, 0)}):Play()
			TweenService:Create(ContentFrame, info, {GroupTransparency = 0}):Play()
		end
	end

	local function refreshTabVisibility()
		local firstVisible = nil
		for _, name in ipairs(tabOrder) do
			local page = pages[name]
			local show = true
			if currentMode == "Buttons" then
				-- In Buttons mode only tabs with dropdowns (or always-visible tabs) stay visible
				show = (page:GetAttribute("AlwaysVisible") == true) or (page:FindFirstChild("DropdownContainer") ~= nil) or (page:FindFirstChild("FlingDropdownContainer") ~= nil)
			end
			tabButtons[name].Visible = show
			if show and not firstVisible then firstVisible = name end
		end
		if firstVisible and (not activeTab or not tabButtons[activeTab].Visible) then
			selectTab(firstVisible)
		end
	end

	local function createTab(name, alwaysVisible)
		local page = Instance.new("ScrollingFrame", ContentFrame)
		page.Name = name .. "Page"
		page.Size = UDim2.new(1, 0, 1, 0)
		page.BackgroundTransparency = 1
		page.BorderSizePixel = 0
		page.ScrollBarThickness = math.max(2, math.floor(2 * scale))
		page.AutomaticCanvasSize = Enum.AutomaticSize.Y
		page.CanvasSize = UDim2.new(0, 0, 0, 0)
		page.Visible = false
		page:SetAttribute("AlwaysVisible", alwaysVisible == true)

		local pageLayout = Instance.new("UIListLayout", page)
		pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
		pageLayout.Padding = UDim.new(0, math.floor(6 * scale))
		local pagePadding = Instance.new("UIPadding", page)
		pagePadding.PaddingRight = UDim.new(0, math.floor(5 * scale))

		local header = Instance.new("TextLabel", page)
		header.Name = "PageHeader"
		header.LayoutOrder = -1
		header.Size = UDim2.new(1, 0, 0, math.floor(18 * scale))
		header.BackgroundTransparency = 1
		header.Text = string.upper(name)
		header.TextColor3 = Color3.fromRGB(130, 130, 130)
		header.TextSize = math.max(9, math.floor(10 * scale))
		header.Font = Enum.Font.GothamBold
		header.TextXAlignment = Enum.TextXAlignment.Left

		local btn = Instance.new("TextButton", TabList)
		btn.Name = name .. "Tab"
		btn.Size = UDim2.new(1, -pad * 2, 0, math.floor(30 * scale))
		btn.BackgroundColor3 = themes[currentThemeName].Stroke
		btn.BackgroundTransparency = 1
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.Text = name
		btn.TextColor3 = Color3.fromRGB(170, 170, 170)
		btn.TextSize = math.max(9, math.floor(11 * scale))
		btn.Font = Enum.Font.GothamMedium
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, math.floor(7 * scale))

		local bar = Instance.new("Frame", btn)
		bar.Name = "ActiveBar"
		bar.Size = UDim2.new(0, math.max(2, math.floor(3 * scale)), 0.6, 0)
		bar.Position = UDim2.new(0, math.floor(3 * scale), 0.2, 0)
		bar.BackgroundColor3 = themes[currentThemeName].TopGrad2
		bar.BackgroundTransparency = 1
		bar.BorderSizePixel = 0
		Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

		btn.MouseEnter:Connect(function()
			if name ~= activeTab then
				TweenService:Create(btn, tabTweenInfo, {BackgroundTransparency = 0.75, TextColor3 = Color3.fromRGB(215, 215, 215)}):Play()
			end
		end)
		btn.MouseLeave:Connect(function()
			if name ~= activeTab then
				TweenService:Create(btn, tabTweenInfo, {BackgroundTransparency = 1, TextColor3 = Color3.fromRGB(170, 170, 170)}):Play()
			end
		end)
		bindClick(btn, function() selectTab(name) end)

		pages[name] = page
		tabButtons[name] = btn
		tabBars[name] = bar
		table.insert(tabOrder, name)
		btn.LayoutOrder = #tabOrder
		return page
	end

	local function usePage(name)
		currentPage = pages[name]
	end

	createTab("Visuals")
