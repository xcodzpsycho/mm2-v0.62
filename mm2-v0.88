-- Floating overlays whose position is remembered between sessions (filled in by the hub: stats overlay).
local FloatingUi = {}

-- EARLY ROLE DATA
-- MM2 keeps a role table for the whole round (the same one its own UI uses). Asking for it tells us who is Murderer /
-- Sheriff before anybody holds a weapon. Inventory checks stay as the fallback when the table is not available.
local RoleInfo = {data = nil, time = 0, remote = nil, busy = false, busyAt = 0}

function RoleInfo.refresh()
	if RoleInfo.busy and os.clock() - RoleInfo.busyAt < 6 then return end
	RoleInfo.busy, RoleInfo.busyAt = true, os.clock()
	task.spawn(function()
		pcall(function()
			local remote = RoleInfo.remote
			if not (remote and remote.Parent) then
				remote = game:GetService("ReplicatedStorage"):FindFirstChild("GetPlayerData", true)
				RoleInfo.remote = remote
			end
			if remote and remote:IsA("RemoteFunction") then
				local result = remote:InvokeServer()
				if type(result) == "table" then
					RoleInfo.data = result
					RoleInfo.time = os.clock()
				end
			end
		end)
		RoleInfo.busy = false
	end)
end

-- "Murderer", "Sheriff" (also used for Hero) or nil when the table does not say (then the inventory decides)
function RoleInfo.roleOf(player)
	local data = RoleInfo.data
	if not data or os.clock() - RoleInfo.time > 6 then return nil end
	local entry = data[player.Name]
	if type(entry) ~= "table" then return nil end
	if entry.Role == "Murderer" then return "Murderer" end
	if entry.Role == "Sheriff" or entry.Role == "Hero" then return "Sheriff" end
	return nil
end

