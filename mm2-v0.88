	createRightButton("Knife Reach (My Knife)", function(s) FloatingUi.x.reachOn = s end, true, false)
	createRightSpeedInput("Reach Size:", 4, 1, 15, function(v) FloatingUi.x.reachMult = v end)
	createRightButton("Server Hop (Random)", function() FloatingUi.serverHop("random") end, false)
	createRightButton("Server Hop (Fewest Players)", function() FloatingUi.serverHop("fewest") end, false)
	createRightButton("Server Hop (Most Players)", function() FloatingUi.serverHop("most") end, false)
	createRightButton("Best Connection (Random)", function() FloatingUi.serverHop("best_random") end, false)
	createRightButton("Best Connection (Fewest Players)", function() FloatingUi.serverHop("best_fewest") end, false)
	createRightButton("Best Connection (Most Players)", function() FloatingUi.serverHop("best_most") end, false)
	createRightButton("Keybinds", function(s) FloatingUi.setKeybinds(s) end, true, false)
	createRightButton("Music Player", function(s) FloatingUi.setMusic(s) end, true, false)
	createRightButton("Role Automation", setRoleAutomation, true, false)
	createRightButton("Kill All (As Murder)", function(state) killAllMurderEnabled = state end, true, killAllMurderEnabled)
	createRightButton("Kill Murder (As Sheriff)", function(state) sheriffAutoKillEnabled = state end, true, sheriffAutoKillEnabled)
	createRightButton("1st Person Aimbot (As Sheriff)", function(state) aimbotEnabled = state end, true, aimbotEnabled)

	createRightButton("Speed Boost", function(state)
		speedEnabled = state
		if not state and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
			LocalPlayer.Character.Humanoid.WalkSpeed = 16
		end
	end, true, speedEnabled)
	createRightSpeedInput("Speed Boost:", currentSpeed, 1, 150, function(val) currentSpeed = val end)

	createRightButton("Fly", function(state)
		flyEnabled = state
		if state then startFly() else stopFly() end
	end, true, flyEnabled)
	createRightSpeedInput("Fly Speed:", currentFlySpeed, 1, 300, function(val) currentFlySpeed = val end)

	createRightButton("Jump Boost", fx.setJump, true, fx.jump)
	createRightSpeedInput("Jump Power:", fx.jumpValue, 1, 200, function(val) fx.jumpValue = val end)

	createRightButton("Infinite Jump", function(state) infJumpEnabled = state end, true, infJumpEnabled)
	createRightButton("Noclip", function(state)
		noclipEnabled = state
		if not state and LocalPlayer.Character then
			for part in pairs(noclipChanged) do
				noclipChanged[part] = nil
				if part.Parent and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
			end
		end
	end, true, noclipEnabled)
	createRightButton("Anti Fling", setAntiFling, true, antiFlingEnabled)

	createRightButton("Anti AFK", fx.setAntiAfk, true, fx.antiAfk)
	createRightButton("FPS Booster", onFpsBooster, true, fpsBoosterEnabled)
	createRightButton("Stats Overlay", fx.setStats, true, fx.stats)
	createRightSpeedInput("Game Volume:", 100, 0, 100, function(val) setGameVolume(val) end)

	createRightButton("PLACE TP (RED)", function() placeTPRed() end, false)
	createRightButton("TP (RED)", function() tpRed() end, false)
	createRightButton("PLACE TP (GREEN)", function() placeTPGreen() end, false)
	createRightButton("TP (GREEN)", function() tpGreen() end, false)
	createRightButton("Rejoin Server", fx.rejoin, false)
	createRightButton("Reset Character", fx.resetCharacter, false)

	createPlayerDropdown(RightButtonsContainer)
	createFlingDropdown(RightButtonsContainer)

	-- ==========================================
	-- SETTINGS PERSISTENCE: restored on start, saved automatically whenever something changes
	-- ==========================================
	do
		-- Risky automation never starts on its own after a rejoin
		local NO_AUTORESTORE = {
			["Show Welcome Screen"] = true, -- stored separately (welcome_skip), never part of the settings snapshot
		}

		local function canonical(v)
			if type(v) ~= "table" then return tostring(v) end
			local keys = {}
			for k in pairs(v) do keys[#keys + 1] = tostring(k) end
			table.sort(keys)
			local parts = {}
			for _, k in ipairs(keys) do
				parts[#parts + 1] = k .. "=" .. canonical(v[k])
			end
			return "{" .. table.concat(parts, ",") .. "}"
		end

		local function buildSettings()
			local data = uiApi and uiApi.snapshot() or {}
			local toggles, sliders = {}, {}
			for name, d in pairs(registeredToggles) do
				-- states set automatically (role automation) are not the player's own choice
				if not NO_AUTORESTORE[name] and not autoApplied[name] then
					toggles[name] = d.state
				end
			end
			for label, value in pairs(sliderValues) do sliders[label] = value end
			data.Toggles = toggles
			data.Sliders = sliders
			local p = MainFrame.AbsolutePosition - ScreenGui.AbsolutePosition
			data.PosX, data.PosY = math.floor(p.X), math.floor(p.Y)
			local ip = ReopenIcon.AbsolutePosition - ScreenGui.AbsolutePosition
			data.IconX, data.IconY = math.floor(ip.X), math.floor(ip.Y)
			local stats = FloatingUi.stats
			if stats and stats.Position.X.Scale == 0 then -- only once it was moved (the default is centered at the top)
				local sp = stats.AbsolutePosition - ScreenGui.AbsolutePosition
				data.StatsX, data.StatsY = math.floor(sp.X), math.floor(sp.Y)
			end
			local coinsUi = FloatingUi.coins
			if coinsUi then
				local cp = coinsUi.AbsolutePosition - ScreenGui.AbsolutePosition
				data.CoinsX, data.CoinsY = math.floor(cp.X), math.floor(cp.Y)
				data.CoinsW, data.CoinsH = math.floor(coinsUi.AbsoluteSize.X), math.floor(coinsUi.AbsoluteSize.Y)
			end
			return data
		end

		local saved = Storage.get("settings")
		if type(saved) == "table" then
			pcall(function()
				if uiApi then uiApi.apply(saved) end
				if type(saved.PosX) == "number" and type(saved.PosY) == "number" then
					MainFrame.Position = UDim2.fromOffset(saved.PosX, saved.PosY)
					clampToScreen(MainFrame)
				end
				if type(saved.IconX) == "number" and type(saved.IconY) == "number" then
					ReopenIcon.Position = UDim2.fromOffset(saved.IconX, saved.IconY)
					clampToScreen(ReopenIcon)
				end
				if FloatingUi.stats and type(saved.StatsX) == "number" and type(saved.StatsY) == "number" then
					local st = FloatingUi.stats
					local x, y = clampPosition(Vector2.new(st.Size.X.Offset, st.Size.Y.Offset), saved.StatsX, saved.StatsY)
					st.Position = UDim2.fromOffset(x, y)
				end
				if FloatingUi.coins and type(saved.CoinsX) == "number" and type(saved.CoinsY) == "number" then
					local cu = FloatingUi.coins
					if FloatingUi.coinsResize and type(saved.CoinsW) == "number" and type(saved.CoinsH) == "number" then
						FloatingUi.coinsResize(saved.CoinsW, saved.CoinsH)
					end
					local x, y = clampPosition(Vector2.new(cu.Size.X.Offset, cu.Size.Y.Offset), saved.CoinsX, saved.CoinsY)
					cu.Position = UDim2.fromOffset(x, y)
				end
				if type(saved.Sliders) == "table" then
					for label, value in pairs(saved.Sliders) do
						if type(value) == "number" and sliderApi[label] then sliderApi[label](value) end
					end
				end
				if type(saved.Toggles) == "table" then
					for name, data in pairs(registeredToggles) do
						local want = saved.Toggles[name]
						if type(want) == "boolean" and not NO_AUTORESTORE[name] and data.state ~= want then
							setToggleState(name, want)
						end
					end
				end
			end)
		end

		ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			clampToScreen(ReopenIcon)
		end)

		local function saveNow()
			local data = buildSettings()
			return Storage.set("settings", data), canonical(data)
		end

		local lastSaved = canonical(buildSettings())
		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(1)
				pcall(function()
					local data = buildSettings()
					local canon = canonical(data)
					if canon ~= lastSaved and Storage.set("settings", data) then
						lastSaved = canon
					end
				end)
			end
		end)

		Players.PlayerRemoving:Connect(function(p)
			if p == LocalPlayer then pcall(saveNow) end
		end)
	end

	-- ==========================================
	-- REORDER LAYOUT: move the tabs (sidebar) and the buttons inside a tab. Things stay in their own tab.
	-- UI Settings > "Reorder Layout": tap a tab or a button, then use the arrows. The order is saved.
	-- ==========================================
	;(function()
		local ORDER_BASE = -50000
		local HEADER_ORDER = -100000
		local on = false
		local target = nil -- {kind = "tab", name = ...} or {kind = "item", item = ...}
		local shields = {}
		local keyOf = setmetatable({}, {__mode = "k"})

		local saved = Storage.get("layout")
		if type(saved) ~= "table" then saved = {} end
		if type(saved.tabs) ~= "table" then saved.tabs = {} end
		if type(saved.lists) ~= "table" then saved.lists = {} end

		local function labelOf(inst)
			local t = ""
			if (inst:IsA("TextLabel") or inst:IsA("TextButton")) and inst.Text ~= "" then t = inst.Text end
			if t == "" then
				for _, d in ipairs(inst:GetDescendants()) do
					if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then t = d.Text break end
				end
			end
			t = t:gsub(":.*$", "")
			t = t:gsub("^%s+", "")
			t = t:gsub("%s+$", "")
			return t:sub(1, 40)
		end

		-- the things inside a tab, in the order they are shown now
		local function itemsOf(frame)
			local list = {}
			for i, c in ipairs(frame:GetChildren()) do
				if c:IsA("GuiObject") and c.Name ~= "PageHeader" and not c:GetAttribute("NoReorder") then
					list[#list + 1] = {inst = c, idx = i, lo = c.LayoutOrder}
				end
			end
			table.sort(list, function(a, b)
				if a.lo ~= b.lo then return a.lo < b.lo end
				return a.idx < b.idx
			end)
			local out = {}
			for i, e in ipairs(list) do out[i] = e.inst end
			return out
		end

		local function makeKeys(list)
			local used, keys = {}, {}
			for i, inst in ipairs(list) do
				local base = inst.ClassName .. "|" .. inst.Name .. "|" .. labelOf(inst)
				local n = (used[base] or 0) + 1
				used[base] = n
				keys[i] = (n == 1) and base or (base .. "#" .. n)
			end
			return keys
		end

		-- saved order + everything that is new since (put behind the item that was in front of it by default)
		local function mergeOrder(defaults, savedList)
			local isDefault, inRes, result = {}, {}, {}
			for _, k in ipairs(defaults) do isDefault[k] = true end
			for _, k in ipairs(savedList) do
				if type(k) == "string" and isDefault[k] and not inRes[k] then
					result[#result + 1] = k
					inRes[k] = true
				end
			end
			for i, k in ipairs(defaults) do
				if not inRes[k] then
					local at = 0
					for j = i - 1, 1, -1 do
						local idx = table.find(result, defaults[j])
						if idx then at = idx break end
					end
					table.insert(result, at + 1, k)
					inRes[k] = true
				end
			end
			return result
		end

		local function assign(list)
			for i, inst in ipairs(list) do inst.LayoutOrder = ORDER_BASE + i end
		end

		-- the tabs
		local defaultTabs = {}
		for i, n in ipairs(tabOrder) do defaultTabs[i] = n end
		local function applyTabs(names)
			for i = #tabOrder, 1, -1 do tabOrder[i] = nil end
			for _, n in ipairs(names) do
				if tabButtons[n] then
					tabOrder[#tabOrder + 1] = n
					tabButtons[n].LayoutOrder = #tabOrder
				end
			end
		end
		if #saved.tabs > 0 then applyTabs(mergeOrder(defaultTabs, saved.tabs)) end

		-- the buttons of every tab and the right button bar (UI Settings keeps its own fixed layout)
		local containers = {}
		for name, page in pairs(pages) do
			if name ~= "UI Settings" then containers[#containers + 1] = {id = name, frame = page} end
		end
		containers[#containers + 1] = {id = "__right", frame = RightButtonsContainer}
		for _, c in ipairs(containers) do
			local list = itemsOf(c.frame)
			local keys = makeKeys(list)
			c.byKey = {}
			for i, inst in ipairs(list) do
				keyOf[inst] = keys[i]
				c.byKey[keys[i]] = inst
			end
			c.defaultKeys = keys
			local sv = saved.lists[c.id]
			if type(sv) == "table" and #sv > 0 then
				local ordered = {}
				for i, k in ipairs(mergeOrder(keys, sv)) do ordered[i] = c.byKey[k] end
				assign(ordered)
			end
			local h = c.frame:FindFirstChild("PageHeader")
			if h then h.LayoutOrder = HEADER_ORDER end
		end
		do
			local h = pages["UI Settings"] and pages["UI Settings"]:FindFirstChild("PageHeader")
			if h then h.LayoutOrder = HEADER_ORDER end
		end

		local saveTok = 0
		local function saveLayout()
			saveTok += 1
			local my = saveTok
			task.delay(0.6, function()
				if my ~= saveTok then return end
				local data = {tabs = {}, lists = {}}
				for i, n in ipairs(tabOrder) do data.tabs[i] = n end
				for _, c in ipairs(containers) do
					local keys = {}
					for i, inst in ipairs(itemsOf(c.frame)) do
						keys[i] = keyOf[inst] or ("new|" .. inst.ClassName .. "|" .. inst.Name .. "|" .. labelOf(inst))
					end
					data.lists[c.id] = keys
				end
				pcall(Storage.set, "layout", data)
			end)
		end

		-- ---------- reorder bar (inside the window, bottom) ----------
		local BAR_H = math.max(28, math.floor(30 * scale))
		local bar = Instance.new("Frame")
		bar.Name = "ApexReorderBar"
		bar.AnchorPoint = Vector2.new(0, 1)
		bar.Position = UDim2.new(0, pad, 1, -pad)
		bar.Size = UDim2.new(1, -pad * 2, 0, BAR_H)
		bar.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
		bar.BorderSizePixel = 0
		bar.Visible = false
		bar.ZIndex = 80
		Instance.new("UICorner", bar).CornerRadius = UDim.new(0, math.floor(8 * scale))
		local barStroke = Instance.new("UIStroke", bar)
		barStroke.Thickness = 1.5
		bar.Parent = MainFrame

		local function barBtn(text, width, rightOffset)
			local b = Instance.new("TextButton")
			b.AnchorPoint = Vector2.new(1, 0.5)
			b.Position = UDim2.new(1, -rightOffset, 0.5, 0)
			b.Size = UDim2.new(0, width, 1, -6)
			b.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
			b.BorderSizePixel = 0
			b.AutoButtonColor = false
			b.Text = text
			b.TextColor3 = Color3.fromRGB(255, 255, 255)
			b.TextSize = math.max(11, math.floor(13 * scale))
			b.Font = Enum.Font.GothamBold
			b.ZIndex = 81
			b:SetAttribute("NoTranslate", true)
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, math.floor(6 * scale))
			b.Parent = bar
			return b
		end
		local arrowW = math.max(30, math.floor(30 * scale))
		local doneW = math.max(44, math.floor(44 * scale))
		local doneBtn = barBtn("Done", doneW, 4)
		local downBtn = barBtn(utf8.char(0x25BC), arrowW, 4 + doneW + 4)
		local upBtn = barBtn(utf8.char(0x25B2), arrowW, 4 + doneW + 4 + arrowW + 4)
		local barLabel = Instance.new("TextLabel")
		barLabel.BackgroundTransparency = 1
		barLabel.Position = UDim2.new(0, math.floor(8 * scale), 0, 0)
		barLabel.Size = UDim2.new(1, -(doneW + arrowW * 2 + 20 + math.floor(8 * scale)), 1, 0)
		barLabel.TextColor3 = Color3.fromRGB(225, 225, 225)
		barLabel.TextSize = math.max(9, math.floor(10 * scale))
		barLabel.Font = Enum.Font.GothamMedium
		barLabel.TextXAlignment = Enum.TextXAlignment.Left
		barLabel.TextTruncate = Enum.TextTruncate.AtEnd
		barLabel.ZIndex = 81
		barLabel:SetAttribute("NoTranslate", true)
		barLabel.Parent = bar

		local tabStroke = Instance.new("UIStroke")
		tabStroke.Thickness = 2
		tabStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border -- default (Contextual) would outline the letters and make them look bigger

		local function refreshMarks()
			local t = themes[currentThemeName]
			barStroke.Color = t.TopGrad2
			tabStroke.Color = t.TopGrad2
			for inst, sh in pairs(shields) do
				local sel = target and target.kind == "item" and target.item == inst
				sh.BackgroundTransparency = sel and 0.25 or 0.65
				local st = sh:FindFirstChildOfClass("UIStroke")
				if st then
					st.Color = sel and t.TopGrad2 or t.Stroke
					st.Thickness = sel and 2.5 or 1
				end
			end
			if target and target.kind == "tab" and tabButtons[target.name] then
				tabStroke.Parent = tabButtons[target.name]
			else
				tabStroke.Parent = nil
			end
			if not target then
				barLabel.Text = "Tap a tab or a button, then use the arrows"
			elseif target.kind == "tab" then
				barLabel.Text = "Tab: " .. target.name
			else
				barLabel.Text = "Move: " .. labelOf(target.item)
			end
		end

		local function setTarget(t)
			target = t
			refreshMarks()
		end

		local function addShield(inst)
			if shields[inst] then return end
			local sh = Instance.new("TextButton")
			sh.Name = "ApexReorderShield"
			sh.Text = ""
			sh.AutoButtonColor = false
			sh.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			sh.BackgroundTransparency = 0.65
			sh.BorderSizePixel = 0
			sh.Size = UDim2.new(1, 0, 1, 0)
			sh.ZIndex = 30
			sh:SetAttribute("NoTranslate", true)
			Instance.new("UICorner", sh).CornerRadius = UDim.new(0, math.floor(6 * scale))
			local st = Instance.new("UIStroke", sh)
			st.Thickness = 1
			st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			sh.Activated:Connect(function() setTarget({kind = "item", item = inst}) end)
			sh.Parent = inst
			shields[inst] = sh
		end

		local reorderBtn
		local function syncBar() bar.Visible = on and ContentFrame.Visible end
		ContentFrame:GetPropertyChangedSignal("Visible"):Connect(syncBar)

		local function setMode(state)
			on = state and true or false
			if reorderBtn then reorderBtn.Text = on and "Reorder Layout: ON" or "Reorder Layout: OFF" end
			if on then
				for _, c in ipairs(containers) do
					for _, inst in ipairs(itemsOf(c.frame)) do addShield(inst) end
					if c.id ~= "__right" then
						local pp = c.frame:FindFirstChildOfClass("UIPadding")
						if pp then
							c.origBottom = c.origBottom or pp.PaddingBottom
							pp.PaddingBottom = UDim.new(0, BAR_H + pad * 2) -- the last item can be scrolled above the bar
						end
					end
				end
			else
				for inst, sh in pairs(shields) do
					sh:Destroy()
					shields[inst] = nil
				end
				for _, c in ipairs(containers) do
					local pp = c.frame:FindFirstChildOfClass("UIPadding")
					if pp and c.origBottom then pp.PaddingBottom = c.origBottom end
				end
				target = nil
			end
			refreshMarks()
			syncBar()
		end

		local function keepInView(inst, frame)
			task.spawn(function()
				RunService.Heartbeat:Wait()
				RunService.Heartbeat:Wait()
				if not (inst.Parent and frame.Parent) then return end
				local k = frame:IsDescendantOf(MainFrame) and MainScale.Scale or 1
				local rel = inst.AbsolutePosition.Y - frame.AbsolutePosition.Y
				local h = inst.AbsoluteSize.Y
				local view = frame.AbsoluteSize.Y
				if frame ~= RightButtonsContainer then view -= (BAR_H + pad * 2) * k end
				if rel < 0 or rel + h > view then
					local y = frame.CanvasPosition.Y + (rel - (view - h) / 2) / k
					frame.CanvasPosition = Vector2.new(0, math.max(0, y))
				end
			end)
		end

		local function moveTarget(dir)
			if not target then return end
			if target.kind == "tab" then
				local i = table.find(tabOrder, target.name)
				if not i then return end
				local j = i + dir
				while tabOrder[j] and not tabButtons[tabOrder[j]].Visible do j += dir end
				if not tabOrder[j] then return end
				table.remove(tabOrder, i)
				table.insert(tabOrder, j, target.name)
				for k, n in ipairs(tabOrder) do tabButtons[n].LayoutOrder = k end
				saveLayout()
				return
			end
			local inst = target.item
			local frame = inst.Parent
			if not frame then return end
			local list = itemsOf(frame)
			local i = table.find(list, inst)
			if not i then return end
			local j = i + dir
			while list[j] and not list[j].Visible do j += dir end -- hidden neighbours do not count
			if not list[j] then return end
			table.remove(list, i)
			table.insert(list, j, inst)
			assign(list)
			saveLayout()
			keepInView(inst, frame)
		end

		local function resetLayout()
			for _, c in ipairs(containers) do
				local ordered = {}
				for _, k in ipairs(c.defaultKeys) do
					local inst = c.byKey[k]
					if inst and inst.Parent then ordered[#ordered + 1] = inst end
				end
				assign(ordered)
			end
			applyTabs(defaultTabs)
			pcall(Storage.delete, "layout")
			refreshMarks()
		end

		bindClick(upBtn, function() moveTarget(-1) end)
		bindClick(downBtn, function() moveTarget(1) end)
		bindClick(doneBtn, function() setMode(false) end)
		for name, btn in pairs(tabButtons) do
			btn.Activated:Connect(function()
				if on then setTarget({kind = "tab", name = name}) end
			end)
		end

		-- the two buttons at the top of the UI Settings tab
		local prevPage = currentPage
		usePage("UI Settings")
		reorderBtn = createButton("Reorder Layout: OFF", function() setMode(not on) end, false)
		local resetBtn = createButton("Reset Layout (tabs + buttons)", resetLayout, false)
		reorderBtn:SetAttribute("NoReorder", true)
		resetBtn:SetAttribute("NoReorder", true)
		reorderBtn.LayoutOrder = -60000
		resetBtn.LayoutOrder = -59999
		currentPage = prevPage
	end)()

	-- Window intro animation
	task.delay(introDelay or 0, function()
		if MainFrame.Parent then
			TweenService:Create(MainScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
		end
	end)

	Players.PlayerRemoving:Connect(cleanupPlayer)
	print("APEX MM2 " .. SCRIPT_VERSION .. " successfully loaded!")
end
