-- ==========================================
-- WELCOME SCREEN (full screen, shown after the device selector)
-- Fades in, reveals the avatar and the greeting (about 5 seconds), then offers Let's Go. "Skip this time" and
-- "Always skip" are available throughout; "Always skip" is remembered (Storage key welcome_skip) and can be
-- switched back on under Settings > Show Welcome Screen.
-- ==========================================
function showWelcomeScreen(scale, onReady)
	local ACCENT = Color3.fromRGB(0, 205, 195)
	local avatarSize = math.floor(132 * scale)
	local textSize = math.max(16, math.floor(30 * scale))
	local textH = textSize + 8
	local gapA = math.floor(30 * scale)
	local gapB = math.floor(36 * scale)
	local barW, barH = math.floor(120 * scale), 2
	local btnW, btnH = math.floor(156 * scale), math.max(32, math.floor(38 * scale))
	local totalH = textH + gapA + avatarSize + gapB + btnH
	local topY = -math.floor(totalH / 2)
	local textY = topY
	local avatarCY = topY + textH + gapA + math.floor(avatarSize / 2)
	local barY = topY + textH + gapA + avatarSize + gapB + math.floor((btnH - barH) / 2)
	local btnY = topY + textH + gapA + avatarSize + gapB
	local FILL = 3.8 -- progress line duration; with the reveal in front the whole intro takes about 5 seconds

	local closing = false

	local function tween(inst, t, props, style, dir)
		local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
		tw:Play()
		return tw
	end
	-- wait that ends early when the screen is being closed (returns false then)
	local function sleep(t)
		local untilT = os.clock() + t
		while os.clock() < untilT do
			if closing then return false end
			task.wait(0.03)
		end
		return not closing
	end

	local root = Instance.new("Frame")
	root.Name = "WelcomeScreen"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = Color3.fromRGB(9, 10, 11)
	root.BackgroundTransparency = 1
	root.BorderSizePixel = 0
	root.ClipsDescendants = true
	root.Active = true -- swallows clicks so nothing underneath can be pressed
	root.ZIndex = 1000
	root.Parent = ScreenGui

	-- soft glow behind the avatar (two big, very faint circles)
	local function makeCircle(size)
		local c = Instance.new("Frame", root)
		c.AnchorPoint = Vector2.new(0.5, 0.5)
		c.Position = UDim2.new(0.5, 0, 0.5, avatarCY)
		c.Size = UDim2.fromOffset(size, size)
		c.BackgroundColor3 = ACCENT
		c.BackgroundTransparency = 1
		c.BorderSizePixel = 0
		Instance.new("UICorner", c).CornerRadius = UDim.new(1, 0)
		return c
	end
	local glowA = makeCircle(math.floor(avatarSize * 3.4))
	local glowB = makeCircle(math.floor(avatarSize * 2.2))

	-- expanding rings
	local function makeRing()
		local r = Instance.new("Frame", root)
		r.AnchorPoint = Vector2.new(0.5, 0.5)
		r.Position = UDim2.new(0.5, 0, 0.5, avatarCY)
		r.Size = UDim2.fromOffset(avatarSize, avatarSize)
		r.BackgroundTransparency = 1
		r.BorderSizePixel = 0
		Instance.new("UICorner", r).CornerRadius = UDim.new(1, 0)
		local st = Instance.new("UIStroke", r)
		st.Color = ACCENT
		st.Thickness = 1.5
		st.Transparency = 1
		return r, st
	end
	local ring1, ring1Stroke = makeRing()
	local ring2, ring2Stroke = makeRing()

	-- avatar
	local avatar = Instance.new("ImageLabel", root)
	avatar.Name = "Avatar"
	avatar.AnchorPoint = Vector2.new(0.5, 0.5)
	avatar.Position = UDim2.new(0.5, 0, 0.5, avatarCY)
	avatar.Size = UDim2.fromOffset(avatarSize, avatarSize)
	avatar.BackgroundColor3 = Color3.fromRGB(22, 24, 26)
	avatar.BackgroundTransparency = 1
	avatar.BorderSizePixel = 0
	avatar.Image = ""
	avatar.ImageTransparency = 1
	avatar.ScaleType = Enum.ScaleType.Crop
	Instance.new("UICorner", avatar).CornerRadius = UDim.new(1, 0)
	local avatarStroke = Instance.new("UIStroke", avatar)
	avatarStroke.Color = ACCENT
	avatarStroke.Thickness = 2
	avatarStroke.Transparency = 1
	local avatarScale = Instance.new("UIScale", avatar)
	avatarScale.Scale = 0.55

	-- fallback letter if the thumbnail cannot be loaded
	local initial = Instance.new("TextLabel", avatar)
	initial.Size = UDim2.fromScale(1, 1)
	initial.BackgroundTransparency = 1
	initial.Text = string.upper(string.sub(LocalPlayer.DisplayName, 1, 1))
	initial.TextColor3 = Color3.fromRGB(235, 235, 235)
	initial.TextSize = math.floor(avatarSize * 0.42)
	initial.Font = Enum.Font.GothamBold
	initial.TextTransparency = 1
	initial.Visible = false

	-- greeting
	local safeName = LocalPlayer.DisplayName:gsub("&", "&"):gsub("<", "<"):gsub(">", ">")
	local greeting = Instance.new("TextLabel", root)
	greeting.Name = "Greeting"
	greeting.AnchorPoint = Vector2.new(0.5, 0)
	greeting.Position = UDim2.new(0.5, 0, 0.5, textY + 16)
	greeting.Size = UDim2.new(0.9, 0, 0, textH)
	greeting.BackgroundTransparency = 1
	greeting.RichText = true
	greeting.Text = 'Welcome back, <font color="rgb(255,255,255)">' .. safeName .. '</font>'
	greeting.TextColor3 = Color3.fromRGB(150, 156, 160)
	greeting.TextSize = textSize
	greeting.Font = Enum.Font.GothamBold
	greeting.TextTruncate = Enum.TextTruncate.AtEnd
	greeting.TextTransparency = 1

	-- thin progress line
	local track = Instance.new("Frame", root)
	track.AnchorPoint = Vector2.new(0.5, 0)
	track.Position = UDim2.new(0.5, 0, 0.5, barY)
	track.Size = UDim2.fromOffset(barW, barH)
	track.BackgroundColor3 = Color3.fromRGB(38, 40, 42)
	track.BackgroundTransparency = 1
	track.BorderSizePixel = 0
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
	local fill = Instance.new("Frame", track)
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = ACCENT
	fill.BackgroundTransparency = 1
	fill.BorderSizePixel = 0
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	-- "Let's Go" button (takes the place of the progress line when it is full)
	local startBtn = Instance.new("TextButton", root)
	startBtn.Name = "LetsGo"
	startBtn.AnchorPoint = Vector2.new(0.5, 0)
	startBtn.Position = UDim2.new(0.5, 0, 0.5, btnY + 14)
	startBtn.Size = UDim2.fromOffset(btnW, btnH)
	startBtn.BackgroundColor3 = ACCENT
	startBtn.BackgroundTransparency = 1
	startBtn.BorderSizePixel = 0
	startBtn.AutoButtonColor = false
	startBtn.Active = false
	startBtn.Text = "Let's Go"
	startBtn.TextColor3 = Color3.fromRGB(8, 12, 12)
	startBtn.TextTransparency = 1
	startBtn.TextSize = math.max(12, math.floor(14 * scale))
	startBtn.Font = Enum.Font.GothamBold
	Instance.new("UICorner", startBtn).CornerRadius = UDim.new(1, 0)
	local startScale = Instance.new("UIScale", startBtn)
	startScale.Scale = 0.9

	-- button feel: it eases up on hover, presses in while held, and never fights the entrance animation
	local startReady = false
	local startHover, startPressed = false, false
	local START_HOVER_COLOR = ACCENT:Lerp(Color3.fromRGB(255, 255, 255), 0.2)
	local function refreshStartBtn()
		if not startReady or closing then return end
		local target = startPressed and 0.95 or (startHover and 1.05 or 1)
		tween(startScale, startPressed and 0.08 or 0.2, {Scale = target}, Enum.EasingStyle.Quad)
		tween(startBtn, 0.2, {BackgroundColor3 = (startHover or startPressed) and START_HOVER_COLOR or ACCENT}, Enum.EasingStyle.Quad)
	end
	startBtn.MouseEnter:Connect(function()
		startHover = true
		refreshStartBtn()
	end)
	startBtn.MouseLeave:Connect(function()
		startHover = false
		startPressed = false
		refreshStartBtn()
	end)
	startBtn.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			startPressed = true
			refreshStartBtn()
		end
	end)
	startBtn.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			startPressed = false
			refreshStartBtn()
		end
	end)

	-- quiet skip options at the bottom
	local skipRow = Instance.new("Frame", root)
	skipRow.AnchorPoint = Vector2.new(0.5, 1)
	skipRow.Position = UDim2.new(0.5, 0, 1, -math.floor(52 * scale))
	skipRow.Size = UDim2.new(0.9, 0, 0, math.max(24, math.floor(28 * scale)))
	skipRow.BackgroundTransparency = 1
	local rowLayout = Instance.new("UIListLayout", skipRow)
	rowLayout.FillDirection = Enum.FillDirection.Horizontal
	rowLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	rowLayout.VerticalAlignment = Enum.VerticalAlignment.Center
	rowLayout.Padding = UDim.new(0, math.floor(10 * scale))

	local ghostButtons = {}
	local function makeGhost(text, width, order)
		local b = Instance.new("TextButton", skipRow)
		b.Size = UDim2.fromOffset(math.floor(width * scale), math.max(24, math.floor(28 * scale)))
		b.LayoutOrder = order
		b.BackgroundTransparency = 1
		b.BorderSizePixel = 0
		b.AutoButtonColor = false
		b.Active = false
		b.Text = text
		b.TextColor3 = Color3.fromRGB(128, 134, 138)
		b.TextTransparency = 1
		b.TextSize = math.max(10, math.floor(12 * scale))
		b.Font = Enum.Font.GothamMedium
		Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
		local st = Instance.new("UIStroke", b)
		st.Color = Color3.fromRGB(52, 56, 59)
		st.Thickness = 1
		st.Transparency = 1
		b.MouseEnter:Connect(function() tween(b, 0.15, {TextColor3 = Color3.fromRGB(225, 228, 230)}, Enum.EasingStyle.Sine) end)
		b.MouseLeave:Connect(function() tween(b, 0.15, {TextColor3 = Color3.fromRGB(128, 134, 138)}, Enum.EasingStyle.Sine) end)
		table.insert(ghostButtons, {button = b, stroke = st})
		return b
	end
	local skipBtn = makeGhost("Skip this time", 104, 1)
	local alwaysBtn = makeGhost("Always skip", 92, 2)

	-- small brand line at the bottom
	local brand = Instance.new("TextLabel", root)
	brand.AnchorPoint = Vector2.new(0.5, 1)
	brand.Position = UDim2.new(0.5, 0, 1, -math.floor(22 * scale))
	brand.Size = UDim2.new(0.9, 0, 0, math.max(12, math.floor(14 * scale)))
	brand.BackgroundTransparency = 1
	brand.Text = "APEX MM2 " .. utf8.char(183) .. " " .. SCRIPT_VERSION
	brand.TextColor3 = Color3.fromRGB(92, 98, 102)
	brand.TextSize = math.max(9, math.floor(11 * scale))
	brand.Font = Enum.Font.GothamMedium
	brand.TextTransparency = 1

	-- layering: the background has ZIndex 1000, so everything on it must be above that. Under "Global" z-index
	-- behavior a child with a lower ZIndex than its parent is drawn BEHIND it (you would see only the black screen)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiObject") then d.ZIndex = 1001 end
	end

	-- ring loop (runs until the screen is destroyed)
	local function pulse(ring, stroke, delay)
		task.spawn(function()
			task.wait(delay)
			while root.Parent do
				ring.Size = UDim2.fromOffset(avatarSize, avatarSize)
				stroke.Transparency = 0.55
				tween(ring, 2.2, {Size = UDim2.fromOffset(math.floor(avatarSize * 2.1), math.floor(avatarSize * 2.1))}, Enum.EasingStyle.Quad)
				tween(stroke, 2.2, {Transparency = 1}, Enum.EasingStyle.Quad)
				task.wait(2.2)
			end
		end)
	end

	-- fade out the background and everything on it
	local function fadeOutAll(t)
		local info = TweenInfo.new(t, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)
		local function go(inst, props) pcall(function() TweenService:Create(inst, info, props):Play() end) end
		go(root, {BackgroundTransparency = 1})
		for _, d in ipairs(root:GetDescendants()) do
			if d:IsA("TextButton") or d:IsA("TextLabel") then
				go(d, {TextTransparency = 1, BackgroundTransparency = 1})
			elseif d:IsA("ImageLabel") then
				go(d, {ImageTransparency = 1, BackgroundTransparency = 1})
			elseif d:IsA("Frame") then
				go(d, {BackgroundTransparency = 1})
			elseif d:IsA("UIStroke") then
				go(d, {Transparency = 1})
			end
		end
	end

	-- fail-safe: if the animated intro ever errors, show the final state right away so the buttons are usable
	local function revealAll()
		if closing then return end
		pcall(function()
			root.BackgroundTransparency = 0
			avatarScale.Scale = 1
			avatar.ImageTransparency = 0
			avatar.BackgroundTransparency = 0
			avatarStroke.Transparency = 0.15
			if avatar.Image == "" then
				initial.Visible = true
				initial.TextTransparency = 0
			end
			greeting.TextTransparency = 0
			greeting.Position = UDim2.new(0.5, 0, 0.5, textY)
			brand.TextTransparency = 0
			for _, g in ipairs(ghostButtons) do
				g.button.Active = true
				g.button.TextTransparency = 0
				g.stroke.Transparency = 0
			end
			startBtn.Active = true
			startBtn.BackgroundTransparency = 0
			startBtn.TextTransparency = 0
			startBtn.Position = UDim2.new(0.5, 0, 0.5, btnY)
			startScale.Scale = 1
			startReady = true
			track.BackgroundTransparency = 1
			fill.BackgroundTransparency = 1
		end)
	end

	-- close the screen: build the hub while it still covers everything, then fade out to reveal it
	local function finish(always)
		if closing then return end
		closing = true
		if always then
			Storage.welcomeSkip = true
			Storage.set("welcome_skip", true)
		end
		task.spawn(function()
			local ok, err = pcall(onReady)
			if not ok then warn("APEX: failed to load the hub: " .. tostring(err)) end
			task.wait(0.05)
			fadeOutAll(0.6)
			task.wait(0.65)
			if root.Parent then root:Destroy() end
		end)
		-- safety net: whatever happens above, the screen is gone after 4 seconds
		task.delay(4, function()
			if root.Parent then root:Destroy() end
		end)
	end
	bindClick(startBtn, function()
		if closing then return end
		startReady = false -- no more hover / press tweens from here on
		tween(startScale, 0.15, {Scale = 0.97}, Enum.EasingStyle.Quad)
		finish(false)
	end)
	bindClick(skipBtn, function() finish(false) end)
	bindClick(alwaysBtn, function() finish(true) end)

	local function runIntro()
		-- load the profile picture while the background fades in
		local thumb, thumbDone = nil, false
		task.spawn(function()
			local ok, content = pcall(function()
				return Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			end)
			if ok and content and content ~= "" then thumb = content end
			thumbDone = true
		end)

		tween(root, 0.35, {BackgroundTransparency = 0}, Enum.EasingStyle.Sine)
		if not sleep(0.35) then return end
		local waited = 0
		while not thumbDone and waited < 1.5 do
			task.wait(0.05)
			waited += 0.05
		end
		if closing then return end
		if thumb then
			avatar.Image = thumb
		else
			initial.Visible = true
			tween(initial, 0.6, {TextTransparency = 0})
		end

		-- reveal
		tween(glowA, 1.2, {BackgroundTransparency = 0.97}, Enum.EasingStyle.Sine)
		tween(glowB, 1.2, {BackgroundTransparency = 0.94}, Enum.EasingStyle.Sine)
		tween(avatarScale, 0.8, {Scale = 1}, Enum.EasingStyle.Back)
		tween(avatar, 0.5, {ImageTransparency = 0, BackgroundTransparency = 0}, Enum.EasingStyle.Sine)
		tween(avatarStroke, 0.5, {Transparency = 0.15}, Enum.EasingStyle.Sine)
		pulse(ring1, ring1Stroke, 0.5)
		pulse(ring2, ring2Stroke, 1.6)

		if not sleep(0.15) then return end
		tween(greeting, 0.8, {TextTransparency = 0, Position = UDim2.new(0.5, 0, 0.5, textY)})
		if not sleep(0.25) then return end
		tween(track, 0.5, {BackgroundTransparency = 0}, Enum.EasingStyle.Sine)
		tween(fill, 0.5, {BackgroundTransparency = 0}, Enum.EasingStyle.Sine)
		tween(brand, 0.8, {TextTransparency = 0}, Enum.EasingStyle.Sine)
		tween(fill, FILL, {Size = UDim2.fromScale(1, 1)}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

		-- skip options fade in shortly after the reveal and stay available the whole time
		if not sleep(0.6) then return end
		for _, g in ipairs(ghostButtons) do
			g.button.Active = true
			tween(g.button, 0.6, {TextTransparency = 0}, Enum.EasingStyle.Sine)
			tween(g.stroke, 0.6, {Transparency = 0}, Enum.EasingStyle.Sine)
		end

		if not sleep(FILL - 0.6) then return end
		-- progress is full: swap the line for the Let's Go button and wait for the player
		tween(track, 0.4, {BackgroundTransparency = 1}, Enum.EasingStyle.Sine)
		tween(fill, 0.4, {BackgroundTransparency = 1}, Enum.EasingStyle.Sine)
		if not sleep(0.2) then return end
		startBtn.Active = true
		startReady = true
		-- clean entrance: it fades in, rises into place and grows from 90% to full size in one smooth motion
		tween(startBtn, 0.7, {BackgroundTransparency = 0, TextTransparency = 0, Position = UDim2.new(0.5, 0, 0.5, btnY)}, Enum.EasingStyle.Quint)
		tween(startScale, 0.7, {Scale = 1}, Enum.EasingStyle.Quint)
	end

	task.spawn(function()
		local ok, err = pcall(runIntro)
		if not ok then
			warn("APEX: welcome intro error: " .. tostring(err))
			revealAll()
		end
	end)

	-- you can never get stuck here: if nothing was pressed after 12 seconds the hub opens on its own
	task.delay(12, function()
		if root.Parent and not closing then
			revealAll()
			finish(false)
		end
	end)
end

-- the device is remembered (Storage key "device"); after a reconnect it is chosen again by itself
local function chooseDevice(name, scaleValue, fromReconnect)
	if not DeviceSelectorGui.Parent then return end
	Storage.device = {name = name, scale = scaleValue}
	pcall(Storage.set, "device", Storage.device)
	DeviceSelectorGui:Destroy()
	Storage.welcomeSkip = Storage.get("welcome_skip") == true
	if fromReconnect or Storage.welcomeSkip then
		loadMainHub(scaleValue) -- "Always skip" was chosen before, or the script just reconnected
	else
		showWelcomeScreen(scaleValue, function() loadMainHub(scaleValue, 0.3) end)
	end
end

local function createSelectorButton(name, scaleValue)
	local btn = Instance.new("TextButton", DeviceSelectorGui)
	btn.Size = UDim2.new(0, 260, 0, 32)
	btn.BackgroundColor3 = themes.Black.ButtonOff
	btn.BorderSizePixel = 0
	btn.Text = name
	btn.TextColor3 = Color3.fromRGB(220, 220, 220)
	btn.TextSize = 12
	btn.Font = Enum.Font.GothamBold
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)

	bindClick(btn, function() chooseDevice(name, scaleValue, false) end)
end

createSelectorButton("Tablet", 0.85)
createSelectorButton("Phone", 0.7)
createSelectorButton("PC/Laptop", 1.0)

-- after a reconnect (Auto Reconnect started the script again) the device of the last session is picked without asking,
-- and the welcome screen is skipped
task.spawn(function()
	local info
	pcall(function()
		local g = getgenv and getgenv()
		if g and type(g.APEX_RECONNECT_INFO) == "table" then info = g.APEX_RECONNECT_INFO end
	end)
	if type(info) ~= "table" then info = Storage.get("reconnect") end
	if type(info) ~= "table" or type(info.t) ~= "number" or os.time() - info.t > 300 then return end
	local dev = type(info.device) == "table" and info.device or Storage.get("device")
	if type(dev) ~= "table" or type(dev.name) ~= "string" or not tonumber(dev.scale) then return end
	task.wait(0.3)
	chooseDevice(dev.name, tonumber(dev.scale), true)
end)

function loadMainHub(scale, introDelay) -- introDelay: wait before the window pop-in (used while the welcome screen fades out)
	local baseW = math.floor(300 * scale)
	local baseH = math.floor(410 * scale)
	local rightW = math.floor(140 * scale)
	local textSize = math.floor(12 * scale)
	local topBarH = math.max(30, math.floor(36 * scale))
	local sidebarW = math.floor(88 * scale)
	local profileH = math.floor(80 * scale)
	local pad = math.floor(6 * scale)

	-- Window limits (resize handle) and safe-zone margin (dragging)
	local minW, minH = math.floor(270 * scale), math.floor(300 * scale)
	local maxW, maxH = math.floor(620 * scale), math.floor(640 * scale)
	local EDGE = 4

	-- Elements that follow the active theme (key = theme field used as BackgroundColor3)
	local themedBg = {}
	local function themeBg(inst, key)
		themedBg[#themedBg + 1] = {inst = inst, key = key}
		return inst
	end

	local openUI, closeUI
	local ReopenStroke
	local onThemeApplied
	local uiApi -- set by the UI Settings tab (snapshot / apply)

	-- Safe zone: keeps a GUI object fully inside the screen
	local function clampPosition(size, x, y)
		local vp = ScreenGui.AbsoluteSize
		local maxX = math.max(EDGE, vp.X - size.X - EDGE)
		local maxY = math.max(EDGE, vp.Y - size.Y - EDGE)
		return math.clamp(x, EDGE, maxX), math.clamp(y, EDGE, maxY)
	end

	local function clampToScreen(target)
		local p = target.AbsolutePosition - ScreenGui.AbsolutePosition
		local x, y = clampPosition(target.AbsoluteSize, p.X, p.Y)
		target.Position = UDim2.fromOffset(x, y)
	end

	-- Drag helper (mouse + touch) with safe zone. onClick fires if the pointer did not move.
	local function attachDrag(handle, target, onClick)
		local dragging, moved = false, false
		local startMouse, startPos
		handle.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			dragging, moved = true, false
			startMouse = input.Position
			startPos = target.AbsolutePosition - ScreenGui.AbsolutePosition
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					conn:Disconnect()
					dragging = false
					if onClick and not moved then onClick() end
				end
			end)
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not dragging then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local delta = input.Position - startMouse
			if delta.Magnitude > 5 then moved = true end
			if not moved then return end
			local x, y = clampPosition(target.AbsoluteSize, startPos.X + delta.X, startPos.Y + delta.Y)
			target.Position = UDim2.fromOffset(x, y)
		end)
	end

	local vp0 = ScreenGui.AbsoluteSize
	if vp0.X < 10 or vp0.Y < 10 then vp0 = Camera.ViewportSize end

	local MainFrame = Instance.new("Frame", ScreenGui)
	MainFrame.Name = "MainFrame"
	MainFrame.Size = UDim2.new(0, baseW, 0, baseH)
	MainFrame.Position = UDim2.fromOffset(math.floor(vp0.X * 0.05), math.floor(vp0.Y * 0.1))
	MainFrame.BackgroundColor3 = themes[currentThemeName].Primary
	MainFrame.BorderSizePixel = 0
	MainFrame.Active = true
	MainFrame.ClipsDescendants = true

	local MainScale = Instance.new("UIScale", MainFrame)
	MainScale.Scale = 0.85

	local UICorner = Instance.new("UICorner", MainFrame)
	UICorner.CornerRadius = UDim.new(0, math.floor(12 * scale))
	local UIStroke = Instance.new("UIStroke", MainFrame)
	UIStroke.Color = themes[currentThemeName].Stroke
	UIStroke.Thickness = 1.5

	clampToScreen(MainFrame)
	ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		if MainFrame.Visible then clampToScreen(MainFrame) end
	end)

	-- ==========================================
	-- APEX BUTTON (shown while the UI is closed, NOT draggable)
	-- ==========================================
	-- A scale-based square (relative to the screen height, about 62 px on a 1080 px tall screen) kept inside
	-- a 48-64 px range, so it stays easy to hit and looks the same on every device.
	local ReopenIcon = Instance.new("ImageButton", ScreenGui)
	ReopenIcon.Name = "ApexButton"
	ReopenIcon.SizeConstraint = Enum.SizeConstraint.RelativeYY
	ReopenIcon.Size = UDim2.fromScale(0.058, 0.058)
	ReopenIcon.Position = UDim2.new(0, 116, 0, 6)
	ReopenIcon.BackgroundColor3 = themes[currentThemeName].Primary
	ReopenIcon.BackgroundTransparency = 0
	ReopenIcon.AutoButtonColor = false
	ReopenIcon.BorderSizePixel = 0
	ReopenIcon.Visible = false
	ReopenIcon.ZIndex = 100
	local apexLimit = Instance.new("UISizeConstraint", ReopenIcon)
	apexLimit.MinSize = Vector2.new(48, 48)
	apexLimit.MaxSize = Vector2.new(64, 64)
	Instance.new("UICorner", ReopenIcon).CornerRadius = UDim.new(1, 0)
	ReopenStroke = Instance.new("UIStroke", ReopenIcon)
	ReopenStroke.Color = themes[currentThemeName].Stroke
	ReopenStroke.Thickness = 1
	ReopenStroke.Transparency = 0
	themeBg(ReopenIcon, "Primary")

	if SCRIPT_ICON ~= "" then
		local apexImage = Instance.new("ImageLabel", ReopenIcon)
		apexImage.AnchorPoint = Vector2.new(0.5, 0.5)
		apexImage.Position = UDim2.new(0.5, 0, 0.5, 0)
		apexImage.Size = UDim2.new(1, 0, 1, 0) -- the logo fills the whole button
		apexImage.BackgroundTransparency = 1
		apexImage.ImageTransparency = 0
		apexImage.Image = SCRIPT_ICON
		apexImage.ScaleType = Enum.ScaleType.Crop
		apexImage.ZIndex = 101
		Instance.new("UICorner", apexImage).CornerRadius = UDim.new(1, 0)
	else
		local glyph = Instance.new("TextLabel", ReopenIcon)
		glyph.Size = UDim2.new(1, 0, 1, 0)
		glyph.BackgroundTransparency = 1
		glyph.Text = "A"
		glyph.TextColor3 = Color3.fromRGB(255, 255, 255)
		glyph.TextScaled = true
		glyph.Font = Enum.Font.GothamBlack
		glyph.ZIndex = 101
	end

	-- draggable (stays inside the screen); a click without moving opens the UI
	attachDrag(ReopenIcon, ReopenIcon, function()
		if openUI then openUI() end
	end)

	-- Buttons are not animated by themselves. The switch knobs slide smoothly (setToggleState and the crosshair window).
	local function attachButtonFx(btn)
	end

	-- ==========================================
	-- TOP BAR (top left: round script icon, title and Discord link)
	-- ==========================================
	local TopBar = Instance.new("Frame", MainFrame)
	TopBar.Name = "TopBar"
	TopBar.Size = UDim2.new(1, 0, 0, topBarH)
	TopBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	TopBar.BorderSizePixel = 0
	Instance.new("UICorner", TopBar).CornerRadius = UDim.new(0, math.floor(12 * scale))

	local UIGradient = Instance.new("UIGradient", TopBar)
	UIGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, themes[currentThemeName].TopGrad1),
		ColorSequenceKeypoint.new(1, themes[currentThemeName].TopGrad2)
	})
	TweenService:Create(UIGradient, TweenInfo.new(4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {Rotation = 25}):Play()

	local iconSize = topBarH - math.floor(10 * scale)
	local iconX = math.floor(8 * scale)

	local IconHolder = Instance.new("Frame", TopBar)
	IconHolder.Name = "ScriptIcon"
	IconHolder.Size = UDim2.new(0, iconSize, 0, iconSize)
	IconHolder.Position = UDim2.new(0, iconX, 0.5, -math.floor(iconSize / 2))
	IconHolder.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	IconHolder.BackgroundTransparency = 0.8
	IconHolder.BorderSizePixel = 0
	IconHolder.ClipsDescendants = true
	Instance.new("UICorner", IconHolder).CornerRadius = UDim.new(1, 0)
	local IconStroke = Instance.new("UIStroke", IconHolder)
	IconStroke.Color = Color3.fromRGB(255, 255, 255)
	IconStroke.Transparency = 0.5
	IconStroke.Thickness = 1.5

	if SCRIPT_ICON ~= "" then
		local IconImage = Instance.new("ImageLabel", IconHolder)
		IconImage.Size = UDim2.new(1, 0, 1, 0)
		IconImage.BackgroundTransparency = 1
		IconImage.Image = SCRIPT_ICON
		IconImage.ScaleType = Enum.ScaleType.Crop
		Instance.new("UICorner", IconImage).CornerRadius = UDim.new(1, 0)
	else
		local IconGlyph = Instance.new("TextLabel", IconHolder)
		IconGlyph.Size = UDim2.new(1, 0, 1, 0)
		IconGlyph.BackgroundTransparency = 1
		IconGlyph.Text = "A"
		IconGlyph.TextColor3 = Color3.fromRGB(255, 255, 255)
		IconGlyph.TextSize = math.floor(16 * scale)
		IconGlyph.Font = Enum.Font.GothamBlack
	end

	local btnSize = math.max(22, math.floor(26 * scale))
	local titleX = iconX + iconSize + math.floor(8 * scale)
	local titleW = -(titleX + btnSize * 2 + math.floor(12 * scale))
	local titleTextSize = math.max(10, math.floor(14 * scale))
	local discordTextSize = math.max(8, math.floor(9 * scale))

