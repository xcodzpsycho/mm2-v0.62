	local RightListLayout = Instance.new("UIListLayout", RightButtonsContainer)
	RightListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	RightListLayout.Padding = UDim.new(0, math.floor(6 * scale))

	local function teleportToPlayer(target)
		pcall(function()
			if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
					LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
				end
			end
		end)
	end

	local fling = {busy = false, stop = false}
	-- Flings a player: sits on top of them with a heavy, spinning body and huge speed until they really fly away.
	-- Up to 6 attempts, every attempt with a different approach (sweep around the target / from below / orbit), each one
	-- longer than the last, and a moving target is led by the ping. Returns true when the target was flung.
	local function flingPlayer(target)
		if fling.busy then return false end
		if target and apexMemberCheck(target) then
			warn("APEX: " .. target.Name .. " runs APEX, not flinging")
			return false
		end
		fling.busy = true
		local result = false
		local oldGrav = workspace.Gravity
		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
		local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
		local originalPos = myRoot and myRoot.CFrame
		local oldProps = myRoot and myRoot.CustomPhysicalProperties
		local noCollide = {}
		pcall(function()
			if not (myRoot and myHum) then return end
			local tool = myChar:FindFirstChildOfClass("Tool")
			if tool then tool:Activate() end
			workspace.Gravity = 0
			myHum.PlatformStand = true
			-- a very heavy, grippy body: every touch moves the other player much further
			myRoot.CustomPhysicalProperties = PhysicalProperties.new(100, 0.3, 0.5, 1, 1)
			-- only the root part may hit anything: the rest of the body can not snag on the map or on the target
			for _, d in ipairs(myChar:GetDescendants()) do
				if d:IsA("BasePart") and d ~= myRoot and d.CanCollide then
					noCollide[#noCollide + 1] = d
					d.CanCollide = false
				end
			end

			-- points around the target that are hit one after the other (one per frame); the wide vertical spread
			-- covers a player that spam-jumps
			local OFFSETS = {Vector3.zero, Vector3.new(0, -2, 0), Vector3.new(0, 2.5, 0), Vector3.new(0, 5, 0),
				Vector3.new(1.3, 0, 0), Vector3.new(-1.3, 0, 0), Vector3.new(0, 0, 1.3), Vector3.new(0, 0, -1.3),
				Vector3.new(0, -4.5, 0)}
			local LEADS = {0.4, 1, 1.6, 2.4, 0.7, 1.2, 2, 3}
			local MAX_ATTEMPTS = 6

			for attempt = 1, MAX_ATTEMPTS do
				if fling.stop then break end
				local targetChar = target and target.Character
				local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
				local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
				myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if not targetRoot or not myRoot or (targetHum and targetHum.Health <= 0) then break end

				local mode = (attempt - 1) % 3 -- 0 sweep, 1 from below (launches upwards), 2 orbit (touches from every side)
				local startPos, startVel = targetRoot.Position, targetRoot.AssemblyLinearVelocity
				local t0 = os.clock()
				local flung = false
				local frame = 0
				local bv = Instance.new("BodyVelocity")
				bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
				bv.Velocity = Vector3.zero
				bv.Parent = myRoot

				local function step()
					if not (targetRoot.Parent and myRoot.Parent) then return end
					frame += 1
					for _, part in ipairs(noCollide) do -- the game turns collisions back on every frame
						if part.Parent then part.CanCollide = false end
					end
					local vel = targetRoot.AssemblyLinearVelocity
					local moving = vel.Magnitude > 3
					-- a moving player is shown late (ping + interpolation): aim at where it really is, with a
					-- different guess every frame so one of them lands
					local lead = moving and ((LocalPlayer:GetNetworkPing() + 0.1) * LEADS[(frame % #LEADS) + 1]) or 0
					local flat = Vector3.new(vel.X, math.clamp(vel.Y, -50, 50), vel.Z)
					local aim = targetRoot.Position + flat * lead
					local sign = (frame % 2 == 0) and 1 or -1
					if mode == 1 then
						myRoot.CFrame = CFrame.new(aim + Vector3.new(0, -2.5, 0)) * targetRoot.CFrame.Rotation
						myRoot.AssemblyLinearVelocity = Vector3.new(300 * sign, 999999, -300 * sign)
						myRoot.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
						return
					elseif mode == 2 then
						local a = frame * 1.3
						myRoot.CFrame = CFrame.new(aim + Vector3.new(math.cos(a) * 1.6, math.sin(a * 0.7) * 2.5, math.sin(a) * 1.6)) * targetRoot.CFrame.Rotation
					else
						local offset = (moving or frame % 2 == 0) and OFFSETS[(frame % #OFFSETS) + 1] or Vector3.zero
						myRoot.CFrame = CFrame.new(aim + offset) * targetRoot.CFrame.Rotation
					end
					-- full power and a smaller push alternate (some anti-fling scripts only cut the huge ones)
					if (frame + attempt) % 3 ~= 0 then
						myRoot.AssemblyLinearVelocity = Vector3.new(999999, 999999, 999999)
						myRoot.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
					else
						myRoot.AssemblyLinearVelocity = Vector3.new(300 * sign, 180, -300 * sign)
						myRoot.AssemblyAngularVelocity = Vector3.new(0, 400, 0)
					end
				end
				local c1 = RunService.Heartbeat:Connect(function() pcall(step) end)
				local c2 = RunService.Stepped:Connect(function() pcall(step) end)

				local limit = math.min(0.7 + 0.2 * attempt, 1.8)
				while os.clock() - t0 < limit do
					RunService.Heartbeat:Wait()
					if fling.stop or not (targetRoot.Parent and myRoot.Parent) then break end
					-- success: far from where normal movement would have put it, or flying
					local walked = startVel * (os.clock() - t0)
					if (targetRoot.Position - startPos - walked).Magnitude > 45 or targetRoot.AssemblyLinearVelocity.Magnitude > 300 then
						flung = true
						break
					end
				end
				c1:Disconnect()
				c2:Disconnect()
				bv:Destroy()
				-- safe landing: back at the old spot with no speed, for a few frames
				for _ = 1, 5 do
					local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if r then
						r.AssemblyLinearVelocity = Vector3.zero
						r.AssemblyAngularVelocity = Vector3.zero
						r.CFrame = originalPos
					end
					RunService.Heartbeat:Wait()
				end
				if flung then result = true break end
			end
		end)
		workspace.Gravity = oldGrav
		-- always restore the body and hold still for a moment (also after an error in the middle)
		for _ = 1, 8 do
			local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if r and originalPos then
				r.AssemblyLinearVelocity = Vector3.zero
				r.AssemblyAngularVelocity = Vector3.zero
				r.CFrame = originalPos
			end
			RunService.Heartbeat:Wait()
		end
		pcall(function()
			local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
			if r then r.CustomPhysicalProperties = oldProps end
			if h then h.PlatformStand = false end
			for _, part in ipairs(noCollide) do
				if part.Parent then part.CanCollide = true end
			end
		end)
		if not result and target then warn("APEX: could not fling " .. target.Name) end
		fling.busy = false
		return result
	end

	local function updateMode(modeName)
		currentMode = modeName
		local buttonsMode = (modeName == "Buttons")
		if buttonsMode then
			if not RightButtonsContainer.Visible then
				RightButtonsContainer.Position = rightPosHidden
				RightButtonsContainer.Visible = true
				TweenService:Create(RightButtonsContainer, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = rightPosShown}):Play()
			end
		else
			RightButtonsContainer.Visible = false
		end
		MainFrame.Visible = true
		for _, page in pairs(pages) do
			if page:GetAttribute("AlwaysVisible") then continue end
			for _, el in ipairs(page:GetChildren()) do
				if el:IsA("GuiObject") then
					if buttonsMode then
						el.Visible = (el.Name == "DropdownContainer" or el.Name == "FlingDropdownContainer")
					else
						el.Visible = true
					end
				end
			end
		end
		refreshTabVisibility()
	end

	local TRACK_OFF = Color3.fromRGB(70, 70, 82)

	local function applyTheme(themeName)
		local t = themes[themeName]
		if not t then return end
		currentThemeName = themeName

		local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(MainFrame, tweenInfo, {BackgroundColor3 = t.Primary}):Play()
		TweenService:Create(UIStroke, tweenInfo, {Color = t.Stroke}):Play()
		if ReopenStroke then
			TweenService:Create(ReopenStroke, tweenInfo, {Color = t.Stroke}):Play()
		end

		-- Every themed surface (sidebar, rows, dropdowns, inputs, profile, divider ...)
		for i = #themedBg, 1, -1 do
			local entry = themedBg[i]
			if entry.inst and entry.inst.Parent then
				TweenService:Create(entry.inst, tweenInfo, {BackgroundColor3 = t[entry.key]}):Play()
			else
				table.remove(themedBg, i)
			end
		end

		UIGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, t.TopGrad1),
			ColorSequenceKeypoint.new(1, t.TopGrad2)
		})

		refreshTabColors()

		-- Toggle switch tracks
		for _, data in pairs(registeredToggles) do
			for _, w in ipairs(data.buttons) do
				if w.track and w.track.Parent then
					TweenService:Create(w.track, tweenInfo, {BackgroundColor3 = data.state and t.ButtonOn or TRACK_OFF}):Play()
				end
			end
		end

		if onThemeApplied then onThemeApplied(t) end
	end

	local function registerToggle(identifier, defaultState, callback)
		if not registeredToggles[identifier] then
			registeredToggles[identifier] = {
				state = defaultState or false,
				buttons = {},
				callback = callback
			}
		end
		return registeredToggles[identifier]
	end

	local function setToggleState(identifier, newState)
		local data = registeredToggles[identifier]
		if not data then return end
		data.state = newState

		local t = themes[currentThemeName]
		local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

		for _, w in ipairs(data.buttons) do
			if w.track and w.track.Parent then
				TweenService:Create(w.track, tweenInfo, {BackgroundColor3 = data.state and t.ButtonOn or TRACK_OFF}):Play()
				TweenService:Create(w.knob, tweenInfo, {Position = data.state and w.posOn or w.posOff}):Play()
			end
		end

		if data.callback then
			task.spawn(function()
				pcall(function()
					data.callback(data.state)
				end)
			end)
		end
	end

	local function createButtonGen(parentContainer, text, callback, isToggle, defaultState, customSize, customTextSize)
		local btn = Instance.new("TextButton", parentContainer)
		btn.Size = customSize or UDim2.new(1, 0, 0, math.floor(32 * scale))
		btn.BackgroundColor3 = themes[currentThemeName].ButtonOff
		btn.BorderSizePixel = 0
		btn.AutoButtonColor = false
		btn.TextSize = customTextSize or textSize
		btn.Font = Enum.Font.GothamMedium
		themeBg(btn, "ButtonOff")
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, math.floor(6 * scale))

		if isToggle then
			-- Toggle row: label on the left, smooth switch with a sliding knob on the right
			local data = registerToggle(text, defaultState, callback)
			btn.Text = ""

			local trackH = math.max(14, math.floor(18 * scale))
			local trackW = math.floor(trackH * 1.9)
			local knobS = trackH - 4
			local t = themes[currentThemeName]

			local label = Instance.new("TextLabel", btn)
			label.Name = "ToggleLabel"
			label.BackgroundTransparency = 1
			label.Size = UDim2.new(1, -(trackW + math.floor(18 * scale)), 1, 0)
			label.Position = UDim2.new(0, math.floor(8 * scale), 0, 0)
			label.Text = text
			label.TextColor3 = Color3.fromRGB(235, 235, 235)
			label.TextSize = customTextSize or textSize
			label.Font = Enum.Font.GothamMedium
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.TextTruncate = Enum.TextTruncate.AtEnd

			local track = Instance.new("Frame", btn)
			track.Name = "SwitchTrack"
			track.Size = UDim2.fromOffset(trackW, trackH)
			track.Position = UDim2.new(1, -(trackW + math.floor(8 * scale)), 0.5, -math.floor(trackH / 2))
			track.BorderSizePixel = 0
			Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

			local knob = Instance.new("Frame", track)
			knob.Name = "SwitchKnob"
			knob.Size = UDim2.fromOffset(knobS, knobS)
			knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			knob.BorderSizePixel = 0
			Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

			local posOff = UDim2.new(0, 2, 0.5, -math.floor(knobS / 2))
			local posOn = UDim2.new(1, -(knobS + 2), 0.5, -math.floor(knobS / 2))
			track.BackgroundColor3 = data.state and t.ButtonOn or TRACK_OFF
			knob.Position = data.state and posOn or posOff

			table.insert(data.buttons, {track = track, knob = knob, posOn = posOn, posOff = posOff})

			bindClick(btn, function()
				setToggleState(text, not data.state)
			end)
		else
			btn.Text = text
			btn.TextColor3 = Color3.fromRGB(170, 170, 170)
			bindClick(btn, function()
				btn.BackgroundColor3 = themes[currentThemeName].Stroke
				task.wait(0.08)
				btn.BackgroundColor3 = themes[currentThemeName].ButtonOff
				pcall(callback)
			end)
		end
		attachButtonFx(btn)
		return btn
	end

	local function createButton(text, callback, isToggle, defaultState)
		return createButtonGen(currentPage, text, callback, isToggle, defaultState)
	end

	local function createRightButton(text, callback, isToggle, defaultState)
		return createButtonGen(RightButtonsContainer, text, callback, isToggle, defaultState, UDim2.new(1, 0, 0, math.floor(30 * scale)), math.floor(11 * scale))
	end

	local function createDropdown(name, options, callback)
		local container = Instance.new("Frame", currentPage)
		container.Name = "DropdownContainer"
		container.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
		container.BackgroundColor3 = themes[currentThemeName].ButtonOff
		themeBg(container, "ButtonOff")
		container.BorderSizePixel = 0
		container.ClipsDescendants = true
		Instance.new("UICorner", container).CornerRadius = UDim.new(0, math.floor(6 * scale))

		local selectBtn = Instance.new("TextButton", container)
		selectBtn.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
		selectBtn.BackgroundTransparency = 1
		selectBtn.Text = " " .. name .. ": " .. tostring(options[1])
		selectBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
		selectBtn.TextSize = textSize
		selectBtn.Font = Enum.Font.GothamMedium
		selectBtn.TextXAlignment = Enum.TextXAlignment.Left

		local arrow = Instance.new("TextLabel", container)
		arrow.Size = UDim2.new(0, math.floor(25 * scale), 0, math.floor(32 * scale))
		arrow.Position = UDim2.new(1, -math.floor(25 * scale), 0, 0)
		arrow.BackgroundTransparency = 1
		arrow.Text = "▼"
		arrow.TextColor3 = Color3.fromRGB(180, 180, 180)
		arrow.TextSize = math.floor(11 * scale)

		local listContainer = Instance.new("ScrollingFrame", container)
		listContainer.Size = UDim2.new(1, -4, 0, math.floor(120 * scale))
		listContainer.Position = UDim2.new(0, 2, 0, math.floor(34 * scale))
		listContainer.BackgroundTransparency = 1
		listContainer.BorderSizePixel = 0
		listContainer.CanvasSize = UDim2.new(0, 0, 0, #options * math.floor(32 * scale))
		listContainer.ScrollBarThickness = 2
		listContainer.Visible = false

		local listLayout = Instance.new("UIListLayout", listContainer)
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 2)

		for _, optName in ipairs(options) do
			local optBtn = Instance.new("TextButton", listContainer)
			optBtn.Size = UDim2.new(1, 0, 0, math.floor(30 * scale))
			optBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
			optBtn.BorderSizePixel = 0
			optBtn.Text = tostring(optName)
			optBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
			optBtn.TextSize = math.floor(11 * scale)
			optBtn.Font = Enum.Font.Gotham
			Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 5)

			bindClick(optBtn, function()
				pcall(function() callback(optName) end)
				selectBtn.Text = " " .. name .. ": " .. tostring(optName)
				container.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
				listContainer.Visible = false
				arrow.Text = "▼"
			end)
		end

		local isOpen = false
		bindClick(selectBtn, function()
			isOpen = not isOpen
			local targetSize = isOpen and UDim2.new(1, 0, 0, math.floor(160 * scale)) or UDim2.new(1, 0, 0, math.floor(32 * scale))
			TweenService:Create(container, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize}):Play()
			listContainer.Visible = isOpen
			arrow.Text = isOpen and "▲" or "▼"
		end)
		return container, selectBtn
	end

	local function createPlayerDropdown(parentContainer)
		local container = Instance.new("Frame", parentContainer)
		container.Name = "DropdownContainer"
		container.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
		container.BackgroundColor3 = themes[currentThemeName].ButtonOff
		themeBg(container, "ButtonOff")
		container.BorderSizePixel = 0
		container.ClipsDescendants = true
		Instance.new("UICorner", container).CornerRadius = UDim.new(0, math.floor(6 * scale))

		local selectBtn = Instance.new("TextButton", container)
		selectBtn.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
		selectBtn.BackgroundTransparency = 1
		selectBtn.Text = " TP to Player: [Choose]"
		selectBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
		selectBtn.TextSize = math.floor(11 * scale)
		selectBtn.Font = Enum.Font.GothamMedium
		selectBtn.TextXAlignment = Enum.TextXAlignment.Left

		local arrow = Instance.new("TextLabel", container)
		arrow.Size = UDim2.new(0, math.floor(25 * scale), 0, math.floor(32 * scale))
		arrow.Position = UDim2.new(1, -math.floor(25 * scale), 0, 0)
		arrow.BackgroundTransparency = 1
		arrow.Text = "▼"
		arrow.TextColor3 = Color3.fromRGB(180, 180, 180)
		arrow.TextSize = math.floor(11 * scale)

		local listContainer = Instance.new("ScrollingFrame", container)
		listContainer.Size = UDim2.new(1, -4, 0, math.floor(120 * scale))
		listContainer.Position = UDim2.new(0, 2, 0, math.floor(34 * scale))
		listContainer.BackgroundTransparency = 1
		listContainer.BorderSizePixel = 0
		listContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
		listContainer.ScrollBarThickness = 2
		listContainer.Visible = false

		local listLayout = Instance.new("UIListLayout", listContainer)
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 3)

		local function refreshPlayers()
			for _, child in ipairs(listContainer:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			local count = 0
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					count = count + 1
					local pBtn = Instance.new("TextButton", listContainer)
					pBtn.Size = UDim2.new(1, 0, 0, math.floor(28 * scale))
					pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
					pBtn.BorderSizePixel = 0
					pBtn.Text = p.Name
					pBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
					pBtn.TextSize = math.floor(11 * scale)
					pBtn.Font = Enum.Font.Gotham
					Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)

					bindClick(pBtn, function()
						teleportToPlayer(p)
						selectBtn.Text = " TP: " .. p.Name
						container.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
						listContainer.Visible = false
						arrow.Text = "▼"
					end)
				end
			end
			listContainer.CanvasSize = UDim2.new(0, 0, 0, count * math.floor(31 * scale))
		end

		local isOpen = false
		bindClick(selectBtn, function()
			isOpen = not isOpen
			if isOpen then refreshPlayers() end
			local targetSize = isOpen and UDim2.new(1, 0, 0, math.floor(155 * scale)) or UDim2.new(1, 0, 0, math.floor(32 * scale))
			TweenService:Create(container, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize}):Play()
			listContainer.Visible = isOpen
			arrow.Text = isOpen and "▲" or "▼"
		end)
	end

	local function createFlingDropdown(parentContainer)
		local container = Instance.new("Frame", parentContainer)
		container.Name = "FlingDropdownContainer"
		container.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
		container.BackgroundColor3 = themes[currentThemeName].ButtonOff
		themeBg(container, "ButtonOff")
		container.BorderSizePixel = 0
		container.ClipsDescendants = true
		Instance.new("UICorner", container).CornerRadius = UDim.new(0, math.floor(6 * scale))

		local selectBtn = Instance.new("TextButton", container)
		selectBtn.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
		selectBtn.BackgroundTransparency = 1
		selectBtn.Text = " Fling: [Choose]"
		selectBtn.TextColor3 = Color3.fromRGB(200, 200, 200)
		selectBtn.TextSize = math.floor(11 * scale)
		selectBtn.Font = Enum.Font.GothamMedium
		selectBtn.TextXAlignment = Enum.TextXAlignment.Left

		local arrow = Instance.new("TextLabel", container)
		arrow.Size = UDim2.new(0, math.floor(25 * scale), 0, math.floor(32 * scale))
		arrow.Position = UDim2.new(1, -math.floor(25 * scale), 0, 0)
		arrow.BackgroundTransparency = 1
		arrow.Text = "▼"
		arrow.TextColor3 = Color3.fromRGB(180, 180, 180)
		arrow.TextSize = math.floor(11 * scale)

		local listContainer = Instance.new("ScrollingFrame", container)
		listContainer.Size = UDim2.new(1, -4, 0, math.floor(120 * scale))
		listContainer.Position = UDim2.new(0, 2, 0, math.floor(34 * scale))
		listContainer.BackgroundTransparency = 1
		listContainer.BorderSizePixel = 0
		listContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
		listContainer.ScrollBarThickness = 2
		listContainer.Visible = false

		local listLayout = Instance.new("UIListLayout", listContainer)
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 3)

		local function refreshPlayers()
			for _, child in ipairs(listContainer:GetChildren()) do
				if child:IsA("TextButton") then child:Destroy() end
			end
			local count = 0
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					count = count + 1
					local pBtn = Instance.new("TextButton", listContainer)
					pBtn.Size = UDim2.new(1, 0, 0, math.floor(28 * scale))
					pBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
					pBtn.BorderSizePixel = 0
					pBtn.Text = p.Name
					pBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
					pBtn.TextSize = math.floor(11 * scale)
					pBtn.Font = Enum.Font.Gotham
					Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)

					bindClick(pBtn, function()
						selectBtn.Text = " Hit: " .. p.Name
						container.Size = UDim2.new(1, 0, 0, math.floor(32 * scale))
						listContainer.Visible = false
						arrow.Text = "▼"
						flingPlayer(p)
						task.wait(1)
						selectBtn.Text = " Fling: [Choose]"
					end)
				end
			end
			listContainer.CanvasSize = UDim2.new(0, 0, 0, count * math.floor(31 * scale))
		end

		local isOpen = false
		bindClick(selectBtn, function()
			isOpen = not isOpen
			if isOpen then refreshPlayers() end
			local targetSize = isOpen and UDim2.new(1, 0, 0, math.floor(155 * scale)) or UDim2.new(1, 0, 0, math.floor(32 * scale))
			TweenService:Create(container, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = targetSize}):Play()
			listContainer.Visible = isOpen
			arrow.Text = isOpen and "▲" or "▼"
		end)
	end

	-- Slider (replaces the old textboxes). Instances with the same label stay in sync
	-- (normal window + right button bar).
	local function createSpeedInputGen(parentContainer, labelText, defaultVal, min, max, callback, customSize, customTextSize)
		local rowH = math.floor(40 * scale)
		local ts = customTextSize or textSize

		local container = Instance.new("Frame", parentContainer)
		container.Name = "SliderRow"
		container.Size = UDim2.new(1, 0, 0, rowH)
		container.BackgroundColor3 = themes[currentThemeName].ButtonOff
		container.BorderSizePixel = 0
		themeBg(container, "ButtonOff")
		Instance.new("UICorner", container).CornerRadius = UDim.new(0, math.floor(6 * scale))

		local label = Instance.new("TextLabel", container)
		label.Size = UDim2.new(0.65, 0, 0, math.floor(18 * scale))
		label.Position = UDim2.new(0, math.floor(8 * scale), 0, math.floor(4 * scale))
		label.BackgroundTransparency = 1
		label.Text = (labelText:gsub(":%s*$", ""))
		label.TextColor3 = Color3.fromRGB(200, 200, 200)
		label.TextSize = ts
		label.Font = Enum.Font.GothamMedium
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.TextTruncate = Enum.TextTruncate.AtEnd

		local valueLabel = Instance.new("TextLabel", container)
		valueLabel.Size = UDim2.new(0.35, -math.floor(8 * scale), 0, math.floor(18 * scale))
		valueLabel.Position = UDim2.new(0.65, 0, 0, math.floor(4 * scale))
		valueLabel.BackgroundTransparency = 1
		valueLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
		valueLabel.TextSize = ts
		valueLabel.Font = Enum.Font.GothamBold
		valueLabel.TextXAlignment = Enum.TextXAlignment.Right

		local trackH = math.max(4, math.floor(6 * scale))
		local track = Instance.new("Frame", container)
		track.Name = "SliderTrack"
		track.Size = UDim2.new(1, -math.floor(16 * scale), 0, trackH)
		track.Position = UDim2.new(0, math.floor(8 * scale), 1, -math.floor(12 * scale))
		track.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
		track.BorderSizePixel = 0
		Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

		local fill = Instance.new("Frame", track)
		fill.Name = "SliderFill"
		fill.Size = UDim2.new(0, 0, 1, 0)
		fill.BackgroundColor3 = themes[currentThemeName].ButtonOn
		fill.BorderSizePixel = 0
		themeBg(fill, "ButtonOn")
		Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

		local knobS = math.max(10, math.floor(13 * scale))
		local knob = Instance.new("Frame", track)
		knob.Name = "SliderKnob"
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Size = UDim2.fromOffset(knobS, knobS)
		knob.Position = UDim2.new(0, 0, 0.5, 0)
		knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		knob.BorderSizePixel = 0
		Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

		local box
		local value = math.clamp(tonumber(defaultVal) or min, min, max)
		local function display(v)
			value = v
			sliderValues[labelText] = v
			local alpha = (max == min) and 0 or (v - min) / (max - min)
			fill.Size = UDim2.new(alpha, 0, 1, 0)
			knob.Position = UDim2.new(alpha, 0, 0.5, 0)
			valueLabel.Text = tostring(v)
			if box then box.Text = tostring(v) end
		end
		display(value)

		if not registeredSpeedInputs[labelText] then registeredSpeedInputs[labelText] = {} end
		table.insert(registeredSpeedInputs[labelText], display)

		local function userSet(v)
			v = math.clamp(math.floor(v + 0.5), min, max)
			if v == value then return end
			for _, setter in ipairs(registeredSpeedInputs[labelText]) do setter(v) end
			pcall(function() callback(v) end)
		end
		sliderApi[labelText] = userSet

		-- Large touch area over the lower part of the row
		local hitTop = math.floor(rowH * 0.4)
		local hit = Instance.new("TextButton", container)
		hit.Name = "SliderHit"
		hit.Size = UDim2.new(1, 0, 0, rowH - hitTop)
		hit.Position = UDim2.new(0, 0, 0, hitTop)
		hit.BackgroundTransparency = 1
		hit.AutoButtonColor = false
		hit.Text = ""

		attachSafeSlider(hit, track, function() return value end, userSet, min, max)

		box = makeNumberBox(container, ts, scale, nil, function() return value end, userSet)
		NumericInput.register(function()
			local tb = (NumericInput.mode == "Textboxes")
			track.Visible, hit.Visible, valueLabel.Visible = not tb, not tb, not tb
			box.Visible = tb
			box.Text = tostring(value)
			label.Position = tb and UDim2.new(0, math.floor(8 * scale), 0.5, -math.floor(9 * scale)) or UDim2.new(0, math.floor(8 * scale), 0, math.floor(4 * scale))
		end)
	end

	local function createSpeedInput(labelText, defaultVal, min, max, callback)
		createSpeedInputGen(currentPage, labelText, defaultVal, min, max, callback)
	end

	local function createRightSpeedInput(labelText, defaultVal, min, max, callback)
		createSpeedInputGen(RightButtonsContainer, labelText, defaultVal, min, max, callback, UDim2.new(1, 0, 0, math.floor(30 * scale)), math.floor(10 * scale))
	end

	-- ==========================================
	-- WINDOW CONTROLS: minimize, close/reopen, resize handle
	-- ==========================================
	local minimized = false
	local Fx = {} -- background effects and decorations (filled in below)

	-- Resize handle (bottom right) with minimum / maximum limits
	local ResizeHandle = Instance.new("TextButton", MainFrame)
	ResizeHandle.Name = "ResizeHandle"
	local handleSize = math.max(18, math.floor(20 * scale))
	ResizeHandle.Size = UDim2.fromOffset(handleSize, handleSize)
	ResizeHandle.AnchorPoint = Vector2.new(1, 1)
	ResizeHandle.Position = UDim2.new(1, -2, 1, -2)
	ResizeHandle.BackgroundTransparency = 1
	ResizeHandle.AutoButtonColor = false
	ResizeHandle.Text = ""
	ResizeHandle.ZIndex = 60
	for i, len in ipairs({0.72, 0.4}) do
		local grip = Instance.new("Frame", ResizeHandle)
		grip.Name = "Grip" .. i
		grip.AnchorPoint = Vector2.new(0.5, 0.5)
		grip.Size = UDim2.fromOffset(math.floor(handleSize * len), 2)
		grip.Position = UDim2.new(0.5 + i * 0.12, 0, 0.5 + i * 0.12, 0)
		grip.Rotation = -45
		grip.BackgroundColor3 = Color3.fromRGB(190, 190, 190)
		grip.BackgroundTransparency = 0.4
		grip.BorderSizePixel = 0
		grip.ZIndex = 60
	end

	do
		local resizing = false
		local startMouse, startW, startH
		ResizeHandle.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
			resizing = true
			startMouse = input.Position
			startW, startH = baseW, baseH
			local conn
			conn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					conn:Disconnect()
					resizing = false
				end
			end)
		end)
		UserInputService.InputChanged:Connect(function(input)
			if not resizing then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
			local k = MainScale.Scale
			local d = input.Position - startMouse
			local pos = MainFrame.AbsolutePosition - ScreenGui.AbsolutePosition
			local vp = ScreenGui.AbsoluteSize
			local limW = math.min(maxW, math.floor((vp.X - pos.X - EDGE) / k))
			local limH = math.min(maxH, math.floor((vp.Y - pos.Y - EDGE) / k))
			baseW = math.clamp(math.floor(startW + d.X / k), minW, math.max(minW, limW))
			baseH = math.clamp(math.floor(startH + d.Y / k), minH, math.max(minH, limH))
			MainFrame.Size = UDim2.new(0, baseW, 0, baseH)
		end)
	end

	-- Minimize collapses the window to its title bar. Everything that could linger on the
	-- collapsed bar (content, sidebar, resize handle, particle overlay, decorations) is hidden,
	-- and a token makes rapid clicks safe (no half-finished restore after a second click).
	local minimizeToken = 0
	bindClick(MinimizeBtn, function()
		minimized = not minimized
		minimizeToken += 1
		local token = minimizeToken
		local tweenInfo = TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		if minimized then
			ContentFrame.Visible = false
			Sidebar.Visible = false
			ResizeHandle.Visible = false
			Fx.setHidden(true)
			-- the dark window background is faded out so only the themed title bar remains
			TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, baseW, 0, topBarH), BackgroundTransparency = 1}):Play()
			MinimizeBtn.Text = "+"
		else
			MinimizeBtn.Text = "-"
			TweenService:Create(MainFrame, tweenInfo, {Size = UDim2.new(0, baseW, 0, baseH), BackgroundTransparency = 0}):Play()
			task.delay(0.12, function()
				if token ~= minimizeToken or minimized then return end
				ContentFrame.Visible = true
				Sidebar.Visible = true
				ResizeHandle.Visible = true
				Fx.setHidden(false)
			end)
		end
		task.delay(0.3, function()
			if token == minimizeToken then clampToScreen(MainFrame) end
		end)
	end)

	-- Close hides the whole UI; the (non-draggable) Apex button brings it back
	openUI = function()
		if MainFrame.Visible then return end
		ReopenIcon.Visible = false
		MainFrame.Visible = true
		if currentMode == "Buttons" then RightButtonsContainer.Visible = true end
		clampToScreen(MainFrame)
	end
	closeUI = function()
		if not MainFrame.Visible then return end
		MainFrame.Visible = false
		RightButtonsContainer.Visible = false
		ReopenIcon.Visible = true
	end
	bindClick(CloseBtn, closeUI)

	-- ==========================================
	-- BACKGROUND EFFECTS (falling particle overlay) + HALLOWEEN DECORATIONS
	-- ==========================================
	do
		local layer = Instance.new("Frame", MainFrame)
		layer.Name = "EffectLayer"
		layer.Position = UDim2.new(0, 2, 0, 2) -- a margin inside the window border: nothing can touch or cross the outline
		layer.Size = UDim2.new(1, -4, 1, -4)
		layer.BackgroundTransparency = 1
		layer.BorderSizePixel = 0
		layer.ClipsDescendants = true
		layer.ZIndex = 50
		Instance.new("UICorner", layer).CornerRadius = UDim.new(0, math.max(4, math.floor(10 * scale)))

		local effect = "None"
		local particles = {}
		local counts = {Rain = 38, Matrix = 26, Snow = 34, Pumpkins = 12}
		local MATRIX_CHARS = "0123456789ABCDEFGHJKLMNPRSTXYZ"

		local function rnd(a, b) return a + math.random() * (b - a) end
		local function randomChar()
			local i = math.random(1, #MATRIX_CHARS)
			return MATRIX_CHARS:sub(i, i)
		end
		local function layerSize()
			local s = layer.AbsoluteSize
			local k = MainScale.Scale
			return s.X / k, s.Y / k
		end

		local function spawnParticle(kind, scatter)
			local w, h = layerSize()
			if w < 2 then w, h = baseW, baseH end
			local p = {kind = kind, amp = 0, freq = 0, phase = math.random() * 6.28}
			local inst
			if kind == "Rain" then
				inst = Instance.new("Frame")
				local len = math.floor(rnd(10, 18) * scale)
				inst.Size = UDim2.fromOffset(math.max(1, math.floor(1.5 * scale)), len)
				inst.BackgroundColor3 = Color3.fromRGB(170, 205, 255)
				inst.BackgroundTransparency = rnd(0.4, 0.65)
				inst.BorderSizePixel = 0
				p.speed, p.h = rnd(380, 560), len
			elseif kind == "Matrix" then
				inst = Instance.new("TextLabel")
				local ts = math.max(8, math.floor(rnd(11, 15) * scale))
				inst.Size = UDim2.fromOffset(10, ts)
				inst.BackgroundTransparency = 1
				inst.Font = Enum.Font.Code
				inst.Text = randomChar()
				inst.TextSize = ts
				inst.TextColor3 = Color3.fromRGB(0, 255, 110)
				inst.TextTransparency = rnd(0.25, 0.65)
				p.speed, p.h = rnd(110, 200), ts
			elseif kind == "Snow" then
				inst = Instance.new("Frame")
				local s = math.max(3, math.floor(rnd(3, 6) * math.max(scale, 0.8)))
				inst.Size = UDim2.fromOffset(s, s)
				inst.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				inst.BackgroundTransparency = rnd(0.15, 0.45)
				inst.BorderSizePixel = 0
				Instance.new("UICorner", inst).CornerRadius = UDim.new(1, 0)
				p.speed, p.h = rnd(40, 90), s
				p.amp, p.freq = rnd(6, 16), rnd(0.8, 1.8)
			else -- Pumpkins
				inst = Instance.new("TextLabel")
				local ts = math.max(12, math.floor(rnd(14, 20) * scale))
				inst.Size = UDim2.fromOffset(ts + 4, ts + 4)
				inst.BackgroundTransparency = 1
				inst.Text = utf8.char(0x1F383)
				inst.TextSize = ts
				inst.TextTransparency = 0.1
				p.speed, p.h = rnd(50, 100), ts
				p.amp, p.freq = rnd(8, 18), rnd(0.6, 1.2)
			end
			p.x = math.random() * w
			p.y = scatter and math.random() * h or -p.h - math.random() * h * 0.3
			inst.Position = UDim2.fromOffset(p.x, p.y)
			inst.Parent = layer
			p.inst = inst
			particles[#particles + 1] = p
		end

		local function clearParticles()
			for _, p in ipairs(particles) do p.inst:Destroy() end
			table.clear(particles)
		end

		-- ---------- AMBIENT EFFECTS: Aurora, Silk, Nebula, Stars, Fireflies, Embers, Bubbles ----------
		-- Every one of them is built from soft, very transparent frames inside a CanvasGroup, takes its colours from the
		-- active theme (so they follow every palette) and fades in / out smoothly when it is switched or the theme changes.
		local function tcol() return themes[currentThemeName] end
		local function mixc(a, b, x) return a:Lerp(b, x) end
		local function newFrame(parent, props)
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			for k, v in pairs(props) do f[k] = v end
			f.Parent = parent
			return f
		end
		local function round(f) Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0) end
		local function kp(t, v) return NumberSequenceKeypoint.new(t, v) end

		local ambientBuilders = {}

		ambientBuilders.Aurora = function(g)
			-- Light curtains hanging from the top edge. Every strip fades out towards the bottom (no hard lower edge) and the
			-- strips overlap heavily, so the sides blend into each other. Nothing is rotated and everything stays inside the window.
			local t = tcol()
			local cols = {
				mixc(Color3.fromRGB(70, 255, 160), t.TopGrad1, 0.35),
				mixc(Color3.fromRGB(60, 210, 255), t.TopGrad2, 0.35),
				mixc(Color3.fromRGB(170, 110, 255), t.Stroke, 0.35),
			}
			local N = 20
			local strips = {}
			for i = 1, N do
				local pos = (i - 1) / (N - 1) * (#cols - 1)
				local idx = math.floor(pos)
				local col = cols[idx + 1]:Lerp(cols[math.min(idx + 2, #cols)], pos - idx)
				local f = newFrame(g, {
					AnchorPoint = Vector2.new(0.5, 0), BackgroundColor3 = col,
					Size = UDim2.new(0.22, 0, 0.55, 0), Position = UDim2.new((i - 0.5) / N, 0, 0, 0),
				})
				local gr = Instance.new("UIGradient")
				gr.Rotation = 90
				gr.Transparency = NumberSequence.new({kp(0, 0.975), kp(0.18, 0.95), kp(0.55, 0.982), kp(1, 1)})
				gr.Parent = f
				strips[i] = {f = f, ph = math.random() * 6.28, sp = rnd(0.35, 0.9)}
			end
			return function(now)
				for i, s in ipairs(strips) do
					local a = math.sin(now * s.sp + s.ph)
					local b = math.sin(now * 0.21 + i * 0.45)
					s.f.Size = UDim2.new(0.22, 0, 0.55 + 0.2 * b, 0)
					s.f.Position = UDim2.new((i - 0.5) / N + 0.012 * a, 0, 0, 0)
				end
			end
		end

		ambientBuilders.Silk = function(g)
			-- Soft diagonal sheens. Each sheet fills the window and only a gradient stripe inside it is visible, which is moved
			-- sideways over time, so there are no rotated frames that could stick out of the window.
			local t = tcol()
			local defs = {
				{rot = 24, w = 0.2, a = 0.9, sp = 0.17, amp = 0.5},
				{rot = 24, w = 0.1, a = 0.93, sp = 0.23, amp = 0.45},
				{rot = -28, w = 0.17, a = 0.91, sp = 0.13, amp = 0.5},
				{rot = -28, w = 0.06, a = 0.86, sp = 0.2, amp = 0.4},
			}
			local sheets = {}
			for i, d in ipairs(defs) do
				local f = newFrame(g, {Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(1, 1, 1)})
				local gr = Instance.new("UIGradient")
				gr.Rotation = d.rot
				local c0 = mixc(mixc(t.TopGrad1, t.TopGrad2, (i - 1) / (#defs - 1)), Color3.new(1, 1, 1), 0.2)
				local c1 = mixc(mixc(t.TopGrad2, t.TopGrad1, (i - 1) / (#defs - 1)), Color3.new(1, 1, 1), 0.2)
				gr.Color = ColorSequence.new(c0, c1)
				gr.Transparency = NumberSequence.new({kp(0, 1), kp(0.5 - d.w, 1), kp(0.5, d.a), kp(0.5 + d.w, 1), kp(1, 1)})
				gr.Parent = f
				sheets[i] = {gr = gr, rot = d.rot, amp = d.amp, ph = math.random() * 6.28, sp = d.sp}
			end
			return function(now)
				for _, s in ipairs(sheets) do
					s.gr.Offset = Vector2.new(s.amp * math.sin(now * s.sp + s.ph), 0)
					s.gr.Rotation = s.rot + 5 * math.sin(now * s.sp * 0.7 + s.ph * 1.7)
				end
			end
		end

		ambientBuilders.Nebula = function(g)
			-- Soft colour clouds (stacked, very transparent ellipses sized in window fractions) plus faint twinkling dust.
			-- The clouds only drift a little around their spot and the layer clips whatever reaches the edge.
			local t = tcol()
			local cols = {t.TopGrad1, t.TopGrad2, t.Stroke, mixc(t.TopGrad1, t.TopGrad2, 0.5)}
			local bases = {{0.3, 0.3, 0.5, 0.4}, {0.7, 0.28, 0.45, 0.38}, {0.32, 0.72, 0.5, 0.4}, {0.72, 0.7, 0.42, 0.36}} -- {x, y, width, height}: x - width / 2 and x + width / 2 stay inside 0..1
			local blobs = {}
			for i, d in ipairs(bases) do
				local parts = {}
				for k = 1, 8 do
					local fct = 1 - (k - 1) * 0.11
					local c = newFrame(g, {
						AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromScale(d[3] * fct, d[4] * fct),
						Position = UDim2.fromScale(d[1], d[2]), BackgroundColor3 = cols[i], BackgroundTransparency = 0.975,
					})
					round(c)
					parts[k] = c
				end
				blobs[i] = {parts = parts, bx = d[1], by = d[2], sp = rnd(0.08, 0.16), ph = math.random() * 6.28}
			end
			local dust = {}
			for i = 1, 26 do
				local sz = math.max(1, math.floor(rnd(1, 2.6) * scale))
				local f = newFrame(g, {
					Size = UDim2.fromOffset(sz, sz), Position = UDim2.fromScale(math.random() * 0.97, math.random() * 0.97),
					BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.5,
				})
				round(f)
				dust[i] = {f = f, sp = rnd(0.5, 1.8), ph = math.random() * 6.28}
			end
			return function(now)
				for _, b in ipairs(blobs) do
					local cx = b.bx + 0.03 * math.sin(now * b.sp + b.ph)
					local cy = b.by + 0.025 * math.cos(now * b.sp * 0.8 + b.ph)
					for k, c in ipairs(b.parts) do
						c.Position = UDim2.fromScale(cx + 0.003 * k * math.sin(now * 0.3 + k), cy + 0.003 * k * math.cos(now * 0.27 + k))
					end
				end
				for _, d in ipairs(dust) do
					d.f.BackgroundTransparency = 0.25 + 0.65 * (0.5 + 0.5 * math.sin(now * d.sp + d.ph))
				end
			end
		end

		ambientBuilders.Stars = function(g, w, h)
			local t = tcol()
			local tint = mixc(Color3.new(1, 1, 1), t.TopGrad2, 0.45)
			local stars = {}
			for i = 1, 46 do
				local sz = math.max(1, math.floor(rnd(1, 3) * scale))
				local f = newFrame(g, {
					Size = UDim2.fromOffset(sz, sz), Position = UDim2.fromScale(math.random(), math.random()),
					BackgroundColor3 = (i % 5 == 0) and tint or Color3.new(1, 1, 1), BackgroundTransparency = 0.4,
				})
				round(f)
				stars[i] = {f = f, x = math.random(), y = math.random(), sp = rnd(0.6, 2.2), ph = math.random() * 6.28, drift = rnd(0.002, 0.008)}
			end
			-- a shooting star every few seconds
			local streak = newFrame(g, {
				AnchorPoint = Vector2.new(1, 0.5), Size = UDim2.fromOffset(math.floor(46 * scale), 2), BackgroundColor3 = Color3.new(1, 1, 1),
				Rotation = 28, Visible = false,
			})
			local sg = Instance.new("UIGradient")
			sg.Transparency = NumberSequence.new({kp(0, 1), kp(1, 0)})
			sg.Parent = streak
			local nextAt, t0, sx, sy = os.clock() + rnd(2, 5), nil, 0, 0
			return function(now, dt, w2, h2)
				for _, s in ipairs(stars) do
					s.x -= s.drift * dt
					if s.x < -0.02 then s.x = 1.02 s.y = math.random() end
					s.f.Position = UDim2.fromScale(s.x, s.y)
					s.f.BackgroundTransparency = 0.15 + 0.7 * (0.5 + 0.5 * math.sin(now * s.sp + s.ph))
				end
				if not t0 and now > nextAt then
					t0, sx, sy = now, rnd(0.1, 0.6) * w2, rnd(0, 0.35) * h2
					streak.Visible = true
				end
				if t0 then
					local p = (now - t0) / 0.8
					if p >= 1 then
						t0, nextAt = nil, now + rnd(3, 7)
						streak.Visible = false
					else
						local dist = 170 * p
						streak.Position = UDim2.fromOffset(sx + math.cos(math.rad(28)) * dist, sy + math.sin(math.rad(28)) * dist)
						streak.BackgroundTransparency = p * p
					end
				end
			end
		end

		ambientBuilders.Fireflies = function(g)
			local t = tcol()
			local col = mixc(Color3.fromRGB(225, 255, 120), t.TopGrad2, 0.3)
			local flies = {}
			for i = 1, 16 do
				local gs = math.max(8, math.floor(13 * scale))
				local glow = newFrame(g, {
					AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(gs, gs), BackgroundColor3 = col, BackgroundTransparency = 0.88,
				})
				round(glow)
				local cs = math.max(2, math.floor(3 * scale))
				local core = newFrame(glow, {
					AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(cs, cs),
					BackgroundColor3 = mixc(col, Color3.new(1, 1, 1), 0.6), BackgroundTransparency = 0.1,
				})
				round(core)
				flies[i] = {glow = glow, core = core, bx = math.random(), by = math.random(), a1 = rnd(0.03, 0.09), a2 = rnd(0.03, 0.08),
					f1 = rnd(0.15, 0.4), f2 = rnd(0.2, 0.5), ph = math.random() * 6.28, pf = rnd(0.8, 1.8)}
			end
			return function(now)
				for _, f in ipairs(flies) do
					f.glow.Position = UDim2.fromScale(f.bx + f.a1 * math.sin(now * f.f1 + f.ph), f.by + f.a2 * math.sin(now * f.f2 + f.ph * 1.3))
					local pulse = 0.5 + 0.5 * math.sin(now * f.pf + f.ph * 2)
					f.glow.BackgroundTransparency = 0.97 - 0.13 * pulse
					f.core.BackgroundTransparency = 0.75 - 0.65 * pulse
				end
			end
		end

		ambientBuilders.Embers = function(g, w, h)
			local t = tcol()
			local cols = {
				mixc(Color3.fromRGB(255, 150, 40), t.TopGrad2, 0.25),
				mixc(Color3.fromRGB(255, 95, 40), t.TopGrad1, 0.25),
				Color3.fromRGB(255, 210, 120),
			}
			local list = {}
			for i = 1, 30 do
				local sz = math.max(2, math.floor(rnd(2, 4.5) * scale))
				local f = newFrame(g, {Size = UDim2.fromOffset(sz, sz), BackgroundColor3 = cols[(i % 3) + 1]})
				round(f)
				list[i] = {f = f, x = math.random() * w, y = math.random() * h, sp = rnd(18, 48) * scale, amp = rnd(4, 12), fr = rnd(0.8, 2), ph = math.random() * 6.28}
			end
			return function(now, dt, w2, h2)
				for _, p in ipairs(list) do
					p.y -= p.sp * dt
					if p.y < -10 then
						p.y = h2 + rnd(0, 20)
						p.x = math.random() * w2
					end
					p.f.Position = UDim2.fromOffset(p.x + math.sin(now * p.fr + p.ph) * p.amp, p.y)
					p.f.BackgroundTransparency = 1 - math.clamp(p.y / h2, 0, 1) * 0.85
				end
			end
		end

		ambientBuilders.Bubbles = function(g, w, h)
			local t = tcol()
			local col = mixc(Color3.new(1, 1, 1), t.TopGrad2, 0.4)
			local list = {}
			for i = 1, 14 do
				local sz = math.max(8, math.floor(rnd(8, 26) * scale))
				local f = newFrame(g, {Size = UDim2.fromOffset(sz, sz), BackgroundTransparency = 1})
				round(f)
				local st = Instance.new("UIStroke")
				st.Color = col
				st.Thickness = 1.2
				st.Transparency = 0.55
				st.Parent = f
				local hl = newFrame(f, {
					Position = UDim2.fromScale(0.2, 0.18), Size = UDim2.fromScale(0.2, 0.2), BackgroundColor3 = Color3.new(1, 1, 1),
					BackgroundTransparency = 0.45,
				})
				round(hl)
				list[i] = {f = f, x = math.random() * w, y = math.random() * h, sp = rnd(14, 36) * scale, amp = rnd(5, 14), fr = rnd(0.5, 1.2), ph = math.random() * 6.28, sz = sz}
			end
			return function(now, dt, w2, h2)
				for _, p in ipairs(list) do
					p.y -= p.sp * dt
					if p.y < -p.sz - 4 then
						p.y = h2 + rnd(0, 30)
						p.x = math.random() * w2
					end
					p.f.Position = UDim2.fromOffset(p.x + math.sin(now * p.fr + p.ph) * p.amp, p.y)
				end
			end
		end

		local ambient = nil -- {group, update, name}

		local function stopAmbient(fade)
			local old = ambient
			ambient = nil
			if not old then return end
			if fade then
				TweenService:Create(old.group, TweenInfo.new(0.35, Enum.EasingStyle.Sine), {GroupTransparency = 1}):Play()
				task.delay(0.45, function() if old.group.Parent then old.group:Destroy() end end)
			else
				old.group:Destroy()
			end
		end

		local function startAmbient(name)
			local g = Instance.new("CanvasGroup")
			g.Name = "AmbientFx"
			g.Size = UDim2.new(1, 0, 1, 0)
			g.BackgroundTransparency = 1
			g.BorderSizePixel = 0
			g.GroupTransparency = 1
			g.ZIndex = 50
			Instance.new("UICorner", g).CornerRadius = UDim.new(0, math.max(4, math.floor(10 * scale)))
			g.Parent = layer
			local w, h = layerSize()
			if w < 2 then w, h = baseW, baseH end
			local ok, update = pcall(ambientBuilders[name], g, w, h)
			if not ok then
				warn("APEX: effect " .. name .. " failed: " .. tostring(update))
				g:Destroy()
				return
			end
			ambient = {group = g, update = update, name = name}
			TweenService:Create(g, TweenInfo.new(0.6, Enum.EasingStyle.Sine), {GroupTransparency = 0}):Play()
		end

		function Fx.setEffect(name)
			Fx.fxToken = (Fx.fxToken or 0) + 1 -- cancels a theme refresh that is still waiting
			Fx.retries = 0
			local isAmbient = ambientBuilders[name] ~= nil
			if not counts[name] and not isAmbient then name = "None" end
			effect = name
			clearParticles()
			stopAmbient(true)
			if isAmbient then
				startAmbient(name)
			elseif name ~= "None" then
				for _ = 1, counts[name] do spawnParticle(name, true) end
			end
		end

		local fxConn
		fxConn = RunService.Heartbeat:Connect(function(dt)
			if not ScreenGui.Parent then fxConn:Disconnect() return end
			if effect == "None" or not MainFrame.Visible or not layer.Visible then return end
			if ambientBuilders[effect] and not ambient and (Fx.retries or 0) < 3 and os.clock() - (Fx.retryAt or 0) > 1.5 then
				Fx.retryAt = os.clock()
				Fx.retries = (Fx.retries or 0) + 1
				startAmbient(effect)
			end
			dt = math.min(dt, 0.1)
			local w, h = layerSize()
			if w < 2 then return end
			local now = os.clock()
			if ambient then pcall(ambient.update, now, dt, w, h) end
			for _, p in ipairs(particles) do
				p.y += p.speed * dt
				if p.y > h + 20 then
					p.y = -p.h
					p.x = math.random() * w
					if p.kind == "Matrix" then p.inst.Text = randomChar() end
				elseif p.kind == "Matrix" and math.random() < 0.015 then
					p.inst.Text = randomChar()
				end
				local x = p.x
				if p.amp > 0 then
					x += math.sin(now * p.freq + p.phase) * p.amp
					if p.kind == "Pumpkins" then p.inst.Rotation = math.sin(now * p.freq + p.phase) * 18 end
				end
				p.inst.Position = UDim2.fromOffset(x, p.y)
			end
		end)

		-- Halloween decorations: spider webs in two corners + a hanging spider
		local deco = Instance.new("Frame", MainFrame)
		deco.Name = "HalloweenDecor"
		deco.Size = UDim2.new(1, 0, 1, 0)
		deco.BackgroundTransparency = 1
		deco.BorderSizePixel = 0
		deco.Visible = false
		deco.ZIndex = 40

		local function line(parent, a, b, thickness, transparency)
			local d = b - a
			local f = Instance.new("Frame", parent)
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.BorderSizePixel = 0
			f.BackgroundColor3 = Color3.fromRGB(235, 235, 235)
			f.BackgroundTransparency = transparency
			f.Size = UDim2.fromOffset(math.max(1, d.Magnitude), thickness)
			f.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
			f.Rotation = math.deg(math.atan2(d.Y, d.X))
			f.ZIndex = 40
		end

		local angles = {0, 22.5, 45, 67.5, 90}
		local rings = {0.28, 0.5, 0.74, 1}
		local R = math.floor(64 * scale)
		local function web(anchor, sx, sy)
			local origin = Instance.new("Frame", deco)
			origin.Size = UDim2.fromOffset(0, 0)
			origin.Position = anchor
			origin.BackgroundTransparency = 1
			origin.ZIndex = 40
			local function pt(angleDeg, r)
				local a = math.rad(angleDeg)
				return Vector2.new(sx * math.cos(a) * r, sy * math.sin(a) * r)
			end
			for _, ang in ipairs(angles) do
				line(origin, Vector2.new(0, 0), pt(ang, R), 1, 0.45)
			end
			for _, rf in ipairs(rings) do
				for i = 1, #angles - 1 do
					local p1, p2 = pt(angles[i], R * rf), pt(angles[i + 1], R * rf)
					local mid = (p1 + p2) / 2 * 0.86
					line(origin, p1, mid, 1, 0.5)
					line(origin, mid, p2, 1, 0.5)
				end
			end
		end
		web(UDim2.new(1, 0, 0, topBarH), -1, 1)
		web(UDim2.new(0, 0, 1, 0), 1, -1)

		local threadLen = math.floor(40 * scale)
		local thread = Instance.new("Frame", deco)
		thread.Size = UDim2.fromOffset(1, threadLen)
		thread.Position = UDim2.new(0.62, 0, 0, topBarH)
		thread.BackgroundColor3 = Color3.fromRGB(230, 230, 230)
		thread.BackgroundTransparency = 0.35
		thread.BorderSizePixel = 0
		thread.ZIndex = 40
		local bodyS = math.max(7, math.floor(9 * scale))
		local body = Instance.new("Frame", deco)
		body.Size = UDim2.fromOffset(bodyS, bodyS)
		body.Position = UDim2.new(0.62, -math.floor(bodyS / 2), 0, topBarH + threadLen)
		body.BackgroundColor3 = Color3.fromRGB(255, 125, 20)
		body.BorderSizePixel = 0
		body.ZIndex = 40
		Instance.new("UICorner", body).CornerRadius = UDim.new(1, 0)
		local bodyStroke = Instance.new("UIStroke", body)
		bodyStroke.Color = Color3.fromRGB(0, 0, 0)
		bodyStroke.Thickness = 1.5

		local halloweenOn, fxHidden = false, false
		function Fx.setHalloween(state)
			halloweenOn = state and true or false
			deco.Visible = halloweenOn and not fxHidden
		end

		-- Used while the window is minimized so nothing lingers on the collapsed title bar
		function Fx.setHidden(hidden)
			fxHidden = hidden and true or false
			layer.Visible = not fxHidden
			deco.Visible = halloweenOn and not fxHidden
		end

		-- ---------- BACKGROUND STYLES: a soft, theme coloured tint over the whole window ----------
		-- {gradient rotation, colours, transparency}; the colours come from the active palette, so a style always matches
		local function cseq(list)
			local k = {}
			for i, e in ipairs(list) do k[i] = ColorSequenceKeypoint.new(e[1], e[2]) end
			return ColorSequence.new(k)
		end
		local function nseq(list)
			local k = {}
			for i, e in ipairs(list) do k[i] = NumberSequenceKeypoint.new(e[1], e[2]) end
			return NumberSequence.new(k)
		end
		local styleDefs = {
			["Top Glow"] = function(t) return 90, {{0, t.TopGrad1}, {1, t.TopGrad2}}, {{0, 0.78}, {0.45, 0.95}, {1, 1}} end,
			["Bottom Glow"] = function(t) return 90, {{0, t.TopGrad2}, {1, t.TopGrad1}}, {{0, 1}, {0.55, 0.95}, {1, 0.78}} end,
			["Diagonal Tint"] = function(t) return 35, {{0, t.TopGrad1}, {1, t.TopGrad2}}, {{0, 0.86}, {1, 0.92}} end,
			["Dual Tone"] = function(t) return 0, {{0, t.TopGrad1}, {1, t.TopGrad2}}, {{0, 0.88}, {1, 0.88}} end,
			["Side Glow"] = function(t) return 0, {{0, t.TopGrad1}, {1, t.TopGrad2}}, {{0, 0.8}, {0.35, 0.96}, {0.65, 0.96}, {1, 0.8}} end,
			["Center Glow"] = function(t) return 90, {{0, t.Stroke}, {1, t.Stroke}}, {{0, 1}, {0.3, 0.9}, {0.5, 0.84}, {0.7, 0.9}, {1, 1}} end,
		}

		local styleLayer = Instance.new("Frame", MainFrame)
		styleLayer.Name = "BackgroundStyle"
		styleLayer.Size = UDim2.new(1, 0, 1, 0)
		styleLayer.BackgroundColor3 = Color3.new(1, 1, 1)
		styleLayer.BackgroundTransparency = 1
		styleLayer.BorderSizePixel = 0
		styleLayer.Active = false
		styleLayer.Visible = false
		styleLayer.ZIndex = 41 -- over the decorations (40), under the effect layer (50)
		Instance.new("UICorner", styleLayer).CornerRadius = UDim.new(0, math.floor(12 * scale))
		local styleGrad = Instance.new("UIGradient", styleLayer)

		local styleName, styleHidden, styleToken = "None", false, 0
		local function applyStyleGradient()
			local def = styleDefs[styleName]
			if not def then return end
			local rot, colors, trans = def(themes[currentThemeName])
			styleGrad.Rotation = rot
			styleGrad.Offset = Vector2.new(0, 0)
			styleGrad.Color = cseq(colors)
			styleGrad.Transparency = nseq(trans)
		end

		function Fx.setStyle(name)
			if name ~= "None" and not styleDefs[name] then name = "None" end
			styleName = name
			styleToken += 1
			local token = styleToken
			if name == "None" then
				TweenService:Create(styleLayer, TweenInfo.new(0.3, Enum.EasingStyle.Sine), {BackgroundTransparency = 1}):Play()
				task.delay(0.35, function()
					if token == styleToken then styleLayer.Visible = false end
				end)
			else
				applyStyleGradient()
				styleLayer.Visible = not styleHidden
				TweenService:Create(styleLayer, TweenInfo.new(0.4, Enum.EasingStyle.Sine), {BackgroundTransparency = 0}):Play()
			end
		end

		local baseSetHidden = Fx.setHidden
		function Fx.setHidden(hidden)
			baseSetHidden(hidden)
			styleHidden = hidden and true or false
			styleLayer.Visible = (styleName ~= "None") and not styleHidden
		end

		-- the palette changed: rebuild the running effect (cross fade) and recolour the style
		function Fx.refreshTheme()
			Fx.fxToken = (Fx.fxToken or 0) + 1
			local token = Fx.fxToken
			applyStyleGradient()
			task.defer(function()
				-- when an effect was chosen in the same moment (special themes do that) it has already been built with the new colours
				if token ~= Fx.fxToken or not ambient then return end
				local n = ambient.name
				stopAmbient(true)
				startAmbient(n)
			end)
		end

		-- gentle motion for two of the styles
		local styleConn
		styleConn = RunService.Heartbeat:Connect(function()
			if not ScreenGui.Parent then styleConn:Disconnect() return end
			if not styleLayer.Visible then return end
			local now = os.clock()
			if styleName == "Diagonal Tint" then
				styleGrad.Rotation = 35 + 12 * math.sin(now * 0.25)
			elseif styleName == "Center Glow" then
				styleGrad.Offset = Vector2.new(0, 0.1 * math.sin(now * 0.4))
			end
		end)
	end

	local cleanupPlayer, noclipChanged, startFly, stopFly, placeTPRed, tpRed, placeTPGreen, tpGreen, setMovementLocked, createCollectStatus, underMapEnabled, underMapDepth, exitUnderMap, setAntiFling, doneSettings, setCoinDetails, coinUi, autoApplied, setRoleAutomation, fx, setFpsBooster, setGameVolume
	;(function() -- gameplay logic: its own function, so its locals do not use up the 200 local registers of loadMainHub
		local function getPlayerRole(player)
			local success, role, col = pcall(function()
				if not player.Character then return "Innocent", Color3.fromRGB(50, 255, 100) end
				if player ~= LocalPlayer then
					-- known from the game's role table before anybody holds a weapon (your own role stays inventory based)
					local early = RoleInfo.roleOf(player)
					if early == "Murderer" then return "Murderer", Color3.fromRGB(255, 50, 50) end
					if early == "Sheriff" then return "Sheriff", Color3.fromRGB(50, 150, 255) end
				end
				local backpack = player:FindFirstChildOfClass("Backpack")
				local character = player.Character

				local function checkTool(item)
					if item:IsA("Tool") then
						local name = item.Name:lower()
						if name:find("knife") or name:find("murder") then
							return "Murderer", Color3.fromRGB(255, 50, 50)
						elseif name:find("gun") or name:find("revolver") or name:find("sheriff") then
							return "Sheriff", Color3.fromRGB(50, 150, 255)
						end
					end
					return nil
				end

				if backpack then
					for _, item in ipairs(backpack:GetChildren()) do
						local r, c = checkTool(item)
						if r then return r, c end
					end
				end
				for _, item in ipairs(character:GetChildren()) do
					local r, c = checkTool(item)
					if r then return r, c end
				end
				return "Innocent", Color3.fromRGB(50, 255, 100)
			end)
			if success then return role, col end
			return "Innocent", Color3.fromRGB(50, 255, 100)
		end

		local highlights = {}
		local billboards = {}

		function cleanupPlayer(player)
			pcall(function()
				if highlights[player] then highlights[player]:Destroy(); highlights[player] = nil end
				if billboards[player] then billboards[player]:Destroy(); billboards[player] = nil end
			end)
		end

		local bodyGyro, bodyVelocity
		noclipChanged = setmetatable({}, {__mode = "k"}) -- parts that noclip turned non-collidable
		local keysPressed = {W = false, A = false, S = false, D = false, Space = false, LeftShift = false}

		function startFly()
			pcall(function()
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChild("Humanoid")
				if not root or not hum then return end

				hum.PlatformStand = true

				if bodyGyro then bodyGyro:Destroy() end
				if bodyVelocity then bodyVelocity:Destroy() end

				bodyGyro = Instance.new("BodyGyro")
				bodyGyro.P = 9e4
				bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
				bodyGyro.cframe = root.CFrame
				bodyGyro.Parent = root

				bodyVelocity = Instance.new("BodyVelocity")
				bodyVelocity.velocity = Vector3.new(0, 0, 0)
				bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)
				bodyVelocity.Parent = root
			end)
		end

		function stopFly()
			pcall(function()
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				local hum = char and char:FindFirstChild("Humanoid")

				if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end
				if bodyVelocity then bodyVelocity:Destroy(); bodyVelocity = nil end

				if root and hum then
					local rayParams = RaycastParams.new()
					rayParams.FilterType = Enum.RaycastFilterType.Exclude
					rayParams.FilterDescendantsInstances = {char}

					local rayResult = workspace:Raycast(root.Position, Vector3.new(0, -5, 0), rayParams)

					if rayResult then
						hum.PlatformStand = false
						hum:ChangeState(Enum.HumanoidStateType.GettingUp)
						root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
						root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					else
						hum.PlatformStand = false
						hum:ChangeState(Enum.HumanoidStateType.Freefall)
						root.AssemblyLinearVelocity = Vector3.new(0, -15, 0)
						root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
					end
				end
			end)
		end

		function placeTPRed()
			pcall(function()
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if not root then return end
				savedPositionRed = root.Position
				if tpVisualPartRed then tpVisualPartRed:Destroy() end
				tpVisualPartRed = Instance.new("Part")
				tpVisualPartRed.Shape = Enum.PartType.Cylinder
				tpVisualPartRed.Material = Enum.Material.Neon
				tpVisualPartRed.Color = Color3.fromRGB(255, 0, 0)
				tpVisualPartRed.Size = Vector3.new(0.2, 4, 4)
				tpVisualPartRed.Anchored = true
				tpVisualPartRed.CanCollide = false
				tpVisualPartRed.Transparency = 0.2
				tpVisualPartRed.CFrame = CFrame.new(savedPositionRed - Vector3.new(0, 2.9, 0)) * CFrame.Angles(0, 0, math.rad(90))
				tpVisualPartRed.Parent = workspace
			end)
		end
		function tpRed() pcall(function() local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if r and savedPositionRed then r.CFrame = CFrame.new(savedPositionRed + Vector3.new(0, .5, 0)) end end) end

		function placeTPGreen()
			pcall(function()
				local char = LocalPlayer.Character
				local root = char and char:FindFirstChild("HumanoidRootPart")
				if not root then return end
				savedPositionGreen = root.Position
				if tpVisualPartGreen then tpVisualPartGreen:Destroy() end
				tpVisualPartGreen = Instance.new("Part")
				tpVisualPartGreen.Shape = Enum.PartType.Cylinder
				tpVisualPartGreen.Material = Enum.Material.Neon
				tpVisualPartGreen.Color = Color3.fromRGB(0, 255, 0)
				tpVisualPartGreen.Size = Vector3.new(0.2, 4, 4)
				tpVisualPartGreen.Anchored = true
				tpVisualPartGreen.CanCollide = false
				tpVisualPartGreen.Transparency = 0.2
				tpVisualPartGreen.CFrame = CFrame.new(savedPositionGreen - Vector3.new(0, 2.9, 0)) * CFrame.Angles(0, 0, math.rad(90))
				tpVisualPartGreen.Parent = workspace
			end)
		end
		function tpGreen() pcall(function() local r = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") if r and savedPositionGreen then r.CFrame = CFrame.new(savedPositionGreen + Vector3.new(0, .5, 0)) end end) end

		-- Godmode / Anti-Death
		RunService.Stepped:Connect(function()
			if autoCollectCoinsEnabled then
				if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
					local humanoid = LocalPlayer.Character.Humanoid
					if humanoid.Health < humanoid.MaxHealth and humanoid.Health > 0 then
						humanoid.Health = humanoid.MaxHealth
					end
					if humanoid:GetState() == Enum.HumanoidStateType.Dead then
						humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
					end
				end
			end
		end)

		-- Helper: checks whether the player is inside the lobby (RegularLobby or Lobby).
		-- The result is cached for half a second because this is called from several loops.
		local lobbyCache = {time = 0, value = false, parts = {}, partsTime = -100}
		local function isInLobby()
			local now = os.clock()
			if now - lobbyCache.time < 0.5 then return lobbyCache.value end
			lobbyCache.time = now
			lobbyCache.value = false

			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if not root then return false end

			-- Only the real lobby counts (RegularLobby / Lobby as a direct child of workspace). Rooms that are
			-- merely called "Lobby" inside a map no longer pause Auto Collect.
			if now - lobbyCache.partsTime > 10 then
				lobbyCache.partsTime = now
				local parts = {}
				for _, name in ipairs({"RegularLobby", "Lobby"}) do
					local obj = workspace:FindFirstChild(name)
					if obj and (obj:IsA("Model") or obj:IsA("Folder")) then
						for _, d in ipairs(obj:GetDescendants()) do
							if d:IsA("BasePart") then parts[#parts + 1] = d end
						end
					end
				end
				lobbyCache.parts = parts
			end

			local pos = root.Position
			for _, part in ipairs(lobbyCache.parts) do
				if part.Parent and (pos - part.Position).Magnitude < 40 then
					lobbyCache.value = true
					return true
				end
			end
			return false
		end

		-- Helper: checks whether the player owns a weapon
		local function hasWeaponEquippedOrInInventory()
			local char = LocalPlayer.Character
			local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")

			local function scanContainer(container)
				if not container then return false end
				for _, item in ipairs(container:GetChildren()) do
					if item:IsA("Tool") then
						local name = item.Name:lower()
						if name:find("gun") or name:find("revolver") or name:find("sheriff") or name:find("knife") or name:find("murder") then
							return true
						end
					end
				end
				return false
			end

			return scanContainer(char) or scanContainer(backpack)
		end

		-- Auto Collect pauses only while a combat feature that moves your character is running
		-- (Kill All as Murderer / Kill Murderer as Sheriff). Simply holding the knife or gun no longer blocks it.
		local function combatBusy()
			if not (killAllMurderEnabled or sheriffAutoKillEnabled) then return false end
			return hasWeaponEquippedOrInInventory()
		end

		-- Coins are tracked through events, so the loop never has to scan the whole workspace
		-- (that scan is what made collecting slow and unreliable at low frame rates).
		local coinObjects = {}
		local coinPending = setmetatable({}, {__mode = "k"}) -- [coin part] = when the script reached it
		local coinCounted = setmetatable({}, {__mode = "k"}) -- coins that were already counted
		local coinGone -- counts a vanished coin for the Coin Details statistics (defined further down)
		local function considerCoin(obj)
			if obj.Name:lower():find("coin", 1, true) then
				coinObjects[obj] = true
				if obj:IsA("BasePart") then
					-- a coin that is hidden instead of removed counts when it disappears
					obj:GetPropertyChangedSignal("Transparency"):Connect(function()
						if obj.Transparency >= 1 then
							if coinGone then pcall(coinGone, obj) end
						else
							coinCounted[obj] = nil -- visible again: can be collected (and counted) again
						end
					end)
				end
			end
		end
		for _, obj in ipairs(workspace:GetDescendants()) do considerCoin(obj) end
		workspace.DescendantAdded:Connect(considerCoin)
		workspace.DescendantRemoving:Connect(function(obj)
			if coinObjects[obj] and coinGone then pcall(coinGone, obj) end
			coinObjects[obj] = nil
		end)

		local coinSkip = setmetatable({}, {__mode = "k"}) -- coins that did not react when we reached them: ignored for a while
		local function getActiveCoins()
			local coins = {}
			if combatBusy() or isInLobby() then
				return coins
			end

			for obj in pairs(coinObjects) do
				if not autoCollectCoinsEnabled then break end
				if not obj.Parent then
					coinObjects[obj] = nil
				else
					local inLobbyHierarchy = false
					local p = obj.Parent
					while p and p ~= workspace do
						if p.Parent == workspace and (p.Name == "RegularLobby" or p.Name == "Lobby") then
							inLobbyHierarchy = true
							break
						end
						p = p.Parent
					end

					if not inLobbyHierarchy then
						local part = nil
						if obj:IsA("BasePart") then
							part = obj
						elseif obj:IsA("Model") and obj.PrimaryPart then
							part = obj.PrimaryPart
						else
							part = obj:FindFirstChildWhichIsA("BasePart")
						end
						if part and part.Parent and part.Transparency < 1 then
							local skipUntil = coinSkip[part]
							if skipUntil and os.clock() < skipUntil then
								-- ignored for now
							else
								table.insert(coins, part)
							end
						end
					end
				end
			end
			return coins
		end

		-- Is a round running? Several independent signals, because your client usually cannot see the murderer's
		-- knife (it stays in his backpack until he equips it):
		-- * somebody visibly holds a knife
		-- * coins exist on the map (they only exist while a round is running)
		local roundCache = {time = 0, value = false}
		local function roundInProgress()
			local now = os.clock()
			if now - roundCache.time < 0.25 then return roundCache.value end
			roundCache.time = now
			roundCache.value = false

			for _, p in ipairs(Players:GetPlayers()) do
				if getPlayerRole(p) == "Murderer" then
					roundCache.value = true
					return true
				end
			end
			for obj in pairs(coinObjects) do
				if obj.Parent then
					local part = obj
					if not obj:IsA("BasePart") then
						part = (obj:IsA("Model") and obj.PrimaryPart) or obj:FindFirstChildWhichIsA("BasePart")
					end
					if part and part.Transparency < 1 then
						local inLobbyHierarchy = false
						local p = obj.Parent
						while p and p ~= workspace do
							if p.Parent == workspace and (p.Name == "RegularLobby" or p.Name == "Lobby") then
								inLobbyHierarchy = true
								break
							end
							p = p.Parent
						end
						if not inLobbyHierarchy then
							roundCache.value = true
							return true
						end
					end
				end
			end
			return false
		end

		-- also used by the role automation (a round counts as running when coins exist, not only when a knife is visible)
		local function isRoundActive()
			return roundInProgress()
		end

		-- Animation lock used by Auto Collect Coins: while it collects, your character plays no walk / run / jump /
		-- fall animations. The two default idle tracks are left alone because they carry the APEX MEMBER tag signature.
		local animLockConn = nil
		local ANIM_LOCK_KEEP = {["507766388"] = true, ["507766666"] = true, ["507770677"] = true}
		local function setAnimationsLocked(lock)
			if animLockConn then animLockConn:Disconnect() animLockConn = nil end
			pcall(function()
				local animate = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Animate")
				if animate and animate:IsA("LocalScript") then animate.Disabled = lock end
			end)
			if not lock then return end
			animLockConn = RunService.Heartbeat:Connect(function()
				pcall(function()
					local char = LocalPlayer.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					local animator = hum and hum:FindFirstChildOfClass("Animator")
					if not animator then return end
					for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
						local id = tostring(track.Animation and track.Animation.AnimationId or ""):match("%d+")
						if not (id and ANIM_LOCK_KEEP[id]) then track:Stop(0) end
					end
				end)
			end)
		end

		-- Movement lock used by Auto Collect Coins: the player cannot move the character while it collects
		local movementLocked = false
		local collectHoldHook -- set further down (holds the character in the air while it collects)
		function setMovementLocked(lock)
			if movementLocked == lock then return end
			movementLocked = lock
			if collectHoldHook then collectHoldHook(lock) end
			setAnimationsLocked(lock)
			pcall(function()
				local playerScripts = LocalPlayer:WaitForChild("PlayerScripts", 2)
				local playerModule = require(playerScripts:WaitForChild("PlayerModule", 2))
				local controls = playerModule:GetControls()
				if lock then controls:Disable() else controls:Enable() end
			end)
			pcall(function()
				if lock then
					-- Fallback: also swallow keyboard movement input
					ContextActionService:BindActionAtPriority(ACTION_NAME, function()
						return Enum.ContextActionResult.Sink
					end, false, Enum.ContextActionPriority.High.Value,
						Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space,
						Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right)
				else
					ContextActionService:UnbindAction(ACTION_NAME)
				end
			end)
		end

		-- Status line shown under the Auto Collect Coins switch (tells you why it is idle)
		local collectStatusLabels = {}
		local collectStatusText = "Off"
		local function setCollectStatus(text)
			FloatingUi.collectStatus = text
			if text == collectStatusText then return end
			collectStatusText = text
			for _, label in ipairs(collectStatusLabels) do
				if label.Parent then label.Text = "Auto Collect: " .. text end
			end
		end
		function createCollectStatus(parent, size)
			local label = Instance.new("TextLabel", parent)
			label.Name = "CollectStatus"
			label.Size = UDim2.new(1, 0, 0, math.floor(16 * scale))
			label.BackgroundTransparency = 1
			label.Text = "Auto Collect: " .. collectStatusText
			label.TextColor3 = Color3.fromRGB(150, 150, 150)
			label.TextSize = size
			label.Font = Enum.Font.Gotham
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.TextTruncate = Enum.TextTruncate.AtEnd
			table.insert(collectStatusLabels, label)
			return label
		end

		-- Heartbeat-driven movement. Unlike tweens (render driven) it keeps working while the Roblox window is
		-- not focused, and the step size is capped so movement stays smooth even at a very low frame rate.
		-- Returns "arrived", "aborted" or "moved" (the game teleported the character, e.g. at round end).
		local function flyTo(hrp, targetPos, speed, shouldAbort)
			local lastSet = hrp.Position
			local flyHum = hrp.Parent and hrp.Parent:FindFirstChildOfClass("Humanoid")
			while true do
				if not hrp.Parent or (shouldAbort and shouldAbort()) then return "aborted" end
				if flyHum and flyHum.Jump then flyHum.Jump = false end -- Space must not push the character while it is moved
				if gunGrabActive then
					-- Auto Grab Gun is teleporting the character: stand still here and carry on from where it puts
					-- the character back (lastSet stays at the old spot, so this is not mistaken for a game teleport)
					RunService.Heartbeat:Wait()
				else
					local pos = hrp.Position
					if (pos - lastSet).Magnitude > 15 then return "moved" end
					local delta = targetPos - pos
					local dist = delta.Magnitude
					if dist < 0.4 then return "arrived" end
					local dt = math.min(RunService.Heartbeat:Wait(), 0.05)
					if not gunGrabActive then
						local newPos = pos + delta.Unit * math.min(dist, speed * dt)
						hrp.CFrame = CFrame.new(newPos) * hrp.CFrame.Rotation
						hrp.AssemblyLinearVelocity = Vector3.zero
						hrp.AssemblyAngularVelocity = Vector3.zero
						lastSet = newPos
					end
				end
			end
		end

		-- UNDER-MAP COLLECT (optional): the character goes below the floor and lies there on its stomach (face down). For every
		-- coin it (1) slides flat under the floor to the spot right below the coin, (2) slides straight up INTO the coin and stays
		-- on it for a moment ("Under Map Touch" slider) so the game really registers the touch, and (3) sinks back down. It never
		-- walks on the surface; the short vertical move is the only time it is near the map. (A touch fired from far below is
		-- not seen by the game, so the body has to be on the coin.) All movement is continuous (no teleports), and the character
		-- comes back up on its own when the coins are gone, when the mode is switched off, or when Auto Collect stops.
		underMapEnabled = false
		underMapDepth = 10 -- studs below the coin (slider 8-40)
		local underMapActive = false
		local underMapRoot = nil -- the root part we went under the map with
		local underMapHold = nil -- zero-velocity mover that stops the character from falling
		local underMapSurface = nil -- where to come back up
		local underMapExpected = nil -- where the character should be (a big difference = the game moved us)
		local underMapNoCollide = setmetatable({}, {__mode = "k"})
		local underTries = setmetatable({}, {__mode = "k"}) -- [coin] = failed touch attempts
		local underFar = {misses = 0, offUntil = 0} -- touching from below without coming up: when it keeps failing it is skipped for a while

		-- the character does not collide with anything while it is under the map
		RunService.Stepped:Connect(function()
			if not underMapActive then return end
			local char = LocalPlayer.Character
			if not char then return end
			for _, part in ipairs(char:GetChildren()) do
				if part:IsA("BasePart") and part.CanCollide then
					underMapNoCollide[part] = true
					part.CanCollide = false
				end
			end
		end)

		-- COLLECT HOLD: while the script flies the character to a coin, gravity must not pull it down and walls must not
		-- push it around (that is what made the character drop / fall through the floor now and then).
		-- Not used when Fly (own mover) or Under Map Collect (own hold) is active.
		local collectHold, collectActive = nil, false
		local collectNoCollide = setmetatable({}, {__mode = "k"})
		local function ensureCollectHold()
			if not collectActive then return end
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if not hrp then return end
			if flyEnabled or underMapEnabled or underMapActive then
				if collectHold then collectHold:Destroy() collectHold = nil end
				return
			end
			if not (collectHold and collectHold.Parent == hrp) then
				if collectHold then collectHold:Destroy() end
				local hold = Instance.new("BodyVelocity")
				hold.Name = "ApexUnderMapHold" -- Anti-Fling skips this name
				hold.Velocity = Vector3.zero
				hold.MaxForce = Vector3.new(9e9, 9e9, 9e9)
				hold.Parent = hrp
				collectHold = hold
			end
		end
		collectHoldHook = function(lock)
			if lock then
				collectActive = true
				ensureCollectHold()
			else
				collectActive = false
				if collectHold then collectHold:Destroy() collectHold = nil end
				for part in pairs(collectNoCollide) do
					collectNoCollide[part] = nil
					if part.Parent and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
				end
			end
		end
		RunService.Stepped:Connect(function()
			if not collectActive then return end
			local char = LocalPlayer.Character
			if not char then return end
			for _, part in ipairs(char:GetChildren()) do
				if part:IsA("BasePart") and part.CanCollide then
					collectNoCollide[part] = true
					part.CanCollide = false
				end
			end
		end)

		local function findSpawnPosition()
			for _, obj in ipairs(workspace:GetDescendants()) do
				if obj:IsA("SpawnLocation") and obj.Enabled then
					return obj.Position + Vector3.new(0, 5, 0)
				end
			end
			return nil
		end

		-- a spot on the ground above the surface point (nil when the map is already gone)
		local function safeSurfacePosition(surface)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = {LocalPlayer.Character}
			local result = workspace:Raycast(surface + Vector3.new(0, 4, 0), Vector3.new(0, -30, 0), params)
			if result then return result.Position + Vector3.new(0, 3, 0) end
			return nil
		end

		-- UNDER MAP POSE: lying on the stomach = the body turned 90 degrees forward (face down, head in the walking direction)
		local UNDER_MAP_POSE = CFrame.Angles(-math.rad(90), 0, 0)
		local function lieDown(hrp, towards)
			local pos = hrp.Position
			local look = hrp.CFrame.LookVector
			if hrp.CFrame.UpVector.Y < 0.5 then look = hrp.CFrame.UpVector end -- already lying: the head shows the direction
			if towards then
				local d = Vector3.new(towards.X - pos.X, 0, towards.Z - pos.Z)
				if d.Magnitude > 1 then look = d.Unit end
			end
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
			hrp.CFrame = CFrame.lookAt(pos, pos + flat.Unit) * UNDER_MAP_POSE
			hrp.AssemblyAngularVelocity = Vector3.zero
		end
		local function standUp(hrp)
			local pos = hrp.Position
			local head = hrp.CFrame.UpVector -- while lying down the head points the way the body looked
			local flat = Vector3.new(head.X, 0, head.Z)
			if hrp.CFrame.UpVector.Y > 0.5 then flat = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z) end
			if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
			hrp.CFrame = CFrame.lookAt(pos, pos + flat.Unit)
			hrp.AssemblyAngularVelocity = Vector3.zero
		end

		local function releaseUnderMap()
			if underMapHold then
				underMapHold:Destroy()
				underMapHold = nil
			end
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local rootNow = char and char:FindFirstChild("HumanoidRootPart")
			if rootNow and rootNow.CFrame.UpVector.Y < 0.5 then pcall(standUp, rootNow) end -- never leave the body lying down
			if hum then hum.PlatformStand = flyEnabled and true or false end
			for part in pairs(underMapNoCollide) do
				underMapNoCollide[part] = nil
				if part.Parent and part.Name ~= "HumanoidRootPart" then part.CanCollide = true end
			end
			underMapRoot, underMapSurface, underMapExpected = nil, nil, nil
		end

		-- Goes under the map smoothly. Returns "arrived", "aborted" or "moved".
		local HIDE_DEPTH = 70 -- hiding because the coins are done goes much deeper than collecting under the map
		local function enterUnderMap(hrp, hum, shouldAbort, deep)
			if underMapActive then
				if deep and underMapRoot == hrp and underMapSurface and hrp.Position.Y > underMapSurface.Y - HIDE_DEPTH + 2 then
					local result = flyTo(hrp, Vector3.new(hrp.Position.X, underMapSurface.Y - math.max(underMapDepth, HIDE_DEPTH), hrp.Position.Z), math.max(collectSpeed, 20), shouldAbort)
					underMapExpected = hrp.Position
					return result
				end
				return "arrived"
			end
			underMapActive = true
			underMapRoot = hrp
			underMapSurface = hrp.Position
			hum.PlatformStand = true
			lieDown(hrp)
			local hold = Instance.new("BodyVelocity")
			hold.Name = "ApexUnderMapHold" -- Anti-Fling skips this one
			hold.Velocity = Vector3.zero
			hold.MaxForce = Vector3.new(9e9, 9e9, 9e9)
			hold.Parent = hrp
			underMapHold = hold
			local result = flyTo(hrp, hrp.Position - Vector3.new(0, deep and math.max(underMapDepth, HIDE_DEPTH) or underMapDepth, 0), math.max(collectSpeed, 20), shouldAbort)
			underMapExpected = hrp.Position
			return result
		end

		-- Comes back up. restore == false means: just release (the game already moved the character).
		function exitUnderMap(restore)
			if not underMapActive then return end
			underMapActive = false
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if restore ~= false and hrp and hrp == underMapRoot and underMapSurface then
				standUp(hrp) -- upright again before the way back up
				local target = safeSurfacePosition(underMapSurface)
				if target then
					-- rise smoothly instead of teleporting
					flyTo(hrp, target, math.max(collectSpeed, 20), function() return LocalPlayer.Character ~= char end)
				else
					local spawnPos = findSpawnPosition() -- the map is gone: do not fall into the void
					if spawnPos then hrp.CFrame = CFrame.new(spawnPos) end
				end
				hrp.AssemblyLinearVelocity = Vector3.zero
			end
			releaseUnderMap()
		end

		-- Spreading: when many players auto-collect, everybody used to run to the nearest coin, which is the same
		-- coin for everybody. Now a coin only counts as "free" for you when no other player is clearly closer to it
		-- than you are, and the target is picked randomly among the closest free coins.
		local function otherPlayerPositions()
			local list = {}
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer then
					local c = p.Character
					local r = c and c:FindFirstChild("HumanoidRootPart")
					local h = c and c:FindFirstChildOfClass("Humanoid")
					if r and h and h.Health > 0 then list[#list + 1] = r.Position end
				end
			end
			return list
		end

		local function pickCoin(coins, myPos)
			local others = otherPlayerPositions()
			local free, all = {}, {}
			for _, coin in ipairs(coins) do
				local myDist = (coin.Position - myPos).Magnitude
				local taken = false
				for _, pos in ipairs(others) do
					if (coin.Position - pos).Magnitude < myDist - 4 then
						taken = true
						break
					end
				end
				local item = {coin = coin, dist = myDist}
				all[#all + 1] = item
				if not taken then free[#free + 1] = item end
			end
			local pool = (#free > 0) and free or all -- if every coin is contested, fall back to all of them
			table.sort(pool, function(a, b) return a.dist < b.dist end)
			return pool[1].coin
		end

		-- true when another player is clearly closer to the coin than you (so they will get it first)
		local function isContested(coin, myPos, margin)
			local myDist = (coin.Position - myPos).Magnitude
			for _, pos in ipairs(otherPlayerPositions()) do
				if (coin.Position - pos).Magnitude < myDist - margin then return true end
			end
			return false
		end

		-- ==========================================
		-- COIN DETAILS: coins collected this session / today / in the past N hours / all time
		-- ==========================================
		-- A coin counts as yours when it disappears shortly after the script reached it, or (manual pickups)
		-- when it disappears within 6 studs of you and no other player is closer to it. The history is stored in
		-- 5 minute buckets (kept for 4 days) plus an all-time total, saved per account like the other settings.
		local BUCKET = 300
		local coinStats = {total = 0, first = nil, buckets = {}}
		local sessionCoins = 0
		local sessionStart = os.clock()
		local lastCoinClock = nil
		local coinStatsDirty = false
		coinUi = {hours = 3, pause = 60, touch = 200} -- pause = small break between two coins (ms), touch = how long Under Map Collect stays on a coin (ms)

		do
			local loaded = Storage.get("coin_stats")
			if type(loaded) == "table" then
				coinStats.total = tonumber(loaded.total) or 0
				coinStats.first = tonumber(loaded.first)
				if type(loaded.buckets) == "table" then
					for k, n in pairs(loaded.buckets) do
						if tonumber(k) and tonumber(n) then coinStats.buckets[tostring(k)] = tonumber(n) end
					end
				end
			end
		end

		local function addCoin(strict)
			local now = os.time()
			sessionCoins += 1
			lastCoinClock = os.clock()
			coinStats.total += 1
			coinStats.first = coinStats.first or now
			local key = tostring(math.floor(now / BUCKET))
			coinStats.buckets[key] = (coinStats.buckets[key] or 0) + 1
			coinStatsDirty = true
		end

		-- A coin can be seen by two sources: the game's own bag number (exact) and the script's own detection (the coin
		-- disappeared right after the script touched it / next to you). Each source leaves a short-lived credit, and the
		-- other source uses it up instead of counting again, so a coin is never counted twice - and when one source
		-- does not work (bag label not found / never changes) the other one still counts.
		local creditFromBag, creditFromGuess = {}, {}
		local function takeCredit(list)
			local now = os.clock()
			while list[1] and now - list[1] > 4 do table.remove(list, 1) end
			if list[1] then
				table.remove(list, 1)
				return true
			end
			return false
		end
		local function countFromBag(n)
			for _ = 1, n do
				if not takeCredit(creditFromGuess) then
					addCoin(true)
					creditFromBag[#creditFromBag + 1] = os.clock()
				end
			end
		end
		local function countFromGuess(strict)
			if not takeCredit(creditFromBag) then
				addCoin(strict)
				creditFromGuess[#creditFromGuess + 1] = os.clock()
			end
		end

		-- coins since t0. The oldest 5 minute bucket only counts for the part that is inside the window, so a rolling
		-- window ("Past 1 h") slides smoothly instead of dropping by a whole bucket every 5 minutes
		local function coinsSince(t0)
			local firstBucket = math.floor(t0 / BUCKET)
			local inside = 1 - (t0 / BUCKET - firstBucket)
			local sum = 0
			for key, n in pairs(coinStats.buckets) do
				local k = tonumber(key)
				if k > firstBucket then sum += n elseif k == firstBucket then sum += n * inside end
			end
			return sum
		end

		local function coinsToday()
			local now = os.time()
			local t = os.date("*t", now)
			return coinsSince(now - (t.hour * 3600 + t.min * 60 + t.sec))
		end

		coinGone = function(obj)
			local part = obj
			if not obj:IsA("BasePart") then
				part = (obj:IsA("Model") and obj.PrimaryPart) or obj:FindFirstChildWhichIsA("BasePart")
			end
			if not part or coinCounted[part] then return end
			coinCounted[part] = true

			local char = LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not root or not hum or hum.Health <= 0 then return end

			local mine, strict = false, false
			local reached = coinPending[part]
			if reached and os.clock() - reached < 2 then
				mine, strict = true, true -- the script had just reached this coin
			else
				local myDist = (part.Position - root.Position).Magnitude
				if myDist <= 6 then
					mine = true
					for _, pos in ipairs(otherPlayerPositions()) do
						if (part.Position - pos).Magnitude < myDist then mine = false break end
					end
				end
			end
			coinPending[part] = nil
			-- a coin the script reached always counts; a guess from the distance only while the bag counter is silent
			if mine and (strict or not FloatingUi.bagLive) then
				countFromGuess(strict)
			end
		end

		-- saving (every few seconds when something changed, old buckets are dropped)
		local function saveCoinStats()
			local cut = math.floor((os.time() - 4 * 24 * 3600) / BUCKET)
			for key in pairs(coinStats.buckets) do
				if tonumber(key) < cut then coinStats.buckets[key] = nil end
			end
			Storage.set("coin_stats", coinStats)
			coinStatsDirty = false
		end
		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(5)
				if coinStatsDirty then pcall(saveCoinStats) end
			end
		end)
		Players.PlayerRemoving:Connect(function(p)
			if p == LocalPlayer and coinStatsDirty then pcall(saveCoinStats) end
		end)

		-- the overlay (drag it anywhere; the position is remembered)
		local coinPanel, refreshCoinPanel
		do
			local theme = themes[currentThemeName]
			local W = math.floor(240 * scale)
			local PAD = math.floor(9 * scale)
			local GAP = math.floor(5 * scale)
			local tsText = math.max(9, math.floor(11 * scale))
			local tsSmall = math.max(8, math.floor(9 * scale))
			local tsBig = math.max(12, math.floor(17 * scale))
			local GRAY = Color3.fromRGB(150, 156, 168)
			local WHITE = Color3.fromRGB(255, 255, 255)

			-- properties and the NoTranslate flag are set BEFORE the parent, so the translator sees them from the start
			local function mk(class, props, parent, noTranslate)
				local o = Instance.new(class)
				for k, v in pairs(props) do o[k] = v end
				if noTranslate then o:SetAttribute("NoTranslate", true) end
				o.Parent = parent
				return o
			end
			local function label(parent, text, x, y, w, h, size, color, font, align, noTranslate)
				return mk("TextLabel", {
					BackgroundTransparency = 1, Text = text,
					Position = typeof(x) == "UDim2" and x or UDim2.fromOffset(x, y),
					Size = typeof(w) == "UDim2" and w or UDim2.fromOffset(w, h),
					TextSize = size, TextColor3 = color, Font = font, TextXAlignment = align or Enum.TextXAlignment.Left,
					TextYAlignment = Enum.TextYAlignment.Center, ZIndex = -4,
				}, parent, noTranslate)
			end
			local function setText(lbl, text)
				if lbl.Text ~= text then lbl.Text = text end
			end

			local innerW = W - 2 * PAD
			local y = PAD

			-- panel (height is known after the layout below)
			coinPanel = mk("Frame", {
				Name = "CoinDetails", Position = UDim2.fromOffset(12, 150), Size = UDim2.fromOffset(W, 100),
				BackgroundColor3 = theme.Primary, BorderSizePixel = 0, Active = true, Visible = false,
				ZIndex = -6, -- below the main window: it and all its content use ZIndex <= 0, the window starts at 1
			}, ScreenGui)
			themeBg(coinPanel, "Primary")
			Instance.new("UICorner", coinPanel).CornerRadius = UDim.new(0, math.floor(10 * scale))
			local coinPanelStroke = Instance.new("UIStroke", coinPanel)
			coinPanelStroke.Color = theme.Stroke
			coinPanelStroke.Thickness = 1

			-- header: accent dot, title, session timer
			local headerH = math.floor(18 * scale)
			local dotSize = math.max(6, math.floor(8 * scale))
			local dot = mk("Frame", {
				Position = UDim2.fromOffset(PAD, y + math.floor((headerH - dotSize) / 2)), Size = UDim2.fromOffset(dotSize, dotSize),
				BackgroundColor3 = theme.ButtonOn, BorderSizePixel = 0, ZIndex = -5,
			}, coinPanel)
			Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
			themeBg(dot, "ButtonOn")
			label(coinPanel, "COIN DETAILS", PAD + dotSize + math.floor(6 * scale), y, math.floor(120 * scale), headerH,
				tsText, WHITE, Enum.Font.GothamBold)
			local timerLabel = label(coinPanel, "0:00", UDim2.new(1, -(PAD + math.floor(90 * scale)), 0, y), nil,
				UDim2.fromOffset(math.floor(90 * scale), headerH), nil,
				tsSmall + 1, GRAY, Enum.Font.GothamMedium, Enum.TextXAlignment.Right, true)
			y += headerH + GAP

			local divider = mk("Frame", {
				Position = UDim2.fromOffset(PAD, y), Size = UDim2.new(1, -2 * PAD, 0, 1), BackgroundColor3 = theme.Stroke,
				BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = -5,
			}, coinPanel)
			themeBg(divider, "Stroke")
			y += 1 + GAP

			-- 2 x 2 stat cards
			local cardW = math.floor((innerW - GAP) / 2)
			local cardH = math.floor(40 * scale)
			local cards = {}
			local function card(col, row, title)
				local f = mk("Frame", {
					Position = UDim2.new(col * 0.5, col == 0 and PAD or GAP / 2, 0, y + row * (cardH + GAP)),
					Size = UDim2.new(0.5, -(PAD + GAP / 2), 0, cardH),
					BackgroundColor3 = theme.ButtonOff, BorderSizePixel = 0, ZIndex = -5,
				}, coinPanel)
				themeBg(f, "ButtonOff")
				Instance.new("UICorner", f).CornerRadius = UDim.new(0, math.floor(7 * scale))
				local titleLbl = label(f, title, UDim2.fromOffset(math.floor(7 * scale), math.floor(3 * scale)), nil,
					UDim2.new(1, -math.floor(10 * scale), 0, tsSmall + 4), nil,
					tsSmall, GRAY, Enum.Font.GothamMedium)
				local valueLbl = label(f, "0", UDim2.fromOffset(math.floor(7 * scale), math.floor(3 * scale) + tsSmall + 3), nil,
					UDim2.new(1, -math.floor(10 * scale), 0, tsBig + 4), nil,
					tsBig, WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Left, true)
				return {title = titleLbl, value = valueLbl}
			end
			cards.session = card(0, 0, "This session")
			cards.today = card(1, 0, "Today")
			cards.window = card(0, 1, "Past 3 h")
			cards.all = card(1, 1, "All time")
			y += 2 * cardH + GAP + GAP

			-- detail rows
			local rowH = math.floor(15 * scale)
			local rows, rowTitles = {}, {}
			local function row(key, title)
				rowTitles[key] = label(coinPanel, title, UDim2.fromOffset(PAD, y), nil, UDim2.new(1, -2 * PAD, 0, rowH), nil,
					tsSmall + 1, GRAY, Enum.Font.Gotham)
				rows[key] = label(coinPanel, "-", UDim2.fromOffset(PAD, y), nil, UDim2.new(1, -2 * PAD, 0, rowH), nil,
					tsSmall + 1, WHITE, Enum.Font.GothamMedium, Enum.TextXAlignment.Right, true)
				y += rowH
			end
			row("sessionPace", "Hourly rate, session")
			row("windowPace", "Hourly rate, past 3 h")
			row("best", "Best hour")
			row("yesterday", "Yesterday")
			row("daily", "Daily average")
			row("last", "Last coin")
			row("since", "Tracking since")
			y += GAP

			-- bar chart: coins per hour for the last 12 hours
			label(coinPanel, "Last 12 hours", UDim2.fromOffset(PAD, y), nil, UDim2.new(1, -2 * PAD, 0, tsSmall + 4), nil,
				tsSmall, GRAY, Enum.Font.GothamMedium)
			y += tsSmall + 5
			-- bar chart: it takes all the height the window has left (so it grows with the window)
			local axisH = tsSmall + 3
			local chartTop = y
			local minChartH = math.floor(34 * scale)
			local barGap = 2
			local chartArea = mk("Frame", {
				BackgroundTransparency = 1, Position = UDim2.fromOffset(PAD, chartTop),
				Size = UDim2.new(1, -2 * PAD, 1, -(chartTop + axisH + PAD)), ZIndex = -5,
			}, coinPanel)
			local bars = {}
			for i = 1, 12 do
				local bar = mk("Frame", {
					AnchorPoint = Vector2.new(0, 1), Position = UDim2.new((i - 1) / 12, 0, 1, 0), Size = UDim2.new(1 / 12, -barGap, 0, 2),
					BackgroundColor3 = theme.ButtonOn, BackgroundTransparency = 0.7, BorderSizePixel = 0, ZIndex = -4,
				}, chartArea)
				themeBg(bar, "ButtonOn")
				Instance.new("UICorner", bar).CornerRadius = UDim.new(0, 2)
				bars[i] = bar
			end
			local handleSize = math.max(18, math.floor(20 * scale)) -- same size as the main window's resize handle
			label(coinPanel, "12 h ago", UDim2.new(0, PAD, 1, -(PAD + axisH)), nil, UDim2.fromOffset(math.floor(80 * scale), axisH), nil,
				tsSmall - 1, GRAY, Enum.Font.Gotham)
			label(coinPanel, "now", UDim2.new(1, -(PAD + handleSize + math.floor(50 * scale)), 1, -(PAD + axisH)), nil,
				UDim2.fromOffset(math.floor(50 * scale), axisH), nil, tsSmall - 1, GRAY, Enum.Font.Gotham, Enum.TextXAlignment.Right)

			-- size limits (like the main window: minimum / maximum, and never bigger than the screen)
			local minW = math.floor(200 * scale)
			local minH = chartTop + minChartH + axisH + PAD
			local maxW, maxH = math.floor(480 * scale), math.floor(560 * scale)
			coinPanel.Size = UDim2.fromOffset(W, minH)
			attachDrag(coinPanel, coinPanel)
			FloatingUi.coins = coinPanel
			function FloatingUi.coinsResize(w, h)
				coinPanel.Size = UDim2.fromOffset(math.clamp(math.floor(w), minW, maxW), math.clamp(math.floor(h), minH, maxH))
			end

			-- resize handle (bottom right): same look and behaviour as the handle of the main window
			local ResizeGrip = mk("TextButton", {
				Name = "ResizeHandle", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -2, 1, -2), Size = UDim2.fromOffset(handleSize, handleSize), ZIndex = -3,
			}, coinPanel, true)
			for i, len in ipairs({0.72, 0.4}) do
				mk("Frame", {
					Name = "Grip" .. i, AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(math.floor(handleSize * len), 2),
					Position = UDim2.new(0.5 + i * 0.12, 0, 0.5 + i * 0.12, 0), Rotation = -45,
					BackgroundColor3 = Color3.fromRGB(190, 190, 190), BackgroundTransparency = 0.4, BorderSizePixel = 0, ZIndex = -3,
				}, ResizeGrip)
			end
			do
				local resizing = false
				local startMouse, startW, startH
				ResizeGrip.InputBegan:Connect(function(input)
					if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
					resizing = true
					startMouse = input.Position
					startW, startH = coinPanel.AbsoluteSize.X, coinPanel.AbsoluteSize.Y
					local conn
					conn = input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then
							conn:Disconnect()
							resizing = false
						end
					end)
				end)
				UserInputService.InputChanged:Connect(function(input)
					if not resizing then return end
					if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
					local d = input.Position - startMouse
					local pos = coinPanel.AbsolutePosition - ScreenGui.AbsolutePosition
					local vp = ScreenGui.AbsoluteSize
					local limW = math.min(maxW, math.floor(vp.X - pos.X - EDGE))
					local limH = math.min(maxH, math.floor(vp.Y - pos.Y - EDGE))
					coinPanel.Size = UDim2.fromOffset(
						math.clamp(math.floor(startW + d.X), minW, math.max(minW, limW)),
						math.clamp(math.floor(startH + d.Y), minH, math.max(minH, limH)))
				end)
			end
			ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				if coinPanel.Visible then clampToScreen(coinPanel) end
			end)

			local function formatNumber(n)
				local str = tostring(math.floor(n))
				local out = str:reverse():gsub("(%d%d%d)", "%1,"):reverse()
				return (out:gsub("^,", ""))
			end

			local function duration(sec)
				sec = math.max(0, math.floor(sec))
				if sec >= 3600 then
					return string.format("%dh %02dm", math.floor(sec / 3600), math.floor(sec % 3600 / 60))
				end
				return string.format("%d:%02d", math.floor(sec / 60), sec % 60)
			end

			-- coins between two unix times (whole 5 minute buckets)
			local function coinsBetween(t0, t1)
				local a, b = math.floor(t0 / BUCKET), math.floor(t1 / BUCKET)
				local sum = 0
				for key, n in pairs(coinStats.buckets) do
					local k = tonumber(key)
					if k >= a and k < b then sum += n end
				end
				return sum
			end

			refreshCoinPanel = function()
				local now = os.time()
				local hours = coinUi.hours
				local elapsed = os.clock() - sessionStart
				local windowCoins = coinsSince(now - hours * 3600)
				local lt = os.date("*t", now)
				local startToday = now - (lt.hour * 3600 + lt.min * 60 + lt.sec)

				setText(timerLabel, "Session " .. duration(elapsed))
				setText(cards.session.value, formatNumber(sessionCoins))
				setText(cards.today.value, formatNumber(coinsToday()))
				setText(cards.window.title, string.format("Past %d h", hours))
				setText(rowTitles.windowPace, string.format("Hourly rate, past %d h", hours))
				setText(cards.window.value, formatNumber(windowCoins))
				setText(cards.all.value, formatNumber(coinStats.total))

				setText(rows.sessionPace, (elapsed >= 60 and sessionCoins > 0) and (formatNumber(sessionCoins / elapsed * 3600) .. " / h") or "-")
				setText(rows.windowPace, windowCoins > 0 and (formatNumber(windowCoins / hours) .. " / h") or "-")

				-- best clock hour in the stored history (4 days)
				local perHour, best = {}, 0
				for key, n in pairs(coinStats.buckets) do
					local h = math.floor(tonumber(key) * BUCKET / 3600)
					perHour[h] = (perHour[h] or 0) + n
					if perHour[h] > best then best = perHour[h] end
				end
				setText(rows.best, best > 0 and (formatNumber(best) .. " coins") or "-")
				local yesterday = coinsBetween(startToday - 86400, startToday)
				setText(rows.yesterday, yesterday > 0 and formatNumber(yesterday) or "-")
				if coinStats.first and coinStats.total > 0 then
					local days = math.max(1, (now - coinStats.first) / 86400)
					setText(rows.daily, formatNumber(coinStats.total / days) .. " / day")
					local ok, text = pcall(os.date, "%d %b %Y", coinStats.first)
					setText(rows.since, ok and text or "-")
				else
					setText(rows.daily, "-")
					setText(rows.since, "-")
				end
				if lastCoinClock then
					local ago = os.clock() - lastCoinClock
					setText(rows.last, ago < 60 and (math.floor(ago) .. "s ago") or (duration(ago) .. " ago"))
				else
					setText(rows.last, "-")
				end

				-- chart (oldest hour on the left)
				local values, maxValue = {}, 1
				for i = 1, 12 do
					local t1 = now - (12 - i) * 3600
					values[i] = coinsBetween(t1 - 3600, t1)
					if values[i] > maxValue then maxValue = values[i] end
				end
				for i = 1, 12 do
					local v = values[i]
					if v > 0 then
						bars[i].Size = UDim2.new(1 / 12, -barGap, math.max(0.06, v / maxValue), 0)
					else
						bars[i].Size = UDim2.new(1 / 12, -barGap, 0, 2)
					end
					bars[i].BackgroundTransparency = v > 0 and 0.05 or 0.75
				end
			end
		end

		function setCoinDetails(state)
			coinPanel.Visible = state and true or false
			if state then
				clampToScreen(coinPanel)
				pcall(refreshCoinPanel)
			end
		end

		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(0.5)
				if coinPanel.Visible then pcall(refreshCoinPanel) end
			end
		end)

		-- ==========================================
		-- CROSSHAIR (own resizable window, like Coin Details). The hub button opens/closes the window;
		-- inside the window you switch the crosshair on and pick style, size, gap, thickness, colour, opacity
		-- or your own image, and spin it. Everything is saved through Storage (key "crosshair"): DataStore / file /
		-- memory, like the rest of the hub. Own function = own local registers.
		-- ==========================================
		;(function()
			local theme = themes[currentThemeName]
			local PAD = math.floor(9 * scale)
			local GAP = math.floor(5 * scale)
			local tsText = math.max(9, math.floor(11 * scale))
			local tsSmall = math.max(8, math.floor(9 * scale))
			local GRAY = Color3.fromRGB(150, 156, 168)
			local WHITE = Color3.fromRGB(255, 255, 255)

			local cfg = {
				on = false, style = "Cross", size = 10, gap = 4, thickness = 2, opacity = 0, -- opacity = transparency in %
				color = Color3.fromRGB(0, 255, 0), outline = true, image = "",
				spin = false, spinSpeed = 120, -- degrees per second
				hideCursor = true, -- hide Roblox's own cursor while the mouse is locked (shift lock / first person)
			}
			local STYLES = {"Cross", "Cross + Dot", "T-Shape", "Dot", "Circle", "Circle + Dot", "Square", "Diamond", "Corners", "Image"}

			-- load what was saved
			local saved = nil
			pcall(function()
				local d = Storage.get("crosshair")
				if type(d) ~= "table" then return end
				saved = d
				for _, k in ipairs({"on", "outline", "spin", "hideCursor"}) do
					if type(d[k]) == "boolean" then cfg[k] = d[k] end
				end
				local ranges = {size = {2, 60}, gap = {0, 30}, thickness = {1, 10}, opacity = {0, 90}, spinSpeed = {10, 720}}
				for k, r in pairs(ranges) do
					if type(d[k]) == "number" then cfg[k] = math.clamp(math.floor(d[k]), r[1], r[2]) end
				end
				if type(d.style) == "string" and table.find(STYLES, d.style) then cfg.style = d.style end
				if type(d.image) == "string" then cfg.image = d.image end
				if type(d.color) == "table" and type(d.color[1]) == "number" and type(d.color[2]) == "number" and type(d.color[3]) == "number" then
					cfg.color = Color3.fromRGB(math.clamp(d.color[1], 0, 255), math.clamp(d.color[2], 0, 255), math.clamp(d.color[3], 0, 255))
				end
			end)

			local function mk(class, props, parent, noTranslate)
				local o = Instance.new(class)
				for k, v in pairs(props) do o[k] = v end
				if noTranslate then o:SetAttribute("NoTranslate", true) end
				o.Parent = parent
				return o
			end

			-- ---------- the crosshair itself (centre of the screen, never blocks clicks) ----------
			local holder = mk("Frame", {
				Name = "ApexCrosshair", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Active = false, Visible = false, ZIndex = 50,
			}, ScreenGui)

			local function bar(cx, cy, w, h, rot, round, parent)
				w, h = math.max(1, math.floor(w + 0.5)), math.max(1, math.floor(h + 0.5))
				local props = {
					Size = UDim2.fromOffset(w, h), Rotation = rot or 0, BackgroundColor3 = cfg.color,
					BackgroundTransparency = cfg.opacity / 100, BorderSizePixel = 0, ZIndex = 50,
				}
				if (rot or 0) == 0 and not cfg.spin then
					-- still crosshair: whole pixels only (sharp, exactly centred)
					props.Position = UDim2.fromOffset(math.floor(cx - w / 2 + 0.5), math.floor(cy - h / 2 + 0.5))
				else
					-- spinning (or diagonal) crosshair: every part is centred on the exact same pivot. Rounding the corners
					-- made the parts uneven, so the centre of the spinning shape wobbled.
					props.AnchorPoint = Vector2.new(0.5, 0.5)
					props.Position = UDim2.fromOffset(cx, cy)
				end
				local f = mk("Frame", props, parent or holder)
				if round then Instance.new("UICorner", f).CornerRadius = UDim.new(1, 0) end
				if cfg.outline then
					mk("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = cfg.opacity / 100}, f)
				end
				return f
			end

			local function rebuild()
				holder:ClearAllChildren()
				holder.Visible = cfg.on
				if not cfg.on then return end
				local L, G, T = cfg.size, cfg.gap, cfg.thickness
				local style = cfg.style
				local function arms(skipTop)
					if not skipTop then bar(0, -(G + L / 2), T, L) end
					bar(0, G + L / 2, T, L)
					bar(-(G + L / 2), 0, L, T)
					bar(G + L / 2, 0, L, T)
				end
				local function dot() bar(0, 0, math.max(2, T * 1.5), math.max(2, T * 1.5), 0, true) end
				if style == "Cross" then
					arms()
				elseif style == "Cross + Dot" then
					arms(); dot()
				elseif style == "T-Shape" then
					arms(true)
				elseif style == "Dot" then
					bar(0, 0, math.max(2, L / 2), math.max(2, L / 2), 0, true)
				elseif style == "Circle" or style == "Circle + Dot" then
					local d = (L + G) * 2
					local ring = mk("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(d, d),
						BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 50,
					}, holder)
					Instance.new("UICorner", ring).CornerRadius = UDim.new(1, 0)
					mk("UIStroke", {Color = cfg.color, Thickness = T, Transparency = cfg.opacity / 100}, ring)
					if cfg.outline then
						local o = mk("Frame", {
							AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(d + T * 2 + 2, d + T * 2 + 2),
							BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 49,
						}, holder)
						Instance.new("UICorner", o).CornerRadius = UDim.new(1, 0)
						mk("UIStroke", {Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = cfg.opacity / 100}, o)
					end
					if style == "Circle + Dot" then dot() end
				elseif style == "Square" or style == "Diamond" then
					-- an outlined box; the Diamond is the same box turned by 45 degrees (a real shape of its own, not a Cross)
					local d = math.max(4, math.floor((L + G) * (style == "Diamond" and 1.6 or 2)))
					local box = mk("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, 0), Size = UDim2.fromOffset(d, d),
						BackgroundTransparency = 1, BorderSizePixel = 0, Rotation = (style == "Diamond") and 45 or 0, ZIndex = 50,
					}, holder)
					bar(d / 2, T / 2, d, T, 0, false, box)
					bar(d / 2, d - T / 2, d, T, 0, false, box)
					bar(T / 2, d / 2, T, d, 0, false, box)
					bar(d - T / 2, d / 2, T, d, 0, false, box)
				elseif style == "Corners" then
					-- four corner brackets
					local s = (L + G) * 2
					local a = math.max(3, L * 0.6)
					for _, sx in ipairs({-1, 1}) do
						for _, sy in ipairs({-1, 1}) do
							bar(sx * (s / 2 - a / 2), sy * (s / 2 - T / 2), a, T)
							bar(sx * (s / 2 - T / 2), sy * (s / 2 - a / 2), T, a)
						end
					end
				elseif style == "Image" then
					local d = math.max(8, (L + G) * 2)
					local id = cfg.image
					if id ~= "" and not id:find("rbxasset") then id = "rbxassetid://" .. id:gsub("%D", "") end
					mk("ImageLabel", {
						AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(d, d), BackgroundTransparency = 1,
						Image = id, ImageTransparency = cfg.opacity / 100, ZIndex = 50,
					}, holder)
				end
			end

			-- ---------- the window (same look as the hub: themed rows, switches, sliders, selection outlines) ----------
			local W, H = math.floor(250 * scale), math.floor(360 * scale)
			local minW, minH = math.floor(210 * scale), math.floor(200 * scale)
			local maxW, maxH = math.floor(480 * scale), math.floor(620 * scale)
			local ts = math.floor(12 * scale)
			local rowH = math.floor(32 * scale)
			local TRACK_OFF = Color3.fromRGB(70, 70, 82)
			local function cur() return themes[currentThemeName] end

			local panel = mk("Frame", {
				Name = "CrosshairPanel", Position = UDim2.fromOffset(12, 270), Size = UDim2.fromOffset(W, H),
				BackgroundColor3 = theme.Primary, BorderSizePixel = 0, Active = true, Visible = false, ZIndex = -16,
			}, ScreenGui)
			themeBg(panel, "Primary")
			Instance.new("UICorner", panel).CornerRadius = UDim.new(0, math.floor(10 * scale))
			local panelStroke = mk("UIStroke", {Color = theme.Stroke, Thickness = 1}, panel)

			local headerH = math.floor(18 * scale)
			local dotSize = math.max(6, math.floor(8 * scale))
			local dot = mk("Frame", {
				Position = UDim2.fromOffset(PAD, PAD + math.floor((headerH - dotSize) / 2)), Size = UDim2.fromOffset(dotSize, dotSize),
				BackgroundColor3 = theme.ButtonOn, BorderSizePixel = 0, ZIndex = -15,
			}, panel)
			Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
			themeBg(dot, "ButtonOn")
			mk("TextLabel", {
				BackgroundTransparency = 1, Text = "CROSSHAIR", Position = UDim2.fromOffset(PAD + dotSize + math.floor(6 * scale), PAD),
				Size = UDim2.fromOffset(math.floor(120 * scale), headerH), TextSize = tsText, TextColor3 = WHITE,
				Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = -14,
			}, panel)
			attachDrag(panel, panel)

			local top = PAD + headerH + GAP
			local divider = mk("Frame", {
				Position = UDim2.fromOffset(PAD, top), Size = UDim2.new(1, -2 * PAD, 0, 1), BackgroundColor3 = theme.Stroke,
				BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = -15,
			}, panel)
			themeBg(divider, "Stroke")
			top += 1 + GAP

			-- everything below the header lives in a scrolling list, so the window can be any size
			local scroll = mk("ScrollingFrame", {
				BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(PAD, top),
				Size = UDim2.new(1, -2 * PAD, 1, -(top + PAD + math.floor(14 * scale))), ZIndex = -15,
				ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
			}, panel)
			mk("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, GAP)}, scroll)
			local order = 0
			local function nextOrder() order += 1 return order end
			local rowW = UDim2.new(1, -math.floor(6 * scale), 0, rowH)
			local repaints = {} -- functions that recolour things that depend on the active theme

			local function title(text)
				mk("TextLabel", {
					BackgroundTransparency = 1, Text = text, Size = UDim2.new(1, -6, 0, tsSmall + 6), TextSize = tsSmall,
					TextColor3 = GRAY, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
					ZIndex = -14, LayoutOrder = nextOrder(),
				}, scroll)
			end

			-- a row like the hub's: rounded, themed
			local function newRow(height)
				local r = mk("Frame", {
					Size = UDim2.new(1, -math.floor(6 * scale), 0, height or rowH), BackgroundColor3 = theme.ButtonOff, BorderSizePixel = 0,
					ZIndex = -14, LayoutOrder = nextOrder(),
				}, scroll)
				themeBg(r, "ButtonOff")
				Instance.new("UICorner", r).CornerRadius = UDim.new(0, math.floor(6 * scale))
				return r
			end

			local function rowLabel(row, text, w)
				return mk("TextLabel", {
					BackgroundTransparency = 1, Text = text, Position = UDim2.new(0, math.floor(8 * scale), 0, 0),
					Size = UDim2.new(w or 1, -math.floor(16 * scale), 1, 0), TextColor3 = Color3.fromRGB(235, 235, 235), TextSize = ts,
					Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
					ZIndex = -13,
				}, row)
			end

			-- switch row (label left, sliding switch right), like every toggle of the hub
			local function switchRow(text, key, onChange)
				local row = newRow()
				local trackH = math.max(14, math.floor(18 * scale))
				local trackW = math.floor(trackH * 1.9)
				local knobS = trackH - 4
				rowLabel(row, text, 1).Size = UDim2.new(1, -(trackW + math.floor(24 * scale)), 1, 0)
				local track = mk("Frame", {
					Size = UDim2.fromOffset(trackW, trackH), Position = UDim2.new(1, -(trackW + math.floor(8 * scale)), 0.5, -math.floor(trackH / 2)),
					BorderSizePixel = 0, ZIndex = -13,
				}, row)
				Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
				local knob = mk("Frame", {
					Size = UDim2.fromOffset(knobS, knobS), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = -12,
				}, track)
				Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
				local painted = false
				local function paint()
					local on = cfg[key]
					local color = on and cur().ButtonOn or TRACK_OFF
					local pos = on and UDim2.new(1, -(knobS + 2), 0.5, -math.floor(knobS / 2)) or UDim2.new(0, 2, 0.5, -math.floor(knobS / 2))
					if painted then -- same smooth slide as the switches of the hub
						local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
						TweenService:Create(track, info, {BackgroundColor3 = color}):Play()
						TweenService:Create(knob, info, {Position = pos}):Play()
					else
						painted = true
						track.BackgroundColor3 = color
						knob.Position = pos
					end
				end
				paint()
				repaints[#repaints + 1] = paint
				local hit = mk("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = -11}, row, true)
				hit.MouseButton1Click:Connect(function()
					cfg[key] = not cfg[key]
					paint()
					if onChange then onChange() end
					rebuild()
				end)
				return paint
			end

			-- slider row, same as the hub's sliders
			local function slider(name, min, max, key, suffix)
				local row = newRow(math.floor(40 * scale))
				mk("TextLabel", {
					BackgroundTransparency = 1, Text = name, Size = UDim2.new(0.6, 0, 0, math.floor(18 * scale)),
					Position = UDim2.new(0, math.floor(8 * scale), 0, math.floor(4 * scale)), TextColor3 = Color3.fromRGB(200, 200, 200),
					TextSize = ts, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = -13,
				}, row)
				local valueLabel = mk("TextLabel", {
					BackgroundTransparency = 1, Size = UDim2.new(0.4, -math.floor(8 * scale), 0, math.floor(18 * scale)),
					Position = UDim2.new(0.6, 0, 0, math.floor(4 * scale)), TextColor3 = WHITE, TextSize = ts, Font = Enum.Font.GothamBold,
					TextXAlignment = Enum.TextXAlignment.Right, ZIndex = -13,
				}, row, true)
				local trackH = math.max(4, math.floor(6 * scale))
				local track = mk("Frame", {
					Size = UDim2.new(1, -math.floor(16 * scale), 0, trackH), Position = UDim2.new(0, math.floor(8 * scale), 1, -math.floor(12 * scale)),
					BackgroundColor3 = Color3.fromRGB(55, 55, 68), BorderSizePixel = 0, ZIndex = -13,
				}, row)
				Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
				local fill = mk("Frame", {Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = theme.ButtonOn, BorderSizePixel = 0, ZIndex = -12}, track)
				themeBg(fill, "ButtonOn")
				Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
				local knobS = math.max(10, math.floor(13 * scale))
				local knob = mk("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(knobS, knobS), Position = UDim2.new(0, 0, 0.5, 0),
					BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = -11,
				}, track)
				Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
				local box
				local function paint()
					local alpha = (cfg[key] - min) / (max - min)
					fill.Size = UDim2.new(alpha, 0, 1, 0)
					knob.Position = UDim2.new(alpha, 0, 0.5, 0)
					valueLabel.Text = cfg[key] .. (suffix or "")
					if box then box.Text = tostring(cfg[key]) end
				end
				paint()
				local function setValue(v)
					v = math.clamp(math.floor(v + 0.5), min, max)
					if v == cfg[key] then return end
					cfg[key] = v
					paint(); rebuild()
				end
				local hitTop = math.floor(math.floor(40 * scale) * 0.4)
				local hit = mk("TextButton", {
					Text = "", BackgroundTransparency = 1, AutoButtonColor = false, Position = UDim2.new(0, 0, 0, hitTop),
					Size = UDim2.new(1, 0, 1, -hitTop), ZIndex = -10,
				}, row, true)
				attachSafeSlider(hit, track, function() return cfg[key] end, setValue, min, max)
				box = makeNumberBox(row, ts, scale, -9, function() return cfg[key] end, setValue)
				NumericInput.register(function()
					local tb = (NumericInput.mode == "Textboxes")
					track.Visible, hit.Visible, valueLabel.Visible = not tb, not tb, not tb
					box.Visible = tb
					box.Text = tostring(cfg[key])
				end)
			end

			-- selection grid: the chosen entry gets a white outline and white text (like the hub's theme / style choices)
			local function grid(items, isSelected, onPick, itemW)
				local box = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 10), AutomaticSize = Enum.AutomaticSize.Y,
					ZIndex = -14, LayoutOrder = nextOrder()}, scroll)
				mk("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, Wraps = true, SortOrder = Enum.SortOrder.LayoutOrder,
					Padding = UDim.new(0, GAP)}, box)
				local widgets = {}
				local painted = false
				local function paint()
					local info = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
					for item, w in pairs(widgets) do
						local on = isSelected(item)
						local textColor = on and WHITE or Color3.fromRGB(170, 170, 170)
						local hasText = w.btn:IsA("TextButton") and w.btn.Text ~= ""
						if painted then -- fade instead of switching at once
							TweenService:Create(w.stroke, info, {Transparency = on and 0 or 1}):Play()
							if hasText then TweenService:Create(w.btn, info, {TextColor3 = textColor}):Play() end
						else
							w.stroke.Transparency = on and 0 or 1
							if hasText then w.btn.TextColor3 = textColor end
						end
					end
					painted = true
				end
				for i, item in ipairs(items) do
					local b = itemW(item, box, i)
					local stroke = mk("UIStroke", {Color = WHITE, Thickness = 1.5, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, b)
					widgets[item] = {btn = b, stroke = stroke}
					b.MouseButton1Click:Connect(function() onPick(item) paint() rebuild() end)
				end
				paint()
				return paint
			end

			local function textBox(placeholder, text)
				local row = newRow()
				local t = mk("TextBox", {
					Size = UDim2.new(1, -math.floor(16 * scale), 1, 0), Position = UDim2.new(0, math.floor(8 * scale), 0, 0), BackgroundTransparency = 1,
					TextColor3 = WHITE, PlaceholderText = placeholder, PlaceholderColor3 = GRAY, Text = text, TextSize = ts,
					Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false, ZIndex = -13,
				}, row, true)
				return t
			end

			-- ---- content ----
			switchRow("Crosshair", "on")

			title("Style")
			local paintStyles
			paintStyles = grid(STYLES, function(n) return cfg.style == n end, function(n) cfg.style = n end, function(name, box, i)
				local b = mk("TextButton", {
					Text = name, AutoButtonColor = false, Size = UDim2.fromOffset(math.floor(#name * 6.2 * scale) + math.floor(18 * scale), math.floor(26 * scale)),
					BackgroundColor3 = theme.ButtonOff, BorderSizePixel = 0, TextColor3 = Color3.fromRGB(170, 170, 170), TextSize = ts - 1,
					Font = Enum.Font.GothamMedium, ZIndex = -14, LayoutOrder = i,
				}, box)
				themeBg(b, "ButtonOff")
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, math.floor(6 * scale))
				return b
			end)

			slider("Size", 2, 60, "size", " px")
			slider("Gap", 0, 30, "gap", " px")
			slider("Thickness", 1, 10, "thickness", " px")
			slider("Transparency", 0, 90, "opacity", " %")
			switchRow("Outline", "outline")
			switchRow("Spinning", "spin")
			slider("Spin speed", 10, 720, "spinSpeed", " deg/s")
			switchRow("Hide cursor (shift lock)", "hideCursor")

			title("Colour")
			local hexBox
			local function setColor(c)
				cfg.color = c
				if hexBox then hexBox.Text = string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
				rebuild()
			end
			local swatches = {
				Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 50, 50), Color3.fromRGB(0, 220, 255),
				Color3.fromRGB(255, 235, 60), Color3.fromRGB(255, 80, 220), Color3.fromRGB(255, 150, 30), Color3.fromRGB(90, 110, 255),
				Color3.fromRGB(0, 0, 0),
			}
			local sw = math.floor(24 * scale)
			local paintSwatches
			paintSwatches = grid(swatches, function(c) return cfg.color == c end, function(c) setColor(c) end, function(c, box, i)
				local b = mk("TextButton", {
					Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(sw, sw), BackgroundColor3 = c, BorderSizePixel = 0,
					ZIndex = -14, LayoutOrder = i,
				}, box)
				Instance.new("UICorner", b).CornerRadius = UDim.new(1, 0)
				return b
			end)

			hexBox = textBox("Custom colour: #RRGGBB or R,G,B", "")
			do
				local c = cfg.color
				hexBox.Text = string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
			end
			hexBox.FocusLost:Connect(function()
				local txt = hexBox.Text:gsub("%s", "")
				local r, g, b = txt:match("^(%d+),(%d+),(%d+)$") if r then setColor(Color3.fromRGB(math.clamp(tonumber(r), 0, 255), math.clamp(tonumber(g), 0, 255), math.clamp(tonumber(b), 0, 255))) else local hex = txt:match("^#?(%x%x%x%x%x%x)$")
					if hex then
						setColor(Color3.fromRGB(tonumber(hex:sub(1, 2), 16), tonumber(hex:sub(3, 4), 16), tonumber(hex:sub(5, 6), 16)))
					else
						setColor(cfg.color) -- invalid input: restore the text
					end
				end
				paintSwatches()
			end)

			title("Custom image (style \"Image\"): Roblox image ID")
			local imgBox = textBox("e.g. 123456789", cfg.image)
			imgBox.FocusLost:Connect(function()
				cfg.image = imgBox.Text:gsub("%s", "")
				if cfg.image ~= "" then cfg.style = "Image"; paintStyles() end
				rebuild()
			end)

			-- the switches follow the theme the user picked (the panel itself is tweened to the new theme colour)
			panel:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
				panelStroke.Color = cur().Stroke
				for _, f in ipairs(repaints) do f() end
			end)

			-- resize handle (bottom right), same look as the other windows
			local handleSize = math.max(18, math.floor(20 * scale))
			local grip = mk("TextButton", {
				Name = "ResizeHandle", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -2, 1, -2), Size = UDim2.fromOffset(handleSize, handleSize), ZIndex = -13,
			}, panel, true)
			for i, len in ipairs({0.72, 0.4}) do
				mk("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(math.floor(handleSize * len), 2),
					Position = UDim2.new(0.5 + i * 0.12, 0, 0.5 + i * 0.12, 0), Rotation = -45,
					BackgroundColor3 = Color3.fromRGB(190, 190, 190), BackgroundTransparency = 0.4, BorderSizePixel = 0, ZIndex = -13,
				}, grip)
			end
			do
				local resizing = false
				local startMouse, startW, startH
				grip.InputBegan:Connect(function(input)
					if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
					resizing = true
					startMouse = input.Position
					startW, startH = panel.AbsoluteSize.X, panel.AbsoluteSize.Y
					local conn
					conn = input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then conn:Disconnect() resizing = false end
					end)
				end)
				UserInputService.InputChanged:Connect(function(input)
					if not resizing then return end
					if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
					local d = input.Position - startMouse
					local pos = panel.AbsolutePosition - ScreenGui.AbsolutePosition
					local vp = ScreenGui.AbsoluteSize
					local limW = math.min(maxW, math.floor(vp.X - pos.X - EDGE))
					local limH = math.min(maxH, math.floor(vp.Y - pos.Y - EDGE))
					panel.Size = UDim2.fromOffset(
						math.clamp(math.floor(startW + d.X), minW, math.max(minW, limW)),
						math.clamp(math.floor(startH + d.Y), minH, math.max(minH, limH)))
				end)
			end
			ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				if panel.Visible then clampToScreen(panel) end
			end)

			-- window position / size from the save
			if saved and type(saved.px) == "number" and type(saved.py) == "number" then
				panel.Position = UDim2.fromOffset(math.max(0, saved.px), math.max(0, saved.py))
			end
			if saved and type(saved.pw) == "number" and type(saved.ph) == "number" then
				panel.Size = UDim2.fromOffset(math.clamp(saved.pw, minW, maxW), math.clamp(saved.ph, minH, maxH))
			end

			rebuild()

			-- the crosshair follows the screen centre; with the mouse locked (shift lock / first person) it uses the real
			-- locked mouse position, so it always sits exactly where you aim
			-- THE GAME'S OWN CROSSHAIR / SHIFT LOCK: while your crosshair is on,
			-- * holding the gun: the mouse icon the game sets for it (and the round shift lock cursor) is replaced by an
			-- empty image every frame, so the gun's crosshair never shows next to yours
			-- * crosshair pictures in the game's own GUI (names with "crosshair", "reticle", "xhair") are made see-through
			-- (not Visible=false: the game keeps switching Visible itself), and brought back when yours goes off
			-- * on a phone / tablet the shift lock itself is switched off (Player.DevEnableMouseLock): its dot has no mouse
			-- icon that could be hidden. It comes back when your crosshair is switched off.
			local mouse = LocalPlayer:GetMouse()
			local BLANK_ICON = "rbxasset://textures/Blank.png"
			local iconBlanked, blankWanted, guiHide = false, false, false
			local mouseLockSaved = nil
			local hiddenGui = {} -- [root] = {[object] = {property, original value}}

			local function holdingGun()
				local char = LocalPlayer.Character
				if not char then return false end
				for _, item in ipairs(char:GetChildren()) do
					if item:IsA("Tool") then
						local n = item.Name:lower()
						if n:find("gun") or n:find("revolver") or n:find("sheriff") then return true end
					end
				end
				return false
			end
			local function isOurs(obj)
				local c = obj
				while c do
					if c == holder or c == panel then return true end
					c = c.Parent
				end
				return false
			end
			local function looksLikeReticle(obj)
				local n = obj.Name:lower()
				return n:find("reticle", 1, true) or n:find("crosshair", 1, true) or n:find("xhair", 1, true)
			end
			local function hideGuiTree(root)
				local saved = {}
				local function one(o)
					if o:IsA("ImageLabel") or o:IsA("ImageButton") then
						saved[o] = {"ImageTransparency", o.ImageTransparency}
						o.ImageTransparency = 1
					elseif o:IsA("TextLabel") or o:IsA("TextButton") then
						saved[o] = {"TextTransparency", o.TextTransparency}
						o.TextTransparency = 1
					elseif o:IsA("Frame") then
						saved[o] = {"BackgroundTransparency", o.BackgroundTransparency}
						o.BackgroundTransparency = 1
					end
				end
				one(root)
				for _, d in ipairs(root:GetDescendants()) do one(d) end
				hiddenGui[root] = saved
			end
			local function showGuiTrees()
				for root, saved in pairs(hiddenGui) do
					for o, s in pairs(saved) do
						if o.Parent then o[s[1]] = s[2] end
					end
					hiddenGui[root] = nil
				end
			end
			local function keepGuiHidden() -- the game may bring a picture back: it is hidden again every frame
				for _, saved in pairs(hiddenGui) do
					for o, s in pairs(saved) do
						if o.Parent and o[s[1]] ~= 1 then o[s[1]] = 1 end
					end
				end
			end
			local function setIconBlank(state)
				blankWanted = state
				if state then
					iconBlanked = true
					if mouse.Icon ~= BLANK_ICON then mouse.Icon = BLANK_ICON end
				elseif iconBlanked then
					iconBlanked = false
					local locked = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
					mouse.Icon = locked and "rbxasset://textures/MouseLockedCursor.png" or ""
				end
			end
			local function setShiftLockOff(state)
				if not (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then return end
				if state then
					if mouseLockSaved == nil then mouseLockSaved = LocalPlayer.DevEnableMouseLock end
					if LocalPlayer.DevEnableMouseLock then LocalPlayer.DevEnableMouseLock = false end
				elseif mouseLockSaved ~= nil then
					LocalPlayer.DevEnableMouseLock = mouseLockSaved
					mouseLockSaved = nil
				end
			end
			RunService.Heartbeat:Connect(function() -- after the game's own scripts: its icon never survives a frame
				if blankWanted and mouse.Icon ~= BLANK_ICON then mouse.Icon = BLANK_ICON end
			end)
			task.spawn(function()
				while ScreenGui.Parent do
					task.wait(0.4)
					pcall(function()
						if not guiHide then return end
						local pg = LocalPlayer:FindFirstChild("PlayerGui")
						if not pg then return end
						for _, d in ipairs(pg:GetDescendants()) do
							if d:IsA("GuiObject") and not hiddenGui[d] and looksLikeReticle(d) and not isOurs(d) then hideGuiTree(d) end
						end
					end)
				end
			end)

			local rot, cursorHidden = 0, false
			RunService.RenderStepped:Connect(function(dt)
				if not cfg.on then
					if cursorHidden then UserInputService.MouseIconEnabled = true cursorHidden = false end
					if blankWanted or iconBlanked then pcall(setIconBlank, false) end
					if guiHide then
						guiHide = false
						pcall(showGuiTrees)
					end
					pcall(setShiftLockOff, false)
					return
				end
				pcall(setShiftLockOff, true)
				guiHide = true
				pcall(keepGuiHidden)
				local locked = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter
				pcall(setIconBlank, holdingGun() or (cfg.hideCursor and locked))
				local p = ScreenGui.AbsoluteSize / 2
				holder.Position = UDim2.fromOffset(math.floor(p.X + 0.5), math.floor(p.Y + 0.5))
				if cfg.spin then
					rot = (rot + cfg.spinSpeed * dt) % 360
					holder.Rotation = rot
				elseif holder.Rotation ~= 0 then
					rot = 0
					holder.Rotation = 0
				end
				-- Roblox's own cursor is hidden only while the mouse is locked, so you can always click the menu otherwise
				if locked and cfg.hideCursor then
					UserInputService.MouseIconEnabled = false
					cursorHidden = true
				elseif cursorHidden then
					UserInputService.MouseIconEnabled = true
					cursorHidden = false
				end
			end)

			-- saving (checked every 2 seconds, written only when something changed)
			local function snapshot()
				local c = cfg.color
				local ap = panel.AbsolutePosition - ScreenGui.AbsolutePosition
				local data = {
					on = cfg.on, outline = cfg.outline, spin = cfg.spin, hideCursor = cfg.hideCursor, style = cfg.style,
					size = cfg.size, gap = cfg.gap, thickness = cfg.thickness, opacity = cfg.opacity, spinSpeed = cfg.spinSpeed,
					image = cfg.image, color = {math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)},
					px = math.floor(ap.X), py = math.floor(ap.Y), pw = math.floor(panel.AbsoluteSize.X), ph = math.floor(panel.AbsoluteSize.Y),
				}
				local key = table.concat({
					tostring(data.on), tostring(data.outline), tostring(data.spin), tostring(data.hideCursor), data.style, data.size,
					data.gap, data.thickness, data.opacity, data.spinSpeed, data.image, data.color[1], data.color[2], data.color[3],
					data.px, data.py, data.pw, data.ph,
				}, "|")
				return data, key
			end
			local _, lastKey = snapshot()
			task.spawn(function()
				while ScreenGui.Parent do
					task.wait(2)
					pcall(function()
						local data, key = snapshot()
						if key ~= lastKey and Storage.set("crosshair", data) then lastKey = key end
					end)
				end
			end)

			FloatingUi.crosshair = panel
			FloatingUi.setCrosshair = function(state)
				panel.Visible = state and true or false
				if state then clampToScreen(panel) end
			end
		end)()

		-- ==========================================
		-- EXTRAS: keybinds, knife reach and server hop. Own function = own local registers.
		-- The hub buttons (tab "Extras") only set values in FloatingUi.x and call FloatingUi.* functions.
		-- ==========================================
		;(function()
			local X = {
				reachOn = false, reachMult = 4,
			}
			FloatingUi.x = X

			local WHITE = Color3.fromRGB(255, 255, 255)
			local GRAY = Color3.fromRGB(150, 156, 168)
			local PAD = math.floor(9 * scale)
			local GAP = math.floor(5 * scale)
			local ts = math.max(9, math.floor(12 * scale))
			local tsSmall = math.max(8, math.floor(10 * scale))
			local rowH = math.floor(32 * scale)
			local TRACK_OFF = Color3.fromRGB(70, 70, 82)
			local function cur() return themes[currentThemeName] end

			local function mk(class, props, parent, noTranslate)
				local o = Instance.new(class)
				for k, v in pairs(props) do o[k] = v end
				if noTranslate then o:SetAttribute("NoTranslate", true) end
				o.Parent = parent
				return o
			end

			-- ---------- saved data (Storage key "extras": keybinds) ----------
			local E = {keys = {}, screen = {}} -- screen: positions of the on-screen buttons (phones)
			pcall(function()
				local d = Storage.get("extras")
				if type(d) ~= "table" then return end
				if type(d.keys) == "table" then
					for name, key in pairs(d.keys) do
						if type(name) == "string" and type(key) == "string" and (key == "Touch" or Enum.KeyCode[key]) then E.keys[name] = key end
					end
				end
				if type(d.screen) == "table" then
					for name, p in pairs(d.screen) do
						if type(name) == "string" and type(p) == "table" and tonumber(p.x) and tonumber(p.y) then
							E.screen[name] = {x = tonumber(p.x), y = tonumber(p.y)}
						end
					end
				end
			end)
			local saveToken = 0
			local function saveE()
				saveToken += 1
				local my = saveToken
				task.delay(0.8, function() -- one write for a burst of changes
					if my == saveToken then pcall(Storage.set, "extras", E) end
				end)
			end

			-- ---------- HTTP helpers (server list) ----------
			local function httpFn()
				return (syn and syn.request) or request or http_request or (http and http.request) or (fluxus and fluxus.request)
			end
			local function httpGet(url)
				local req = httpFn()
				if req then
					local ok, res = pcall(req, {Url = url, Method = "GET", Headers = {["Accept"] = "application/json"}})
					if ok and res and type(res.Body) == "string" and (res.StatusCode == 200 or res.Success == true) then return res.Body end
					return nil, ok and res and res.StatusCode or "request failed"
				end
				local ok, body = pcall(function() return game:HttpGet(url) end)
				if ok and type(body) == "string" then return body end
				return nil, "no HTTP support"
			end
			local function hopNotify(text)
				print("[APEX] " .. text)
				pcall(function()
					game:GetService("StarterGui"):SetCore("SendNotification", {Title = "APEX Server Hop", Text = text, Duration = 5})
				end)
			end

			-- ---------- knife reach (changes only what YOUR game client sees) ----------
			-- EVERY part of the knife is scaled, not only "Handle": many knives have a tiny Handle and the visible blade as
			-- separate parts, and knives with a SpecialMesh keep their looks when only the part size changes - so the
			-- mesh scale is multiplied as well.
			local partOrig = setmetatable({}, {__mode = "k"}) -- part -> {size, massless}
			local meshOrig = setmetatable({}, {__mode = "k"}) -- mesh -> {scale, offset}
			local function eachKnifePart(fn)
				for _, container in ipairs({LocalPlayer.Character, LocalPlayer:FindFirstChildOfClass("Backpack")}) do
					if container then
						for _, item in ipairs(container:GetChildren()) do
							if item:IsA("Tool") then
								local n = item.Name:lower()
								if n:find("knife") or n:find("murder") then
									for _, d in ipairs(item:GetDescendants()) do fn(d) end
								end
							end
						end
					end
				end
			end
			task.spawn(function()
				while ScreenGui.Parent do
					task.wait(0.15)
					pcall(function()
						if X.reachOn then
							local m = X.reachMult
							eachKnifePart(function(d)
								if d:IsA("BasePart") then
									if not partOrig[d] then partOrig[d] = {size = d.Size, massless = d.Massless} end
									local o = partOrig[d].size
									local want = Vector3.new(o.X * m, o.Y * m, o.Z * m)
									if d.Size ~= want then d.Size = want end
									if not d.Massless then d.Massless = true end
								elseif d:IsA("DataModelMesh") then
									if not meshOrig[d] then meshOrig[d] = {scale = d.Scale, offset = d.Offset} end
									local o = meshOrig[d].scale
									local want = Vector3.new(o.X * m, o.Y * m, o.Z * m)
									if d.Scale ~= want then d.Scale = want end
								end
							end)
						else
							for part, o in pairs(partOrig) do
								partOrig[part] = nil
								if part.Parent then part.Size = o.size part.Massless = o.massless end
							end
							for mesh, o in pairs(meshOrig) do
								meshOrig[mesh] = nil
								if mesh.Parent then mesh.Scale = o.scale end
							end
						end
					end)
				end
			end)

			-- ---------- server hop ----------
			local hopping = false
			local TeleportService = game:GetService("TeleportService")
			-- Reads up to maxPages pages (100 servers each) of the public server list of this game. Full servers, the server
			-- you are in and empty ones are left out. Every entry of the list carries the numbers the server browser gives:
			-- playing, maxPlayers and, estimated for YOUR connection, ping (ms) and fps.
			-- the official endpoint first, then mirrors (the official one is blocked or rate limited on many networks / executors)
			local HOSTS = {"games.roblox.com", "games.roproxy.com"}
			local lastFetchError = "no response"
			local function fetchServers(sortOrder, maxPages)
				local list, cursor = {}, ""
				for _ = 1, maxPages do
					local data
					for attempt = 1, 2 do
						for _, host in ipairs(HOSTS) do
							local url = "https://" .. host .. "/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=" .. sortOrder
							.. "&limit=100&excludeFullGames=true"
							if cursor ~= "" then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
							local body, err = httpGet(url)
							if body then
								local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
								if ok and type(d) == "table" and type(d.data) == "table" then data = d break end
								lastFetchError = host .. ": bad response"
							else
								lastFetchError = host .. ": " .. tostring(err)
							end
						end
						if data then break end
						task.wait(1.5) -- rate limited: wait, then try both hosts once more
					end
					if not data then break end
					for _, sv in ipairs(data.data) do
						if type(sv) == "table" and sv.id ~= game.JobId and type(sv.playing) == "number" and type(sv.maxPlayers) == "number"
						and sv.playing >= 1 and sv.playing < sv.maxPlayers - 1 then
							list[#list + 1] = sv
						end
					end
					cursor = type(data.nextPageCursor) == "string" and data.nextPageCursor or ""
					if cursor == "" then break end
					task.wait(0.4) -- the list endpoint rate limits quick repeated calls
				end
				return list
			end

			-- BEST CONNECTION: the best servers by estimated ping (the server browser's ping value for your connection; when a
			-- response has no ping the fps value is used as the quality estimate instead). The best ~30 % (at least 5, at
			-- most 15 servers) form the pool, and the mode picks inside that pool.
			local function bestPool(list)
				local ranked = {}
				for _, s in ipairs(list) do
					if type(s.ping) == "number" and s.ping > 0 then ranked[#ranked + 1] = s end
				end
				if #ranked >= 3 then
					table.sort(ranked, function(a, b) return a.ping < b.ping end)
				else
					ranked = {}
					for _, s in ipairs(list) do
						if type(s.fps) == "number" and s.fps > 0 then ranked[#ranked + 1] = s end
					end
					if #ranked >= 3 then
						table.sort(ranked, function(a, b) return a.fps > b.fps end)
					else
						warn("APEX: the server list has no ping / fps values, choosing among all servers")
						return list
					end
				end
				local n = math.clamp(math.ceil(#ranked * 0.3), math.min(5, #ranked), 15)
				local pool = {}
				for i = 1, n do pool[i] = ranked[i] end
				return pool
			end

			-- modes: "random", "fewest", "most" and the best connection versions "best_random", "best_fewest", "best_most"
			local function serverHop(mode)
				if hopping then hopNotify("Already searching for a server...") return end
				hopping = true
				task.delay(60, function() hopping = false end)
				task.spawn(function()
					local best = mode:sub(1, 5) == "best_"
					local base = best and mode:sub(6) or mode
					hopNotify("Searching for a server...")
					-- the fullest servers are at the start of a Desc list, the emptiest at the start of an Asc list
					local list = fetchServers(base == "most" and "Desc" or "Asc", best and 3 or 1)
					if #list == 0 then
						hopNotify("No server found (" .. lastFetchError .. ")")
						hopping = false
						return
					end
					-- candidate order for this mode
					local cand = list
					if best then cand = bestPool(list) end
					cand = table.clone(cand)
					if base == "fewest" then
						table.sort(cand, function(a, b) return a.playing < b.playing end)
					elseif base == "most" then
						table.sort(cand, function(a, b) return a.playing > b.playing end)
					else
						for i = #cand, 2, -1 do local j = math.random(1, i) cand[i], cand[j] = cand[j], cand[i] end
					end
					-- fewest / most: a little randomness among the top 3 so repeated hops do not hit the same full server
					if base ~= "random" and #cand > 1 then
						local j = math.random(1, math.min(3, #cand))
						cand[1], cand[j] = cand[j], cand[1]
					end
					-- try up to 5 servers: a server that filled up meanwhile makes the teleport fail, then the next one is used
					for i = 1, math.min(5, #cand) do
						local pick = cand[i]
						local failed, msg = false, nil
						local conn = TeleportService.TeleportInitFailed:Connect(function(_, result, errMsg)
							failed, msg = true, tostring(errMsg or result)
						end)
						local sent, err = pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LocalPlayer) end)
						if not sent then failed, msg = true, tostring(err) end
						local t0 = os.clock()
						while not failed and os.clock() - t0 < 8 do task.wait(0.25) end
						conn:Disconnect()
						if not failed then return end -- the teleport is under way
						hopNotify("Teleport failed (" .. tostring(msg) .. "), trying another server...")
						task.wait(1)
					end
					hopNotify("Could not join any server, try again")
					hopping = false
				end)
			end
			FloatingUi.serverHop = serverHop

			;(function() -- own function: keeps the local variable count of the enclosing block low
			-- ---------- AUTO RECONNECT ----------
			-- Kick / disconnect -> the script rejoins by itself and starts again after landing:
			--  1. the exact same server (same JobId), up to 3 tries; "full / closed / not found" skips straight to step 3
			--  2. friends: when a friend was in your server (or you typed a friend name), you are put back together. Everybody who
			--     runs this script takes the same role: the lowest user id is the leader and picks the server, the others wait
			--     for the leader's server to show up (GetPlayerPlaceInstanceAsync) and join it. A friend that is already in a
			--     server of this game is joined directly.
			--  3. fallback: a quiet server (1-2 players, then 3, 5, any), the lowest ping first
			-- The script is started again with queue_on_teleport. The executor can not tell this script where it came from, so
			-- the source is set in the Extras tab (URL, file name in the workspace folder, or a full loadstring line). Leave it
			-- empty when the script is in the autoexec folder.
			local GuiService = game:GetService("GuiService")
			local RC = {enabled = true, busy = false, queued = false, status = "Waiting for a disconnect"}
			local function trim(s) return (tostring(s or ""):gsub("^%s+", ""):gsub("%s+$", "")) end

			local function rcNotify(text)
				print("[APEX] " .. text)
				pcall(function()
					game:GetService("StarterGui"):SetCore("SendNotification", {Title = "APEX Reconnect", Text = text, Duration = 6})
				end)
			end
			local function rcStatus(text, notify)
				RC.status = text
				if RC.onStatus then pcall(RC.onStatus, text) end
				if notify then rcNotify(text) end
			end

			-- what is run after landing: a URL, a file of the executor's workspace folder, or a complete line of code
			local function buildLoader(src)
				src = trim(src)
				if src == "" then return nil end
				if src:match("^https?://") then
					return ("loadstring(game:HttpGet(%q))()"):format(src)
				elseif src:find("[%(%)]") then
					return src
				end
				return ("loadstring(readfile(%q))()"):format(src)
			end

			local function resolveSource()
				local src = trim(RECONNECT_SOURCE)
				if src == "" then
					pcall(function()
						local g = getgenv and getgenv()
						if g and type(g.APEX_SOURCE_URL) == "string" then src = trim(g.APEX_SOURCE_URL) end
					end)
				end
				return src
			end

			local function queueReload(info)
				local q = queue_on_teleport or queueonteleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
				if type(q) ~= "function" then return false, "this executor has no queue_on_teleport" end
				local loader = buildLoader(resolveSource())
				if not loader then return false, "no script link set (RECONNECT_SOURCE at the top of the script)" end
				if RC.queued then return true end -- queued once per session, a second one would start the script twice
				local okJson, json = pcall(function() return HttpService:JSONEncode(info) end)
				-- the key of the key system is set again before the script is loaded
				local key = trim(RECONNECT_KEY)
				if key == "" then key = CAPTURED_KEY or "" end
				if key == "" then
					pcall(function()
						local g = getgenv and getgenv()
						if g and type(g.SCRIPT_KEY) == "string" then key = g.SCRIPT_KEY end
					end)
				end
				local keyLine = ""
				if key ~= "" then
					keyLine = ("getgenv().SCRIPT_KEY = %q\ngetgenv().script_key = %q\n"):format(key, key)
				else
					rcNotify("No key found for the reconnect - set getgenv().SCRIPT_KEY before running the script, or RECONNECT_KEY at the top")
				end
				local code = keyLine .. (okJson and ("pcall(function() getgenv().APEX_RECONNECT_INFO = game:GetService('HttpService'):JSONDecode([==[" .. json .. "]==]) end)\n") or "") .. loader
				local ok, err = pcall(q, code)
				if ok then RC.queued = true return true end
				return false, tostring(err)
			end

			-- landing: tell where we are after a reconnect
			task.spawn(function()
				local info
				pcall(function()
					local g = getgenv and getgenv()
					if g and g.APEX_RECONNECT_INFO then info = g.APEX_RECONNECT_INFO g.APEX_RECONNECT_INFO = nil end
				end)
				if type(info) ~= "table" then info = Storage.get("reconnect") end
				if type(info) ~= "table" or type(info.t) ~= "number" or os.time() - info.t > 300 then return end
				pcall(Storage.delete, "reconnect")
				task.wait(3)
				rcStatus(info.jobId == game.JobId and "Reconnected to the same server" or "Reconnected (new server)", true)
			end)

			-- ---------- friends that are in the server (snapshot, a disconnect empties the player list) ----------
			local friendCache, recent = {}, {}
			local partnerId, partnerShown = nil, ""
			local function isFriend(p)
				local c = friendCache[p.UserId]
				if c ~= nil then return c end
				friendCache[p.UserId] = false -- until the answer arrives (the call yields)
				task.spawn(function()
					local ok, res = pcall(function() return LocalPlayer:IsFriendsWith(p.UserId) end)
					friendCache[p.UserId] = ok and res == true
				end)
				return false
			end
			task.spawn(function()
				while ScreenGui.Parent do
					if not RC.busy then
						for _, p in ipairs(Players:GetPlayers()) do
							if p ~= LocalPlayer and (p.UserId == partnerId or isFriend(p)) then
								recent[p.UserId] = {name = p.Name, t = os.clock(), apex = apexMemberCheck(p) == true}
							end
						end
					end
					task.wait(4)
				end
			end)
			local function partnersNow()
				local list, now = {}, os.clock()
				for id, f in pairs(recent) do
					if now - f.t <= 30 then list[#list + 1] = {id = id, name = f.name, apex = f.apex or id == partnerId} end
				end
				if partnerId and not recent[partnerId] then list[#list + 1] = {id = partnerId, name = partnerShown, apex = true} end
				table.sort(list, function(a, b) -- the typed friend first, then by user id
					if (a.id == partnerId) ~= (b.id == partnerId) then return a.id == partnerId end
					return a.id < b.id
				end)
				return list
			end

			-- where a player is right now: place id + server id (nil when offline / not joinable)
			local function lookupServer(userId)
				local res = table.pack(pcall(function() return TeleportService:GetPlayerPlaceInstanceAsync(userId) end))
				if not res[1] then return nil end
				local placeId, instanceId
				for i = 2, res.n do
					local v = res[i]
					if type(v) == "number" and not placeId then placeId = v end
					if type(v) == "string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then instanceId = v end
				end
				if placeId and instanceId then return placeId, instanceId end
				return nil
			end

			-- ---------- teleporting ----------
			local teleportingUntil = 0
			pcall(function()
				LocalPlayer.OnTeleport:Connect(function(state)
					if state ~= Enum.TeleportState.Failed then teleportingUntil = os.clock() + 25 end
				end)
			end)
			local UNAVAILABLE = {GameFull = true, GameEnded = true, GameNotFound = true, Unauthorized = true}
			-- "unavailable": this server can not be joined (full / closed / private), "retry": another try may work
			local function tryJoin(placeId, jobId)
				local failedResult, failedMsg
				local conn = TeleportService.TeleportInitFailed:Connect(function(_, result, msg) failedResult, failedMsg = result, msg end)
				local sent, err = pcall(function() TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer) end)
				if not sent then failedResult, failedMsg = "Error", tostring(err) end
				local t0 = os.clock()
				while not failedResult and os.clock() - t0 < 12 do task.wait(0.25) end
				conn:Disconnect()
				if failedResult then
					local name = typeof(failedResult) == "EnumItem" and failedResult.Name or tostring(failedResult)
					if UNAVAILABLE[name] then return "unavailable", name end
					return "retry", name .. " " .. tostring(failedMsg or "")
				end
				-- no error: the client is leaving. Still here after 40 s = the teleport got stuck
				local t1 = os.clock()
				while os.clock() - t1 < 40 do task.wait(0.5) end
				return "retry", "teleport stuck"
			end

			-- quiet servers, lowest ping first (1-2 players, widened step by step when there are none)
			local function pickFallback(skipId)
				local pool = {}
				for _, sv in ipairs(fetchServers("Asc", 3)) do
					if sv.id ~= skipId then pool[#pool + 1] = sv end
				end
				local function pingOf(sv) return (type(sv.ping) == "number" and sv.ping > 0) and sv.ping or 1e9 end
				for _, maxPlayers in ipairs({2, 3, 5, 99}) do
					local tier = {}
					for _, sv in ipairs(pool) do
						if sv.playing <= maxPlayers then tier[#tier + 1] = sv end
					end
					if #tier > 0 then
						table.sort(tier, function(a, b)
							if pingOf(a) ~= pingOf(b) then return pingOf(a) < pingOf(b) end
							return a.playing < b.playing
						end)
						if #tier > 1 then -- a little randomness so many reconnecting players do not all pick the same server
							local j = math.random(1, math.min(3, #tier))
							tier[1], tier[j] = tier[j], tier[1]
						end
						return tier
					end
				end
				return {}
			end

			local function runReconnect(message)
				local origPlace, origJob = game.PlaceId, game.JobId
				local partners = partnersNow()
				local info = {t = os.time(), jobId = origJob, placeId = origPlace, device = Storage.device}
				local short = trim(message):gsub("%s+", " ")
				rcStatus("Disconnected" .. (short ~= "" and (": " .. short:sub(1, 60)) or "") .. " - reconnecting...", true)
				pcall(Storage.set, "reconnect", info)
				local queued, why = queueReload(info)
				if not queued then rcNotify("Script will not restart after the rejoin: " .. tostring(why)) end
				task.wait(1)

				-- 1) the same server
				for attempt = 1, 3 do
					rcStatus("Rejoining the same server (" .. attempt .. "/3)...")
					local res, detail = tryJoin(origPlace, origJob)
					if res == "unavailable" then
						rcStatus("Original server not available (" .. tostring(detail) .. ")", true)
						break
					end
					task.wait(2 * attempt)
				end

				-- 2) friends: go where they are / wait for the leader of the group
				if #partners > 0 then
					local leaderId = LocalPlayer.UserId
					for _, p in ipairs(partners) do
						if p.apex and p.id < leaderId then leaderId = p.id end
					end
					local leader = leaderId == LocalPlayer.UserId
					local deadline = os.clock() + (leader and 0 or 45)
					repeat
						for _, p in ipairs(partners) do
							local placeId, instanceId = lookupServer(p.id)
							if placeId == origPlace and instanceId and instanceId ~= origJob then
								rcStatus("Joining your friend " .. tostring(p.name) .. "...", true)
								tryJoin(placeId, instanceId)
							end
						end
						if not leader and os.clock() < deadline then
							rcStatus("Waiting for your friend's server...")
							task.wait(2)
						end
					until leader or os.clock() >= deadline
				end

				-- 3) a quiet server with low ping
				for cycle = 1, 3 do
					rcStatus("Looking for a quiet server (" .. cycle .. "/3)...")
					local cands = pickFallback(origJob)
					if #cands == 0 then
						rcStatus("No server found (" .. tostring(lastFetchError) .. ")")
						task.wait(5)
					else
						for i = 1, math.min(6, #cands) do
							local sv = cands[i]
							rcStatus(("Joining a server with %d player(s)%s"):format(sv.playing, type(sv.ping) == "number" and (", ping " .. math.floor(sv.ping)) or ""), i == 1 and cycle == 1)
							local res = tryJoin(origPlace, sv.id)
							if res == "retry" then task.wait(1.5) end
						end
					end
				end
				rcStatus("Reconnect failed - use a Server Hop button", true)
				RC.busy = false
			end

			-- ---------- disconnect detection ----------
			local function onDisconnect(message)
				if not RC.enabled or RC.busy then return end
				message = tostring(message or "")
				if message:find("Rejoining...", 1, true) then return end -- the Rejoin button of this script
				if message:lower():find("banned", 1, true) then
					rcStatus("Not reconnecting: banned from this game")
					return
				end
				RC.busy = true -- the other detectors must not start a second run
				task.spawn(function()
					task.wait(2)
					if teleportingUntil > os.clock() then RC.busy = false return end -- a deliberate teleport (server hop / rejoin)
					runReconnect(message)
				end)
			end
			pcall(function()
				GuiService.ErrorMessageChanged:Connect(function()
					local msg = ""
					pcall(function() msg = GuiService:GetErrorMessage() end)
					if msg == "" then return end
					local okT, errType = pcall(function() return GuiService:GetErrorType() end)
					local name = okT and (tostring(errType):match("([%w_]+)$") or "") or ""
					if name:sub(1, 8) == "Teleport" or name:sub(1, 11) == "Placelaunch" then return end -- results of a teleport, handled there
					onDisconnect(msg)
				end)
			end)
			task.spawn(function()
				pcall(function()
					local overlay = CoreGui:WaitForChild("RobloxPromptGui", 15):WaitForChild("promptOverlay", 15)
					overlay.ChildAdded:Connect(function(child)
						if child.Name ~= "ErrorPrompt" then return end
						task.wait(0.3)
						local msg = ""
						pcall(function() msg = child.MessageArea.ErrorFrame.ErrorMessage.Text end)
						if msg:lower():find("teleport", 1, true) then return end
						onDisconnect(msg)
					end)
				end)
			end)

			FloatingUi.reconnect = {
				setEnabled = function(on) RC.enabled = on and true or false end,
				getStatus = function() return RC.status end,
				setStatusCallback = function(fn) RC.onStatus = fn end,
				test = function()
					if RC.busy then return end
					RC.busy = true
					task.spawn(runReconnect, "manual test")
				end,
			}
			end)()

			-- ---------- coin bag counter ----------
			-- The game's own bag number (a text label or a value object called "Coins" inside the CoinBags UI). Every
			-- increase is one real coin and feeds Coin Details. Several places are watched at once (a template in
			-- ReplicatedStorage never changes, the live copy in PlayerGui does) and only a number that really goes up
			-- counts, so a stale label can no longer switch the counting off.
			local BAG_PATH = {"Game", "CoinBags", "CoinBagContainerScript", "Coin", "CurrencyFrame", "Icon", "Coins"}
			local bagCands = {} -- [label / value object] = last value read (false = not read yet)
			local bagFindTime, lastBagIncrease = -10, -1000
			local function followPath(root)
				local node = root
				for _, name in ipairs(BAG_PATH) do
					node = node and node:FindFirstChild(name)
					if not node then return nil end
				end
				return node
			end
			local function findBagCandidates()
				local list, seen = {}, {}
				local function add(inst)
					if inst and not seen[inst] and (inst:IsA("ValueBase") or inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then
						seen[inst] = true
						list[#list + 1] = inst
					end
				end
				local pg = LocalPlayer:FindFirstChild("PlayerGui")
				local rs = game:GetService("ReplicatedStorage")
				add(followPath(pg and pg:FindFirstChild("MainGUI")))
				add(followPath(rs))
				do -- phone layout: MainGUI.Lobby.Dock.CoinBags.Container.<bag>.CurrencyFrame.Icon.Coins
					local node = pg and pg:FindFirstChild("MainGUI")
					for _, n in ipairs({"Lobby", "Dock", "CoinBags", "Container", "Coin", "CurrencyFrame", "Icon", "Coins"}) do
						node = node and node:FindFirstChild(n)
					end
					add(node)
				end
				-- other game versions: any "Coins" label / value inside a container called CoinBags
				for _, root in ipairs({pg, rs}) do
					if root then
						for _, d in ipairs(root:GetDescendants()) do
							if d.Name == "Coins" and #list < 8 and (d:IsA("TextLabel") or d:IsA("ValueBase")) then
								local anc = d.Parent
								while anc and anc ~= root do
									if anc.Name == "CoinBags" then add(d) break end
									anc = anc.Parent
								end
							end
						end
					end
				end
				return list
			end
			local function readBag(inst)
				if inst:IsA("ValueBase") then return tonumber(inst.Value) end
				if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
					local n = inst.Text:match("(%d+)")
					return n and tonumber(n) or nil
				end
				return nil
			end
			task.spawn(function()
				while ScreenGui.Parent do
					task.wait(0.15)
					pcall(function()
						local now = os.clock()
						for inst in pairs(bagCands) do
							if not inst.Parent then bagCands[inst] = nil end
						end
						-- look for the label again: quickly while none is known, otherwise every 10 s (the game rebuilds its UI)
						if now - bagFindTime >= (next(bagCands) and 10 or 2) then
							bagFindTime = now
							for _, inst in ipairs(findBagCandidates()) do
								if bagCands[inst] == nil then bagCands[inst] = readBag(inst) or false end
							end
						end
						local increase = 0
						for inst, last in pairs(bagCands) do
							local v = readBag(inst)
							if v then
								if last and v > last then increase = math.max(increase, v - last) end
								bagCands[inst] = v
							end
						end
						if increase > 0 then
							lastBagIncrease = now
							countFromBag(math.min(increase, 10))
						end
						-- "live" = the game's number went up recently; then guesses from the distance are not needed
						FloatingUi.bagLive = (now - lastBagIncrease) < 150
					end)
				end
			end)

			-- ---------- generic window (same look and behaviour as the Crosshair window) ----------
			local panelStack, panelState, panelRaise = {}, setmetatable({}, {__mode = "k"}), setmetatable({}, {__mode = "k"})
			local function makePanel(name, titleText, W, H, posY)
				local theme = cur()
				local repaints = {}
				local panel = mk("Frame", {
					Name = name, Position = UDim2.fromOffset(12, posY), Size = UDim2.fromOffset(W, H), BackgroundColor3 = theme.Primary,
					BorderSizePixel = 0, Active = true, Visible = false, ZIndex = -26,
				}, ScreenGui)
				themeBg(panel, "Primary")
				Instance.new("UICorner", panel).CornerRadius = UDim.new(0, math.floor(10 * scale))
				local stroke = mk("UIStroke", {Color = theme.Stroke, Thickness = 1}, panel)
				local headerH = math.floor(18 * scale)
				local dotSize = math.max(6, math.floor(8 * scale))
				local dot = mk("Frame", {
					Position = UDim2.fromOffset(PAD, PAD + math.floor((headerH - dotSize) / 2)), Size = UDim2.fromOffset(dotSize, dotSize),
					BackgroundColor3 = theme.ButtonOn, BorderSizePixel = 0, ZIndex = -25,
				}, panel)
				Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
				themeBg(dot, "ButtonOn")
				mk("TextLabel", {
					BackgroundTransparency = 1, Text = titleText, Position = UDim2.fromOffset(PAD + dotSize + math.floor(6 * scale), PAD),
					Size = UDim2.fromOffset(math.floor(150 * scale), headerH), TextSize = ts, TextColor3 = WHITE,
					Font = Enum.Font.GothamBold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = -24,
				}, panel)
				attachDrag(panel, panel)
				local top = PAD + headerH + GAP
				local divider = mk("Frame", {
					Position = UDim2.fromOffset(PAD, top), Size = UDim2.new(1, -2 * PAD, 0, 1), BackgroundColor3 = theme.Stroke,
					BackgroundTransparency = 0.55, BorderSizePixel = 0, ZIndex = -25,
				}, panel)
				themeBg(divider, "Stroke")
				top += 1 + GAP
				local scroll = mk("ScrollingFrame", {
					BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(PAD, top),
					Size = UDim2.new(1, -2 * PAD, 1, -(top + PAD + math.floor(14 * scale))), ZIndex = -25, ScrollBarThickness = 3,
					CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y,
				}, panel)
				mk("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, GAP)}, scroll)

				local minW, minH = math.floor(200 * scale), math.floor(160 * scale)
				local maxW, maxH = math.floor(520 * scale), math.floor(640 * scale)
				local handleSize = math.max(18, math.floor(20 * scale))
				local grip = mk("TextButton", {
					Name = "ResizeHandle", Text = "", AutoButtonColor = false, BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1),
					Position = UDim2.new(1, -2, 1, -2), Size = UDim2.fromOffset(handleSize, handleSize), ZIndex = -23,
				}, panel, true)
				for i, len in ipairs({0.72, 0.4}) do
					mk("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(math.floor(handleSize * len), 2),
						Position = UDim2.new(0.5 + i * 0.12, 0, 0.5 + i * 0.12, 0), Rotation = -45,
						BackgroundColor3 = Color3.fromRGB(190, 190, 190), BackgroundTransparency = 0.4, BorderSizePixel = 0, ZIndex = -23,
					}, grip)
				end
				local resizing, startMouse, startW, startH = false, nil, 0, 0
				grip.InputBegan:Connect(function(input)
					if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
					resizing, startMouse = true, input.Position
					startW, startH = panel.AbsoluteSize.X, panel.AbsoluteSize.Y
					local conn
					conn = input.Changed:Connect(function()
						if input.UserInputState == Enum.UserInputState.End then conn:Disconnect() resizing = false end
					end)
				end)
				UserInputService.InputChanged:Connect(function(input)
					if not resizing then return end
					if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
					local d = input.Position - startMouse
					local pos = panel.AbsolutePosition - ScreenGui.AbsolutePosition
					local vp = ScreenGui.AbsoluteSize
					local limW = math.min(maxW, math.floor(vp.X - pos.X - EDGE))
					local limH = math.min(maxH, math.floor(vp.Y - pos.Y - EDGE))
					panel.Size = UDim2.fromOffset(
						math.clamp(math.floor(startW + d.X), minW, math.max(minW, limW)),
						math.clamp(math.floor(startH + d.Y), minH, math.max(minH, limH)))
				end)
				ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
					if panel.Visible then clampToScreen(panel) end
				end)
				panel:GetPropertyChangedSignal("BackgroundColor3"):Connect(function() -- the theme changed
					stroke.Color = cur().Stroke
					for _, f in ipairs(repaints) do f() end
				end)

				-- LAYERING: Music Player and Keybinds used the same ZIndex band, so the one created last was always on top and
				-- the other could never be brought forward. Now the window you touch / open comes to the front: every window of
				-- this kind lives in its own band (10 ZIndex steps apart), and a raise shifts the panel and ALL its content by
				-- the same amount (so it works with Sibling and Global ZIndex behavior). Content added later (rows, buttons)
				-- gets the panel's current shift automatically.
				local state = {offset = 0}
				panelState[panel] = state
				local function shiftBy(delta)
					if delta == 0 then return end
					state.offset += delta
					panel.ZIndex += delta
					for _, d in ipairs(panel:GetDescendants()) do
						if d:IsA("GuiObject") then d.ZIndex += delta end
					end
				end
				panel.DescendantAdded:Connect(function(d)
					if d:IsA("GuiObject") and state.offset ~= 0 then d.ZIndex += state.offset end
				end)
				state.shiftTo = function(target) shiftBy(target - state.offset) end
				local function raise()
					if panelStack[1] == panel then return end
					local i = table.find(panelStack, panel)
					if i then table.remove(panelStack, i) end
					table.insert(panelStack, 1, panel)
					for k, p in ipairs(panelStack) do
						local st = panelState[p]
						if st and p.Parent then st.shiftTo(-(k - 1) * 10) end
					end
				end
				panelRaise[panel] = raise
				panel.InputBegan:Connect(function(input)
					local t = input.UserInputType
					if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then raise() end
				end)
				raise() -- registers the panel (the newest one starts in front)
				return panel, scroll, repaints
			end

			local function newRow(scroll, height, order)
				local r = mk("Frame", {
					Size = UDim2.new(1, -math.floor(6 * scale), 0, height or rowH), BackgroundColor3 = cur().ButtonOff, BorderSizePixel = 0,
					ZIndex = -24, LayoutOrder = order or 0,
				}, scroll)
				themeBg(r, "ButtonOff")
				Instance.new("UICorner", r).CornerRadius = UDim.new(0, math.floor(6 * scale))
				return r
			end
			local function rowLabel(row, text, widthOffset)
				return mk("TextLabel", {
					BackgroundTransparency = 1, Text = text, Position = UDim2.new(0, math.floor(8 * scale), 0, 0),
					Size = UDim2.new(1, -(widthOffset or math.floor(16 * scale)), 1, 0), TextColor3 = Color3.fromRGB(235, 235, 235),
					TextSize = ts, Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = -23,
				}, row)
			end
			local function sectionTitle(scroll, text, order)
				mk("TextLabel", {
					BackgroundTransparency = 1, Text = text, Size = UDim2.new(1, -6, 0, tsSmall + 6), TextSize = tsSmall, TextColor3 = GRAY,
					Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = -24, LayoutOrder = order,
				}, scroll)
			end
			local function switchRow(scroll, repaints, text, order, get, set)
				local row = newRow(scroll, rowH, order)
				local trackH = math.max(14, math.floor(18 * scale))
				local trackW = math.floor(trackH * 1.9)
				local knobS = trackH - 4
				rowLabel(row, text, trackW + math.floor(24 * scale))
				local track = mk("Frame", {
					Size = UDim2.fromOffset(trackW, trackH), Position = UDim2.new(1, -(trackW + math.floor(8 * scale)), 0.5, -math.floor(trackH / 2)),
					BorderSizePixel = 0, ZIndex = -23,
				}, row)
				Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
				local knob = mk("Frame", {Size = UDim2.fromOffset(knobS, knobS), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = -22}, track)
				Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
				local painted = false
				local function paint()
					local on = get()
					local color = on and cur().ButtonOn or TRACK_OFF
					local pos = on and UDim2.new(1, -(knobS + 2), 0.5, -math.floor(knobS / 2)) or UDim2.new(0, 2, 0.5, -math.floor(knobS / 2))
					if painted then -- same smooth slide as the switches of the main window
						local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
						TweenService:Create(track, info, {BackgroundColor3 = color}):Play()
						TweenService:Create(knob, info, {Position = pos}):Play()
					else
						painted = true
						track.BackgroundColor3 = color
						knob.Position = pos
					end
				end
				paint()
				repaints[#repaints + 1] = paint
				local hit = mk("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = -21}, row, true)
				hit.MouseButton1Click:Connect(function() set(not get()) paint() end)
			end
			local function actionRow(scroll, text, order, onClick)
				local row = newRow(scroll, rowH, order)
				local b = mk("TextButton", {
					Text = text, AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), TextColor3 = WHITE,
					TextSize = ts, Font = Enum.Font.GothamMedium, ZIndex = -23,
				}, row)
				b.MouseButton1Click:Connect(onClick)
				return b
			end

			-- ---------- keybinds window ----------
			local keyPanel, keyScroll, keyRepaints = makePanel("KeybindsPanel", "KEYBINDS", math.floor(270 * scale), math.floor(340 * scale), 190)
			local capturing = nil
			local captureConn = nil
			local ACTIONS = {
				{"act:Server Hop", "> Server Hop", function() serverHop("random") end},
				{"act:Best Hop Random", "> Best Connection (Random)", function() serverHop("best_random") end},
				{"act:Best Hop Fewest", "> Best Connection (Fewest)", function() serverHop("best_fewest") end},
				{"act:Best Hop Most", "> Best Connection (Most)", function() serverHop("best_most") end},
				{"act:Respawn", "> Respawn", function()
					local h = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
					if h then h.Health = 0 end
				end},
			}
			local keyButtons = {}
			-- a device with no physical/virtual keyboard (most phones) cannot "press a key" to assign or trigger a
			-- bind, so on those devices a row is bound to the on-screen Quick Trigger bar instead (value "Touch").
			local function noKeyboard() return UserInputService.TouchEnabled and (not UserInputService.KeyboardEnabled or not UserInputService.MouseEnabled) end
			local function keyText(id)
				local k = E.keys[id]
				if k == "Touch" then return "On screen" end
				return k or "None"
			end
			local function labelFor(id)
				for _, a in ipairs(ACTIONS) do
					if a[1] == id then return a[2]:gsub("^>%s*", "") end
				end
				return id
			end
			local function fireBinding(id)
				local d = registeredToggles[id]
				if d then
					setToggleState(id, not d.state)
				else
					for _, a in ipairs(ACTIONS) do
						if a[1] == id then pcall(a[3]) end
					end
				end
			end

			-- ---------- on-screen buttons: one per row bound to "Touch" (phones have no keyboard) ----------
			-- Tap = switch the function on / off (or run it). Drag = move it. The button is lit while the function is on,
			-- stays where you put it (saved) and is drawn below the main window. They work whether or not the Keybinds
			-- window is open.
			local screenBtns = {}
			local function addScreenBtn(id)
				if screenBtns[id] then return end
				local label = labelFor(id)
				local n = 0
				for _ in pairs(screenBtns) do n += 1 end
				local pos = E.screen[id] or {x = 12, y = 110 + n * math.floor(38 * scale)}
				local w = math.floor(math.max(78, #label * 6.8 + 24) * scale)
				local b = mk("TextButton", {
					Name = "ApexScreenButton", Text = label, AutoButtonColor = false, Active = true, BorderSizePixel = 0,
					BackgroundColor3 = cur().ButtonOff, BackgroundTransparency = 0.08, Size = UDim2.fromOffset(w, math.floor(32 * scale)),
					Position = UDim2.fromOffset(pos.x, pos.y), TextColor3 = WHITE, TextSize = tsSmall + 1, TextWrapped = true,
					Font = Enum.Font.GothamBold, ZIndex = -3, -- below the main window, above the floating panels
				}, ScreenGui, true)
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, math.floor(8 * scale))
				mk("UIStroke", {Color = cur().Stroke, Thickness = 1.5}, b)
				attachDrag(b, b, function() fireBinding(id) end) -- a tap (no movement) fires it, dragging moves it
				screenBtns[id] = b
				E.screen[id] = {x = pos.x, y = pos.y}
				saveE()
			end
			local function removeScreenBtn(id)
				local b = screenBtns[id]
				if b then b:Destroy() end
				screenBtns[id] = nil
				E.screen[id] = nil
				saveE()
			end
			local function refreshQuickBar() -- creates / removes the buttons so they match the "Touch" bindings
				for id in pairs(screenBtns) do
					if E.keys[id] ~= "Touch" then removeScreenBtn(id) end
				end
				for id, k in pairs(E.keys) do
					if k == "Touch" then addScreenBtn(id) end
				end
			end
			task.spawn(function()
				while ScreenGui.Parent do
					task.wait(0.25)
					pcall(function()
						local t = cur()
						for id, b in pairs(screenBtns) do
							local d = registeredToggles[id]
							b.BackgroundColor3 = (d and d.state) and t.ButtonOn or t.ButtonOff
							if b.AbsoluteSize.X > 0 then clampToScreen(b) end
							local p = b.AbsolutePosition - ScreenGui.AbsolutePosition
							local s = E.screen[id]
							if s and (math.abs(s.x - p.X) >= 1 or math.abs(s.y - p.Y) >= 1) then
								E.screen[id] = {x = math.floor(p.X), y = math.floor(p.Y)}
								saveE()
							end
						end
					end)
				end
			end)
			FloatingUi.refreshQuickTriggers = refreshQuickBar
			refreshQuickBar() -- in case bindings were already saved from a previous session

			local function buildKeys()
				for _, c in ipairs(keyScroll:GetChildren()) do
					if not c:IsA("UIListLayout") then c:Destroy() end
				end
				keyButtons = {}
				sectionTitle(keyScroll, noKeyboard()
					and "Tap a row to put a button for it on the screen (tap again or press X to remove it). Tap that button to switch the function, drag it to move it."
					or "Click a row, then press a key. X (or Backspace) clears it, a second tap or Esc cancels. Avoid movement keys (W A S D, Space).", 0)
				local clearAllRow = newRow(keyScroll, rowH, 0)
				local clearAllBtn = mk("TextButton", {
					Text = "Clear all keybinds", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(150, 55, 55), BorderSizePixel = 0,
					AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(1, -math.floor(12 * scale), 0, math.floor(22 * scale)),
					TextColor3 = WHITE, TextSize = tsSmall + 1, Font = Enum.Font.GothamBold, ZIndex = -23,
				}, clearAllRow, true)
				Instance.new("UICorner", clearAllBtn).CornerRadius = UDim.new(0, math.floor(5 * scale))
				clearAllBtn.MouseButton1Click:Connect(function()
					if captureConn then captureConn:Disconnect() captureConn = nil end
					capturing = nil
					for id in pairs(E.keys) do E.keys[id] = nil end
					saveE()
					refreshQuickBar()
					buildKeys()
				end)
				local entries = {}
				for name in pairs(registeredToggles) do
					if name ~= "Show Welcome Screen" then entries[#entries + 1] = {name, name} end
				end
				table.sort(entries, function(a, b) return a[1] < b[1] end)
				for _, a in ipairs(ACTIONS) do table.insert(entries, 1, {a[1], a[2]}) end
				for i, entry in ipairs(entries) do
					local id, label = entry[1], entry[2]
					local row = newRow(keyScroll, rowH, i)
					rowLabel(row, label, math.floor(110 * scale))
					local b = mk("TextButton", {
						Text = keyText(id), AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(55, 55, 68), BorderSizePixel = 0,
						AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -math.floor(6 * scale), 0.5, 0),
						Size = UDim2.fromOffset(math.floor(92 * scale), math.floor(22 * scale)), TextColor3 = WHITE, TextSize = tsSmall + 1,
						Font = Enum.Font.GothamBold, ZIndex = -23,
					}, row, true)
					Instance.new("UICorner", b).CornerRadius = UDim.new(0, math.floor(5 * scale))
					keyButtons[id] = b
					local clearBtn = mk("TextButton", {
						Text = "X", AutoButtonColor = false, BackgroundColor3 = Color3.fromRGB(150, 55, 55), BorderSizePixel = 0,
						AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -math.floor(102 * scale), 0.5, 0),
						Size = UDim2.fromOffset(math.max(22, math.floor(22 * scale)), math.floor(22 * scale)), TextColor3 = WHITE, TextSize = tsSmall + 1,
						Font = Enum.Font.GothamBold, ZIndex = -23, Visible = E.keys[id] ~= nil,
					}, row, true)
					Instance.new("UICorner", clearBtn).CornerRadius = UDim.new(0, math.floor(5 * scale))
					b:GetPropertyChangedSignal("Text"):Connect(function() clearBtn.Visible = E.keys[id] ~= nil end)
					clearBtn.MouseButton1Click:Connect(function() -- works on every device, also while this row waits for a key
						if capturing == id and captureConn then captureConn:Disconnect() captureConn = nil end
						if capturing == id then capturing = nil end
						E.keys[id] = nil
						b.Text = keyText(id)
						clearBtn.Visible = false
						saveE()
						refreshQuickBar()
					end)
					b.MouseButton1Click:Connect(function()
						if noKeyboard() then
							-- no physical/virtual keyboard: bind straight to the Quick Trigger bar (tap again to clear)
							E.keys[id] = (E.keys[id] == "Touch") and nil or "Touch"
							b.Text = keyText(id)
							saveE()
							refreshQuickBar()
							return
						end

						-- a second tap on the row that waits for a key cancels the wait (a touch screen cannot press Esc / Backspace)
						if capturing == id then
							if captureConn then captureConn:Disconnect() captureConn = nil end
							capturing = nil
							b.Text = keyText(id)
							return
						end
						if capturing then -- another row was waiting: stop that one first
							if captureConn then captureConn:Disconnect() captureConn = nil end
							local prev = keyButtons[capturing]
							if prev then prev.Text = keyText(capturing) end
							capturing = nil
						end

						capturing = id
						b.Text = "Press a key..."
						captureConn = UserInputService.InputBegan:Connect(function(input)
							if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
							if captureConn then captureConn:Disconnect() captureConn = nil end
							local key = input.KeyCode.Name
							if input.KeyCode == Enum.KeyCode.Escape then
								-- cancelled
							elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
								E.keys[id] = nil
							else
								for other, k in pairs(E.keys) do -- one physical key, one function (Touch bindings are independent)
									if k == key and other ~= id then
										E.keys[other] = nil
										if keyButtons[other] then keyButtons[other].Text = "None" end
									end
								end
								E.keys[id] = key
							end
							b.Text = keyText(id)
							saveE()
							refreshQuickBar()
							task.delay(0.2, function() if capturing == id then capturing = nil end end)
						end)
					end)
				end
			end
			UserInputService.InputBegan:Connect(function(input, processed)
				if processed or capturing or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
				local key = input.KeyCode.Name
				for id, k in pairs(E.keys) do
					if k == key then fireBinding(id) end
				end
			end)

			local function openPanel(panel, state)
				panel.Visible = state and true or false
				if state then
					clampToScreen(panel)
					local r = panelRaise[panel]
					if r then r() end -- the window you just opened comes to the front
				end
			end
			FloatingUi.setKeybinds = function(state)
				if state then buildKeys() end -- rebuilt on every open, so it always lists every toggle
				openPanel(keyPanel, state)
			end

			;(function()
				-- ---------- MUSIC PLAYER ----------
				-- Search by name (Roblox audio library) or paste an asset ID / rbxassetid:// / library link. Plays only for you.
				local MarketplaceService = game:GetService("MarketplaceService")
				local UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"

				-- sound settings (saved)
				local S = {volume = 1, speed = 1, pitch = 1, bass = 0, mid = 0, treble = 0, reverb = false, echo = false, loop = false, autoNext = true}
				pcall(function()
					local d = Storage.get("music")
					if type(d) ~= "table" then return end
					for k, v in pairs(S) do
						if type(d[k]) == type(v) then S[k] = d[k] end
					end
				end)
				local saveTok = 0
				local function saveS()
					saveTok += 1
					local my = saveTok
					task.delay(0.8, function()
						if my == saveTok then pcall(Storage.set, "music", S) end
					end)
				end

				-- the sound itself (local, in SoundService) + effects
				for _, old in ipairs(SoundService:GetChildren()) do
					if old.Name == "ApexMusic" then old:Destroy() end
				end
				local sound = Instance.new("Sound")
				sound.Name = "ApexMusic"
				sound:SetAttribute("ApexIgnoreGameVolume", true) -- the Game Volume slider must not touch the music
				sound.Volume = S.volume
				sound.PlaybackSpeed = S.speed
				sound.Looped = S.loop
				sound.Parent = SoundService
				local eq = Instance.new("EqualizerSoundEffect")
				eq.LowGain, eq.MidGain, eq.HighGain = S.bass, S.mid, S.treble
				eq.Parent = sound
				local pitchFx = Instance.new("PitchShiftSoundEffect")
				pitchFx.Octave = S.pitch
				pitchFx.Parent = sound
				local reverbFx = Instance.new("ReverbSoundEffect")
				reverbFx.Enabled = S.reverb
				reverbFx.Parent = sound
				local echoFx = Instance.new("EchoSoundEffect")
				echoFx.Enabled = S.echo
				echoFx.Parent = sound
				ScreenGui.AncestryChanged:Connect(function()
					if not ScreenGui.Parent then pcall(function() sound:Destroy() end) end
				end)

				local function fmtTime(t)
					t = math.max(0, math.floor((t or 0) + 0.5))
					return string.format("%d:%02d", math.floor(t / 60), t % 60)
				end

				-- ---------- window ----------
				local panel, scroll, repaints = makePanel("MusicPanel", "MUSIC PLAYER", math.floor(290 * scale), math.floor(440 * scale), 60)
				local TEXT = Color3.fromRGB(235, 235, 235)
				local BAD = Color3.fromRGB(235, 110, 110)

				sectionTitle(scroll, "Search a song name, or paste an asset ID", 1)
				local searchFrame = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -math.floor(6 * scale), 0, rowH), LayoutOrder = 2, ZIndex = -24}, scroll)
				local goW = math.max(40, math.floor(44 * scale))
				local box = mk("TextBox", {
					Text = "", PlaceholderText = "Song name or asset ID...", PlaceholderColor3 = GRAY, ClearTextOnFocus = false,
					BackgroundColor3 = cur().ButtonOff, BorderSizePixel = 0, TextColor3 = WHITE, TextSize = ts, Font = Enum.Font.GothamMedium,
					TextXAlignment = Enum.TextXAlignment.Left, ClipsDescendants = true, ZIndex = -23,
					Size = UDim2.new(1, -(goW + GAP), 1, 0),
				}, searchFrame, true)
				themeBg(box, "ButtonOff")
				Instance.new("UICorner", box).CornerRadius = UDim.new(0, math.floor(6 * scale))
				mk("UIPadding", {PaddingLeft = UDim.new(0, math.floor(8 * scale)), PaddingRight = UDim.new(0, math.floor(8 * scale))}, box)
				local goBtn = mk("TextButton", {
					Text = "Go", AutoButtonColor = false, BackgroundColor3 = cur().ButtonOn, BorderSizePixel = 0, TextColor3 = WHITE,
					TextSize = ts, Font = Enum.Font.GothamBold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0),
					Size = UDim2.new(0, goW, 1, 0), ZIndex = -23,
				}, searchFrame, true)
				themeBg(goBtn, "ButtonOn")
				Instance.new("UICorner", goBtn).CornerRadius = UDim.new(0, math.floor(6 * scale))

				local statusLbl = mk("TextLabel", {
					BackgroundTransparency = 1, Text = "Type a song name or paste an asset ID.", Size = UDim2.new(1, -6, 0, tsSmall + 6),
					AutomaticSize = Enum.AutomaticSize.Y, TextSize = tsSmall, TextColor3 = GRAY, Font = Enum.Font.GothamMedium,
					TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, ZIndex = -24, LayoutOrder = 3,
				}, scroll, true)
				local function setStatus(text, bad)
					statusLbl.Text = text
					statusLbl.TextColor3 = bad and BAD or GRAY
				end

				-- now playing
				local nowRow = newRow(scroll, math.floor(44 * scale), 4)
				local nowTitle = mk("TextLabel", {
					BackgroundTransparency = 1, Text = "Nothing playing", Position = UDim2.new(0, math.floor(8 * scale), 0, math.floor(5 * scale)),
					Size = UDim2.new(1, -math.floor(16 * scale), 0, ts + 2), TextColor3 = WHITE, TextSize = ts, Font = Enum.Font.GothamBold,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = -23,
				}, nowRow, true)
				local nowSub = mk("TextLabel", {
					BackgroundTransparency = 1, Text = "", Position = UDim2.new(0, math.floor(8 * scale), 0, math.floor(5 * scale) + ts + 4),
					Size = UDim2.new(1, -math.floor(16 * scale), 0, tsSmall + 2), TextColor3 = GRAY, TextSize = tsSmall, Font = Enum.Font.GothamMedium,
					TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = -23,
				}, nowRow, true)

				-- numbers typed into the boxes: "150", "150%", "1.5x", "-3 dB", "1:30" are all understood
				local function numFrom(text)
					local n = tostring(text):match("[-+]?%d*%.?%d+")
					return n and tonumber(n) or nil
				end
				local function pctParse(text)
					local n = numFrom(text)
					return n and n / 100 or nil
				end
				local function timeParse(text)
					local m, s = tostring(text):match("^%s*(%d+):(%d+)")
					if m then return tonumber(m) * 60 + tonumber(s) end
					return numFrom(text)
				end

				-- slider (drag with the mouse or a finger, or type the number into the box on the right);
				-- onRelease is called when the finger / mouse is lifted or a typed number is confirmed
				local function sliderRow(order, labelText, minV, maxV, value, fmt, onChange, onRelease, opts)
					opts = opts or {}
					local row = newRow(scroll, math.floor(40 * scale), order)
					local api = {dragging = false}
					mk("TextLabel", {
						BackgroundTransparency = 1, Text = labelText, Position = UDim2.new(0, math.floor(8 * scale), 0, math.floor(3 * scale)),
						Size = UDim2.new(0.5, 0, 0, ts + 2), TextSize = tsSmall + 1, TextColor3 = TEXT, Font = Enum.Font.GothamMedium,
						TextXAlignment = Enum.TextXAlignment.Left, ZIndex = -23,
					}, row)
					local valLbl = mk("TextBox", {
						BackgroundColor3 = cur().Primary, Text = "", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -math.floor(6 * scale), 0, math.floor(2 * scale)),
						Size = UDim2.new(0, math.max(56, math.floor(74 * scale)), 0, ts + 6), TextSize = tsSmall + 1, TextColor3 = WHITE, Font = Enum.Font.GothamMedium,
						TextXAlignment = Enum.TextXAlignment.Center, ClearTextOnFocus = true, BorderSizePixel = 0, ZIndex = -22,
					}, row, true)
					themeBg(valLbl, "Primary")
					Instance.new("UICorner", valLbl).CornerRadius = UDim.new(0, math.floor(5 * scale))
					local trackH = math.max(5, math.floor(6 * scale))
					local sidePad = math.floor(10 * scale)
					local track = mk("Frame", {
						Position = UDim2.new(0, sidePad, 1, -(trackH + math.floor(8 * scale))), Size = UDim2.new(1, -2 * sidePad, 0, trackH),
						BackgroundColor3 = TRACK_OFF, BorderSizePixel = 0, ZIndex = -23,
					}, row)
					Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
					local fill = mk("Frame", {Size = UDim2.fromScale(0, 1), BackgroundColor3 = cur().ButtonOn, BorderSizePixel = 0, ZIndex = -22}, track)
					Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
					themeBg(fill, "ButtonOn")
					local knobS = math.max(12, math.floor(14 * scale))
					local knob = mk("Frame", {
						AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(knobS, knobS),
						BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = -21,
					}, track)
					Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
					local function show()
						local f = maxV > minV and math.clamp((value - minV) / (maxV - minV), 0, 1) or 0
						fill.Size = UDim2.fromScale(f, 1)
						knob.Position = UDim2.new(f, 0, 0.5, 0)
						if not valLbl:IsFocused() then valLbl.Text = fmt(value) end
					end
					function api.set(v)
						if api.dragging then return end
						value = math.clamp(v, minV, maxV)
						show()
					end
					function api.setMax(m)
						maxV = math.max(m, minV + 0.001)
						show()
					end
					local function fromX(x)
						local w = track.AbsoluteSize.X
						if w < 1 then return end
						local f = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
						value = minV + f * (maxV - minV)
						show()
						if onChange then onChange(value) end
					end
					local hit = mk("TextButton", {Text = "", BackgroundTransparency = 1, Position = UDim2.fromScale(0, 0.42), Size = UDim2.fromScale(1, 0.58), ZIndex = -20}, row, true)
					hit.InputBegan:Connect(function(input)
						if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
						api.dragging = true
						scroll.ScrollingEnabled = false -- the window must not scroll while the slider is dragged
						fromX(input.Position.X)
						local conn
						conn = input.Changed:Connect(function()
							if input.UserInputState == Enum.UserInputState.End then
								conn:Disconnect()
								api.dragging = false
								scroll.ScrollingEnabled = true
								if onRelease then onRelease(value) end
							end
						end)
					end)
					UserInputService.InputChanged:Connect(function(input)
						if not api.dragging then return end
						if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
						fromX(input.Position.X)
					end)
					valLbl.FocusLost:Connect(function()
						local n = (opts.parse or numFrom)(valLbl.Text)
						if n then
							value = math.clamp(n, opts.lo or minV, opts.hi or maxV)
							show()
							if onChange then onChange(value) end
							if onRelease then onRelease(value) end
						else
							show() -- not a number: back to the current value
						end
					end)
					show()
					return api
				end

				local seek = sliderRow(5, "Position", 0, 1, 0,
					function(v) return fmtTime(v) end,
					nil,
					function(v) if sound.TimeLength > 0 then sound.TimePosition = math.clamp(v, 0, sound.TimeLength) end end,
					{parse = timeParse, lo = 0, hi = 100000})

				-- playlist (the last search result)
				local playlist, current, playToken = {}, 0, 0
				local resultsHolder = mk("Frame", {
					BackgroundTransparency = 1, Size = UDim2.new(1, -math.floor(6 * scale), 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = 8, ZIndex = -24,
				}, scroll)
				mk("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, GAP)}, resultsHolder)
				local resultRows = {}
				local function paintRows()
					for i, r in ipairs(resultRows) do
						local on = (i == current)
						r.label.TextColor3 = on and cur().ButtonOn or TEXT
						r.stroke.Color = cur().ButtonOn
						r.stroke.Transparency = on and 0 or 1
					end
				end
				repaints[#repaints + 1] = paintRows

				local playTrack
				local function buildResults()
					for _, r in ipairs(resultRows) do r.row:Destroy() end
					table.clear(resultRows)
					for i, item in ipairs(playlist) do
						local row = newRow(resultsHolder, rowH, i)
						local text = item.name
						if item.artist and item.artist ~= "" then text = text .. " - " .. item.artist end
						if item.dur and item.dur > 0 then text = text .. "  (" .. fmtTime(item.dur) .. ")" end
						local label = mk("TextLabel", {
							BackgroundTransparency = 1, Text = text, Position = UDim2.new(0, math.floor(8 * scale), 0, 0),
							Size = UDim2.new(1, -math.floor(16 * scale), 1, 0), TextColor3 = TEXT, TextSize = ts, Font = Enum.Font.GothamMedium,
							TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = -23,
						}, row, true)
						local stroke = mk("UIStroke", {Color = cur().ButtonOn, Thickness = 1.5, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, row)
						local hit = mk("TextButton", {Text = "", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = -21}, row, true)
						hit.MouseButton1Click:Connect(function() playTrack(i) end)
						resultRows[i] = {row = row, label = label, stroke = stroke}
					end
					paintRows()
				end

				-- chain = true when this was started by "play the next one" (an unplayable song is skipped then)
				playTrack = function(index, chain)
					local item = playlist[index]
					if not item then return end
					playToken += 1
					local my = playToken
					current = index
					paintRows()
					nowTitle.Text = item.name
					nowSub.Text = (item.artist and item.artist ~= "" and (item.artist .. "  |  ") or "") .. "ID " .. item.id
					setStatus("Loading...")
					sound:Stop()
					sound.SoundId = "rbxassetid://" .. item.id
					sound.TimePosition = 0
					sound:Play()
					local t0 = os.clock()
					while my == playToken and not sound.IsLoaded and os.clock() - t0 < 8 do task.wait(0.1) end
					if my ~= playToken then return end
					if not sound.IsLoaded or sound.TimeLength <= 0 then
						sound:Stop()
						setStatus("This one can't be played (private, removed or not allowed in this game). Try another.", true)
						if chain and index < #playlist then playTrack(index + 1, true) end
						return
					end
					setStatus("Playing  |  length " .. fmtTime(sound.TimeLength))
					seek.set(0)
					seek.setMax(sound.TimeLength)
				end

				sound.Ended:Connect(function()
					if S.autoNext and not S.loop and current > 0 and current < #playlist then playTrack(current + 1, true) end
				end)

				-- controls
				local controls = mk("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, -math.floor(6 * scale), 0, rowH), LayoutOrder = 6, ZIndex = -24}, scroll)
				mk("UIListLayout", {FillDirection = Enum.FillDirection.Horizontal, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, GAP)}, controls)
				local function ctrlBtn(order, text)
					local b = mk("TextButton", {
						Text = text, AutoButtonColor = false, BackgroundColor3 = cur().ButtonOff, BorderSizePixel = 0, TextColor3 = WHITE,
						TextSize = ts, Font = Enum.Font.GothamBold, Size = UDim2.new(0.25, -math.ceil(GAP * 3 / 4), 1, 0), LayoutOrder = order, ZIndex = -23,
					}, controls, true)
					themeBg(b, "ButtonOff")
					Instance.new("UICorner", b).CornerRadius = UDim.new(0, math.floor(6 * scale))
					return b
				end
				local prevBtn, playBtn, stopBtn, nextBtn = ctrlBtn(1, "<<"), ctrlBtn(2, "Play"), ctrlBtn(3, "Stop"), ctrlBtn(4, ">>")
				local function step(dir)
					if #playlist == 0 then return end
					local i = current + dir
					if i < 1 then i = #playlist elseif i > #playlist then i = 1 end
					playTrack(i)
				end
				prevBtn.MouseButton1Click:Connect(function() step(-1) end)
				nextBtn.MouseButton1Click:Connect(function() step(1) end)
				playBtn.MouseButton1Click:Connect(function()
					if sound.IsPlaying then
						sound:Pause()
					elseif sound.IsPaused then
						sound:Resume()
					elseif current > 0 then
						playTrack(current)
					elseif #playlist > 0 then
						playTrack(1)
					end
				end)
				stopBtn.MouseButton1Click:Connect(function()
					playToken += 1
					sound:Stop()
					setStatus("Stopped")
				end)

				sectionTitle(scroll, "RESULTS", 7)

				-- ---------- searching ----------
				local function fetch(url)
					local req = httpFn()
					if req then
						local ok, res = pcall(req, {Url = url, Method = "GET", Headers = {["User-Agent"] = UA, ["Accept"] = "application/json"}})
						if ok and res then
							if type(res.Body) == "string" and (res.StatusCode == 200 or res.Success == true) then return res.Body end
							return nil, res.StatusCode
						end
						return nil
					end
					local ok, body = pcall(function() return game:HttpGet(url) end)
					if ok and type(body) == "string" then return body end
					return nil
				end
				local function decodeJson(body)
					local ok, d = pcall(function() return HttpService:JSONDecode(body) end)
					return ok and d or nil
				end

				local function parseAssetId(q)
					local t = q:gsub("^%s+", "")
					t = t:gsub("%s+$", "")
					local id = t:match("^rbxassetid://(%d+)$") or t:match("^rbxassetid:(%d+)$") or t:match("[?&]id=(%d+)")
						or t:match("/library/(%d+)") or t:match("/store/asset/(%d+)") or t:match("/asset/(%d+)")
					if not id then
						local n = t:match("^(%d+)$")
						if n and #n >= 5 then id = n end -- short numbers are searched like words
					end
					return id and tonumber(id) or nil
				end

				local function searchAudio(query)
					local kw = HttpService:UrlEncode(query)
					local ids, lastStatus = {}, nil
					local urls = {
						"https://apis.roblox.com/toolbox-service/v1/marketplace/3?limit=30&pageNumber=0&sortType=Relevance&keyword=" .. kw,
						"https://apis.roblox.com/toolbox-service/v1/marketplace/3?keyword=" .. kw,
					}
					for _, url in ipairs(urls) do
						local body, status = fetch(url)
						lastStatus = status or lastStatus
						local data = body and decodeJson(body)
						if type(data) == "table" and type(data.data) == "table" then
							for _, it in ipairs(data.data) do
								local id = tonumber(it.id) or (type(it.asset) == "table" and tonumber(it.asset.id)) or nil
								if id then ids[#ids + 1] = id end
								if #ids >= 30 then break end
							end
							if #ids > 0 then break end
							lastStatus = 200
						end
					end
					if #ids == 0 then return (lastStatus == 200) and {} or nil, lastStatus end
					local info = {}
					local body = fetch("https://apis.roblox.com/toolbox-service/v1/items/details?assetIds=" .. table.concat(ids, ","))
					local data = body and decodeJson(body)
					if type(data) == "table" and type(data.data) == "table" then
						for _, it in ipairs(data.data) do
							local a = type(it) == "table" and it.asset
							if type(a) == "table" then
								local ad = type(a.audioDetails) == "table" and a.audioDetails or {}
								local creator = type(it.creator) == "table" and it.creator.name or nil
								info[tonumber(a.id) or 0] = {
									name = (type(ad.title) == "string" and ad.title ~= "") and ad.title or a.name,
									artist = (type(ad.artist) == "string" and ad.artist ~= "") and ad.artist or creator,
									dur = tonumber(ad.durationSeconds) or tonumber(a.duration),
								}
							end
						end
					end
					local list = {}
					for _, id in ipairs(ids) do
						local i = info[id]
						list[#list + 1] = {id = id, name = (i and i.name) or ("Audio " .. id), artist = i and i.artist, dur = i and i.dur}
					end
					return list
				end

				local searchToken = 0
				local function doSearch()
					local q = box.Text:gsub("^%s+", "")
					q = q:gsub("%s+$", "")
					if q == "" then
						setStatus("Type a song name or paste an asset ID.")
						return
					end
					searchToken += 1
					local my = searchToken
					local id = parseAssetId(q)
					if id then
						setStatus("Loading asset " .. id .. "...")
						task.spawn(function()
							local name, artist = "Asset " .. id, nil
							local ok, info = pcall(function() return MarketplaceService:GetProductInfo(id, Enum.InfoType.Asset) end)
							if ok and type(info) == "table" then
								name = info.Name or name
								artist = type(info.Creator) == "table" and info.Creator.Name or nil
							end
							if my ~= searchToken then return end
							playlist = {{id = id, name = name, artist = artist}}
							current = 0
							buildResults()
							playTrack(1)
						end)
						return
					end
					setStatus("Searching...")
					task.spawn(function()
						local list, status = searchAudio(q)
						if my ~= searchToken then return end
						if not list then
							if status == 401 or status == 403 then
								setStatus("Roblox refused the search (a login is needed here). Paste an asset ID instead.", true)
							else
								setStatus("Search failed" .. (status and (" (HTTP " .. tostring(status) .. ")") or "") .. ". Paste an asset ID instead.", true)
							end
							return
						end
						playlist, current = list, 0
						buildResults()
						if #list == 0 then
							setStatus("Nothing found for \"" .. q .. "\".")
						else
							setStatus(#list .. " results - tap one to play. Some songs are private and can't play.")
						end
					end)
				end
				goBtn.MouseButton1Click:Connect(doSearch)
				box.FocusLost:Connect(function(enterPressed) if enterPressed then doSearch() end end)

				-- ---------- sound settings ----------
				sectionTitle(scroll, "SOUND SETTINGS", 9)
				local sliders = {}
				sliders.volume = sliderRow(10, "Volume", 0, 3, S.volume, function(v) return string.format("%d%%", math.floor(v * 100 + 0.5)) end,
					function(v) S.volume = v sound.Volume = v saveS() end, nil, {parse = pctParse, lo = 0, hi = 10})
				sliders.speed = sliderRow(11, "Speed", 0.25, 3, S.speed, function(v) return string.format("%.2fx", v) end,
					function(v) S.speed = v sound.PlaybackSpeed = v saveS() end, nil, {lo = 0.1, hi = 4})
				sliders.pitch = sliderRow(12, "Pitch (keeps the speed)", 0.5, 2, S.pitch, function(v) return string.format("%.2fx", v) end,
					function(v) S.pitch = v pitchFx.Octave = v saveS() end, nil, {lo = 0.5, hi = 2})
				sliders.bass = sliderRow(13, "Bass", -20, 10, S.bass, function(v) return string.format("%+d dB", math.floor(v + 0.5)) end,
					function(v) S.bass = v eq.LowGain = v saveS() end, nil, {lo = -80, hi = 10})
				sliders.mid = sliderRow(14, "Mid", -20, 10, S.mid, function(v) return string.format("%+d dB", math.floor(v + 0.5)) end,
					function(v) S.mid = v eq.MidGain = v saveS() end, nil, {lo = -80, hi = 10})
				sliders.treble = sliderRow(15, "Treble", -20, 10, S.treble, function(v) return string.format("%+d dB", math.floor(v + 0.5)) end,
					function(v) S.treble = v eq.HighGain = v saveS() end, nil, {lo = -80, hi = 10})

				switchRow(scroll, repaints, "Loop song", 16, function() return S.loop end, function(v) S.loop = v sound.Looped = v saveS() end)
				switchRow(scroll, repaints, "Play next automatically", 17, function() return S.autoNext end, function(v) S.autoNext = v saveS() end)
				switchRow(scroll, repaints, "Reverb", 18, function() return S.reverb end, function(v) S.reverb = v reverbFx.Enabled = v saveS() end)
				switchRow(scroll, repaints, "Echo", 19, function() return S.echo end, function(v) S.echo = v echoFx.Enabled = v saveS() end)
				actionRow(scroll, "Reset sound settings", 20, function()
					S.volume, S.speed, S.pitch, S.bass, S.mid, S.treble = 1, 1, 1, 0, 0, 0
					sound.Volume, sound.PlaybackSpeed, pitchFx.Octave = 1, 1, 1
					eq.LowGain, eq.MidGain, eq.HighGain = 0, 0, 0
					for name, api in pairs(sliders) do api.set(S[name]) end
					saveS()
				end)

				-- keeps the position bar and the Play / Pause text up to date while the window is open
				task.spawn(function()
					while ScreenGui.Parent do
						task.wait(0.25)
						if panel.Visible then
							local len = sound.TimeLength
							if len > 0 then
								seek.setMax(len)
								seek.set(sound.TimePosition)
							end
							playBtn.Text = sound.IsPlaying and "Pause" or "Play"
						end
					end
				end)

				FloatingUi.setMusic = function(state) openPanel(panel, state) end
			end)()
		end)()

		-- Settings for "done collecting" (changed from the UI):
		-- hide = stay under the map once the coins are gone
		-- respawn = respawn once the coins are done (resets your character)
		-- wait = seconds without coins before you count as done
		-- idleSince = when the current coin-less period started (nil while coins are being collected)
		doneSettings = {hide = false, wait = 6, idleSince = nil}
		local doneHiding = false -- under the map because collecting is done
		local getApexPlayers -- set by the APEX MEMBER block below
		local noCoinsSince = nil
		task.spawn(function()
			while true do
				task.wait() -- one frame (was 0.3s): no break between coins
				pcall(function()
					if gunGrabActive then -- the character is at the gun right now; do not react to that
						if autoCollectCoinsEnabled then setCollectStatus("Grabbing the gun") end
						return
					end
					local reason, restore
					if not autoCollectCoinsEnabled then
						reason, restore = "Off", true
					elseif isInLobby() then
						reason, restore = "Paused (in lobby)", false -- never move the character back to an old map spot
					elseif combatBusy() then
						reason, restore = "Paused (Kill All / Kill Murderer active)", true
					end
					if reason then
						setCollectStatus(reason)
						setMovementLocked(false)
						exitUnderMap(restore)
						noCoinsSince = nil
						doneSettings.idleSince = nil
						return
					end

					local char = LocalPlayer.Character
					local hrp = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if not (char and hrp and hum) then
						setCollectStatus("Waiting for your character")
						setMovementLocked(false)
						exitUnderMap(false)
						noCoinsSince = nil
						return
					end
					if hum.Health <= 0 then
						setCollectStatus("Dead - waiting for respawn")
						setMovementLocked(false)
						exitUnderMap(false)
						noCoinsSince = nil
						return
					end

					-- the game moved the character (round end, respawn point ...): leave it where the game put it
					if underMapActive and underMapExpected and (hrp.Position - underMapExpected).Magnitude > 25 then
						exitUnderMap(false)
					end
					-- the mode was switched off, or this is a new character
					if underMapActive and ((not underMapEnabled and not doneHiding) or hrp ~= underMapRoot) then
						exitUnderMap(hrp == underMapRoot)
					end

					local coins = getActiveCoins()
					if #coins == 0 then
						setCollectStatus("Waiting for coins")
						setMovementLocked(false)
						noCoinsSince = noCoinsSince or os.clock()
						doneSettings.idleSince = noCoinsSince
						local idle = os.clock() - noCoinsSince
						if doneSettings.hide and idle >= doneSettings.wait then
							-- done collecting: sink below the map and stay there so nobody can kill you
							if not underMapActive or not doneHiding then
								local result = enterUnderMap(hrp, hum, function()
									return not autoCollectCoinsEnabled or not doneSettings.hide or LocalPlayer.Character ~= char
									or hum.Health <= 0 or combatBusy() or isInLobby()
								end, true)
								if result ~= "arrived" then
									exitUnderMap(result ~= "moved")
									return
								end
								doneHiding = true
							end
							setCollectStatus("Done - hiding under the map")
						elseif underMapActive and not doneSettings.hide and not underMapEnabled and idle >= 3 then
							-- all coins collected: come back up on your own (Under Map Collect stays down)
							exitUnderMap(true)
						end
						task.wait() -- was 0.5s: react to new coins instantly
						return
					end
					noCoinsSince = nil
					doneSettings.idleSince = nil
					-- new coins showed up: come back up for them (under map collect mode simply keeps going)
					if doneHiding and not underMapEnabled then exitUnderMap(true) end
					doneHiding = false

					local targetCoin = pickCoin(coins, hrp.Position)
					if not (targetCoin and targetCoin.Parent) then
						task.wait()
						return
					end

					setMovementLocked(true) -- the player cannot steer the character while it collects
					ensureCollectHold()

					-- give the coin up when somebody else is going to reach it first (checked 4 times a second)
					local lastContestCheck = os.clock()
					local function contestedNow()
						if os.clock() - lastContestCheck < 0.25 then return false end
						lastContestCheck = os.clock()
						-- nearly there: finish this coin instead of giving it up (giving up right before the coin is what made
						-- the character hop only a few studs and then switch to another target)
						if (targetCoin.Position - hrp.Position).Magnitude < 12 then return false end
						return isContested(targetCoin, hrp.Position, 10)
					end
					local function stop()
						return not autoCollectCoinsEnabled or LocalPlayer.Character ~= char or hum.Health <= 0
						or combatBusy() or isInLobby() or not targetCoin.Parent or contestedNow()
					end
					local function stopUnder()
						return stop() or not underMapEnabled or not underMapActive
					end
					-- slight speed variation so the movement is less uniform
					local speed = collectSpeed

					if underMapEnabled then
						setCollectStatus("Collecting (under map)")
						if not underMapActive then
							local result = enterUnderMap(hrp, hum, stop)
							if result ~= "arrived" then
								exitUnderMap(result ~= "moved")
								return
							end
						end
						local coinPos = targetCoin.Position
						underMapSurface = coinPos
						local underPos = Vector3.new(coinPos.X, coinPos.Y - underMapDepth, coinPos.Z)
						-- for the short vertical moves only a real reason stops the character (another player being closer does not)
						local function stopHard()
							return not autoCollectCoinsEnabled or LocalPlayer.Character ~= char or hum.Health <= 0
							or combatBusy() or isInLobby() or not underMapEnabled or not underMapActive
						end
						local function collected() return not targetCoin.Parent or targetCoin.Transparency >= 1 end
						local function touchCoin()
							pcall(function()
								firetouchinterest(hrp, targetCoin, 0)
								firetouchinterest(hrp, targetCoin, 1)
							end)
						end
						local VERTICAL_SPEED = 80

						-- 1) glide to the spot right below the coin. The pose stays as it is: no turning around for every coin.
						local result = flyTo(hrp, underPos, speed, stopUnder)
						if result == "moved" then
							exitUnderMap(false)
							return
						end
						underMapExpected = hrp.Position

						if result == "arrived" then
							coinPending[targetCoin] = os.clock()
							local got = false

							-- 2) first try to take it from below, without coming up at all (this is the "stays under the map" case).
							-- When that keeps failing it is skipped for a minute and the character goes into the coin straight away.
							if os.clock() >= underFar.offUntil then
								local started = os.clock()
								while os.clock() - started < 0.25 do -- long enough for the coin to disappear with some ping
									if stopHard() then break end
									touchCoin()
									if collected() then got = true break end
									RunService.Heartbeat:Wait()
								end
								if got then
									underFar.misses = 0
								else
									underFar.misses += 1
									if underFar.misses >= 3 then
										underFar.misses = 0
										underFar.offUntil = os.clock() + 60
									end
								end
							end

							-- 3) not taken from below: slide straight up INTO the coin, touch it, and sink right back down
							if not got and not stopHard() then
								local up = flyTo(hrp, coinPos, VERTICAL_SPEED, stopHard)
								if up == "moved" then
									exitUnderMap(false)
									return
								end
								underMapExpected = hrp.Position
								if up == "arrived" then
									local rotation = hrp.CFrame.Rotation
									local started = os.clock()
									while os.clock() - started < coinUi.touch / 1000 do
										if stopHard() then break end
										hrp.CFrame = CFrame.new(coinPos) * rotation -- exactly on the coin, standing still
										hrp.AssemblyLinearVelocity = Vector3.zero
										touchCoin()
										if collected() then got = true break end
										RunService.Heartbeat:Wait()
									end
								end
								if underMapActive then
									flyTo(hrp, underPos, VERTICAL_SPEED, function()
										return LocalPlayer.Character ~= char or hum.Health <= 0
									end)
									underMapExpected = hrp.Position
								end
							end

							-- never go to the same coin twice in a row: it may need a moment to disappear (ping). The check runs in
							-- the background; a coin that really did not react is tried once more, then ignored for a while.
							coinSkip[targetCoin] = os.clock() + 1.5
							local checked = targetCoin
							task.delay(1.2, function()
								if checked.Parent and checked.Transparency < 1 and hum.Health > 0 then
									local tries = (underTries[checked] or 0) + 1
									if tries >= 2 then
										underTries[checked] = nil
										coinSkip[checked] = os.clock() + 10 -- decoy coin / bag full
									else
										underTries[checked] = tries
										coinSkip[checked] = os.clock() + 0.2
									end
								else
									underTries[checked] = nil
									coinSkip[checked] = nil
								end
							end)
						end
						if coinUi.pause > 0 then task.wait(coinUi.pause / 1000) end -- small break between coins
						return
					end

					-- normal mode: travel on the surface
					setCollectStatus("Collecting")
					if flyTo(hrp, targetCoin.Position, speed, stop) == "arrived" then
						coinPending[targetCoin] = os.clock()
						-- touch it explicitly, then check that the coin really reacted; if not (decoy coin, wrong spot)
						-- it is ignored for a while instead of hovering over it
						pcall(function()
							if firetouchinterest then
								firetouchinterest(hrp, targetCoin, 0)
								firetouchinterest(hrp, targetCoin, 1)
							end
						end)
						-- no waiting here: move on to the next coin right away. The coin is ignored for a moment so it is
						-- not picked twice, and the reaction check runs in the background.
						coinSkip[targetCoin] = os.clock() + 1.2
						local checked = targetCoin
						task.delay(1, function() -- 1 s: with some ping the coin needs a moment to disappear
							if checked.Parent and checked.Transparency < 1 and hum.Health > 0 then
								coinSkip[checked] = os.clock() + 10 -- did not react (decoy coin / wrong spot / bag full)
							else
								coinSkip[checked] = nil
							end
						end)
					end
					if coinUi.pause > 0 then task.wait(coinUi.pause / 1000) end -- small break between coins
				end)
			end
		end)

		-- MM2: Sheriff gun ESP & auto grab.
		-- Only the "GunDrop" that the sheriff leaves behind is targeted; random guns on maps are ignored.
		local gunHighlights = {}
		local gunBillboards = {}
		local grabbedGuns = {}
		local gunDrops = {}

		local function clearGunVisuals(obj)
			if gunHighlights[obj] then gunHighlights[obj]:Destroy(); gunHighlights[obj] = nil end
			if gunBillboards[obj] then gunBillboards[obj]:Destroy(); gunBillboards[obj] = nil end
		end

		local function considerGunDrop(obj)
			if obj.Name:lower() == "gundrop" and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Tool")) then
				gunDrops[obj] = true
			end
		end
		for _, obj in ipairs(workspace:GetDescendants()) do pcall(considerGunDrop, obj) end
		workspace.DescendantAdded:Connect(function(obj) pcall(considerGunDrop, obj) end)
		workspace.DescendantRemoving:Connect(function(obj)
			if gunDrops[obj] then
				gunDrops[obj] = nil
				grabbedGuns[obj] = nil
				clearGunVisuals(obj)
			end
		end)

		RunService.Stepped:Connect(function()
			pcall(function()
				for obj in pairs(gunDrops) do
					if not obj.Parent then
						gunDrops[obj] = nil
						grabbedGuns[obj] = nil
						clearGunVisuals(obj)
					else
						-- ignore a gun that a player already picked up
						local owned = false
						for _, player in ipairs(Players:GetPlayers()) do
							local backpack = player:FindFirstChildOfClass("Backpack")
							if (player.Character and obj:IsDescendantOf(player.Character)) or (backpack and obj:IsDescendantOf(backpack)) then
								owned = true
								break
							end
						end

						local targetPart = obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) or (obj:IsA("Tool") and obj:FindFirstChild("Handle")) or (obj:IsA("BasePart") and obj) or obj:FindFirstChildWhichIsA("BasePart")

						if owned or not targetPart then
							clearGunVisuals(obj)
						else
							if gunEspEnabled then
								if not gunHighlights[obj] then
									local hl = Instance.new("Highlight", obj)
									hl.FillColor = Color3.fromRGB(50, 150, 255)
									hl.OutlineColor = Color3.fromRGB(255, 255, 255)
									hl.FillTransparency = 0.3
									hl.OutlineTransparency = 0
									gunHighlights[obj] = hl

									local bg = Instance.new("BillboardGui", targetPart)
									bg.Size = UDim2.new(6, 0, 2, 0) -- Scale (studs), not Offset
									bg.StudsOffset = Vector3.new(0, 2.5, 0)
									bg.AlwaysOnTop = true

									local tl = Instance.new("TextLabel", bg)
									tl.Size = UDim2.new(1, 0, 1, 0)
									tl.BackgroundTransparency = 1
									tl.Text = "Sheriff Gun"
									tl.TextColor3 = Color3.fromRGB(50, 150, 255)
									tl.TextScaled = true
									tl.Font = Enum.Font.GothamBold
									tl.TextStrokeTransparency = 0.2
									gunBillboards[obj] = bg
								end
							else
								clearGunVisuals(obj)
							end

						end
					end
				end
			end)
		end)

		-- AUTO GRAB GUN (own loop, not part of the ESP loop)
		-- * never in the lobby (RegularLobby / Lobby)
		-- * teleports you to the gun INSTANTLY, touches it and puts you straight back where you were, as soon as the gun
		-- is yours (half a second at the latest). Auto Collect Coins does not stop for it: its movement just freezes
		-- for those few frames (gunGrabActive, see flyTo) and carries on afterwards, also under the map
		-- * no distance limit; up to 6 tries per gun (grabbedGuns[obj] counts them)
		do -- own scope: Lua / Luau allow at most 200 local variables per function
			local function gunTargetPart(obj)
				if obj:IsA("BasePart") then return obj end
				if obj:IsA("Model") then return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart") end
				if obj:IsA("Tool") then return obj:FindFirstChild("Handle") or obj:FindFirstChildWhichIsA("BasePart") end
				return obj:FindFirstChildWhichIsA("BasePart")
			end

			local function gunTaken(obj)
				if not obj.Parent then return true end
				for _, player in ipairs(Players:GetPlayers()) do
					local backpack = player:FindFirstChildOfClass("Backpack")
					if (player.Character and obj:IsDescendantOf(player.Character)) or (backpack and obj:IsDescendantOf(backpack)) then
						return true
					end
				end
				return false
			end

			local function grabGun(obj, part, char, root, hum)
				gunGrabActive = true
				pcall(function()
					if not part.Parent or gunTaken(obj) or hum.Health <= 0 or isInLobby() then return end
					local safePos = root.CFrame
					local held = 0
					while held < 0.5 and part.Parent and not gunTaken(obj) and hum.Health > 0 and char.Parent do
						root.CFrame = CFrame.new(part.Position + Vector3.new(0, 1, 0))
						root.AssemblyLinearVelocity = Vector3.zero
						pcall(function()
							firetouchinterest(root, part, 0)
							firetouchinterest(root, part, 1)
						end)
						held += task.wait()
					end
					if root.Parent and hum.Health > 0 then
						root.CFrame = safePos
						root.AssemblyLinearVelocity = Vector3.zero
					end
				end)
				gunGrabActive = false
			end

			task.spawn(function()
				local wasEnabled = false
				while true do
					task.wait(0.1)
					if autoGrabGunEnabled then
						if not wasEnabled then
							wasEnabled = true
							table.clear(grabbedGuns) -- switching it on again gives every gun fresh attempts
						end
						pcall(function()
							if isInLobby() then return end
							local char = LocalPlayer.Character
							local hum = char and char:FindFirstChildOfClass("Humanoid")
							local root = char and char:FindFirstChild("HumanoidRootPart")
							if not (hum and root) or hum.Health <= 0 then return end
							if getPlayerRole(LocalPlayer) == "Murderer" then return end -- the murderer never goes for the gun
							for obj in pairs(gunDrops) do
								local tries = grabbedGuns[obj] or 0
								if obj.Parent and tries < 6 and not gunTaken(obj) then
									local part = gunTargetPart(obj)
									if part then
										grabbedGuns[obj] = tries + 1
										grabGun(obj, part, char, root, hum)
										break -- one gun per cycle
									end
								end
							end
						end)
					else
						wasEnabled = false
					end
				end
			end)
		end

		-- EARLY ROLE DATA: ask the game for the role table about every 1.5 seconds while ESP / role labels are on
		do
			task.spawn(function()
				while true do
					task.wait(1.5)
					if isInLobby() then
						RoleInfo.data = nil -- last round's roles must not show up in the lobby or the next round
					elseif rolesEnabled or espEnabled then
						RoleInfo.refresh()
					end
				end
			end)
		end

		-- ANTI-FLING
		-- 1. velocity lock: huge linear / angular velocity on your character is reset every physics step
		-- 2. foreign movers (BodyVelocity, BodyThrust, VectorForce ...) that get attached to your root are removed
		-- 3. other players' body parts do not collide with you, so they cannot push or fling you
		local noCollided = setmetatable({}, {__mode = "k"})
		local FLING_MOVERS = {"BodyVelocity", "BodyAngularVelocity", "BodyForce", "BodyThrust", "BodyPosition",
			"BodyGyro", "RocketPropulsion", "LinearVelocity", "AngularVelocity", "VectorForce"}

		local function antiFlingStep(root)
			if root.AssemblyLinearVelocity.Magnitude > 250 or root.AssemblyAngularVelocity.Magnitude > 100 then
				root.AssemblyLinearVelocity = Vector3.zero
				root.AssemblyAngularVelocity = Vector3.zero
			end
			for _, child in ipairs(root:GetChildren()) do
				if child ~= bodyGyro and child ~= bodyVelocity and child.Name ~= "ApexUnderMapHold" then -- never remove our own movers
					for _, className in ipairs(FLING_MOVERS) do
						if child:IsA(className) then
							child:Destroy()
							break
						end
					end
				end
			end
		end

		function setAntiFling(state)
			antiFlingEnabled = state
			if not state then
				-- give other players their collision back
				for part in pairs(noCollided) do
					noCollided[part] = nil
					if part.Parent then pcall(function() part.CanCollide = true end) end
				end
			end
		end

		RunService.Stepped:Connect(function()
			if not antiFlingEnabled then return end
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer then
					local char = player.Character
					if char then
						for _, part in ipairs(char:GetChildren()) do
							if part:IsA("BasePart") and part.CanCollide then
								noCollided[part] = true
								part.CanCollide = false
							end
						end
					end
				end
			end
		end)

		-- ROLE AUTOMATION (only active while the "Role Automation" switch is on; off by default)
		-- Murderer -> "Kill All (As Murder)" switches on
		-- Sheriff -> "Kill Murder (As Sheriff)" + "1st Person Aimbot (As Sheriff)" switch on
		-- Round end -> everything that was switched on automatically switches off again
		local lastRoleState = "Innocent"
		autoApplied = {}
		local roleAutomationEnabled = false
		local function autoSwitch(name, on)
			local data = registeredToggles[name]
			if not data then return end
			if on then
				if not data.state then
					autoApplied[name] = true
					setToggleState(name, true)
				end
			elseif autoApplied[name] then
				autoApplied[name] = nil
				setToggleState(name, false)
			end
		end

		task.spawn(function()
			while true do
				task.wait(0.5)
				pcall(function()
					if not roleAutomationEnabled then
						lastRoleState = "Innocent" -- re-evaluate the current role as soon as it is switched on
						return
					end
					local role = getPlayerRole(LocalPlayer)
					if role ~= "Innocent" and not isRoundActive() then role = "Innocent" end
					if role == lastRoleState then return end
					lastRoleState = role
					autoSwitch("Kill All (As Murder)", role == "Murderer")
					autoSwitch("Kill Murder (As Sheriff)", role == "Sheriff")
					autoSwitch("1st Person Aimbot (As Sheriff)", role == "Sheriff")
				end)
			end
		end)

		function setRoleAutomation(state)
			roleAutomationEnabled = state
			if not state then
				-- switching the automation off also switches off everything it had turned on
				autoSwitch("Kill All (As Murder)", false)
				autoSwitch("Kill Murder (As Sheriff)", false)
				autoSwitch("1st Person Aimbot (As Sheriff)", false)
			end
		end

		-- APEX MEMBER TAG: shown above the head of every player who runs this script (and on yourself).
		--
		-- Detection (no chat needed): the script plays the two default R15 idle animations together. Animations
		-- played by a player replicate to everybody and the result looks like a normal standing pose. Another
		-- script user is recognised when BOTH idle animations are playing on a character for several checks in a
		-- row (the default animate script only overlaps them for a split second).
		-- Optional second channel: a hidden chat message (APEX_TAG_USE_CHAT, off by default).
		do
			local TextChatService = game:GetService("TextChatService")
			local ReplicatedStorage = game:GetService("ReplicatedStorage")
			local SIGNATURE = "\u{200B}\u{200C}\u{200D}\u{200B}\u{200D}\u{200C}"
			local SIG_A, SIG_B = "507766388", "507766666" -- default R15 idle 1 and idle 2
			local SIG_BUSY = "507770677" -- default R15 cheer emote: only played (at the lowest priority) while this user is still collecting coins
			local apexBusy = {} -- [player] = true while that APEX user is still collecting
			local busySeen = {} -- [player] = how many checks in a row the flag was visible (one is not enough)
			local apexPlayers = {}
			getApexPlayers = function() return apexPlayers end
			apexMemberCheck = function(player) return apexPlayers[player] == true end
			local tags = {}
			local seen, missing = {}, {}
			local lastAnnounce = -1000

			local function removeTag(p)
				if tags[p] then tags[p]:Destroy(); tags[p] = nil end
			end

			-- ---- channel 1: animation signature -------------------------------------------------
			local myAnimator, myTracks = nil, {}
			local function maintainSignature()
				local char = LocalPlayer.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local animator = hum and hum:FindFirstChildOfClass("Animator")
				if not animator then return end
				if animator ~= myAnimator then -- new character
					myAnimator = animator
					myTracks = {}
				end
				for _, id in ipairs({SIG_A, SIG_B}) do
					local track = myTracks[id]
					if not track then
						local anim = Instance.new("Animation")
						anim.AnimationId = "rbxassetid://" .. id
						track = animator:LoadAnimation(anim)
						track.Looped = true
						track.Priority = Enum.AnimationPriority.Core -- lowest priority: never overrides real animations
						myTracks[id] = track
					end
					if not track.IsPlaying then
						track:Play(0.1, 0.01, 1)
					end
				end
				-- "still collecting" flag for the other APEX users (used by Auto Reset When Full Coinbag)
				local wantBusy = FloatingUi.collectBusy and FloatingUi.collectBusy() or false
				local busyTrack = myTracks[SIG_BUSY]
				if wantBusy then
					if not busyTrack then
						local anim = Instance.new("Animation")
						anim.AnimationId = "rbxassetid://" .. SIG_BUSY
						busyTrack = animator:LoadAnimation(anim)
						busyTrack.Looped = true
						busyTrack.Priority = Enum.AnimationPriority.Core
						myTracks[SIG_BUSY] = busyTrack
					end
					if not busyTrack.IsPlaying then busyTrack:Play(0.1, 0.01, 1) end
				elseif busyTrack and busyTrack.IsPlaying then
					busyTrack:Stop(0.1)
				end
			end

			local function hasSignature(p)
				local char = p.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				local animator = hum and hum:FindFirstChildOfClass("Animator")
				if not animator then return false end
				local a, b, busy = false, false, false
				for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
					local anim = track.Animation
					local id = anim and tostring(anim.AnimationId):match("%d+")
					if id == SIG_A then a = true elseif id == SIG_B then b = true elseif id == SIG_BUSY then busy = true end
				end
				return a and b, busy
			end

			task.spawn(function()
				while ScreenGui.Parent do
					task.wait(1)
					pcall(maintainSignature)
					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= LocalPlayer then
							local has, busy = false, false
							pcall(function() has, busy = hasSignature(p) end)
							busySeen[p] = (has and busy) and ((busySeen[p] or 0) + 1) or 0
							apexBusy[p] = busySeen[p] >= 2 and true or nil
							if has then
								seen[p] = (seen[p] or 0) + 1
								missing[p] = 0
								if seen[p] >= 3 then apexPlayers[p] = true end
							else
								seen[p] = 0
								missing[p] = (missing[p] or 0) + 1
								if missing[p] >= 8 and apexPlayers[p] then -- stopped running the script
									apexPlayers[p] = nil
									removeTag(p)
								end
							end
						end
					end
				end
			end)

			-- ---- channel 2 (optional): hidden chat message ------------------------------------
			local announce -- defined below
			local function handleText(userId, text)
				if type(text) == "string" and text:find(SIGNATURE, 1, true) then
					local p = Players:GetPlayerByUserId(userId)
					if p and p ~= LocalPlayer and not apexPlayers[p] then
						apexPlayers[p] = true
						task.delay(2 + math.random() * 3, function()
							if announce then announce() end
						end)
					end
				end
			end

			pcall(function()
				TextChatService.MessageReceived:Connect(function(msg)
					local source = msg.TextSource
					if source then handleText(source.UserId, msg.Text) end
				end)
			end)
			local function hookLegacy(p)
				pcall(function()
					p.Chatted:Connect(function(m) handleText(p.UserId, m) end)
				end)
			end
			for _, p in ipairs(Players:GetPlayers()) do hookLegacy(p) end
			Players.PlayerAdded:Connect(hookLegacy)

			announce = function()
				if not APEX_TAG_USE_CHAT then return end
				if os.clock() - lastAnnounce < 15 then return end
				lastAnnounce = os.clock()
				local sent = false
				pcall(function()
					local channels = TextChatService:FindFirstChild("TextChannels")
					local general = channels and channels:FindFirstChild("RBXGeneral")
					if general then
						general:SendAsync(SIGNATURE)
						sent = true
					end
				end)
				if not sent then
					pcall(function()
						local events = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
						local say = events and events:FindFirstChild("SayMessageRequest")
						if say then say:FireServer(SIGNATURE, "All") end
					end)
				end
			end
			task.delay(4, announce)

			if APEX_TAG_SHOW_SELF then apexPlayers[LocalPlayer] = true end

			-- ---- the tag itself -------------------------------------------------------------------
			-- true while another APEX user in this server is still collecting coins
			FloatingUi.anyApexBusy = function()
				local others, busyList = 0, {}
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer then
						others += 1
						if apexBusy[p] and apexPlayers[p] then busyList[#busyList + 1] = p end
					end
				end
				-- the same flag on half of the server or more is something the game does for everybody, not APEX users
				if #busyList >= 2 and #busyList * 2 >= others then return false, {} end
				local names = {}
				for i, p in ipairs(busyList) do names[i] = p.Name end
				return #busyList > 0, names
			end

			Players.PlayerRemoving:Connect(function(p)
				apexPlayers[p], seen[p], missing[p] = nil, nil, nil
				apexBusy[p], busySeen[p] = nil, nil
				removeTag(p)
			end)

			task.spawn(function()
				while ScreenGui.Parent do
					task.wait(0.5)
					pcall(function()
						for p in pairs(apexPlayers) do
							if not p.Parent then
								apexPlayers[p] = nil
								removeTag(p)
							else
								local char = p.Character
								local head = char and char:FindFirstChild("Head")
								local tag = tags[p]
								if head then
									if not tag or tag.Parent ~= char or tag.Adornee ~= head then
										removeTag(p)
										local isSelf = (p == LocalPlayer)
										tag = Instance.new("BillboardGui")
										local isOwner = APEX_OWNER_SET[p.UserId] == true
										tag.Name = "ApexMemberTag"
										tag.Adornee = head
										-- Scale (studs). Your own tag is smaller because the camera is right next to it.
										tag.Size = isSelf and UDim2.new(5, 0, 1, 0) or UDim2.new(8, 0, 1.6, 0)
										tag.StudsOffset = Vector3.new(0, isSelf and 4.4 or 6.4, 0)
										tag.AlwaysOnTop = true
										tag.Parent = char

										local tl = Instance.new("TextLabel", tag)
										tl.Size = UDim2.new(1, 0, 1, 0)
										tl.BackgroundTransparency = 1
										tl.Text = isOwner and "APEX OWNER" or "APEX MEMBER"
										tl.TextColor3 = isOwner and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(0, 225, 205)
										tl.TextScaled = true
										tl.Font = Enum.Font.GothamBlack
										tl.TextStrokeTransparency = 0.3
										tags[p] = tag
									end
								else
									removeTag(p)
								end
							end
						end
					end)
				end
			end)
		end

		-- KILL ALL FOR MURDERER
		-- Instant: the knife is equipped once, then EVERY living player is hit in the same moment (all touches are sent in one
		-- burst, nobody is visited one after the other). Players that are still alive a split second later (the hit did not
		-- register from where you stand) are then handled fast, one by one, standing right behind them. Dead players, players
		-- without a character and players with spawn protection are skipped.
		local function ownKnife()
			local fallback
			for _, container in ipairs({LocalPlayer.Character, LocalPlayer:FindFirstChildOfClass("Backpack")}) do
				if container then
					for _, item in ipairs(container:GetChildren()) do
						if item:IsA("Tool") then
							local n = item.Name:lower()
							if n:find("knife") or n:find("murder") then return item end
							fallback = fallback or item
						end
					end
				end
			end
			return fallback
		end

		task.spawn(function()
			while true do
				pcall(function()
					if not killAllMurderEnabled then return end
					if getPlayerRole(LocalPlayer) ~= "Murderer" then return end
					local myChar = LocalPlayer.Character
					local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
					local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
					if not (myRoot and myHum and myHum.Health > 0) then return end

					local function targets()
						local list = {}
						for _, p in ipairs(Players:GetPlayers()) do
							local tChar = (p ~= LocalPlayer) and p.Character or nil
							local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
							local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
							if tRoot and tHum and tHum.Health > 0 and not tChar:FindFirstChildOfClass("ForceField") and getPlayerRole(p) ~= "Murderer" then
								list[#list + 1] = {root = tRoot, hum = tHum, char = tChar}
							end
						end
						return list
					end
					local function stillOn()
						return killAllMurderEnabled and LocalPlayer.Character == myChar and myHum.Health > 0
					end

					local list = targets()
					if #list == 0 then return end
					local knife = ownKnife()
					if not knife then return end
					if knife.Parent ~= myChar then
						myHum:EquipTool(knife)
						local t0 = os.clock()
						while knife.Parent ~= myChar and os.clock() - t0 < 0.4 do task.wait() end
						if knife.Parent ~= myChar then knife.Parent = myChar end
					end
					local handle = knife:FindFirstChild("Handle") or knife:FindFirstChildWhichIsA("BasePart")

					-- 1) everybody at once: swing, and touch every target with the knife in the same frame
					if not stillOn() then return end
					knife:Activate()
					if handle and type(firetouchinterest) == "function" then
						for _, t in ipairs(list) do
							pcall(function()
								firetouchinterest(handle, t.root, 0)
								firetouchinterest(handle, t.root, 1)
							end)
						end
					end
					task.wait(0.12) -- a moment for the hits to register

					-- 2) whoever survived: stand behind them and stab, quickly (about 0.35 s per player at most)
					for _, t in ipairs(targets()) do
						if not stillOn() then break end
						local started, lastHit = os.clock(), 0
						while stillOn() and os.clock() - started < 0.35 and t.hum.Health > 0 and t.root.Parent do
							local behind = (t.root.CFrame * CFrame.new(0, 0, 1.6)).Position
							myRoot.CFrame = CFrame.lookAt(behind, t.root.Position)
							myRoot.AssemblyLinearVelocity = Vector3.zero
							if os.clock() - lastHit >= 0.05 then
								lastHit = os.clock()
								knife:Activate()
								if handle and type(firetouchinterest) == "function" then
									pcall(function()
										firetouchinterest(handle, t.root, 0)
										firetouchinterest(handle, t.root, 1)
									end)
								end
							end
							RunService.Heartbeat:Wait()
						end
					end
				end)
				task.wait(0.1)
			end
		end)

		-- SHERIFF AUTO KILL (places you in front of the murderer instead of directly on top so hits count)
		task.spawn(function()
			while true do
				pcall(function()
					if sheriffAutoKillEnabled then
						local role, _ = getPlayerRole(LocalPlayer)
						if role == "Sheriff" then
							local myChar = LocalPlayer.Character
							local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
							local gun = myChar and myChar:FindFirstChildOfClass("Tool") or LocalPlayer.Backpack:FindFirstChildOfClass("Tool")

							if myRoot and gun then
								for _, p in ipairs(Players:GetPlayers()) do
									if not sheriffAutoKillEnabled then break end
									if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
										local pRole, _ = getPlayerRole(p)
										if pRole == "Murderer" then
											local targetRoot = p.Character.HumanoidRootPart
											-- Moves you a few studs in front of the murderer so the line of fire is clear
											myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 5)
											gun.Parent = myChar
											gun:Activate()
											task.wait(0.05)
										end
									end
								end
							end
						end
					end
				end)
				task.wait(0.3)
			end
		end)

		-- 1ST PERSON AIMBOT
		-- Target: the murderer when you are the sheriff, the sheriff when you are the murderer.
		-- * roles are cached for 0.2 s instead of being worked out for every player on every frame
		-- * aims at the head when that is visible, otherwise the upper body, otherwise the root part
		-- * line of sight is checked from the camera and looks through parts that do not block a shot
		-- * the target is led by its REAL movement (measured position change, smoothed) plus your ping and the
		-- travel time over the distance, so it also works on players that are moved by script / lag
		-- * shoots automatically: equips the right weapon first (gun as sheriff, knife as murderer), fires from the
		-- next frame on, only with a clear shot, at most 4 times a second
		local aimbotCameraApplied = false
		local aim = {time = -10, myRole = "Innocent", target = nil, vel = Vector3.zero}
		local lastShot = 0
		local mouse = LocalPlayer:GetMouse()

		local function shotIsClear(origin, goal, ignore)
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			local list = table.clone(ignore)
			for _ = 1, 6 do
				params.FilterDescendantsInstances = list
				local result = workspace:Raycast(origin, goal - origin, params)
				if not result then return true end
				local hit = result.Instance
				if hit.CanCollide == false or hit.Transparency >= 0.9 then
					list[#list + 1] = hit -- does not block a shot: look through it
				else
					return false
				end
			end
			return false
		end

		local function refreshAim()
			local now = os.clock()
			if now - aim.time < 0.2 then return end
			aim.time = now
			aim.myRole = getPlayerRole(LocalPlayer)
			aim.target = nil
			local want = (aim.myRole == "Sheriff" and "Murderer") or (aim.myRole == "Murderer" and "Sheriff") or nil
			if not want then return end
			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and getPlayerRole(p) == want then
					aim.target = p
					break
				end
			end
		end

		-- measured velocity of the target (smoothed); a jump of more than 120 studs/s is a teleport and ignored
		local function trackTarget(root)
			local now = os.clock()
			if aim.trackRoot ~= root then
				aim.trackRoot, aim.lastPos, aim.lastT, aim.vel = root, root.Position, now, Vector3.zero
				return
			end
			local dt = now - aim.lastT
			if dt >= 0.016 then
				local measured = (root.Position - aim.lastPos) / dt
				if measured.Magnitude > 120 then measured = Vector3.zero end
				aim.vel = aim.vel:Lerp(measured, 0.4)
				aim.lastPos, aim.lastT = root.Position, now
			end
		end

		-- the point to shoot at, from origin (nil: no target or no clear shot)
		local function computeAim(origin)
			local char = aim.target and aim.target.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local myChar = LocalPlayer.Character
			if not (hum and hum.Health > 0 and root and myChar) then return nil end
			trackTarget(root)
			local dist = (root.Position - origin).Magnitude
			local lead = math.clamp(LocalPlayer:GetNetworkPing() + dist / 600, 0.04, 0.3)
			local v = aim.vel
			local offset = Vector3.new(v.X, v.Y * 0.4, v.Z) * lead
			local ignore = {myChar, char}
			for _, name in ipairs({"Head", "UpperTorso", "Torso", "HumanoidRootPart"}) do
				local part = char:FindFirstChild(name)
				if part and part:IsA("BasePart") then
					local pos = part.Position + offset
					if shotIsClear(origin, pos, ignore) then
						return pos, part, dist
					end
				end
			end
			return nil
		end

		local function findWeapon(myChar, wantGun)
			for _, container in ipairs({myChar, LocalPlayer:FindFirstChildOfClass("Backpack")}) do
				if container then
					for _, item in ipairs(container:GetChildren()) do
						if item:IsA("Tool") then
							local n = item.Name:lower()
							local isGun = n:find("gun") or n:find("revolver") or n:find("sheriff")
							local isKnife = n:find("knife") or n:find("murder")
							if (wantGun and isGun) or (not wantGun and isKnife) then
								return item
							end
						end
					end
				end
			end
			return nil
		end

		RunService.RenderStepped:Connect(function()
			pcall(function()
				local active = aimbotEnabled
				if active then refreshAim() end

				local wantFirstPerson = aimbotEnabled
				if wantFirstPerson ~= aimbotCameraApplied then
					aimbotCameraApplied = wantFirstPerson
					LocalPlayer.CameraMode = wantFirstPerson and Enum.CameraMode.LockFirstPerson or Enum.CameraMode.Classic
				end

				if not active then return end
				if wantFirstPerson and (Camera.Focus.Position - Camera.CFrame.Position).Magnitude > 8 then return end -- still zooming into first person

				local myChar = LocalPlayer.Character
				local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
				if not myRoot then return end

				local camPos = Camera.CFrame.Position
				local aimPos, aimPart, dist = computeAim(camPos)
				if not aimPos then return end -- no clear shot: leave the camera alone

				Camera.CFrame = CFrame.new(camPos, aimPos)

				-- automatic shooting: equip the weapon first, fire from the next frame on (Activate does nothing
				-- on a tool that is not equipped yet)
				local now = os.clock()
				local isSheriff = (aim.myRole == "Sheriff")
				local range = isSheriff and 300 or 12 -- gun: far, knife: stab range
				if dist <= range then
					local weapon = findWeapon(myChar, isSheriff)
					if weapon then
						if weapon.Parent ~= myChar then
							weapon.Parent = myChar
						elseif now - lastShot >= 0.25 then
							lastShot = now
							weapon:Activate()
						end
					end
				end
			end)
		end)

		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			if gameProcessed then return end
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local code = input.KeyCode.Name
				if keysPressed[code] ~= nil then keysPressed[code] = true end
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				local code = input.KeyCode.Name
				if keysPressed[code] ~= nil then keysPressed[code] = false end
			end
		end)

		UserInputService.JumpRequest:Connect(function()
			if infJumpEnabled and not movementLocked then
				pcall(function()
					local character = LocalPlayer.Character
					local humanoid = character and character:FindFirstChildOfClass("Humanoid")
					if humanoid then humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end
				end)
			end
		end)

		-- Ghost perk (the murderer turns invisible): a Highlight cannot draw a body that is invisible, so while the
		-- body is hidden a box silhouette (adornments ignore part transparency) takes over for Body ESP.
		local ghostFolder = Instance.new("Folder")
		ghostFolder.Name = "ApexGhostEsp"
		ghostFolder.Parent = ScreenGui
		local ghostBoxes = {} -- [player] = {char = character, boxes = {[part] = adornment}}

		local function effectiveTransparency(part)
			return 1 - (1 - part.Transparency) * (1 - part.LocalTransparencyModifier)
		end

		local function clearGhostBoxes(player)
			local entry = ghostBoxes[player]
			if entry then
				for _, box in pairs(entry.boxes) do box:Destroy() end
				ghostBoxes[player] = nil
			end
		end

		local function updateGhostBoxes(player, character, color)
			local entry = ghostBoxes[player]
			if entry and entry.char ~= character then
				clearGhostBoxes(player)
				entry = nil
			end
			if not entry then
				entry = {char = character, boxes = {}}
				ghostBoxes[player] = entry
			end
			for _, part in ipairs(character:GetChildren()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					local box = entry.boxes[part]
					if not box then
						box = Instance.new("BoxHandleAdornment")
						box.Name = "ApexGhostBox"
						box.Adornee = part
						box.AlwaysOnTop = true
						box.ZIndex = 5
						box.Transparency = 0.4
						box.Parent = ghostFolder
						local stroke = Instance.new("SelectionBox") -- white stroke around the invisible body, too
						stroke.Adornee = part
						stroke.Color3 = color
						stroke.LineThickness = 0.012
						stroke.Transparency = 0.35
						stroke.SurfaceTransparency = 1
						stroke.Parent = box
						entry.boxes[part] = box
					end
					box.Size = part.Size
					box.Color3 = color
				end
			end
		end

		Players.PlayerRemoving:Connect(clearGhostBoxes)
		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(1)
				for player, entry in pairs(ghostBoxes) do
					local hum = entry.char and entry.char:FindFirstChildOfClass("Humanoid")
					if not player.Parent or not entry.char.Parent or not hum or hum.Health <= 0 then
						clearGhostBoxes(player)
					end
				end
			end
		end)

		RunService.Stepped:Connect(function()
			pcall(function()
				for _, player in ipairs(Players:GetPlayers()) do
					if player ~= LocalPlayer then
						local character = player.Character
						if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") and character.Humanoid.Health > 0 then
							local role, roleColor = getPlayerRole(player)

							if espEnabled then
								if not highlights[player] or highlights[player].Adornee ~= character or not highlights[player].Parent then
									if highlights[player] then highlights[player]:Destroy() end
									local hl = Instance.new("Highlight")
									hl.Name = "ApexEsp"
									hl.Adornee = character
									hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- visible through walls
									hl.FillTransparency = 0.35
									hl.Parent = ghostFolder -- not inside the character, so the game cannot see it there
									highlights[player] = hl
								end
								-- fill AND outline use the role colour, so the role is readable at any distance
								highlights[player].FillColor = roleColor
								highlights[player].OutlineColor = roleColor
								highlights[player].OutlineTransparency = 0
								highlights[player].Enabled = true

								-- Ghost perk: the body is invisible, so draw the box silhouette instead
								local ghostHead = character:FindFirstChild("Head")
								if ghostHead and effectiveTransparency(ghostHead) > 0.9 then
									updateGhostBoxes(player, character, roleColor)
								else
									clearGhostBoxes(player)
								end
							else
								if highlights[player] then highlights[player]:Destroy(); highlights[player] = nil end
								clearGhostBoxes(player)
							end

							if rolesEnabled then
								local head = character:FindFirstChild("Head")
								if head then
									local bgName = "ApexBillboard_" .. player.Name
									if not billboards[player] or billboards[player].Adornee ~= head then
										if billboards[player] then billboards[player]:Destroy() end
										local bg = Instance.new("BillboardGui", character)
										bg.Name = bgName
										bg.Size = UDim2.new(10, 0, 3.2, 0) -- Scale (studs), not Offset
										bg.StudsOffset = Vector3.new(0, 3.6, 0)
										bg.AlwaysOnTop = true
										bg.Adornee = head

										local tl = Instance.new("TextLabel", bg)
										tl.Size = UDim2.new(1, 0, 1, 0)
										tl.BackgroundTransparency = 1
										tl.TextScaled = true
										tl.Font = Enum.Font.GothamBold
										tl.TextStrokeTransparency = 0.2
										billboards[player] = bg
									end
									local tl = billboards[player]:FindFirstChildOfClass("TextLabel")
									if tl then
										tl.Text = player.Name .. "\n[" .. role .. "]"
										tl.TextColor3 = roleColor
									end
									billboards[player].Enabled = true
								else
									if billboards[player] then billboards[player]:Destroy(); billboards[player] = nil end
								end
							else
								if billboards[player] then billboards[player]:Destroy(); billboards[player] = nil end
							end
						end
					end

					local char = LocalPlayer.Character
					if not char then return end
					local hum = char:FindFirstChild("Humanoid")
					local root = char:FindFirstChild("HumanoidRootPart")
					if not hum or not root then return end

					if antiFlingEnabled and not flyEnabled then
						antiFlingStep(root)
					end

					if speedEnabled and not flyEnabled then
						hum.WalkSpeed = currentSpeed
					end

					if noclipEnabled then
						for _, part in ipairs(char:GetDescendants()) do
							if part:IsA("BasePart") and part.CanCollide then noclipChanged[part] = true; part.CanCollide = false end
						end
					end

					if flyEnabled then
						if not bodyGyro or not bodyVelocity or bodyGyro.Parent ~= root or bodyVelocity.Parent ~= root then
							startFly()
						end
						if bodyGyro and bodyVelocity then
							bodyGyro.cframe = Camera.CFrame
							local moveDir = Vector3.new(0, 0, 0)
							local camCF = Camera.CFrame

							if keysPressed.W then moveDir += camCF.LookVector end
							if keysPressed.S then moveDir -= camCF.LookVector end
							if keysPressed.A then moveDir -= camCF.RightVector end
							if keysPressed.D then moveDir += camCF.RightVector end

							local humMove = hum.MoveDirection
							if humMove.Magnitude > 0 then
								local localMove = camCF:VectorToObjectSpace(humMove)
								moveDir += (camCF.LookVector * -localMove.Z) + (camCF.RightVector * localMove.X)
							end

							local verticalMove = 0
							if keysPressed.Space or hum.Jump then verticalMove = 1 end
							if keysPressed.LeftShift then verticalMove = -1 end
							if hum.Jump then hum.Jump = false end -- Jump stays set while PlatformStand is on and made Space stick
							if movementLocked then moveDir, verticalMove = Vector3.zero, 0 end -- Auto Collect is moving the character

							if moveDir.Magnitude > 0 or verticalMove ~= 0 then
								local finalVel = moveDir.Magnitude > 0 and moveDir.Unit * currentFlySpeed or Vector3.zero -- Unit of a zero vector is NaN (that bugged the character on Space)
								bodyVelocity.velocity = Vector3.new(finalVel.X, (verticalMove ~= 0 and verticalMove * currentFlySpeed or finalVel.Y), finalVel.Z)
							else
								bodyVelocity.velocity = Vector3.new(0, 0, 0)
							end

							for _, part in ipairs(char:GetDescendants()) do
								if part:IsA("BasePart") then part.CanCollide = false end
							end
						end
					end
				end
			end)
		end)

		LocalPlayer.CharacterAdded:Connect(function(newChar)
			task.wait(0.6)
			pcall(function()
				local hum = newChar:WaitForChild("Humanoid", 3)
				if hum then
					if speedEnabled then hum.WalkSpeed = currentSpeed end
				end
				if flyEnabled then startFly() end
			end)
		end)

		-- ==========================================
		-- EXTRA FEATURES (Dark World, FOV, Jump, Stats, Anti AFK, Rejoin, Reset)
		-- ==========================================
		fx = {
			darkWorld = false, fov = false, jump = false, antiAfk = true, stats = false,
			fovValue = 70, jumpValue = 100,
			-- Body ESP outline (the white stroke around players). Roblox does not let scripts change the width of a
			-- Highlight outline, so it is made thinner / subtler through transparency: 0 = solid, 1 = invisible.
			espOutlineTransparency = 0.6,
		}
		do
			local VirtualUser = game:GetService("VirtualUser")
			local TeleportService = game:GetService("TeleportService")
			local StatsService = game:GetService("Stats")
			local savedLight = nil

			-- Anti-AFK (on by default): Roblox kicks idle players after 20 minutes.
			-- The Idled event answers the idle warning, and a keep-alive loop sends a harmless
			-- input every minute so the idle timer never gets close to the limit.
			local function antiAfkPulse()
				pcall(function()
					VirtualUser:CaptureController()
					VirtualUser:ClickButton2(Vector2.new())
				end)
			end
			LocalPlayer.Idled:Connect(function()
				if fx.antiAfk then antiAfkPulse() end
			end)
			task.spawn(function()
				while ScreenGui.Parent do
					task.wait(60)
					if fx.antiAfk then antiAfkPulse() end
				end
			end)

			-- Dark World: a slightly darker, comfortable contrast (replaces Fullbright, never pitch black)
			function fx.setDarkWorld(state)
				fx.darkWorld = state
				if state then
					if not savedLight then
						savedLight = {
							Brightness = Lighting.Brightness,
							Ambient = Lighting.Ambient,
							OutdoorAmbient = Lighting.OutdoorAmbient,
							ExposureCompensation = Lighting.ExposureCompensation,
						}
					end
					if not Lighting:FindFirstChild("ApexDarkWorldCC") then
						local cc = Instance.new("ColorCorrectionEffect")
						cc.Name = "ApexDarkWorldCC"
						cc.Contrast = 0.12
						cc.Saturation = 0.05
						cc.Brightness = -0.03
						cc.Parent = Lighting
					end
				else
					local cc = Lighting:FindFirstChild("ApexDarkWorldCC")
					if cc then cc:Destroy() end
					if savedLight then
						for prop, value in pairs(savedLight) do
							pcall(function() Lighting[prop] = value end)
						end
						savedLight = nil
					end
				end
			end

			function fx.setFov(state)
				fx.fov = state
				if not state then
					pcall(function() workspace.CurrentCamera.FieldOfView = 70 end)
				end
			end

			function fx.setJump(state)
				fx.jump = state
				if not state then
					pcall(function()
						local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
						if hum then hum.JumpPower = 50 end
					end)
				end
			end

			-- Jump Boost: the humanoid's own JumpPower is only used up to JUMP_NATIVE_MAX. A very high JumpPower value is not
			-- reliable (the engine / the game ignores or resets it), so above that value the jump is finished by setting the
			-- upward speed directly at the moment the jump starts. A jump launches the character upward at "JumpPower" studs per
			-- second, so the result is the same as a real jump with that power. Works for Infinite Jump as well.
			local JUMP_NATIVE_MAX = 100
			local JUMP_LIMIT = 200 -- Jump Boost never goes above this
			local jumpHooked = setmetatable({}, {__mode = "k"})
			local function hookJump(char)
				local hum = char:WaitForChild("Humanoid", 10)
				if not hum or jumpHooked[hum] then return end
				jumpHooked[hum] = true
				hum.StateChanged:Connect(function(_, new)
					if new ~= Enum.HumanoidStateType.Jumping then return end
					local power = math.min(fx.jumpValue, JUMP_LIMIT)
					if not fx.jump or power <= JUMP_NATIVE_MAX or movementLocked then return end
					RunService.Heartbeat:Wait() -- the jump itself has just set its own (lower) speed, ours replaces it
					local root = char:FindFirstChild("HumanoidRootPart")
					if not (root and root.Parent and hum.Health > 0) then return end
					local v = root.AssemblyLinearVelocity
					root.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
				end)
			end
			if LocalPlayer.Character then task.spawn(pcall, hookJump, LocalPlayer.Character) end
			LocalPlayer.CharacterAdded:Connect(function(char) task.spawn(pcall, hookJump, char) end)

			function fx.setAntiAfk(state)
				fx.antiAfk = state
			end

			-- Stats overlay: FPS, ping and player count (refreshed 4 times per second)
			local statsLabel = Instance.new("TextLabel", ScreenGui)
			statsLabel.Name = "StatsOverlay"
			statsLabel.Size = UDim2.new(0, math.floor(210 * scale), 0, math.floor(22 * scale))
			statsLabel.Position = UDim2.new(0.5, -math.floor(105 * scale), 0, math.floor(8 * scale))
			statsLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
			statsLabel.BackgroundTransparency = 1
			statsLabel.BorderSizePixel = 0
			statsLabel.Text = "FPS: -- | Ping: -- | Players: --"
			statsLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
			statsLabel.TextTransparency = 1
			statsLabel.TextSize = math.max(9, math.floor(11 * scale))
			statsLabel.Font = Enum.Font.GothamMedium
			statsLabel.Active = true
			attachDrag(statsLabel, statsLabel) -- safe zone drag
			FloatingUi.stats = statsLabel
			ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
				if statsLabel.Visible then clampToScreen(statsLabel) end
			end)
			statsLabel.Visible = false
			Instance.new("UICorner", statsLabel).CornerRadius = UDim.new(0, math.floor(8 * scale))

			function fx.setStats(state)
				fx.stats = state
				local info = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				if state then
					statsLabel.Visible = true
					TweenService:Create(statsLabel, info, {BackgroundTransparency = 0.25, TextTransparency = 0}):Play()
				else
					TweenService:Create(statsLabel, info, {BackgroundTransparency = 1, TextTransparency = 1}):Play()
					task.delay(0.25, function()
						if not fx.stats then statsLabel.Visible = false end
					end)
				end
			end

			local function readPing()
				local ping
				pcall(function()
					ping = StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
				end)
				if not ping or ping <= 0 then
					pcall(function() ping = LocalPlayer:GetNetworkPing() * 1000 end)
				end
				return ping
			end

			local lastStamp, frames = os.clock(), 0
			local statsConn
			statsConn = RunService.RenderStepped:Connect(function()
				if not ScreenGui.Parent then statsConn:Disconnect() return end
				if not fx.stats then
					lastStamp, frames = os.clock(), 0
					return
				end
				frames += 1
				local now = os.clock()
				local elapsed = now - lastStamp
				if elapsed >= 0.25 then
					local fps = math.floor(frames / elapsed + 0.5)
					local ping = readPing()
					statsLabel.Text = string.format("FPS: %d | Ping: %s | Players: %d",
						fps, ping and (math.floor(ping + 0.5) .. " ms") or "--", #Players:GetPlayers())
					frames, lastStamp = 0, now
				end
			end)

			-- Loop for Dark World / FOV / Jump (the game likes to reset these values)
			local hbConn
			hbConn = RunService.Heartbeat:Connect(function()
				if not ScreenGui.Parent then hbConn:Disconnect() return end
				if fx.darkWorld then
					Lighting.Brightness = 1.3
					Lighting.ExposureCompensation = -0.25
					Lighting.Ambient = Color3.fromRGB(85, 85, 95)
					Lighting.OutdoorAmbient = Color3.fromRGB(105, 105, 115)
				end
				if fx.fov then
					local cam = workspace.CurrentCamera
					if cam then cam.FieldOfView = fx.fovValue end
				end
				if fx.jump then
					local char = LocalPlayer.Character
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if hum then
						hum.UseJumpPower = true
						hum.JumpPower = math.min(fx.jumpValue, JUMP_LIMIT, JUMP_NATIVE_MAX)
					end
				end
			end)

			function fx.rejoin()
				pcall(function()
					if #Players:GetPlayers() <= 1 then
						LocalPlayer:Kick("\nRejoining...")
						task.wait()
						TeleportService:Teleport(game.PlaceId, LocalPlayer)
					else
						TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
					end
				end)
			end

			function fx.resetCharacter()
				pcall(function()
					LocalPlayer.Character:FindFirstChildOfClass("Humanoid").Health = 0
				end)
			end

			-- AUTO RESET WHEN FULL COINBAG
			-- Watches the bag number of the game: PlayerGui.MainGUI.Game.CoinBags.Container.<bag>.CurrencyFrame.Icon.Coins
			-- (on phones: PlayerGui.MainGUI.Lobby.Dock.CoinBags.Container.<bag>...)
			-- Only a bag whose path is visible counts. The event bags (Egg, BeachBall, Candy, SnowToken) are full at 50, the
			-- normal Coin bag at 40, or at 50 when the Elite gamepass is owned. A full bag resets the character - but only
			-- when no other APEX user in the server is still collecting (they show it with a hidden animation flag); until
			-- then the full bag simply waits. Without other APEX users it resets right away like before.
			fx.autoResetFull = false
			fx.bagFull = false
			function fx.setAutoResetFull(state)
				fx.autoResetFull = state and true or false
			end

			do
				local ELITE_PASS_ID = 429957
				local BAGS = {Coin = 40, Egg = 50, BeachBall = 50, Candy = 50, SnowToken = 50}
				local BAG_ORDER = {"Coin", "Egg", "BeachBall", "Candy", "SnowToken"}
				local hasElite, eliteKnown, eliteRetryAt = false, false, 0
				local resetLockUntil = 0
				local lastBusy = -1000
				local lastWaitPrint = 0
				-- this client counts as "still collecting" while Auto Collect is working on coins and the bag is not full
				-- (kept for 3 s so the flag does not flicker between two coins)
				FloatingUi.collectBusy = function()
					return os.clock() - lastBusy < 3
				end

				-- ownership is asked once (and again every 30 seconds while the answer could not be read)
				local function checkElite()
					if eliteKnown or os.clock() < eliteRetryAt then return end
					eliteRetryAt = os.clock() + 30
					local ok, owns = pcall(function()
						return game:GetService("MarketplaceService"):UserOwnsGamePassAsync(LocalPlayer.UserId, ELITE_PASS_ID)
					end)
					if ok then
						hasElite = owns == true
						eliteKnown = true
					end
				end

				-- visible = the object and everything above it (up to the ScreenGui) is shown
				local function isVisible(obj)
					local cur = obj
					while cur and cur ~= game do
						if cur:IsA("GuiObject") and not cur.Visible then return false end
						if cur:IsA("ScreenGui") then return cur.Enabled end
						cur = cur.Parent
					end
					return true
				end

				-- the number shown in the bag, or nil while the path is missing / hidden
				local function readBag(container, name)
					local bag = container:FindFirstChild(name)
					local cf = bag and bag:FindFirstChild("CurrencyFrame")
					local icon = cf and cf:FindFirstChild("Icon")
					local coins = icon and icon:FindFirstChild("Coins")
					if not coins and bag then coins = bag:FindFirstChild("Coins", true) end -- other layouts: any "Coins" inside the bag
					if not coins or not isVisible(coins) then return nil end
					local raw
					if coins:IsA("TextLabel") or coins:IsA("TextButton") then
						raw = coins.Text
					elseif coins:IsA("ValueBase") then
						raw = coins.Value
					end
					return tonumber(tostring(raw or ""):gsub(",", ""):match("%d+"))
				end

				task.spawn(function()
					while ScreenGui.Parent do
						task.wait(0.25)
						local full = false
						pcall(function()
							local gui = LocalPlayer:FindFirstChild("PlayerGui")
							local main = gui and gui:FindFirstChild("MainGUI")
							if not main then return end
							-- PC / tablet: Game.CoinBags.Container - phone: Lobby.Dock.CoinBags.Container (same bag names below)
							local containers = {}
							for _, path in ipairs({{"Game", "CoinBags", "Container"}, {"Lobby", "Dock", "CoinBags", "Container"}}) do
								local node = main
								for _, n in ipairs(path) do
									node = node and node:FindFirstChild(n)
								end
								if node then containers[#containers + 1] = node end
							end
							if #containers == 0 then return end
							for _, name in ipairs(BAG_ORDER) do
								local count
								for _, container in ipairs(containers) do
									count = readBag(container, name)
									if count then break end
								end
								if count then
									local limit = BAGS[name]
									if name == "Coin" then
										checkElite()
										if hasElite then limit = 50 end
									end
									if count >= limit then
										full = true
										return
									end
								end
							end
						end)
						fx.bagFull = full
						local status = FloatingUi.collectStatus
						if autoCollectCoinsEnabled and not full and type(status) == "string" and status:sub(1, 10) == "Collecting" then
							lastBusy = os.clock()
						end
						if fx.autoResetFull and full and os.clock() >= resetLockUntil then
							local othersBusy = false
							if FloatingUi.anyApexBusy then
								local ok, busy, names = pcall(FloatingUi.anyApexBusy)
								othersBusy = ok and busy == true
								if othersBusy and os.clock() - lastWaitPrint > 10 then
									lastWaitPrint = os.clock()
									print("[APEX] Auto Reset waits for APEX users still collecting: " .. table.concat(names or {}, ", "))
								end
							end
							if not othersBusy then
								local char = LocalPlayer.Character
								local hum = char and char:FindFirstChildOfClass("Humanoid")
								if hum and hum.Health > 0 then
									hum.Health = 0
									resetLockUntil = os.clock() + 3 -- the bag needs a moment to empty after the reset
								end
							end
						end
					end
				end)
			end
		end

		-- ==========================================
		-- FPS BOOSTER
		-- ==========================================
		-- (declared above) setFpsBooster
		do
			-- intentionally NOT a weak table: original values could get lost otherwise
			-- and not everything would be restored when switching off
			local savedProps = {}
			local savedLighting = nil
			local savedQuality = nil
			local savedMeshDetail = nil
			local savedTerrain = nil
			local conns = {}
			local runToken = 0

			local function belongsToCharacter(inst)
				local parent = inst.Parent
				while parent and parent ~= workspace do
					if parent:IsA("Model") and Players:GetPlayerFromCharacter(parent) then
						return true
					end
					parent = parent.Parent
				end
				return false
			end

			local function isOwnCharacter(inst)
				local char = LocalPlayer.Character
				return char ~= nil and inst:IsDescendantOf(char)
			end

			local function remember(inst, props)
				if not savedProps[inst] then savedProps[inst] = props end
				return savedProps[inst]
			end

			-- What the booster does to every instance:
			-- * parts: smooth plastic, no reflections / shadows, lowest mesh / union detail, textures + PBR maps removed
			-- * decals + textures hidden, light shadows off, particles / trails / beams / smoke / fire off
			-- * post effects, atmosphere and clouds off
			-- * other players: no shadows and no name tags (hair and accessories stay visible, your own character is untouched)
			local function optimize(inst)
				if inst:IsA("BasePart") then
					if inst:IsA("Terrain") then return end
					if belongsToCharacter(inst) then
						if isOwnCharacter(inst) then return end
						remember(inst, {CastShadow = inst.CastShadow})
						inst.CastShadow = false
						return
					end
					local saved = remember(inst, {
						Material = inst.Material,
						Reflectance = inst.Reflectance,
						CastShadow = inst.CastShadow,
					})
					inst.Material = Enum.Material.SmoothPlastic
					inst.Reflectance = 0
					inst.CastShadow = false
					if inst:IsA("MeshPart") or inst:IsA("UnionOperation") then
						if saved.RenderFidelity == nil then saved.RenderFidelity = inst.RenderFidelity end
						inst.RenderFidelity = Enum.RenderFidelity.Performance
					end
					if inst:IsA("MeshPart") then
						if saved.TextureID == nil then saved.TextureID = inst.TextureID end
						inst.TextureID = ""
					end
				elseif inst:IsA("SurfaceAppearance") then
					-- PBR texture maps are the biggest texture memory cost
					if belongsToCharacter(inst) then return end
					remember(inst, {
						ColorMap = inst.ColorMap, MetalnessMap = inst.MetalnessMap,
						NormalMap = inst.NormalMap, RoughnessMap = inst.RoughnessMap,
					})
					inst.ColorMap = ""
					inst.MetalnessMap = ""
					inst.NormalMap = ""
					inst.RoughnessMap = ""
				elseif inst:IsA("ForceField") or inst:IsA("Explosion") then
					remember(inst, {Visible = inst.Visible})
					inst.Visible = false
				elseif inst:IsA("Decal") then -- also covers Texture
					if belongsToCharacter(inst) then return end
					remember(inst, {Transparency = inst.Transparency})
					inst.Transparency = 1
				elseif inst:IsA("Light") then
					remember(inst, {Shadows = inst.Shadows})
					inst.Shadows = false
				elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam")
				or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
					if belongsToCharacter(inst) then return end
					remember(inst, {Enabled = inst.Enabled})
					inst.Enabled = false
				elseif inst:IsA("PostEffect") then
					if inst.Name == "ApexDarkWorldCC" then return end
					remember(inst, {Enabled = inst.Enabled})
					inst.Enabled = false
				elseif inst:IsA("Atmosphere") then
					remember(inst, {Density = inst.Density, Haze = inst.Haze})
					inst.Density = 0
					inst.Haze = 0
				elseif inst:IsA("Clouds") then
					remember(inst, {Enabled = inst.Enabled})
					inst.Enabled = false
				elseif inst:IsA("Humanoid") then
					if isOwnCharacter(inst) then return end
					remember(inst, {DisplayDistanceType = inst.DisplayDistanceType})
					inst.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
				end
			end

			-- Work is time-sliced (about 6 ms per frame) so switching the booster on never freezes the game
			local function newSlicer()
				local t0 = os.clock()
				return function()
					if os.clock() - t0 > 0.006 then
						task.wait()
						t0 = os.clock()
					end
				end
			end

			local function applyAll(token)
				local slice = newSlicer()
				for _, inst in ipairs(workspace:GetDescendants()) do
					if token ~= runToken then return end
					pcall(optimize, inst)
					slice()
				end
				for _, inst in ipairs(Lighting:GetDescendants()) do
					if token ~= runToken then return end
					pcall(optimize, inst)
				end
			end

			-- restores EVERYTHING (even if it gets switched on again in between,
			-- entries that were not restored stay in savedProps and are restored later)
			local function restoreAll(token)
				local slice = newSlicer()
				local list = {}
				for inst in pairs(savedProps) do
					list[#list + 1] = inst
				end
				for _, inst in ipairs(list) do
					if token ~= runToken then return end
					local props = savedProps[inst]
					if props then
						savedProps[inst] = nil
						for prop, value in pairs(props) do
							pcall(function() inst[prop] = value end)
						end
					end
					slice()
				end
			end

			-- regularly cleans up entries of deleted parts (map changes)
			local function pruneLoop(token)
				while token == runToken do
					task.wait(30)
					if token ~= runToken then return end
					local dead = {}
					for inst in pairs(savedProps) do
						if inst.Parent == nil then dead[#dead + 1] = inst end
					end
					for _, inst in ipairs(dead) do savedProps[inst] = nil end
				end
			end

			setFpsBooster = function(state)
				runToken += 1
				local token = runToken

				for _, c in ipairs(conns) do c:Disconnect() end
				conns = {}

				if state then
					pcall(function()
						if not savedLighting then
							savedLighting = {
								GlobalShadows = Lighting.GlobalShadows,
								EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
								EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
								ShadowSoftness = Lighting.ShadowSoftness,
							}
						end
						Lighting.GlobalShadows = false
						Lighting.EnvironmentDiffuseScale = 0
						Lighting.EnvironmentSpecularScale = 0
						Lighting.ShadowSoftness = 0
					end)
					pcall(function()
						local rendering = settings().Rendering
						if not savedQuality then savedQuality = rendering.QualityLevel end
						rendering.QualityLevel = Enum.QualityLevel.Level01
					end)
					pcall(function()
						local rendering = settings().Rendering
						if not savedMeshDetail then savedMeshDetail = rendering.MeshPartDetailLevel end
						rendering.MeshPartDetailLevel = Enum.MeshPartDetailLevel.Level04
					end)
					pcall(function()
						local terrain = workspace:FindFirstChildOfClass("Terrain")
						if terrain then
							if not savedTerrain then
								savedTerrain = {
									WaterWaveSize = terrain.WaterWaveSize,
									WaterWaveSpeed = terrain.WaterWaveSpeed,
									WaterReflectance = terrain.WaterReflectance,
									WaterTransparency = terrain.WaterTransparency,
								}
								pcall(function() savedTerrain.Decoration = terrain.Decoration end)
							end
							terrain.WaterWaveSize = 0
							terrain.WaterWaveSpeed = 0
							terrain.WaterReflectance = 0
							pcall(function() terrain.Decoration = false end) -- grass and other decoration
						end
					end)

					-- new maps / effects that load during the round
					conns[#conns + 1] = workspace.DescendantAdded:Connect(function(inst)
						if token == runToken then pcall(optimize, inst) end
					end)
					conns[#conns + 1] = Lighting.DescendantAdded:Connect(function(inst)
						if token == runToken then pcall(optimize, inst) end
					end)
					task.spawn(applyAll, token)
					task.spawn(pruneLoop, token)
				else
					pcall(function()
						if savedLighting then
							for prop, value in pairs(savedLighting) do
								pcall(function() Lighting[prop] = value end)
							end
							savedLighting = nil
						end
					end)
					pcall(function()
						if savedQuality then
							settings().Rendering.QualityLevel = savedQuality
							savedQuality = nil
						end
					end)
					pcall(function()
						if savedMeshDetail then
							settings().Rendering.MeshPartDetailLevel = savedMeshDetail
							savedMeshDetail = nil
						end
					end)
					pcall(function()
						local terrain = workspace:FindFirstChildOfClass("Terrain")
						if terrain and savedTerrain then
							for prop, value in pairs(savedTerrain) do
								pcall(function() terrain[prop] = value end)
							end
						end
						savedTerrain = nil
					end)
					task.spawn(restoreAll, token)
				end
			end
		end

		-- ==========================================
		-- GAME VOLUME: scales game and SFX sounds only. Voice chat is not made of Sound instances,
		-- so it is not affected. Sounds that already belong to a game-made SoundGroup are left alone.
		-- ==========================================
		-- (declared above) setGameVolume
		do
			-- Ungrouped sounds are routed through one SoundGroup. Sounds that already belong to a game-made
			-- SoundGroup (music / SFX groups) get their own Volume scaled instead. A sound whose volume the
			-- game changes later is re-scaled from its new value. Voice chat is not made of Sound instances.
			local volumeGroup = Instance.new("SoundGroup")
			volumeGroup.Name = "ApexGameVolume"
			volumeGroup.Volume = 1
			volumeGroup.Parent = SoundService

			local percent = 100
			local managed = setmetatable({}, {__mode = "k"}) -- sounds routed through volumeGroup
			local scaled = {} -- [sound] = {orig = base volume, set = applied volume, conn = signal}
			local conns = {}
			local active = false

			local function applyScale(snd, entry)
				entry.set = entry.orig * (percent / 100)
				snd.Volume = entry.set
			end

			local function unscale(snd)
				local entry = scaled[snd]
				if entry then
					scaled[snd] = nil
					if entry.conn then entry.conn:Disconnect() end
					pcall(function() snd.Volume = entry.orig end)
				end
			end

			local function manage(inst)
				if not inst:IsA("Sound") then return end
				if inst:GetAttribute("ApexIgnoreGameVolume") then return end -- the music player
				local group = inst.SoundGroup
				if group == nil then
					managed[inst] = true
					inst.SoundGroup = volumeGroup
				elseif group ~= volumeGroup and not scaled[inst] then
					local entry = {orig = inst.Volume}
					scaled[inst] = entry
					entry.conn = inst:GetPropertyChangedSignal("Volume"):Connect(function()
						if inst.Volume ~= entry.set then
							entry.orig = inst.Volume -- the game changed it: that is the new base volume
							applyScale(inst, entry)
						end
					end)
					applyScale(inst, entry)
				end
			end

			local function startManaging()
				if active then return end
				active = true
				local roots = {workspace, SoundService, Lighting, game:GetService("ReplicatedStorage"), LocalPlayer}
				for _, root in ipairs(roots) do
					for _, inst in ipairs(root:GetDescendants()) do pcall(manage, inst) end
					conns[#conns + 1] = root.DescendantAdded:Connect(function(inst) pcall(manage, inst) end)
					-- a sound that moves keeps its original volume so it never gets scaled twice
					conns[#conns + 1] = root.DescendantRemoving:Connect(function(inst)
						if inst:IsA("Sound") then unscale(inst) end
					end)
				end
			end

			-- at 100% every sound is released again, so nothing is left modified
			local function stopManaging()
				if not active then return end
				active = false
				for _, c in ipairs(conns) do c:Disconnect() end
				conns = {}
				for snd in pairs(managed) do
					managed[snd] = nil
					if snd.Parent and snd.SoundGroup == volumeGroup then
						pcall(function() snd.SoundGroup = nil end)
					end
				end
				local list = {}
				for snd in pairs(scaled) do list[#list + 1] = snd end
				for _, snd in ipairs(list) do unscale(snd) end
			end

			setGameVolume = function(value)
				percent = math.clamp(tonumber(value) or 100, 0, 100)
				if percent >= 100 then
					volumeGroup.Volume = 1
					stopManaging()
				else
					startManaging()
					volumeGroup.Volume = percent / 100
					for snd, entry in pairs(scaled) do applyScale(snd, entry) end
				end
			end

			ScreenGui.Destroying:Connect(function()
				stopManaging()
				volumeGroup:Destroy()
			end)
		end

	end)()

	-- ==========================================
	-- UI Element Registration (Tabs)
	-- ==========================================
	local function onFpsBooster(state)
		fpsBoosterEnabled = state
		setFpsBooster(state)
	end

	;(function() -- own function: keeps the local variable count of loadMainHub low
		-- ROUND TIMER: PlayerGui.MainGUI.Game.Timer.XPText is always shown (on phones the game's own layout hides it or the
		-- text is too big for its box). The text shrinks to fit its box (never above the size the game uses), and a hide
		-- by the game is undone at once.
		local fixed = setmetatable({}, {__mode = "k"})
		local cacheLabel, cacheTimer, lastSearch = nil, nil, -10
		local function findParts()
			if cacheLabel and cacheLabel.Parent then return cacheTimer, cacheLabel end
			if os.clock() - lastSearch < 1 then return nil end
			lastSearch = os.clock()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if not pg then return nil end
			local main = pg:FindFirstChild("MainGUI")
			local gameGui = main and main:FindFirstChild("Game")
			local timer = gameGui and gameGui:FindFirstChild("Timer")
			local label = timer and timer:FindFirstChild("XPText")
			if not label then -- other layouts (phone): the XPText label wherever it is
				label = (main or pg):FindFirstChild("XPText", true) or pg:FindFirstChild("XPText", true)
				timer = label and label.Parent
			end
			if label and (label:IsA("TextLabel") or label:IsA("TextButton")) and timer then
				cacheLabel, cacheTimer = label, timer
				return timer, label
			end
			return nil
		end
		local function enforce(timer, label)
			if timer:IsA("GuiObject") and not timer.Visible then timer.Visible = true end
			if not label.Visible then label.Visible = true end
			if label.TextTransparency > 0 then label.TextTransparency = 0 end
			if not label.TextScaled then label.TextScaled = true end
			if label.TextWrapped then label.TextWrapped = false end
		end
		local function fix(timer, label)
			if fixed[label] then return end
			fixed[label] = true
			local limit = Instance.new("UITextSizeConstraint")
			limit.Name = "ApexTimerFit"
			limit.MaxTextSize = math.max(label.TextSize, 14) -- never bigger than the game's own size
			limit.MinTextSize = 8
			limit.Parent = label
			pcall(enforce, timer, label)
			for _, prop in ipairs({"Visible", "TextTransparency", "TextScaled", "TextWrapped"}) do
				label:GetPropertyChangedSignal(prop):Connect(function() pcall(enforce, timer, label) end)
			end
			if timer:IsA("GuiObject") then
				timer:GetPropertyChangedSignal("Visible"):Connect(function() pcall(enforce, timer, label) end)
			end
		end
		task.spawn(function()
			while ScreenGui.Parent do
				local timer, label = findParts()
				if timer then
					pcall(fix, timer, label)
					pcall(enforce, timer, label) -- backup when a change signal was missed
				end
				task.wait(1)
			end
		end)

		-- TIMER OVERLAY: a copy of the timer text that this script draws itself. The game's own label can be hidden,
		-- clipped or covered on phones; this copy always sits on top, shrinks to fit and can be dragged anywhere.
		-- On by default on touch devices (Visuals tab > Timer Overlay).
		local overlay = Instance.new("TextLabel", ScreenGui)
		overlay.Name = "TimerOverlay"
		overlay.AnchorPoint = Vector2.new(0.5, 0) -- centered at the top, whatever the screen size
		overlay.Size = UDim2.fromOffset(math.floor(150 * scale), math.floor(30 * scale))
		overlay.Position = UDim2.new(0.5, 0, 0, math.floor(40 * scale))
		overlay.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
		overlay.BackgroundTransparency = 0.25
		overlay.BorderSizePixel = 0
		overlay.Text = ""
		overlay.TextColor3 = Color3.fromRGB(255, 255, 255)
		overlay.Font = Enum.Font.GothamBold
		overlay.TextScaled = true
		overlay.Active = true
		overlay.Visible = false
		overlay.ZIndex = 50
		Instance.new("UICorner", overlay).CornerRadius = UDim.new(0, math.floor(8 * scale))
		local overlayLimit = Instance.new("UITextSizeConstraint", overlay)
		overlayLimit.MaxTextSize = math.max(14, math.floor(20 * scale))
		overlayLimit.MinTextSize = 8
		local overlayPad = Instance.new("UIPadding", overlay)
		overlayPad.PaddingLeft, overlayPad.PaddingRight = UDim.new(0, 6), UDim.new(0, 6)
		overlayPad.PaddingTop, overlayPad.PaddingBottom = UDim.new(0, 3), UDim.new(0, 3)
		-- dragging / clamping work with a top-left position: switch from the anchor to plain offsets first
		local function toTopLeft()
			if overlay.AnchorPoint ~= Vector2.zero then
				local p = overlay.AbsolutePosition - ScreenGui.AbsolutePosition
				overlay.AnchorPoint = Vector2.zero
				overlay.Position = UDim2.fromOffset(p.X, p.Y)
			end
		end
		overlay.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then toTopLeft() end
		end)
		attachDrag(overlay, overlay)
		ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if overlay.Visible and overlay.AnchorPoint == Vector2.zero then clampToScreen(overlay) end
		end)
		local overlayOn = UserInputService.TouchEnabled
		FloatingUi.setTimerOverlay = function(state) overlayOn = state and true or false end
		task.spawn(function()
			while ScreenGui.Parent do
				local _, label = findParts()
				if overlayOn then
					if label then
						local text = label.Text
						overlay.RichText = label.RichText
						overlay.Text = text ~= "" and text or "--"
					else
						overlay.RichText = false
						overlay.Text = "Timer: not found"
					end
				end
				if overlay.Visible ~= overlayOn then overlay.Visible = overlayOn end
				task.wait(0.2)
			end
		end)
	end)()

