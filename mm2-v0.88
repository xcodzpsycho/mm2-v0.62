-- Asset ID of the script icon (shown as a circle, also used for the reopen button)
-- Leave empty to show an "A" placeholder instead
local SCRIPT_ICON = "rbxassetid://123645319057555"
local DISCORD_LINK = "discord.gg/RHS3J44G9k"
-- AUTO RECONNECT: where the script is loaded from again after a rejoin. Put the URL you host the script at here (the same
-- link your users run with loadstring(game:HttpGet(...))()), then nobody has to set anything up and nothing has to be in
-- the autoexec folder. It only runs after a real disconnect while "Auto Reconnect" is on. The key of the key system
-- (getgenv().SCRIPT_KEY) is passed on automatically, a loader can also set getgenv().APEX_SOURCE_URL instead of this link.
local RECONNECT_SOURCE = "https://api.jnkie.com/api/v1/luascripts/public/7d531550d1a02f299efc7b309bee4b441cce97c581f28096719ba6834e0714bb/download"
local SCRIPT_VERSION = "v0.88" -- shown in the title bar, bump it with every update
-- RECONNECT KEY: normally nothing to do - the key you started the script with (getgenv().SCRIPT_KEY) is remembered at
-- startup and used again after a reconnect. Only if you still get "No key provided" after a rejoin, put your key
-- between the quotes (it is then stored in plain text in this file - do not share the file).
local RECONNECT_KEY = ""
-- the key is read at startup: key system loaders often clear getgenv().SCRIPT_KEY once the script runs, so reading it
-- only at disconnect time finds nothing and the rejoined script is started without a key
local CAPTURED_KEY = nil
pcall(function()
	local envs = {}
	if getgenv then envs[#envs + 1] = getgenv() end
	envs[#envs + 1] = _G
	if shared then envs[#envs + 1] = shared end
	for _, env in ipairs(envs) do
		for _, name in ipairs({"SCRIPT_KEY", "script_key", "ScriptKey"}) do
			local v = env[name]
			if type(v) == "string" and v ~= "" then CAPTURED_KEY = v return end
		end
	end
end)

