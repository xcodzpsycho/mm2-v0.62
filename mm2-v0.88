	local rightPosHidden = UDim2.new(1, 20, 0, rightMargin)

	local RightButtonsContainer = Instance.new("ScrollingFrame", ScreenGui)
	RightButtonsContainer.Name = "RightButtonsContainer"
	RightButtonsContainer.Size = UDim2.new(0, rightW, 1, -rightMargin * 2)
	RightButtonsContainer.Position = rightPosShown
	RightButtonsContainer.BackgroundTransparency = 1
	RightButtonsContainer.BorderSizePixel = 0
	RightButtonsContainer.ScrollBarThickness = math.max(2, math.floor(3 * scale))
	RightButtonsContainer.AutomaticCanvasSize = Enum.AutomaticSize.Y
	RightButtonsContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
	RightButtonsContainer.Visible = false

	local RightPadding = Instance.new("UIPadding", RightButtonsContainer)
