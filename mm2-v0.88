local function bindClick(button, callback)
	local debounce = false
	button.Activated:Connect(function()
		if debounce then return end
		debounce = true
		task.spawn(callback)
		task.wait(0.15)
		debounce = false
	end)
end

-- Drag helper with a safe zone: the object can never be dragged off the screen
local function makeSafeDraggable(frame)
	local dragging, startMouse, startPos = false, nil, nil
	frame.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		dragging = true
		startMouse = input.Position
		startPos = frame.AbsolutePosition - ScreenGui.AbsolutePosition
		local conn
		conn = input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				conn:Disconnect()
				dragging = false
			end
		end)
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then return end
		local delta = input.Position - startMouse
		local vp, size = ScreenGui.AbsoluteSize, frame.AbsoluteSize
		local x = math.clamp(startPos.X + delta.X, 4, math.max(4, vp.X - size.X - 4))
		local y = math.clamp(startPos.Y + delta.Y, 4, math.max(4, vp.Y - size.Y - 4))
		frame.Position = UDim2.fromOffset(x, y)
	end)
end

-- SAFE SLIDER (touch friendly), used by every slider of the hub and of the crosshair window.
-- * Touch: nothing happens until the finger has moved a few pixels. If it moves mostly UP / DOWN that was a scroll,
-- so the slider is released untouched (the page keeps scrolling). If it moves mostly SIDEWAYS the slider takes
-- over, and the page stops scrolling until the finger is lifted.
-- * Touch drags are RELATIVE: the value changes by how far the finger moved, it never jumps to the place that was
-- touched. A plain tap does nothing, so a stray touch while scrolling or resizing can not change a value.
-- * Only the finger that started the drag counts (a second finger, e.g. on a resize handle, is ignored).
-- * Mouse (PC): click and drag works like before (the value jumps to the click position).
local function attachSafeSlider(hit, track, getValue, setValue, min, max)
	local DEAD = 10 -- pixels of finger movement before the direction is decided
	local active, absoluteMode = false, false
	local activeInput, intent, startPos, startValue, scrollFrame
	local scrollLocked = false

	local function findScroll()
		local p = hit.Parent
		while p do
			if p:IsA("ScrollingFrame") then return p end
			p = p.Parent
		end
		return nil
	end

	local function finish()
		if scrollFrame and scrollLocked then
			pcall(function() scrollFrame.ScrollingEnabled = true end)
		end
		active, absoluteMode, activeInput, intent, scrollFrame, scrollLocked = false, false, nil, nil, nil, false
	end

	local function setFromAbsolute(x)
		local w = track.AbsoluteSize.X
		if w <= 0 then return end
		local alpha = math.clamp((x - track.AbsolutePosition.X) / w, 0, 1)
		setValue(min + alpha * (max - min))
	end

	hit.InputBegan:Connect(function(input)
		local kind = input.UserInputType
		if kind == Enum.UserInputType.MouseButton1 then
			if active then finish() end
			active, absoluteMode, activeInput = true, true, input
			setFromAbsolute(input.Position.X)
		elseif kind == Enum.UserInputType.Touch then
			if active then return end -- a second finger never takes over a running drag
			active, absoluteMode, activeInput, intent = true, false, input, nil
			startPos, startValue = input.Position, getValue()
			scrollFrame = findScroll()
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not active then return end
		if not hit.Parent then finish() return end
		if absoluteMode then
			if input.UserInputType == Enum.UserInputType.MouseMovement then setFromAbsolute(input.Position.X) end
			return
		end
		if input ~= activeInput then return end
		local d = input.Position - startPos
		if not intent then
			local ax, ay = math.abs(d.X), math.abs(d.Y)
			if ax < DEAD and ay < DEAD then return end
			if ax > ay * 1.3 then
				intent = "drag"
				if scrollFrame then
					scrollLocked = true
					pcall(function() scrollFrame.ScrollingEnabled = false end)
				end
			else
				finish() -- mostly vertical: it is a scroll, leave the slider alone
				return
			end
		end
		local w = track.AbsoluteSize.X
		if w > 0 then setValue(startValue + d.X / w * (max - min)) end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if not active then return end
		if input == activeInput or (absoluteMode and input.UserInputType == Enum.UserInputType.MouseButton1) then
			finish()
		end
	end)

	-- safety: if the slider disappears while it is being dragged, scrolling must come back
	hit.AncestryChanged:Connect(function()
		if not hit.Parent then finish() end
	end)
end

-- NUMBER INPUT MODE: every numeric setting (sliders of the hub, the right button bar and the crosshair window) can be
-- shown as a slider or as a textbox. Settings > "Number Input" switches all of them at once (saved as "input_mode").
local NumericInput = {mode = "Sliders", appliers = {}}
function NumericInput.register(applyFn)
	NumericInput.appliers[#NumericInput.appliers + 1] = applyFn
	pcall(applyFn)
end
function NumericInput.setMode(mode)
	if mode ~= "Textboxes" then mode = "Sliders" end
	NumericInput.mode = mode
	for _, applyFn in ipairs(NumericInput.appliers) do pcall(applyFn) end
end

-- the textbox of one numeric row. setValue clamps / rounds; anything that is not a number restores the old value.
local function makeNumberBox(row, textSize, scale, zIndex, getValue, setValue)
	local box = Instance.new("TextBox")
	box.Name = "NumberBox"
	box.AnchorPoint = Vector2.new(1, 0.5)
	box.Position = UDim2.new(1, -math.floor(8 * scale), 0.5, 0)
	box.Size = UDim2.new(0.34, 0, 0, math.max(18, math.floor(24 * scale)))
	box.BackgroundColor3 = Color3.fromRGB(55, 55, 68)
	box.BorderSizePixel = 0
	box.TextColor3 = Color3.fromRGB(255, 255, 255)
	box.TextSize = textSize
	box.Font = Enum.Font.GothamBold
	box.TextXAlignment = Enum.TextXAlignment.Center
	box.ClearTextOnFocus = false
	box.Text = tostring(getValue())
	box.Visible = false
	if zIndex then box.ZIndex = zIndex end
	box:SetAttribute("NoTranslate", true)
	Instance.new("UICorner", box).CornerRadius = UDim.new(0, math.floor(5 * scale))
	box.Parent = row
	box.FocusLost:Connect(function()
		local text = box.Text:gsub("%s", ""):gsub(",", ".")
		local n = tonumber(text)
		if n then pcall(setValue, n) end
		box.Text = tostring(getValue())
	end)
	return box
end

