	end, true, underMapEnabled)
	createRightSpeedInput("Under Map Depth:", underMapDepth, 8, 40, function(val) underMapDepth = val end)
	createRightSpeedInput("Under Map Touch (ms):", coinUi.touch, 60, 600, function(val) coinUi.touch = val end)
	createRightButton("Hide Under Map When Done", function(state)
