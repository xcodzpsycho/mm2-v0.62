-- ==========================================
-- STORAGE (DataStore first, then executor files, then memory)
-- ==========================================
-- Roblox only allows DataStore access from the server, so a normal client script cannot use it.
-- The script still tries it first (it works in environments that allow it, e.g. Studio) and
-- otherwise falls back to executor file functions (writefile) and finally to memory.
local Storage = {backend = "Memory"}
do
	local DataStoreService = game:GetService("DataStoreService")
	local FILE_DIR = "APEX_MM2"
	local userKey = tostring(LocalPlayer.UserId)
	local memory = {}
	local store

	pcall(function()
		local ds = DataStoreService:GetDataStore("APEX_MM2_" .. userKey) -- one DataStore per user
		ds:GetAsync("probe_" .. userKey) -- throws when DataStores are not available to this script
		store = ds
	end)

	local hasFs = type(writefile) == "function" and type(readfile) == "function"
	and type(isfile) == "function" and type(delfile) == "function"
	and type(isfolder) == "function" and type(makefolder) == "function"

	if store then
		Storage.backend = "DataStore"
	elseif hasFs then
		Storage.backend = "File"
	end

	local function fullKey(key) return userKey .. "_" .. key end
	local USER_DIR = FILE_DIR .. "/" .. userKey -- every account gets its own folder
	local function filePath(key) return USER_DIR .. "/" .. key .. ".json" end
	local function legacyFilePath(key) return FILE_DIR .. "/" .. fullKey(key) .. ".json" end -- older flat layout

	function Storage.get(key)
		local result
		pcall(function()
			if Storage.backend == "DataStore" then
				result = store:GetAsync(fullKey(key))
			elseif Storage.backend == "File" then
				local path = filePath(key)
				if not isfile(path) then path = legacyFilePath(key) end -- settings saved by an older version
				if isfile(path) then
					result = HttpService:JSONDecode(readfile(path))
				end
			else
				local raw = memory[fullKey(key)]
				if raw then result = HttpService:JSONDecode(raw) end
			end
		end)
		return result
	end

	function Storage.set(key, value)
		return (pcall(function()
			if Storage.backend == "DataStore" then
				store:SetAsync(fullKey(key), value)
			elseif Storage.backend == "File" then
				if not isfolder(FILE_DIR) then makefolder(FILE_DIR) end
				if not isfolder(USER_DIR) then makefolder(USER_DIR) end
				writefile(filePath(key), HttpService:JSONEncode(value))
			else
				memory[fullKey(key)] = HttpService:JSONEncode(value)
			end
		end))
	end

	function Storage.delete(key)
		return (pcall(function()
			if Storage.backend == "DataStore" then
				store:RemoveAsync(fullKey(key))
			elseif Storage.backend == "File" then
				if isfile(filePath(key)) then delfile(filePath(key)) end
				if isfile(legacyFilePath(key)) then delfile(legacyFilePath(key)) end
			else
				memory[fullKey(key)] = nil
			end
		end))
	end
end

-- TRANSLATOR (language selector in the Settings tab)
-- Translates every text of the script window into the chosen language with an online translation service
-- (needs an executor with HTTP requests). Each text is translated once and the result is saved per language,
-- so the next start is instant. The English text always stays the source, so switching back to English is
-- instant as well. Numbers inside a text are kept as they are.
local Translator = (function()
	local T = {code = "en"}
	T.languages = {
		{"English", "en"}, {"Deutsch", "de"}, {"Español", "es"}, {"Français", "fr"}, {"Italiano", "it"},
	}
	T.names, T.codeOf, T.nameOf = {}, {}, {}
	local langNameSet = {}
	for _, l in ipairs(T.languages) do
		T.names[#T.names + 1] = l[1]
		T.codeOf[l[1]] = l[2]
		T.nameOf[l[2]] = l[1]
		langNameSet[l[1]] = true
	end

	-- Speed: texts are sent in batches (many texts in ONE request, joined by line breaks), several requests run at the
	-- same time, and texts that are on screen right now are translated first.
	local MAX_WORKERS = 6
	local MAX_BATCH = 30 -- texts per request
	local MAX_BATCH_CHARS = 1100 -- keeps the request URL short enough
	local state = setmetatable({}, {__mode = "k"}) -- [text object] = {en = original text, shown = text on screen}
	local cache = {} -- English text -> translation (current language only)
	local waiting, queue, queued, retries = {}, {}, {}, {}
	local workers, dirty, warned, scheduled = 0, false, false, false
	local enqueue

	-- Words that are never translated: "APEX" and the names of the players (username and display name).
	-- Words that appear in the fixed texts of the window (like "Fly") are not treated as player names.
	local PROTECTED_WORDS = {"APEX"}
	local staticWords = {}
	local protectedList, protectedStamp = nil, 0

	-- HTTP through whatever the executor offers. Some services refuse requests without a browser-like User-Agent,
	-- which is a common reason for "translation request failed", so one is always sent.
	local HEADERS = {["User-Agent"] = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"}
	local function httpRequest(url, method, body)
		local req = (syn and syn.request) or request or http_request or (http and http.request) or (fluxus and fluxus.request)
		if req then
			local opts = {Url = url, Method = method or "GET", Headers = HEADERS}
			if body then
				opts.Body = body
				opts.Headers = {["User-Agent"] = HEADERS["User-Agent"], ["Content-Type"] = "application/x-www-form-urlencoded"}
			end
			local ok, res = pcall(req, opts)
			if ok and res and type(res.Body) == "string" and res.Body ~= "" and (res.StatusCode == 200 or res.Success == true) then
				return res.Body
			end
			return nil
		end
		if method == "POST" then return nil end
		local ok, text = pcall(function() return game:HttpGet(url) end)
		if ok and type(text) == "string" and text ~= "" then return text end
		return nil
	end

	local function decode(body)
		if not body then return nil end
		local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
		if ok then return data end
		return nil
	end

	-- answer of translate_a/single: [[["translated","original",...], ...], ...]
	local function parseSingle(body)
		local data = decode(body)
		if type(data) ~= "table" or type(data[1]) ~= "table" then return nil end
		local out = {}
		for _, seg in ipairs(data[1]) do
			if type(seg) == "table" and type(seg[1]) == "string" then out[#out + 1] = seg[1] end
		end
		local result = table.concat(out)
		if result == "" then return nil end
		return result
	end

	-- Several services, tried one after the other (the one that worked last time first). A single service failing, being
	-- blocked by the executor or refusing the request no longer means that translating does not work.
	local ENDPOINTS = {
		function(text, code) -- Google, GET
			return parseSingle(httpRequest("https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=" .. code
				.. "&dt=t&q=" .. HttpService:UrlEncode(text)))
		end,
		function(text, code) -- Google, POST (no limit on the length of the URL)
			return parseSingle(httpRequest("https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=" .. code .. "&dt=t",
				"POST", "q=" .. HttpService:UrlEncode(text)))
		end,
		function(text, code) -- Google web address
			return parseSingle(httpRequest("https://translate.google.com/translate_a/single?client=gtx&sl=en&tl=" .. code
				.. "&dt=t&q=" .. HttpService:UrlEncode(text)))
		end,
		function(text, code) -- Google Chrome extension service
			local data = decode(httpRequest("https://clients5.google.com/translate_a/t?client=dict-chrome-ex&sl=en&tl=" .. code
				.. "&q=" .. HttpService:UrlEncode(text)))
			if type(data) ~= "table" then return nil end
			local first = data[1]
			if type(first) == "table" then first = first[1] end
			if type(first) == "string" and first ~= "" then return first end
			return nil
		end,
		function(text, code) -- Lingva (single texts only)
			if text:find("\n") then return nil end
			local lc = (code == "zh-CN" and "zh") or (code == "zh-TW" and "zh_HANT") or code
			local data = decode(httpRequest("https://lingva.ml/api/v1/en/" .. lc .. "/" .. HttpService:UrlEncode(text)))
			if type(data) == "table" and type(data.translation) == "string" and data.translation ~= "" then return data.translation end
			return nil
		end,
		function(text, code) -- MyMemory (single short texts only)
			if text:find("\n") or #text > 450 then return nil end
			local data = decode(httpRequest("https://api.mymemory.translated.net/get?q=" .. HttpService:UrlEncode(text) .. "&langpair=en|" .. code))
			local r = type(data) == "table" and type(data.responseData) == "table" and data.responseData.translatedText
			if type(r) == "string" and r ~= "" and not r:find("MYMEMORY WARNING", 1, true) then return r end
			return nil
		end,
	}
	local preferred = 1

	-- one request: English text (may contain line breaks) -> language code (nil when every service failed)
	function T.fetch(text, code)
		for i = 0, #ENDPOINTS - 1 do
			local idx = ((preferred - 1 + i) % #ENDPOINTS) + 1
			local ok, result = pcall(ENDPOINTS[idx], text, code)
			if ok and result then
				preferred = idx
				return result
			end
		end
		return nil
	end

	-- several texts in one request. Returns {text = translation} or nil plus the reason:
	-- "http" (request failed) or "split" (the answer did not have one line per text, so the batch gets split up)
	function T.fetchMany(keys, code)
		if #keys == 1 then
			local r = T.fetch(keys[1], code)
			if r then return {[keys[1]] = r} end
			return nil, "http"
		end
		-- every line carries its number ("[3] text"); an answer in which a number is missing / doubled / changed is
		-- never used (the batch is split up instead), so a translation can not end up on the wrong text
		local numbered = {}
		for i, key in ipairs(keys) do numbered[i] = "[" .. i .. "] " .. key end
		local joined = T.fetch(table.concat(numbered, "\n"), code)
		if not joined then return nil, "http" end
		local map, count = {}, 0
		for line in (joined .. "\n"):gmatch("(.-)\r?\n") do
			if line:find("%S") then
				local idx, text = line:match("^%[%s*(%d+)%s*%]%s*(.-)%s*$")
				idx = tonumber(idx)
				local key = idx and keys[idx]
				if not key or text == "" or map[key] ~= nil then return nil, "split" end
				map[key] = text
				count += 1
			end
		end
		if count ~= #keys then return nil, "split" end
		return map
	end

	-- splits a text into: spaces in front, the part that is translated, and the part that stays (numbers ...)
	function T.split(text)
		local lead, core, tail = text:match("^(%s*)(.-)(%s*)$") if core == "" or not core:find("%a") then return nil end local key, rest = core, "" local head = core:match("^(%D*%a%D*)%d") if head then key = head:match("^(.-)%s*$")
			rest = core:sub(#key + 1)
		end
		if key == "" or not key:find("%a") or langNameSet[key] then return nil end
		if not key:find("%l") and #key <= 5 then return nil end -- "MM", "TP", "FOV" ... stay as they are
		return lead, key, rest .. tail
	end

	local function protectedTokens()
		if protectedList and os.clock() - protectedStamp < 3 then return protectedList end
		local list, seen = {}, {}
		for _, w in ipairs(PROTECTED_WORDS) do seen[w] = true; list[#list + 1] = w end
		local function add(w, always)
			if type(w) == "string" and #w >= 2 and not seen[w] and (always or not staticWords[w]) then
				seen[w] = true
				list[#list + 1] = w
			end
		end
		add(LocalPlayer.Name, true)
		add(LocalPlayer.DisplayName, true)
		for _, p in ipairs(Players:GetPlayers()) do
			add(p.Name)
			add(p.DisplayName)
		end
		protectedList, protectedStamp = list, os.clock()
		return list
	end

	-- cuts a text into pieces: {text, keep}. keep = true for protected words (whole words only)
	local function splitProtected(text)
		local spans = {}
		for _, tok in ipairs(protectedTokens()) do
			local init = 1
			while true do
				local s, e = text:find(tok, init, true)
				if not s then break end
				local before = s > 1 and text:sub(s - 1, s - 1) or ""
				local after = text:sub(e + 1, e + 1)
				if not before:match("[%w_]") and not after:match("[%w_]") then
					spans[#spans + 1] = {s, e}
				end
				init = e + 1
			end
		end
		if #spans == 0 then return nil end
		table.sort(spans, function(a, b)
			if a[1] ~= b[1] then return a[1] < b[1] end
			return a[2] > b[2]
		end)
		local parts, pos = {}, 1
		for _, sp in ipairs(spans) do
			if sp[1] >= pos then
				if sp[1] > pos then parts[#parts + 1] = {text = text:sub(pos, sp[1] - 1), keep = false} end
				parts[#parts + 1] = {text = text:sub(sp[1], sp[2]), keep = true}
				pos = sp[2] + 1
			end
		end
		if pos <= #text then parts[#parts + 1] = {text = text:sub(pos), keep = false} end
		return parts
	end


	local function show(obj, text)
		local st = state[obj]
		if not st then return end
		st.shown = text
		if obj.Text ~= text then obj.Text = text end
		-- the font is never changed: only Latin languages are offered, and the original font of every text stays as it is
	end

	-- NoTranslate on the object or on one of its parents
	local function isExcluded(obj)
		local cur, depth = obj, 0
		while cur and cur ~= T.gui and depth < 8 do
			if cur:GetAttribute("NoTranslate") then return true end
			cur = cur.Parent
			depth += 1
		end
		return false
	end

	-- true when the object is on screen right now (it is translated first)
	local function isShown(obj)
		local cur = obj
		while cur and cur ~= T.gui do
			if cur:IsA("GuiObject") and not cur.Visible then return false end
			cur = cur.Parent
		end
		return cur == T.gui
	end

	-- the translated text, or nil while parts are still missing (they are queued, and the object is updated on arrival)
	local function compose(text, obj, front)
		local parts = splitProtected(text) or {{text = text, keep = false}}
		local out, missing = {}, false
		for _, part in ipairs(parts) do
			if part.keep then
				out[#out + 1] = part.text
			else
				local lead, key, rest = T.split(part.text)
				if not key then
					out[#out + 1] = part.text
				else
					local tr = cache[key]
					if tr then
						out[#out + 1] = lead .. tr .. rest
					else
						missing = true
						waiting[key] = waiting[key] or {}
						waiting[key][obj] = true
						enqueue(key, front)
						out[#out + 1] = part.text
					end
				end
			end
		end
		if missing then return nil end
		return table.concat(out)
	end

	local function translateObject(obj)
		local st = state[obj]
		if not st then return end
		if T.code == "en" or isExcluded(obj) then
			show(obj, st.en)
			return
		end
		show(obj, compose(st.en, obj, isShown(obj)) or st.en) -- English until the translation arrives
	end

	local function applyTranslation(key, tr, code)
		if code ~= T.code then return end
		cache[key] = tr
		dirty = true
		local objs = waiting[key]
		waiting[key] = nil
		if objs then
			for obj in pairs(objs) do translateObject(obj) end
		end
		if key == "Language" then T.refreshDropdown() end
	end

	local function processBatch(batch, code)
		local map, why = T.fetchMany(batch, code)
		if code ~= T.code then return end
		if map then
			for _, key in ipairs(batch) do
				queued[key] = nil
				applyTranslation(key, map[key], code)
			end
		elseif why == "split" and #batch > 1 then
			local mid = math.ceil(#batch / 2)
			local a, b = {}, {}
			for i, key in ipairs(batch) do
				if i <= mid then a[#a + 1] = key else b[#b + 1] = key end
			end
			processBatch(a, code)
			processBatch(b, code)
		else
			if not warned then
				warned = true
				warn("APEX: translation request failed (does your executor allow HTTP requests?)")
			end
			for _, key in ipairs(batch) do
				queued[key] = nil
				retries[key] = (retries[key] or 0) + 1
				if retries[key] < 3 then
					task.delay(1.5, function()
						if code == T.code then enqueue(key) end
					end)
				end
			end
		end
	end

	local function takeBatch()
		local first = table.remove(queue, 1)
		if not first then return nil end
		local batch = {first}
		if first:find("\n") then return batch end
		local size = #first + 3
		while #batch < MAX_BATCH do
			local nxt = queue[1]
			if not nxt or nxt:find("\n") or size + #nxt + 3 > MAX_BATCH_CHARS then break end
			table.remove(queue, 1)
			batch[#batch + 1] = nxt
			size += #nxt + 3
		end
		return batch
	end

	local function worker()
		while true do
			local batch = takeBatch()
			if not batch then break end
			local ok = pcall(processBatch, batch, T.code)
			if not ok then
				for _, key in ipairs(batch) do queued[key] = nil end
			end
		end
		workers -= 1
	end

	-- workers start one step later, so a whole screen of texts is collected first and leaves in few big requests
	local function startWorkers()
		scheduled = false
		if #queue == 0 then return end
		local need = math.min(MAX_WORKERS, math.max(1, math.ceil(#queue / 10)))
		for _ = 1, need - workers do -- a fixed number of starts (a worker that ends at once must not loop this)
			workers += 1
			task.spawn(worker)
		end
	end

	enqueue = function(key, front)
		if queued[key] then return end
		queued[key] = true
		if front then table.insert(queue, 1, key) else queue[#queue + 1] = key end
		if not scheduled then
			scheduled = true
			task.defer(startWorkers)
		end
	end

	-- the Language dropdown shows the chosen language and the translated word "Language"
	function T.attachDropdown(btn)
		btn:SetAttribute("NoTranslate", true)
		T.dropBtn = btn
		T.refreshDropdown()
	end

	function T.refreshDropdown()
		local btn = T.dropBtn
		if btn and btn.Parent then
			local word = (T.code ~= "en" and cache["Language"]) or "Language"
			btn.Text = " " .. word .. ": " .. (T.nameOf[T.code] or "English")
		end
	end

	function T.setLanguage(code, dontSave)
		if not T.nameOf[code] then code = "en" end
		T.code = code
		table.clear(queue)
		table.clear(queued)
		table.clear(waiting)
		table.clear(retries)
		warned = false
		local saved = (code ~= "en") and Storage.get("lang_" .. code) or nil
		cache = type(saved) == "table" and saved or {}
		dirty = false
		if not dontSave then pcall(Storage.set, "language", code) end
		if code ~= "en" and not cache["Language"] then enqueue("Language", true) end
		for obj in pairs(state) do translateObject(obj) end
		T.refreshDropdown()
	end

	local function track(obj)
		if state[obj] or not (obj:IsA("TextLabel") or obj:IsA("TextButton")) then return end
		if obj:GetAttribute("NoTranslate") then return end
		local text = obj.Text
		if text ~= "" and not text:find("%a") then return end -- symbols / digits only (arrows, effects ...)
		local st = {en = text, shown = text}
		state[obj] = st
		obj:GetPropertyChangedSignal("Text"):Connect(function()
			local cur = obj.Text
			if cur == st.shown then return end -- that was our own change
			st.en, st.shown = cur, cur -- the script set a new text: this is the new original
			if T.code ~= "en" then translateObject(obj) end
		end)
		if T.code ~= "en" then translateObject(obj) end
	end

	function T.init(gui)
		if T.gui == gui then return end
		T.gui = gui
		for _, d in ipairs(gui:GetDescendants()) do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				for w in d.Text:gmatch("[%w_]+") do staticWords[w] = true end
			end
		end
		for _, d in ipairs(gui:GetDescendants()) do track(d) end
		gui.DescendantAdded:Connect(track)
		local saved = Storage.get("language")
		T.setLanguage(type(saved) == "string" and saved or "en", true)
	end

	task.spawn(function()
		while true do
			task.wait(4)
			if dirty and T.code ~= "en" then
				dirty = false
				pcall(Storage.set, "lang_" .. T.code, cache)
			end
		end
	end)

	return T
end)()

