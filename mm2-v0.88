	-- Tab: Trading (value list from supremevalues.com/mm2/<category>)
	usePage("Trading")
	;(function()
		local CATS = {"Rares", "Legendaries", "Godlies", "Chromas", "Vintages", "Ancients", "Evos", "Uniques", "Sets"}
		local BASE = "https://supremevalues.com/mm2/"
		local UA = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36"
		local MAXROWS = 80
		local CACHE_SECONDS = 600
		local ts = math.max(9, math.floor(11 * scale))
		local tsSmall = math.max(8, math.floor(9 * scale))
		local rowH = math.floor(40 * scale)
		local WHITE, GRAY = Color3.fromRGB(255, 255, 255), Color3.fromRGB(150, 156, 168)

		local function mk(class, props, parent, noTranslate)
			local o = Instance.new(class)
			for k, v in pairs(props) do o[k] = v end
			if noTranslate then o:SetAttribute("NoTranslate", true) end
			o.Parent = parent
			return o
		end

		-- ---------- download ----------
		local function httpGet(url)
			local req = (syn and syn.request) or request or http_request or (http and http.request) or (fluxus and fluxus.request)
			if req then
				local ok, res = pcall(req, {Url = url, Method = "GET", Headers = {["User-Agent"] = UA, ["Accept"] = "text/html,application/json"}})
				if ok and res then
					if type(res.Body) == "string" and res.Body ~= "" and (res.StatusCode == 200 or res.Success == true) then return res.Body end
					return nil, res.StatusCode
				end
				return nil, "request failed"
			end
			local ok, body = pcall(function() return game:HttpGet(url) end)
			if ok and type(body) == "string" and body ~= "" then return body end
			return nil, "no HTTP support"
		end

		-- ---------- parsing ----------
		local ENT = {amp = "&", lt = "<", gt = ">", quot = '"', apos = "'", nbsp = " "}
		local function decodeEntities(s)
			s = s:gsub("&#(%d+);", function(n) local c = tonumber(n) return c and c < 1114112 and utf8.char(c) or "" end)
			s = s:gsub("&#[xX](%x+);", function(h) local c = tonumber(h, 16) return c and c < 1114112 and utf8.char(c) or "" end)
			s = s:gsub("&(%a+);", function(n) return ENT[n] or ("&" .. n .. ";") end)
			return s
		end

		local function toLines(html)
			html = html:gsub("<!%-%-.-%-%->", "")
			html = html:gsub("<[Ss][Cc][Rr][Ii][Pp][Tt].-</[Ss][Cc][Rr][Ii][Pp][Tt]>", "")
			html = html:gsub("<[Ss][Tt][Yy][Ll][Ee].-</[Ss][Tt][Yy][Ll][Ee]>", "")
			html = html:gsub("<[^>]*>", "\n")
			html = decodeEntities(html)
			local lines = {}
			for line in (html .. "\n"):gmatch("(.-)\r?\n") do
				line = line:gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
				if line ~= "" then lines[#lines + 1] = line end
			end
			return lines
		end

		-- 1) data embedded as JSON in the page (script tags / __NEXT_DATA__)
		local function plain(v)
			if type(v) == "table" then
				v = v.name or v.text or v.label or v.value or v.title
				if type(v) == "table" then return nil end
			end
			if v == nil then return nil end
			return tostring(v)
		end
		local function pick(e, keys)
			for _, k in ipairs(keys) do
				local v = e[k]
				if v ~= nil and type(v) ~= "table" then return v end
			end
			return nil
		end
		-- any key that contains the word (demand, demandRating, item_demand, Stability ...)
		local function pickLike(e, word)
			for k, v in pairs(e) do
				if type(k) == "string" and k:lower():find(word, 1, true) then
					local p = plain(v)
					if p and p ~= "" then return p end
				end
			end
			return nil
		end
		local function walk(node, depth)
			if depth > 9 or type(node) ~= "table" then return nil end
			if #node >= 3 and type(node[1]) == "table" then
				local found = {}
				for _, e in ipairs(node) do
					if type(e) == "table" then
						local n = pick(e, {"name", "Name", "title", "itemName", "item_name", "item"})
						local v = pick(e, {"value", "Value", "val", "worth", "price"})
						if n ~= nil and v ~= nil then
							found[#found + 1] = {
								name = tostring(n), value = tostring(v),
								demand = pickLike(e, "demand") or pickLike(e, "popular"),
								stability = pickLike(e, "stab") or pickLike(e, "trend"),
							}
						end
					end
				end
				if #found >= 3 then return found end
			end
			for _, child in pairs(node) do
				local r = walk(child, depth + 1)
				if r then return r end
			end
			return nil
		end
		local function parseJson(html)
			for body in html:gmatch("<[Ss][Cc][Rr][Ii][Pp][Tt][^>]*>(.-)</[Ss][Cc][Rr][Ii][Pp][Tt]>") do
				local first = body:match("^%s*(.)")
				if first == "{" or first == "[" then
					local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
					if ok and type(data) == "table" then
						local found = walk(data, 0)
						if found then return found end
					end
				end
			end
			return nil
		end

		-- 2) readable text of the page: "Name", then Value / Demand / Stability (label and number on the same line or the next)
		local LABELS = {value = "value", demand = "demand", popularity = "demand", stability = "stability", trend = "stability", trending = "stability", status = "stability"}
		local STABLE_WORDS = {stable = true, unstable = true, rising = true, falling = true, fluctuating = true, declining = true, improving = true,
			dropping = true, recovering = true, overpaid = true, underpaid = true, ["doing well"] = true, ["slowly dropping"] = true,
			["slowly rising"] = true, ["unstable value"] = true, ["very stable"] = true, ["getting higher"] = true, ["getting lower"] = true}
		local function labelOf(line)
			local lab, sep, rest = line:match("^(%a+)%s*([:%-]?)%s*(.*)$")
			if not lab then return nil end
			local key = LABELS[lab:lower()]
			if not key then return nil end
			if sep ~= "" or rest == "" or rest:match("^%d") or key ~= "value" then return key, rest end
			return nil
		end
		local function parseText(html)
			local lines = toLines(html)
			local items, cur, lastText = {}, nil, nil
			local i = 1
			while i <= #lines do
				local key, rest = labelOf(lines[i])
				if key then
					if rest == "" and lines[i + 1] and not labelOf(lines[i + 1]) then
						rest = lines[i + 1]
						i += 1
					end
					if not cur then
						cur = {name = lastText or "?"}
						items[#items + 1] = cur
					end
					if cur[key] == nil and rest ~= "" then cur[key] = rest end
					lastText = nil
				else
					local line = lines[i]
					-- an unlabeled line inside an item: a stability word or a "x/10" demand is picked up, anything else is skipped.
					-- It only starts a new item when a label follows within the next two lines.
					local startsNew = labelOf(lines[i + 1] or "") or labelOf(lines[i + 2] or "")
					if cur and not startsNew then
						local low = line:lower()
						if cur.stability == nil and STABLE_WORDS[low] then
							cur.stability = line
						elseif cur.demand == nil and line:match("^%d+%s*/%s*%d+$") then
							cur.demand = line
						end
					else
						cur = nil
						lastText = line
					end
				end
				i += 1
			end
			local out = {}
			for _, it in ipairs(items) do
				if it.value and it.name ~= "?" and #it.name <= 60 then out[#out + 1] = it end
			end
			return out
		end

		local function hasExtra(list)
			for _, it in ipairs(list) do
				if it.demand or it.stability then return true end
			end
			return false
		end
		-- the site's own layout: <div class="itemcolumn" data-stability="Stable" data-value="1875" data-demand="5" ...>
		-- with the item name in <a class="itemlink"> (or the id of the "itemcell")
		local function parseCards(html)
			local starts, items = {}, {}
			local init = 1
			while true do
				local s1, e1, attrs = html:find('<div class="itemcolumn[^"]*"([^>]*)>', init)
				if not s1 then break end
				starts[#starts + 1] = {s = s1, e = e1, attrs = attrs}
				init = e1 + 1
			end
			for i, c in ipairs(starts) do
				local block = html:sub(c.e + 1, (starts[i + 1] and starts[i + 1].s or #html + 1) - 1)
				local data = {}
				for k, v in c.attrs:gmatch('data%-([%w%-]+)="([^"]*)"') do data[k] = v end
				local name = block:match('class="itemlink"[^>]*>(.-)</a>') or block:match('class="itemcell"[^>]-id="([^"]+)"') or block:match('id="([^"]+)"[^>]-class="itemcell"') or block:match('<div class="itemcell"%s+id="([^"]+)"')
				if name then
					name = decodeEntities(name:gsub("<[^>]*>", "")):gsub("^%s+", ""):gsub("%s+$", "")
					local shown = block:match('class="itemvalue[^"]*"[^>]*>(.-)</b>')
					local value = shown and decodeEntities(shown:gsub("<[^>]*>", "")):gsub("%s+", "") or data.value
					if name ~= "" and value and value ~= "" then
						local demand = data.demand
						if not demand then
							local d = block:match("Demand%s*%-%s*<b[^>]*>(.-)</b>")
							demand = d and d:gsub("<[^>]*>", "")
						end
						local stability = data.stability
						if not stability then
							local st = block:match('class="itemstability[^"]*"[^>]*>(.-)</b>')
							stability = st and st:gsub("<[^>]*>", "")
						end
						if demand and demand:match("^%d+%.?%d*$") then demand = demand .. "/10" end
						items[#items + 1] = {name = name, value = value, demand = demand, stability = stability, raw = (c.attrs .. " " .. block):sub(1, 700), src = "cards", hidden = c.attrs:find("display%s*:%s*none") ~= nil, event = data.event, year = data.year}
					end
				end
			end
			return items
		end

		local function parsePage(html)
			local cards = parseCards(html)
			if #cards > 0 then return cards end
			local items = parseJson(html)
			if items then for _, it in ipairs(items) do it.src = "json" end end
			-- JSON found but without demand / stability (e.g. only a name + value search list): read the visible page text too
			if not items or #items == 0 or not hasExtra(items) then
				local fromText = parseText(html)
				if not items or #items == 0 then
					items = fromText
				elseif hasExtra(fromText) then
					local byName = {}
					for _, it in ipairs(fromText) do byName[it.name:lower()] = it end
					for _, it in ipairs(items) do
						local t = byName[it.name:lower()]
						if t then
							it.demand = it.demand or t.demand
							it.stability = it.stability or t.stability
						end
					end
				end
			end
			return items
		end

		-- ---------- data ----------
		local cache, lastRaw = {}, {}
		local current, query, failNote = "All", "", ""
		local loading, started = false, false
		local rows = {}
		local statusLabel, listScroll

		local function setStatus(text, bad)
			if statusLabel then
				statusLabel.Text = text
				statusLabel.TextColor3 = bad and Color3.fromRGB(235, 110, 110) or GRAY
			end
		end

		-- a hidden (display:none) card is a placeholder: drop it when the same name exists as a visible card in any category
		local function visibleNames()
			local set = {}
			for _, c in ipairs(CATS) do
				local ce = cache[c]
				if ce then
					for _, it in ipairs(ce.items) do
						if not it.hidden then set[(it.name:lower():gsub("[^%w]", ""))] = true end
					end
				end
			end
			return set
		end
		local function isPlaceholder(it, vis)
			return it.hidden and vis[(it.name:lower():gsub("[^%w]", ""))] == true
		end

		local function pool()
			local list = {}
			local vis = visibleNames()
			for _, c in ipairs(CATS) do
				if current == "All" or current == c then
					local ce = cache[c]
					if ce then
						for _, it in ipairs(ce.items) do if not isPlaceholder(it, vis) then list[#list + 1] = it end end
					end
				end
			end
			return list
		end

		local function render()
			for _, r in ipairs(rows) do r:Destroy() end
			table.clear(rows)
			local q = query:lower()
			local shown, matches = 0, 0
			for _, it in ipairs(pool()) do
				if q == "" or it.name:lower():find(q, 1, true) then
					matches += 1
					if shown < MAXROWS then
						shown += 1
						local row = mk("Frame", {
							Size = UDim2.new(1, -math.floor(6 * scale), 0, rowH), BackgroundColor3 = Color3.fromRGB(40, 40, 50),
							BorderSizePixel = 0, LayoutOrder = shown,
						}, listScroll)
						Instance.new("UICorner", row).CornerRadius = UDim.new(0, math.floor(5 * scale))
						mk("TextLabel", {
							BackgroundTransparency = 1, Text = it.name, Position = UDim2.new(0, math.floor(6 * scale), 0, math.floor(3 * scale)),
							Size = UDim2.new(0.62, 0, 0, ts + 3), TextColor3 = WHITE, TextSize = ts, Font = Enum.Font.GothamBold,
							TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
						}, row, true)
						mk("TextLabel", {
							BackgroundTransparency = 1, Text = it.value, AnchorPoint = Vector2.new(1, 0),
							Position = UDim2.new(1, -math.floor(6 * scale), 0, math.floor(3 * scale)), Size = UDim2.new(0.36, 0, 0, ts + 3),
							TextColor3 = themes[currentThemeName].TopGrad2, TextSize = ts, Font = Enum.Font.GothamBold,
							TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd,
						}, row, true)
						mk("TextLabel", {
							BackgroundTransparency = 1,
							Text = (current == "All" and (it.cat .. "  |  ") or "") .. "Demand: " .. (it.demand or "-") .. "  |  Stability: " .. (it.stability or "-"),
							Position = UDim2.new(0, math.floor(6 * scale), 0, math.floor(3 * scale) + ts + 3),
							Size = UDim2.new(1, -math.floor(12 * scale), 0, tsSmall + 3), TextColor3 = GRAY, TextSize = tsSmall,
							Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
						}, row, true)
						rows[#rows + 1] = row
					end
				end
			end
			local text
			if loading then
				return -- the loader keeps writing its own progress text
			elseif matches == 0 then
				text = (#pool() == 0) and "Nothing loaded yet" or "No item matches your search"
			elseif matches > shown then
				text = matches .. " items (showing the first " .. shown .. " - refine the search)"
			else
				text = matches .. " items"
			end
			setStatus(text .. failNote, failNote ~= "" and matches == 0)
		end

		local function loadCat(cat)
			local body, err = httpGet(BASE .. cat:lower())
			if not body then return nil, "HTTP " .. tostring(err) end
			lastRaw[cat] = body
			local items = parsePage(body)
			if #items == 0 then return nil, "page layout not recognized" end
			for _, it in ipairs(items) do it.cat = cat end
			return items
		end

		local function ensure()
			if loading then return end
			local cats = {}
			for _, c in ipairs(CATS) do
				if current == "All" or current == c then cats[#cats + 1] = c end
			end
			loading = true
			failNote = ""
			task.spawn(function()
				local failed = {}
				for i, c in ipairs(cats) do
					local ce = cache[c]
					if not ce or os.clock() - ce.t > CACHE_SECONDS then
						setStatus("Loading " .. c .. " (" .. i .. "/" .. #cats .. ")...")
						local items, err = loadCat(c)
						if items then
							cache[c] = {t = os.clock(), items = items}
						else
							failed[#failed + 1] = c .. ": " .. tostring(err)
						end
						loading = false
						render()
						loading = true
						if i < #cats then task.wait(0.3) end
					end
				end
				loading = false
				if #failed > 0 then failNote = "  |  failed: " .. table.concat(failed, ", ") end
				render()
			end)
		end

		-- ---------- UI ----------
		createDropdown("Category", {"All", table.unpack(CATS)}, function(name)
			current = name
			render()
			if started then ensure() end
		end)

		local searchHolder = mk("Frame", {
			Name = "TradingSearch", Size = UDim2.new(1, 0, 0, math.floor(30 * scale)), BackgroundColor3 = themes[currentThemeName].ButtonOff, BorderSizePixel = 0,
		}, currentPage)
		themeBg(searchHolder, "ButtonOff")
		Instance.new("UICorner", searchHolder).CornerRadius = UDim.new(0, math.floor(6 * scale))
		local searchBox = mk("TextBox", {
			Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1, PlaceholderText = "Search item...",
			PlaceholderColor3 = Color3.fromRGB(120, 120, 120), Text = "", TextColor3 = WHITE, TextSize = math.max(9, math.floor(11 * scale)),
			Font = Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left, ClearTextOnFocus = false,
		}, searchHolder, true)
		local searchToken = 0
		searchBox:GetPropertyChangedSignal("Text"):Connect(function()
			searchToken += 1
			local my = searchToken
			task.delay(0.2, function()
				if my ~= searchToken then return end
				query = searchBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
				render()
			end)
		end)

		statusLabel = mk("TextLabel", {
			Name = "TradingStatus", Size = UDim2.new(1, 0, 0, math.floor(28 * scale)), BackgroundTransparency = 1, Text = "Open this tab to load the values",
			TextColor3 = GRAY, TextSize = math.max(8, math.floor(9 * scale)), Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
		}, currentPage, true)

		local listHolder = mk("Frame", {
			Name = "TradingList", Size = UDim2.new(1, 0, 0, math.floor(250 * scale)), BackgroundColor3 = themes[currentThemeName].ButtonOff, BorderSizePixel = 0,
		}, currentPage)
		themeBg(listHolder, "ButtonOff")
		Instance.new("UICorner", listHolder).CornerRadius = UDim.new(0, math.floor(6 * scale))
		listScroll = mk("ScrollingFrame", {
			Size = UDim2.new(1, -8, 1, -8), Position = UDim2.new(0, 4, 0, 4), BackgroundTransparency = 1, BorderSizePixel = 0,
			ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(),
		}, listHolder)
		mk("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 3)}, listScroll)

		createButton("Refresh Values", function()
			cache = {}
			render()
			started = true
			ensure()
		end, false)
		mk("TextLabel", {
			Name = "TradingInfo", Size = UDim2.new(1, 0, 0, math.floor(28 * scale)), BackgroundTransparency = 1,
			Text = "Values, demand and stability are taken from supremevalues.com", TextColor3 = GRAY,
			TextSize = math.max(8, math.floor(9 * scale)), Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
			TextWrapped = true,
		}, currentPage)
		-- ==========================================
		-- TRADE CALCULATOR: while a trade window is open, both offers are read from the trade GUI of the game, matched
		-- against the value list (same data as supremevalues.com/mm2, loaded in the background and kept in memory) and
		-- the totals are shown in a small window that appears on its own. The check runs 5 times a second and only
		-- redraws when the offers really changed, so it reacts at once.
		-- ==========================================
		local calcOn = true
		local indexStamp, byName = nil, {}
		local loadingAll = false

		local function norm(s) return (tostring(s):lower():gsub("[^%w]", "")) end
		local function parseNum(v)
			local s = tostring(v):lower():gsub(",", "")
			local n, suffix = s:match("([%d%.]+)%s*([km]?)")
			n = tonumber(n)
			if not n then return nil end
			if suffix == "k" then n *= 1000 elseif suffix == "m" then n *= 1000000 end
			return n
		end
		local function fmt(n)
			local sign = n < 0 and "-" or ""
			local str = tostring(math.floor(math.abs(n) + 0.5))
			local out = str:reverse():gsub("(%d%d%d)", "%1,"):reverse()
			return sign .. out:gsub("^,", "")
		end

		local function rebuildIndex()
			local stamp, count = 0, 0
			for _, c in ipairs(CATS) do
				local ce = cache[c]
				if ce then stamp += ce.t count += 1 end
			end
			stamp = stamp .. ":" .. count
			if stamp == indexStamp then return end
			indexStamp = stamp
			byName = {}
			local vis = visibleNames()
			-- when one name exists in several categories (e.g. "Sunset" as a godly and as a cheap rare / set entry) the
			-- higher category wins instead of whichever was downloaded first
			local PRIORITY = {Chromas = 1, Godlies = 2, Ancients = 3, Vintages = 4, Uniques = 5, Evos = 6, Legendaries = 7, Rares = 8, Sets = 9}
			local function rank(c) return PRIORITY[c] or 99 end
			for _, c in ipairs(CATS) do
				local ce = cache[c]
				if ce then
					for _, it in ipairs(ce.items) do
						local key = norm(it.name)
						if key ~= "" and not isPlaceholder(it, vis) then
							it.num = it.num or parseNum(it.value)
							local cur = byName[key]
							if not cur or rank(it.cat) < rank(cur.cat) then
								byName[key] = it
							end
						end
					end
				end
			end
		end

		-- loads every category in the background (the calculator needs all of them)
		local function loadAll()
			if loadingAll then return end
			loadingAll = true
			task.spawn(function()
				for i, c in ipairs(CATS) do
					local ce = cache[c]
					if not ce or os.clock() - ce.t > CACHE_SECONDS then
						local items = loadCat(c)
						if items then cache[c] = {t = os.clock(), items = items} end
						if i < #CATS then task.wait(0.25) end
					end
				end
				loadingAll = false
				if started then render() end
			end)
		end

		-- ---------- reading the trade window ----------
		local function shown(obj)
			local c = obj
			while c and c ~= game do
				if c:IsA("ScreenGui") then return c.Enabled end
				if c:IsA("GuiObject") and not c.Visible then return false end
				c = c.Parent
			end
			return true
		end

		local function hasWord(name, words)
			name = name:lower()
			for _, w in ipairs(words) do
				if name:find(w, 1, true) then return true end
			end
			return false
		end
		local MINE_WORDS = {"your", "my", "self", "local"}
		local THEIR_WORDS = {"their", "other", "partner", "opponent", "trader", "recipient"}
		local function sideOf(node, gui)
			local c = node
			while c and c ~= gui do
				if hasWord(c.Name, MINE_WORDS) then return "mine" end
				if hasWord(c.Name, THEIR_WORDS) then return "theirs" end
				c = c.Parent
			end
			return nil
		end

		local function amountIn(root)
			for _, d in ipairs(root:GetDescendants()) do
				if d:IsA("TextLabel") and d.Text ~= "" then
					local n = d.Text:match("^%s*[xX\195\151]%s*(%d+)%s*$") or d.Text:match("^%s*(%d+)%s*[xX\195\151]%s*$")
					if n then return math.max(1, tonumber(n)) end
				end
			end
			return 1
		end

		local function textToItem(text)
			local key = norm(text)
			if byName[key] then return byName[key] end
			local stripped = text:gsub("%s*[xX\195\151]%s*%d+%s*$", ""):gsub("^%s*%d+%s*[xX\195\151]%s*", "")
			return byName[norm(stripped)]
		end

		local function collectItems(container)
			local found = {}
			for _, d in ipairs(container:GetDescendants()) do
				if d:IsA("GuiObject") and shown(d) then
					local item, root
					if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Text ~= "" then
						item = textToItem(d.Text)
						root = (d.Parent ~= container) and d.Parent or d
					end
					if not item then
						local byNodeName = byName[norm(d.Name)]
						if byNodeName then item, root = byNodeName, d end
					end
					if item then found[#found + 1] = {item = item, root = root} end
				end
			end
			-- the same item seen twice inside one slot (frame name + label) counts once
			local entries = {}
			for i, e in ipairs(found) do
				local nested = false
				for j, o in ipairs(found) do
					if i ~= j and o.item == e.item and (o.root == e.root and j < i or (o.root ~= e.root and e.root:IsDescendantOf(o.root))) then
						nested = true
						break
					end
				end
				if not nested then entries[#entries + 1] = e end
			end
			local list = {}
			for _, e in ipairs(entries) do
				local amount = (e.root ~= container) and amountIn(e.root) or 1
				list[#list + 1] = {name = e.item.name, value = e.item.num or 0, known = e.item.num ~= nil, amount = amount}
			end
			return list
		end

		local function scanGui(gui)
			local sides = {}
			for _, d in ipairs(gui:GetDescendants()) do
				if d:IsA("GuiObject") and d.Name:lower():find("offer", 1, true) then
					local inside = false
					local p = d.Parent
					while p and p ~= gui do
						if p:IsA("GuiObject") and p.Name:lower():find("offer", 1, true) then inside = true break end
						p = p.Parent
					end
					if not inside and shown(d) then
						local side = sideOf(d, gui)
						if side then sides[side] = sides[side] or {} sides[side][#sides[side] + 1] = d end
					end
				end
			end
			if not (sides.mine or sides.theirs) then return nil end
			local result = {mine = {}, theirs = {}}
			for side, nodes in pairs(sides) do
				for _, node in ipairs(nodes) do
					for _, e in ipairs(collectItems(node)) do result[side][#result[side] + 1] = e end
				end
			end
			return result
		end

		local function scanTrade()
			local pg = LocalPlayer:FindFirstChild("PlayerGui")
			if not pg then return nil end
			for _, g in ipairs(pg:GetChildren()) do
				if g:IsA("ScreenGui") and g ~= ScreenGui and g.Enabled and g.Name:lower():find("trade", 1, true) then
					local res = scanGui(g)
					if res then return res end
				end
			end
			return nil
		end

		-- ---------- the window ----------
		local GREEN, RED, YELLOW = Color3.fromRGB(90, 220, 120), Color3.fromRGB(235, 100, 100), Color3.fromRGB(240, 200, 90)
		local PW, PH = math.floor(240 * scale), math.floor(300 * scale)
		local ZB = -79
		local calcPanel = mk("Frame", {
			Name = "TradeCalculator", Position = UDim2.fromOffset(12, 330), Size = UDim2.fromOffset(PW, PH),
			BackgroundColor3 = themes[currentThemeName].Primary, BorderSizePixel = 0, Active = true, Visible = false, ZIndex = ZB - 1,
		}, ScreenGui)
		themeBg(calcPanel, "Primary")
		Instance.new("UICorner", calcPanel).CornerRadius = UDim.new(0, math.floor(10 * scale))
		local calcStroke = mk("UIStroke", {Color = themes[currentThemeName].Stroke, Thickness = 1}, calcPanel)
		calcPanel:GetPropertyChangedSignal("BackgroundColor3"):Connect(function() calcStroke.Color = themes[currentThemeName].Stroke end)
		attachDrag(calcPanel, calcPanel)
		local cpad = math.floor(9 * scale)
		mk("TextLabel", {
			BackgroundTransparency = 1, Text = "TRADE CALCULATOR", Position = UDim2.fromOffset(cpad, cpad),
			Size = UDim2.new(1, -2 * cpad, 0, ts + 4), TextSize = ts, TextColor3 = WHITE, Font = Enum.Font.GothamBold,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = ZB,
		}, calcPanel)
		local function statLabel(y, size, font)
			return mk("TextLabel", {
				BackgroundTransparency = 1, Text = "", Position = UDim2.fromOffset(cpad, y), Size = UDim2.new(1, -2 * cpad, 0, size + 4),
				TextSize = size, TextColor3 = WHITE, Font = font, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = ZB,
			}, calcPanel, true)
		end
		local y0 = cpad + ts + 8
		local youLabel = statLabel(y0, ts, Enum.Font.GothamMedium)
		local themLabel = statLabel(y0 + ts + 6, ts, Enum.Font.GothamMedium)
		local verdictLabel = statLabel(y0 + 2 * (ts + 6) + 2, ts + 3, Enum.Font.GothamBold)
		local listTop = y0 + 2 * (ts + 6) + 2 + ts + 12
		local calcScroll = mk("ScrollingFrame", {
			BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(cpad, listTop),
			Size = UDim2.new(1, -2 * cpad, 1, -(listTop + cpad)), ScrollBarThickness = 2, AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(), ZIndex = ZB,
		}, calcPanel)
		mk("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 2)}, calcScroll)
		ScreenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
			if calcPanel.Visible then clampToScreen(calcPanel) end
		end)

		local tradeInfo -- the line in the Trading tab (set below)
		local calcRows = {}
		local lastSig = nil
		local function addLine(text, color, bold, order)
			calcRows[#calcRows + 1] = mk("TextLabel", {
				BackgroundTransparency = 1, Text = text, Size = UDim2.new(1, -4, 0, tsSmall + 4), TextSize = tsSmall + 1,
				TextColor3 = color, Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd, LayoutOrder = order, ZIndex = ZB,
			}, calcScroll, true)
		end

		local function totalOf(list)
			local sum, unknown = 0, 0
			for _, e in ipairs(list) do
				sum += e.value * e.amount
				if not e.known then unknown += 1 end
			end
			return sum, unknown
		end

		local function drawTrade(res)
			local mineTotal = totalOf(res.mine)
			local theirTotal = totalOf(res.theirs)
			local parts = {}
			for _, side in ipairs({"mine", "theirs"}) do
				for _, e in ipairs(res[side]) do parts[#parts + 1] = side .. e.name .. e.amount .. e.value end
			end
			local sig = table.concat(parts, "|")
			if sig == lastSig then return end
			lastSig = sig

			local diff = theirTotal - mineTotal
			local big = math.max(mineTotal, theirTotal)
			local small = math.min(mineTotal, theirTotal)
			local _, mineUnknown = totalOf(res.mine)
			local _, theirUnknown = totalOf(res.theirs)
			local function unk(n) return n > 0 and ("  (+" .. n .. " unknown)") or "" end
			youLabel.Text = "You give: " .. fmt(mineTotal) .. unk(mineUnknown)
			themLabel.Text = "You get: " .. fmt(theirTotal) .. unk(theirUnknown)
			-- one definition for both traders: the difference as a percentage of the smaller side, rounded half away from zero,
			-- so the same trade shows the same number (only the sign flips) on both accounts
			local pct = small > 0 and math.floor(math.abs(diff) / small * 100 + 0.5) or nil
			local pctText = pct and ("  (" .. (diff > 0 and "+" or "-") .. pct .. "%)") or ""
			local partial = (mineUnknown + theirUnknown) > 0 and "  ?" or ""
			if big == 0 then
				verdictLabel.Text, verdictLabel.TextColor3 = "No items yet", GRAY
			elseif math.abs(diff) <= big * 0.03 then
				verdictLabel.Text, verdictLabel.TextColor3 = "FAIR  (" .. (diff >= 0 and "+" or "") .. fmt(diff) .. ")" .. partial, YELLOW
			elseif diff > 0 then
				verdictLabel.Text, verdictLabel.TextColor3 = "WIN  +" .. fmt(diff) .. pctText .. partial, GREEN
			else
				verdictLabel.Text, verdictLabel.TextColor3 = "LOSS  " .. fmt(diff) .. pctText .. partial, RED
			end
			if tradeInfo then
				tradeInfo.Text = "Trade: you give " .. fmt(mineTotal) .. " | you get " .. fmt(theirTotal)
			end

			for _, r in ipairs(calcRows) do r:Destroy() end
			table.clear(calcRows)
			local order = 0
			local function section(title, list, total)
				order += 1
				addLine(title .. "  (" .. fmt(total) .. ")", themes[currentThemeName].TopGrad2, true, order)
				if #list == 0 then
					order += 1
					addLine("-", GRAY, false, order)
				end
				for _, e in ipairs(list) do
					order += 1
					local amount = e.amount > 1 and (" x" .. e.amount) or ""
					addLine(e.name .. amount .. "   " .. fmt(e.value * e.amount), WHITE, false, order)
				end
			end
			section("YOU GIVE", res.mine, mineTotal)
			section("YOU GET", res.theirs, theirTotal)
		end

		local wasInTrade = false
		local tradeStart, lastLoadTry = 0, 0
		task.spawn(function()
			while ScreenGui.Parent do
				task.wait(0.2)
				pcall(function()
					if not calcOn then
						calcPanel.Visible = false
						wasInTrade = false
						return
					end
					local res = scanTrade()
					if not res then
						if wasInTrade then
							wasInTrade = false
							lastSig = nil
							calcPanel.Visible = false
							if tradeInfo then tradeInfo.Text = "Trade: not in a trade" end
						end
						return
					end
					if not wasInTrade then
						wasInTrade = true
						lastSig = nil
						tradeStart = os.clock()
						lastLoadTry = os.clock()
						loadAll() -- refreshes values older than 10 minutes in the background
					end
					rebuildIndex()
					local loaded = 0
					for _, c in ipairs(CATS) do if cache[c] then loaded += 1 end end
					if loaded < #CATS and os.clock() - tradeStart < 20 then
						if os.clock() - lastLoadTry > 5 then lastLoadTry = os.clock() loadAll() end
						if not calcPanel.Visible then calcPanel.Visible = true clampToScreen(calcPanel) end
						youLabel.Text, themLabel.Text = "Loading values (" .. loaded .. "/" .. #CATS .. ")...", ""
						verdictLabel.Text = ""
						lastSig = nil
						return
					end
					if not calcPanel.Visible then
						calcPanel.Visible = true
						clampToScreen(calcPanel)
					end
					if next(byName) == nil then
						youLabel.Text, themLabel.Text = "Loading values...", ""
						verdictLabel.Text = ""
						lastSig = nil
						loadAll()
						return
					end
					drawTrade(res)
				end)
			end
		end)

		createButton("Trade Calculator (auto)", function(state)
			calcOn = state
			if state then loadAll() end
		end, true, true)
		tradeInfo = mk("TextLabel", {
			Name = "TradeInfo", Size = UDim2.new(1, 0, 0, math.floor(20 * scale)), BackgroundTransparency = 1, Text = "Trade: not in a trade",
			TextColor3 = GRAY, TextSize = math.max(8, math.floor(9 * scale)), Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
		}, currentPage, true)
		task.delay(4, function() if calcOn then loadAll() end end) -- values are ready before the first trade

		tabButtons["Trading"].Activated:Connect(function()
			if started then return end
			started = true
			ensure()
		end)
	end)()

	-- Tab: Settings
	usePage("Settings")
	createButton("FPS Booster", onFpsBooster, true, fpsBoosterEnabled)
	createButton("Stats Overlay", fx.setStats, true, fx.stats)
	createButton("Show Welcome Screen", function(state)
		Storage.welcomeSkip = not state
		Storage.set("welcome_skip", not state)
	end, true, not Storage.welcomeSkip)
	createSpeedInput("Game Volume:", 100, 0, 100, function(val) setGameVolume(val) end)
	createButton("Rejoin", fx.rejoin, false)
	createButton("Respawn", fx.resetCharacter, false)
	createDropdown("Mode", {"Normal", "Buttons"}, function(name)
		updateMode(name)
	end)
	local _, inputModeButton = createDropdown("Number Input", {"Sliders", "Textboxes"}, function(name)
		NumericInput.setMode(name)
		pcall(Storage.set, "input_mode", name)
	end)
	do
		local savedInputMode = Storage.get("input_mode")
		if savedInputMode == "Textboxes" then
			NumericInput.setMode("Textboxes")
			inputModeButton.Text = " Number Input: Textboxes"
		end
	end
	-- language: every text of the window is translated (Translator, near the top of the script)
	local _, languageButton = createDropdown("Language", Translator.names, function(name)
		Translator.setLanguage(Translator.codeOf[name])
		task.defer(Translator.refreshDropdown) -- the dropdown writes its own text right after this callback
	end)
	Translator.attachDropdown(languageButton)
	Translator.init(ScreenGui)

	-- Tab: UI Settings (color themes, special themes, background effects, configs)
	usePage("UI Settings")
	do
		local gap = math.floor(4 * scale)
		local labelTextSize = math.max(9, math.floor(10 * scale))
		local optionTextSize = math.max(8, math.floor(10 * scale))
		local effectNames = {"None", "Rain", "Matrix", "Snow", "Pumpkins", "Aurora", "Silk", "Nebula", "Stars", "Fireflies", "Embers", "Bubbles"}
		local currentEffectName = "None"
		local styleNames = {"None", "Top Glow", "Bottom Glow", "Diagonal Tint", "Dual Tone", "Side Glow", "Center Glow"}
		local currentStyleName = "None"
		-- picking one of these themes also switches on the effect and style that go with it (only while you have not
		-- chosen an effect / style yourself); picking another theme takes them away again
		local themePairs = {
			["Aurora Theme"] = {effect = "Aurora", style = "Top Glow"},
			["Silk Theme"] = {effect = "Silk", style = "Diagonal Tint"},
			["Nebula Theme"] = {effect = "Nebula", style = "Center Glow"},
			["Sunset Theme"] = {effect = "Embers", style = "Bottom Glow"},
			["Ocean Theme"] = {effect = "Bubbles", style = "Top Glow"},
			["Sakura Theme"] = {effect = "Snow", style = "Dual Tone"},
			["Midnight Theme"] = {effect = "Stars", style = "Side Glow"},
			["Cyberpunk Theme"] = {effect = "Matrix", style = "Dual Tone"},
			["Forest Theme"] = {effect = "Fireflies", style = "Bottom Glow"},
		}
		local autoEffect, autoStyle = nil, nil

		local function sectionLabel(text)
			local l = Instance.new("TextLabel", currentPage)
			l.Name = "SectionLabel"
			l.Size = UDim2.new(1, 0, 0, math.floor(16 * scale))
			l.BackgroundTransparency = 1
			l.Text = text
			l.TextColor3 = Color3.fromRGB(130, 130, 130)
			l.TextSize = labelTextSize
			l.Font = Enum.Font.GothamBold
			l.TextXAlignment = Enum.TextXAlignment.Left
			return l
		end

		-- Grid of selectable options (radio behaviour); returns an API with set(selected)
		local function createOptionGrid(options, columns, cellH, onSelect)
			local rows = math.ceil(#options / columns)
			local holder = Instance.new("Frame", currentPage)
			holder.Name = "OptionGrid"
			holder.Size = UDim2.new(1, 0, 0, rows * cellH + (rows - 1) * gap)
			holder.BackgroundTransparency = 1
			local grid = Instance.new("UIGridLayout", holder)
			grid.SortOrder = Enum.SortOrder.LayoutOrder
			grid.CellSize = UDim2.new(1 / columns, -math.ceil(gap * (columns - 1) / columns), 0, cellH)
			grid.CellPadding = UDim2.new(0, gap, 0, gap)

			local buttons = {}
			for i, opt in ipairs(options) do
				local b = Instance.new("TextButton", holder)
				b.LayoutOrder = i
				b.BackgroundColor3 = themes[currentThemeName].ButtonOff
				b.BorderSizePixel = 0
				b.AutoButtonColor = false
				b.Text = opt
				b.TextColor3 = Color3.fromRGB(170, 170, 170)
				b.TextSize = optionTextSize
				b.Font = Enum.Font.GothamMedium
				themeBg(b, "ButtonOff")
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, math.floor(6 * scale))
				local stroke = Instance.new("UIStroke", b)
				stroke.Color = Color3.fromRGB(255, 255, 255)
				stroke.Thickness = 1.5
				stroke.Transparency = 1
				stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				bindClick(b, function() onSelect(opt) end)
				buttons[opt] = {btn = b, stroke = stroke}
			end

			local api = {}
			function api.set(selected)
				for opt, w in pairs(buttons) do
					local on = (opt == selected)
					w.stroke.Transparency = on and 0 or 1
					w.btn.TextColor3 = on and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(170, 170, 170)
				end
			end
			return api
		end

		local swatches = {}
		local specialGrid, effectGrid, styleGrid

		local function refreshSelection()
			for name, w in pairs(swatches) do
				local on = (currentSpecialName == "No Special Theme" and name == currentColorName)
				w.stroke.Transparency = on and 0 or 1
			end
			if specialGrid then specialGrid.set(currentSpecialName) end
			if effectGrid then effectGrid.set(currentEffectName) end
			if styleGrid then styleGrid.set(currentStyleName) end
		end
		onThemeApplied = function()
			refreshSelection()
			if Fx.refreshTheme then Fx.refreshTheme() end
		end

		local function setThemeSelection(colorName, specialName, noPair)
			if colorName and themes[colorName] then currentColorName = colorName end
			if specialName then currentSpecialName = specialName end
			local active = currentColorName
			if currentSpecialName ~= "No Special Theme" and themes[currentSpecialName] then
				active = currentSpecialName
			end
			applyTheme(active)
			Fx.setHalloween(currentSpecialName == "Halloween Theme")
			if noPair then return end
			-- matching effect + style
			local pair = themePairs[currentSpecialName]
			if pair then
				-- picking a special theme is an explicit choice: its effect and style always come with it
				-- (before, an effect or style picked by hand silently blocked them, so they "did not work" sometimes)
				currentEffectName, autoEffect = pair.effect, pair.effect
				Fx.setEffect(currentEffectName)
				currentStyleName, autoStyle = pair.style, pair.style
				Fx.setStyle(currentStyleName)
			else
				if autoEffect and currentEffectName == autoEffect then
					currentEffectName = "None"
					Fx.setEffect("None")
				end
				if autoStyle and currentStyleName == autoStyle then
					currentStyleName = "None"
					Fx.setStyle("None")
				end
				autoEffect, autoStyle = nil, nil
			end
			refreshSelection()
		end

		-- COLOR THEMES (swatch grid)
		sectionLabel("COLOR THEMES")
		do
			local cellH = math.floor(34 * scale)
			local holder = Instance.new("Frame", currentPage)
			holder.Name = "ColorGrid"
			local colorRows = math.ceil(#colorThemeNames / 4)
			holder.Size = UDim2.new(1, 0, 0, cellH * colorRows + gap * (colorRows - 1))
			holder.BackgroundTransparency = 1
			local grid = Instance.new("UIGridLayout", holder)
			grid.SortOrder = Enum.SortOrder.LayoutOrder
			grid.CellSize = UDim2.new(0.25, -math.ceil(gap * 3 / 4), 0, cellH)
			grid.CellPadding = UDim2.new(0, gap, 0, gap)
			for i, name in ipairs(colorThemeNames) do
				local t = themes[name]
				local b = Instance.new("TextButton", holder)
				b.LayoutOrder = i
				b.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				b.BorderSizePixel = 0
				b.AutoButtonColor = false
				b.Text = name
				b.TextColor3 = Color3.fromRGB(255, 255, 255)
				b.TextStrokeTransparency = 0.5
				b.TextScaled = true
				b.Font = Enum.Font.GothamMedium
				local limit = Instance.new("UITextSizeConstraint", b)
				limit.MaxTextSize = optionTextSize
				limit.MinTextSize = 6
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, math.floor(6 * scale))
				local gradient = Instance.new("UIGradient", b)
				gradient.Color = ColorSequence.new({
					ColorSequenceKeypoint.new(0, t.TopGrad1),
					ColorSequenceKeypoint.new(1, t.TopGrad2)
				})
				gradient.Rotation = 35
				local stroke = Instance.new("UIStroke", b)
				stroke.Color = Color3.fromRGB(255, 255, 255)
				stroke.Thickness = 2
				stroke.Transparency = 1
				stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
				bindClick(b, function() setThemeSelection(name, "No Special Theme") end)
				swatches[name] = {btn = b, stroke = stroke}
			end
		end

		-- SPECIAL THEMES
		sectionLabel("SPECIAL THEMES")
		specialGrid = createOptionGrid(specialThemeNames, 1, math.floor(28 * scale), function(name)
			setThemeSelection(nil, name)
		end)

		-- BACKGROUND EFFECTS
		sectionLabel("BACKGROUND EFFECTS")
		effectGrid = createOptionGrid(effectNames, 3, math.floor(28 * scale), function(name)
			currentEffectName = name
			autoEffect = nil -- your own choice: a theme change no longer takes it away
			Fx.setEffect(name)
			refreshSelection()
		end)

		-- BACKGROUND STYLES
		sectionLabel("BACKGROUND STYLES")
		styleGrid = createOptionGrid(styleNames, 2, math.floor(28 * scale), function(name)
			currentStyleName = name
			autoStyle = nil
			Fx.setStyle(name)
			refreshSelection()
		end)

		-- CONFIGS (save / load / delete)
		sectionLabel("CONFIGS")

		-- Configs are stored through Storage (DataStore / files / memory)
		local function cfgNames()
			local index = Storage.get("cfg_index")
			local names = {}
			if type(index) == "table" then
				for _, n in ipairs(index) do
					if type(n) == "string" then names[#names + 1] = n end
				end
			end
			table.sort(names)
			return names
		end

		local function cfgSetIndex(names)
			return Storage.set("cfg_index", names)
		end

		local function cfgSave(name, data)
			if not Storage.set("cfg_" .. name, data) then return false end
			local names = cfgNames()
			if not table.find(names, name) then
				names[#names + 1] = name
				table.sort(names)
				return cfgSetIndex(names)
			end
			return true
		end

		local function cfgLoad(name)
			local data = Storage.get("cfg_" .. name)
			return type(data) == "table" and data or nil
		end

		local function cfgDelete(name)
			local ok = Storage.delete("cfg_" .. name)
			local names = cfgNames()
			local i = table.find(names, name)
			if i then
				table.remove(names, i)
				cfgSetIndex(names)
			end
			return ok
		end

		-- One-time import of configs saved by the previous version (executor files)
		if Storage.backend == "File" then
			pcall(function()
				local legacyDir = "APEX_MM2/configs"
				local marker = "APEX_MM2/legacy_configs_imported.txt"
				if not isfolder(legacyDir) or isfile(marker) then return end
				-- the old shared configs go to the first account that opens this version, other accounts start clean
				writefile(marker, tostring(LocalPlayer.UserId))
				local names = cfgNames()
				local changed = false
				for _, path in ipairs(listfiles(legacyDir)) do
					local n = tostring(path):match("([^/\\]+)%.json$")
					if n and not table.find(names, n) then
						local ok, decoded = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
						if ok and type(decoded) == "table" and Storage.set("cfg" .. n, decoded) then
							names[#names + 1] = n
							changed = true
						end
					end
				end
				if changed then
					table.sort(names)
					cfgSetIndex(names)
				end
			end)
		end

		local function sanitizeName(raw)
			local n = tostring(raw or ""):gsub("[^%w _%-]", ""):gsub("^%s+", ""):gsub("%s+$", "")
			return n:sub(1, 24)
		end

		local function snapshot()
			return {
				Color = currentColorName,
				Special = currentSpecialName,
				Effect = currentEffectName,
				Style = currentStyleName,
				Width = baseW,
				Height = baseH,
			}
		end

		local function applyConfig(cfg)
			if type(cfg) ~= "table" then return false end
			local legacyColors = {Teal = "Turquoise", Rose = "Pink"}
			local savedColor = legacyColors[cfg.Color] or cfg.Color
			local color = table.find(colorThemeNames, savedColor) and savedColor or "Black"
			local special = table.find(specialThemeNames, cfg.Special) and cfg.Special or "No Special Theme"
			setThemeSelection(color, special, true)
			local effect = table.find(effectNames, cfg.Effect) and cfg.Effect or "None"
			currentEffectName = effect
			autoEffect, autoStyle = nil, nil
			Fx.setEffect(effect)
			local style = table.find(styleNames, cfg.Style) and cfg.Style or "None"
			currentStyleName = style
			Fx.setStyle(style)
			if not minimized and type(cfg.Width) == "number" and type(cfg.Height) == "number" then
				baseW = math.clamp(math.floor(cfg.Width), minW, maxW)
				baseH = math.clamp(math.floor(cfg.Height), minH, maxH)
				MainFrame.Size = UDim2.new(0, baseW, 0, baseH)
				clampToScreen(MainFrame)
			end
			refreshSelection()
			return true
		end

		local nameHolder = Instance.new("Frame", currentPage)
		nameHolder.Name = "ConfigNameHolder"
		nameHolder.Size = UDim2.new(1, 0, 0, math.floor(30 * scale))
		nameHolder.BackgroundColor3 = themes[currentThemeName].ButtonOff
		nameHolder.BorderSizePixel = 0
		themeBg(nameHolder, "ButtonOff")
		Instance.new("UICorner", nameHolder).CornerRadius = UDim.new(0, math.floor(6 * scale))
		local nameBox = Instance.new("TextBox", nameHolder)
		nameBox.Size = UDim2.new(1, -16, 1, 0)
		nameBox.Position = UDim2.new(0, 8, 0, 0)
		nameBox.BackgroundTransparency = 1
		nameBox.PlaceholderText = "Config name"
		nameBox.PlaceholderColor3 = Color3.fromRGB(120, 120, 120)
		nameBox.Text = ""
		nameBox.TextColor3 = Color3.fromRGB(255, 255, 255)
		nameBox.TextSize = math.max(9, math.floor(11 * scale))
		nameBox.Font = Enum.Font.GothamMedium
		nameBox.TextXAlignment = Enum.TextXAlignment.Left
		nameBox.ClearTextOnFocus = false

		local listHolder = Instance.new("Frame", currentPage)
		listHolder.Name = "ConfigList"
		listHolder.Size = UDim2.new(1, 0, 0, math.floor(86 * scale))
		listHolder.BackgroundColor3 = themes[currentThemeName].ButtonOff
		listHolder.BorderSizePixel = 0
		themeBg(listHolder, "ButtonOff")
		Instance.new("UICorner", listHolder).CornerRadius = UDim.new(0, math.floor(6 * scale))
		local listScroll = Instance.new("ScrollingFrame", listHolder)
		listScroll.Size = UDim2.new(1, -8, 1, -8)
		listScroll.Position = UDim2.new(0, 4, 0, 4)
		listScroll.BackgroundTransparency = 1
		listScroll.BorderSizePixel = 0
		listScroll.ScrollBarThickness = 2
		listScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
		listScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
		local listLayout = Instance.new("UIListLayout", listScroll)
		listLayout.SortOrder = Enum.SortOrder.LayoutOrder
		listLayout.Padding = UDim.new(0, 3)

		local statusLabel = Instance.new("TextLabel", currentPage)
		statusLabel.Name = "ConfigStatus"
		statusLabel.Size = UDim2.new(1, 0, 0, math.floor(16 * scale))
		statusLabel.BackgroundTransparency = 1
		statusLabel.Text = (Storage.backend == "Memory") and "No saving available: settings last until you rejoin" or ("Saving via " .. Storage.backend)
		statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
		statusLabel.TextSize = math.max(8, math.floor(9 * scale))
		statusLabel.Font = Enum.Font.Gotham
		statusLabel.TextXAlignment = Enum.TextXAlignment.Left
		statusLabel.TextTruncate = Enum.TextTruncate.AtEnd

		local function setStatus(msg, ok)
			statusLabel.Text = msg
			statusLabel.TextColor3 = ok and Color3.fromRGB(110, 210, 130) or Color3.fromRGB(230, 100, 100)
		end

		local selectedConfig
		local function refreshConfigList()
			for _, c in ipairs(listScroll:GetChildren()) do
				if c:IsA("GuiObject") then c:Destroy() end
			end
			local names = cfgNames()
			if #names == 0 then
				local l = Instance.new("TextLabel", listScroll)
				l.Size = UDim2.new(1, 0, 0, math.floor(24 * scale))
				l.BackgroundTransparency = 1
				l.Text = "No saved configs"
				l.TextColor3 = Color3.fromRGB(120, 120, 120)
				l.TextSize = optionTextSize
				l.Font = Enum.Font.Gotham
			end
			for i, n in ipairs(names) do
				local selected = (n == selectedConfig)
				local b = Instance.new("TextButton", listScroll)
				b.LayoutOrder = i
				b.Size = UDim2.new(1, 0, 0, math.floor(24 * scale))
				b.BackgroundColor3 = selected and themes[currentThemeName].Stroke or Color3.fromRGB(40, 40, 50)
				b.BackgroundTransparency = selected and 0.35 or 0
				b.BorderSizePixel = 0
				b.AutoButtonColor = false
				b.Text = n
				b.TextColor3 = Color3.fromRGB(210, 210, 210)
				b.TextSize = optionTextSize
				b.Font = Enum.Font.Gotham
				Instance.new("UICorner", b).CornerRadius = UDim.new(0, 5)
				bindClick(b, function()
					selectedConfig = n
					nameBox.Text = n
					refreshConfigList()
				end)
			end
		end

		local actionRow = Instance.new("Frame", currentPage)
		actionRow.Name = "ConfigActions"
		actionRow.Size = UDim2.new(1, 0, 0, math.floor(30 * scale))
		actionRow.BackgroundTransparency = 1
		local rowLayout = Instance.new("UIListLayout", actionRow)
		rowLayout.FillDirection = Enum.FillDirection.Horizontal
		rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
		rowLayout.Padding = UDim.new(0, gap)

		local function actionButton(text, order, callback)
			local b = Instance.new("TextButton", actionRow)
			b.LayoutOrder = order
			b.Size = UDim2.new(1 / 3, -math.ceil(gap * 2 / 3), 1, 0)
			b.BackgroundColor3 = themes[currentThemeName].ButtonOff
			b.BorderSizePixel = 0
			b.AutoButtonColor = false
			b.Text = text
			b.TextColor3 = Color3.fromRGB(210, 210, 210)
			b.TextSize = math.max(9, math.floor(11 * scale))
			b.Font = Enum.Font.GothamMedium
			themeBg(b, "ButtonOff")
			Instance.new("UICorner", b).CornerRadius = UDim.new(0, math.floor(6 * scale))
			bindClick(b, callback)
		end

		actionButton("Save", 1, function()
			local name = sanitizeName(nameBox.Text)
			if name == "" and selectedConfig then name = selectedConfig end
			if name == "" then setStatus("Enter a config name first", false) return end
			if cfgSave(name, snapshot()) then
				selectedConfig = name
				nameBox.Text = name
				setStatus("Saved \"" .. name .. "\"", true)
				refreshConfigList()
			else
				setStatus("Could not save config", false)
			end
		end)

		actionButton("Load", 2, function()
			local name = selectedConfig or sanitizeName(nameBox.Text)
			if name == "" then setStatus("Select a config first", false) return end
			local cfg = cfgLoad(name)
			if cfg and applyConfig(cfg) then
				selectedConfig = name
				setStatus("Loaded \"" .. name .. "\"", true)
				refreshConfigList()
			else
				setStatus("Config not found", false)
			end
		end)

		actionButton("Delete", 3, function()
			local name = selectedConfig or sanitizeName(nameBox.Text)
			if name == "" then setStatus("Select a config first", false) return end
			if cfgDelete(name) then
				if selectedConfig == name then selectedConfig = nil end
				nameBox.Text = ""
				setStatus("Deleted \"" .. name .. "\"", true)
				refreshConfigList()
			else
				setStatus("Could not delete config", false)
			end
		end)

		refreshConfigList()
		refreshSelection()
		uiApi = {snapshot = snapshot, apply = applyConfig}
	end

	selectTab("Visuals", true)

	-- ==========================================
	-- Right button bar (Buttons mode)
	-- ==========================================
	createRightButton("Body ESP", function(state) espEnabled = state end, true, espEnabled)
	createRightButton("Role Billboard", function(state) rolesEnabled = state end, true, rolesEnabled)
	createRightButton("Gun ESP", function(state) gunEspEnabled = state end, true, gunEspEnabled)
	createRightButton("Dark World", fx.setDarkWorld, true, fx.darkWorld)
	createRightButton("Custom FOV", fx.setFov, true, fx.fov)
	createRightSpeedInput("FOV:", fx.fovValue, 40, 120, function(val) fx.fovValue = val end)
	createRightButton("Crosshair", function(state) FloatingUi.setCrosshair(state) end, true, false)

	createRightButton("Auto Grab Gun", function(state) autoGrabGunEnabled = state end, true, autoGrabGunEnabled)
	createRightButton("Auto Collect Coins", function(state)
		autoCollectCoinsEnabled = state
		if not state then
			setMovementLocked(false)
			exitUnderMap()
		end
	end, true, autoCollectCoinsEnabled)
	createRightSpeedInput("Collect Coin Speed:", collectSpeed, 20, 45, function(val) collectSpeed = val end)
	createCollectStatus(RightButtonsContainer, math.max(8, math.floor(9 * scale)))
	createRightButton("Under Map Collect", function(state)
